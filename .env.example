DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chakusa?schema=public"
# Used only by the Prisma CLI (migrate/generate/db pull), never by the
# running API or worker process — see prisma/schema.prisma's datasource
# doc comment. In production this is Supabase's DIRECT (session-mode, port
# 5432) connection, while DATABASE_URL above becomes Supabase's pooled
# (transaction-mode, port 6543) connection. Locally there is no pooler, so
# both variables point at the same local Postgres instance.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/chakusa?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
# Optional free-scheduler fallback. Generate a distinct random value with at
# least 32 characters; never reuse JWT_SECRET or commit the production value.
WORKER_TRIGGER_SECRET=""
PORT=4000
NODE_ENV=development
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_URL="chakusa://reset-password"
# How long a public review/private-feedback link stays usable after
# generation. Defaults to 30 days if unset.
PUBLIC_REVIEW_TOKEN_TTL_DAYS=30
# Placeholder pending a real commercial decision. How many active team
# members (owner included) a Business-tier business may have.
BUSINESS_SEAT_LIMIT=10
# How long a team invitation stays acceptable after creation.
TEAM_INVITATION_TTL_DAYS=7
# Base URL of the public web page that consumes GET/POST
# /public/reviews/:token, e.g. "https://feedback.example.com" (that page is
# not built by this backend). Required in production; falls back to a local
# placeholder in dev/test when unset. Must be https:// in production.
PUBLIC_REVIEW_BASE_URL="https://chakusa.com"
# Public Expo/mobile trust destinations. These values are safe to expose.
EXPO_PUBLIC_PRIVACY_POLICY_URL="https://chakusa.com/privacy"
EXPO_PUBLIC_TERMS_OF_USE_URL="https://chakusa.com/terms"
EXPO_PUBLIC_SUPPORT_URL="https://chakusa.com/support"
EXPO_PUBLIC_SUPPORT_EMAIL="support@chakusa.com"
# Set to "true" in production once Resend's sending domain is verified —
# only then does startup require RESEND_API_KEY/EMAIL_FROM below. With
# EMAIL_ENABLED=false, the API boots normally and password reset / team
# invitation email delivery cleanly no-ops (still succeeds functionally —
# see passwordResetEmail.ts/teamInvitationEmail.ts — just without an
# actual email sent; team invitations still return a manually-shareable
# link either way).
EMAIL_ENABLED=false
RESEND_API_KEY=""
EMAIL_FROM=""
# Set to "true" in production to require Google credentials at startup.
GOOGLE_AUTH_ENABLED=false
# Comma-separated OAuth client IDs whose Google ID tokens the API accepts.
GOOGLE_OAUTH_CLIENT_IDS=""
# Set to "true" in production to require Apple credentials at startup.
APPLE_AUTH_ENABLED=false
# Native iOS App ID / bundle identifier used as the Apple token audience.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# Base64-encoded contents of the Apple Sign in with Apple .p8 private key.
APPLE_PRIVATE_KEY_BASE64=""
# Base64-encoded 32-byte AES key used only to encrypt provider refresh tokens.
PROVIDER_TOKEN_ENCRYPTION_KEY=""
APPLE_CHALLENGE_TTL_MINUTES=5
# Optional. Expo push notifications work without this, but an access token
# enables Expo's enhanced security mode (rejects push requests that don't
# present it). See https://docs.expo.dev/push-notifications/sending-notifications/#additional-security
EXPO_ACCESS_TOKEN=""
# Set to "true" in production to require Twilio credentials at startup.
# Manual SMS sending (Pro-only, POST /messages/send) still works without
# any of these set — it just fails with PROVIDER_SEND_FAILED. Never commit
# real values here.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Exactly one of these is required to actually send: a single sender
# number, or a Messaging Service SID (Twilio's sender-pool concept).
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
# Set to "true" in production once the deployment target's reverse proxy
# (Render, Railway, etc.) is confirmed to set X-Forwarded-For correctly.
# Required for IP-based rate limiting to see real client IPs instead of
# the proxy's. Leave false for local development (no proxy present).
TRUST_PROXY=false
# Optional comma-separated allowlist of browser origins. Leave unset for a
# mobile-only client (today's default) — set this once a real web
# frontend domain exists.
CORS_ALLOWED_ORIGINS=""
# Set to "true" in production once a Sentry DSN is ready — only then does
# startup require SENTRY_DSN below. With SENTRY_ENABLED=false, the API
# boots and runs normally with no error monitoring. Never commit a real
# DSN here.
SENTRY_ENABLED=false
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE=""
# --- Apple billing: App Store Server API + Server Notifications V2 ---
# A DIFFERENT App Store Connect key than APPLE_KEY_ID/APPLE_PRIVATE_KEY_BASE64
# above (Sign in with Apple) — generate it under Users and Access >
# Integrations > In-App Purchase. Never commit real values here.
APPLE_BILLING_ENABLED=false
APPLE_BUNDLE_ID=""
APPLE_BILLING_ISSUER_ID=""
APPLE_BILLING_KEY_ID=""
APPLE_BILLING_PRIVATE_KEY_BASE64=""
# The one Pro monthly auto-renewable subscription product ID configured in
# App Store Connect.
APPLE_PRO_MONTHLY_PRODUCT_ID=""
# Business tier — readiness only, no mobile purchase UI exists yet.
APPLE_BUSINESS_MONTHLY_PRODUCT_ID=""
# "SANDBOX" or "PRODUCTION" — which App Store Server API environment this
# deployment calls, and the only transaction environment it will accept.
APPLE_STORE_ENVIRONMENT="SANDBOX"
# Comma-separated base64-DER Apple root CA certificate(s), downloaded from
# https://www.apple.com/certificateauthority/ — required for this backend to
# trust any Apple-signed transaction/notification. See
# src/lib/billing/jws.ts.
APPLE_ROOT_CERTIFICATES_BASE64=""
# --- Google billing: Play Developer API + Real-time Developer Notifications ---
GOOGLE_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=""
# A Google Cloud service account granted Play Developer API access to this
# app (Play Console > Users and permissions > API access). Never commit
# real values here.
GOOGLE_BILLING_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_BILLING_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=""
# The one Pro monthly subscription product/base-plan ID configured in Play
# Console.
GOOGLE_PRO_MONTHLY_PRODUCT_ID=""
# Business tier — readiness only, no mobile purchase UI exists yet.
GOOGLE_BUSINESS_MONTHLY_PRODUCT_ID=""
# The service account email and audience (this deployment's public webhook
# URL) that Cloud Pub/Sub's push subscription authenticates itself with —
# see src/modules/webhooks/googleRtdnAuth.ts.
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_RTDN_AUDIENCE=""
