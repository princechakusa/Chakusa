{
  "expo": {
    "name": "CHAKUSA",
    "slug": "chakusa",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chakusa",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chakusa.mobile",
      "usesAppleSignIn": true,
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chakusa.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FF5C5C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/chakusa-app-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-iap",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#FF5C5C",
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.618618639466-03el8vtndca92oqjrcqv2f8uv7tqm41m"
        }
      ],
      "./plugins/withCallDetection",
      "./plugins/withReleaseSigning",
      "@sentry/react-native",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Chakusa uses your location while you are using the app: to show businesses near you, to pin your own business on the map, and - only when you choose - to let a customer see you approaching for an appointment. It is never tracked in the background.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "./plugins/withCppStlLinkerFix",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chakusa lets you choose a photo from your library for your profile picture or your business photo. Only the photo you pick is used.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a425309-15fb-4407-8db4-9c380feae21b"
      }
    },
    "owner": "princechakusa"
  }
}
