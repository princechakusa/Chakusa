{
  "expo": {
    "name": "CHAKUSA",
    "slug": "chakusa",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chakusa",
    "icon": "./assets/chakusa-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chakusa.mobile",
      "usesAppleSignIn": true,
      "buildNumber": "9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"] }
        ]
      }
    },
    "android": {
      "package": "com.chakusa.mobile",
      "allowBackup": false,
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#FF5C5C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/chakusa-app-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-iap",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#FF5C5C",
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1004047431327-bi3d48hqkhasgtvk46q3adrtglmtnt04"
        }
      ],
      "./plugins/withCallDetection",
      "./plugins/withReleaseSigning",
      "@sentry/react-native",
      ["expo-splash-screen", {"image": "./assets/chakusa-app-icon.png", "imageWidth": 96, "backgroundColor": "#FBFAF8", "resizeMode": "contain"}],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Chakusa uses your location while you are using the app: to show businesses near you, to pin your own business on the map, and - only when you choose - to let a customer see you approaching for an appointment. It is never tracked in the background.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "./plugins/withCppStlLinkerFix",
      "./plugins/withAndroidSecurity",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chakusa lets you choose a photo from your library for your profile picture or your business photo. Only the photo you pick is used.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a425309-15fb-4407-8db4-9c380feae21b"
      }
    },
    "owner": "princechakusa"
  }
}
