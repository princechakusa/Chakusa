{
  "name": "chakusa-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "send-test-sms": "tsx scripts/send-test-sms.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.2",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^10.70.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^7.1.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "google-auth-library": "^11.0.1",
    "jose": "^6.1.0",
    "libphonenumber-js": "^1.13.10",
    "pino-pretty": "^11.2.2",
    "twilio": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true
  }
}
