// One invitation for one email to join one business at one role. Mirrors
// the existing opaque-token pattern (src/lib/authTokens.ts, already used
// for refresh/reset/public-review tokens): `tokenId` is the lookup key,
// `tokenHash` is the only thing persisted of the secret itself — the raw
// token is returned to the inviting owner exactly once, at creation, and
// never stored or logged again (same guarantee as
// reviews.service.ts's generatePublicReviewLink).
//
// `status` starts PENDING and moves to ACCEPTED or REVOKED via explicit,
// claim-guarded transitions (see teamInvitations.service.ts) — the same
// atomic-updateMany-with-a-WHERE-guard concurrency pattern used throughout
// this codebase. EXPIRED is derived from `expiresAt` at read/accept time
// rather than written by a background job (no cron infrastructure exists
// for this), but is recorded durably the first time an expired PENDING
// invite is actually touched (accepted-against or explicitly checked), so
// a stale-forever PENDING row never misleads a later listing.
//
// Duplicate-pending-invite and existing-member prevention are enforced at
// the application layer inside a Serializable transaction (see
// entitlements.ts's withLimitCheck, reused for seat-limit + duplicate
// checks together) rather than a partial unique index, since Prisma's
// schema DSL cannot express "unique only where status = PENDING" and this
// codebase already has an established pattern for exactly this kind of
// concurrency-safe check.
model TeamInvitation {
  id              String               @id @default(uuid())
  businessId      String               @map("business_id")
  invitedEmail    String               @map("invited_email")
  // Never OWNER — enforced in teamInvitations.schemas.ts's Zod schema, not
  // just convention.
  role            BusinessRole         @map("role")
  tokenId         String               @unique @map("token_id")
  tokenHash       String               @map("token_hash")
  status          TeamInvitationStatus @default(PENDING)
  invitedByUserId String               @map("invited_by_user_id")
  expiresAt       DateTime             @map("expires_at")
  acceptedAt      DateTime?            @map("accepted_at")
  revokedAt       DateTime?            @map("revoked_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("TeamInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, invitedEmail, status])
  @@map("team_invitations")
}

