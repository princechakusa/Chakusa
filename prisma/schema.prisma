generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BusinessRole {
  OWNER
  STAFF
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum AuthChallengePurpose {
  APPLE_SIGN_IN
  APPLE_LINK
  APPLE_DELETE
}

enum DevicePlatform {
  ios
  android
  web
}

enum PushProvider {
  expo
}

enum LeadStatus {
  new
  contacted
  booked
  won
  lost
}

enum LeadUrgency {
  low
  medium
  high
}

enum MessageType {
  missed_call
  booking_confirmation
  review_request
  private_feedback
  comeback_reminder
  custom
}

enum MessageChannel {
  sms
  whatsapp
  call
  email
  other
}

enum MessageStatus {
  draft
  copied
  sent
  failed
}

enum ReviewRequestStatus {
  pending
  sent
  opened
  reviewed
  feedback_received
}

enum FeedbackSentiment {
  positive
  neutral
  negative
}

enum FeedbackStatus {
  new
  acknowledged
  resolved
}

enum ReminderStatus {
  due
  sent
  completed
  dismissed
}

enum MessageTone {
  friendly
  professional
  casual
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  GRACE_PERIOD
  EXPIRED
  CANCELED
}

enum SubscriptionProvider {
  APPLE
  GOOGLE
}

enum ActivityEventType {
  LEAD_CREATED
  LEAD_CONTACTED
  LEAD_BOOKED
  LEAD_WON
  LEAD_LOST
  MESSAGE_COPIED
  MESSAGE_MARKED_SENT
  REVIEW_REQUEST_CREATED
  REVIEW_REQUEST_SENT
  REVIEW_OPENED
  REVIEW_RECEIVED
  FEEDBACK_RECEIVED
  FEEDBACK_STATUS_UPDATED
  REMINDER_CREATED
  REMINDER_SENT
  REMINDER_COMPLETED
  REMINDER_DISMISSED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  // Schema contract for the future automation engine (not yet implemented —
  // see src/lib/messaging/messagingProvider.ts and Phase 1 docs). Nothing
  // in the codebase emits these yet; recordActivity() is never called with
  // them until the automation engine exists.
  AUTOMATION_MESSAGE_SCHEDULED
  AUTOMATION_MESSAGE_SENT
  AUTOMATION_MESSAGE_FAILED
}

// Whether a customer opted out of a specific channel or every channel a
// business might message them on. A dedicated ALL value (rather than a
// nullable `channel`) is deliberate: Postgres treats NULL as distinct from
// NULL in a unique index, so two "opted out of everything" rows for the
// same (business, phone) could otherwise both be inserted — an enum value
// keeps the uniqueness guarantee in CustomerOptOut.@@unique real.
enum OptOutChannel {
  SMS
  WHATSAPP
  ALL
}

// Every trigger justified by an existing domain event this codebase already
// models. Deliberately not "missed call" only — see Phase 3 report. Each
// value maps to one of Chakusa's three KPIs (Recovery, Reviews & Reputation,
// Retention); trigger-specific configuration (e.g. which LeadStatus to wait
// for, which delay) lives in AutomationRule.config, not in this enum, so a
// new *variant* of an existing trigger never requires a schema migration —
// only a genuinely new class of triggering event does.
enum AutomationTriggerType {
  LEAD_CREATED // Recovery — includes missed-call leads (Lead.source), not a separate trigger
  LEAD_FOLLOW_UP // Recovery — lead has sat in a non-terminal status too long
  REVIEW_REQUEST_FOLLOW_UP // Reviews & Reputation — a sent ReviewRequest hasn't converted
  CUSTOMER_RETENTION // Retention — mirrors the existing Reminder/reminderDays concept
}

// SMS is the only real channel Phase 2 can send today (Twilio). WHATSAPP is
// declared now so AutomationRule rows don't need a channel migration when
// WhatsApp ships — see Phase 1's OptOutChannel.WHATSAPP, which exists for
// the identical reason.
enum AutomationChannel {
  SMS
  WHATSAPP
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String
  normalizedEmail String    @unique @map("normalized_email")
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  fullName        String    @map("full_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  ownedBusinesses Business[]           @relation("BusinessOwner")
  memberships     BusinessMember[]
  activityEvents  ActivityEvent[]      @relation("ActivityActor")
  authIdentities  AuthIdentity[]
  authSessions    AuthSession[]
  authChallenges  AuthChallenge[]
  passwordResets  PasswordResetToken[]
  deviceTokens    DeviceToken[]

  @@map("users")
}

model AuthIdentity {
  id                    String       @id @default(uuid())
  userId                String       @map("user_id")
  provider              AuthProvider
  providerSubject       String       @map("provider_subject")
  providerEmail         String?      @map("provider_email")
  providerEmailVerified Boolean      @default(false) @map("provider_email_verified")
  encryptedRefreshToken String?      @map("encrypted_refresh_token")
  credentialUpdatedAt   DateTime?    @map("credential_updated_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_identities")
}

model AuthChallenge {
  id        String               @id @default(uuid())
  userId    String?              @map("user_id")
  purpose   AuthChallengePurpose
  nonceHash String               @unique @map("nonce_hash")
  stateHash String               @unique @map("state_hash")
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model AuthSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  rotatedAt    DateTime? @map("rotated_at")
  replacedById String?   @unique @map("replaced_by_id")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthSession?  @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   AuthSession[] @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model DeviceToken {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  token         String
  platform      DevicePlatform
  provider      PushProvider   @default(expo)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  lastUsedAt    DateTime       @default(now()) @map("last_used_at")
  revokedAt     DateTime?      @map("revoked_at")
  revokedReason String?        @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A physical device token must never be active for more than one user at
  // once (e.g. re-installed app, token reassigned after a different user
  // signs in). This is additionally enforced at the database level by a
  // partial unique index on (token) WHERE is_active — see the
  // add_device_token_active_uniqueness migration; Prisma's schema DSL
  // cannot express a filtered unique index without the extendedIndexes
  // preview feature, so it is not declared here, but it exists in the
  // database and is the true source of the ownership guarantee.
  @@unique([userId, token])
  @@index([userId])
  @@index([userId, isActive])
  @@map("device_tokens")
}

model Business {
  id               String      @id @default(uuid())
  ownerId          String      @map("owner_id")
  name             String
  industry         String?
  phone            String?
  // Best-effort E.164 normalization of `phone`, computed opportunistically
  // at write time (see src/lib/phone.ts) — never required, never validated
  // against `phone` staying in sync, and never blocks a write when it can't
  // be derived. `phone` remains the raw, freeform value every existing
  // client already reads/writes; this is purely an additive derived field
  // for the future messaging/automation layer, which needs a dialable
  // address and has no use for a string it can't send to.
  phoneE164        String?     @map("phone_e164")
  // ISO 3166-1 alpha-2 (e.g. "ZW", "ZA"), IANA timezone (e.g.
  // "Africa/Harare"), ISO 4217 (e.g. "USD", "ZWL"). All nullable: existing
  // businesses predate these fields, and this phase adds no onboarding flow
  // to collect them — they're foundational for future
  // country/timezone-aware automation (provider routing, quiet hours), not
  // read by anything yet.
  country          String?
  timezone         String?
  currency         String?
  googleReviewLink String?     @map("google_review_link")
  workingHours     Json?       @map("working_hours")
  defaultServices  Json?       @map("default_services")
  reminderDays     Int         @default(42) @map("reminder_days")
  preferredTone    MessageTone @default(friendly) @map("preferred_tone")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  owner            User              @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          BusinessMember[]
  customers        Customer[]
  leads            Lead[]
  messages         Message[]
  reviewRequests   ReviewRequest[]
  feedback         Feedback[]
  reminders        Reminder[]
  messageTemplates MessageTemplate[]
  activityEvents   ActivityEvent[]
  subscription     Subscription?
  customerOptOuts  CustomerOptOut[]
  automationRules  AutomationRule[]
  automationRuns   AutomationRun[]

  @@index([ownerId])
  @@map("businesses")
}

model BusinessMember {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  userId     String       @map("user_id")
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("business_members")
}

model Customer {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  phone      String?
  // See Business.phoneE164 — same best-effort, non-blocking derivation,
  // normalized against the owning business's `country` as the default
  // region when the raw value isn't already in international (+…) form.
  phoneE164  String?  @map("phone_e164")
  email      String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads          Lead[]
  messages       Message[]
  reviewRequests ReviewRequest[]
  feedback       Feedback[]
  reminders      Reminder[]
  optOuts        CustomerOptOut[]
  automationRuns AutomationRun[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@map("customers")
}

model Lead {
  id               String      @id @default(uuid())
  businessId       String      @map("business_id")
  customerId       String?     @map("customer_id")
  source           String?
  missedCallTime   DateTime?   @map("missed_call_time")
  serviceRequested String?     @map("service_requested")
  urgency          LeadUrgency @default(medium)
  status           LeadStatus  @default(new)
  estimatedValue   Decimal?    @map("estimated_value") @db.Decimal(10, 2)
  notes            String?
  generatedReply   String?     @map("generated_reply")
  contactedAt      DateTime?   @map("contacted_at")
  bookedAt         DateTime?   @map("booked_at")
  wonAt            DateTime?   @map("won_at")
  lostAt           DateTime?   @map("lost_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages       Message[]
  automationRuns AutomationRun[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([customerId])
  @@map("leads")
}

model Message {
  id                String         @id @default(uuid())
  businessId        String         @map("business_id")
  customerId        String?        @map("customer_id")
  leadId            String?        @map("lead_id")
  messageType       MessageType    @map("message_type")
  channel           MessageChannel @default(sms)
  body              String
  status            MessageStatus  @default(draft)
  sentAt            DateTime?      @map("sent_at")
  // Which MessagingProvider handled this send (e.g. "twilio") and that
  // provider's own message id — populated only for messages actually sent
  // through Chakusa (Phase 2 manual send); rows logged for the pre-existing
  // manual copy/paste flow have neither. Nullable, additive: existing rows
  // (there are none in production yet — Message was unused before Phase 2)
  // and any future non-provider message types are unaffected.
  provider          String?        @map("provider")
  providerMessageId String?        @map("provider_message_id")
  // Set only for messages created by the automation executor — the exact
  // AutomationRun this send belongs to. This is what makes
  // executeAutomationRun idempotent regardless of how many times it's
  // invoked for the same run (fresh claim vs. reclaimed after stale-run
  // recovery): before ever calling the provider, it checks whether a
  // Message already carries this run's id, and if so treats that as the
  // authoritative outcome instead of sending again. Nullable — manual
  // sends (Phase 2) never set it.
  automationRunId   String?        @map("automation_run_id")
  createdAt         DateTime       @default(now()) @map("created_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  automationRun AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)

  // Database-level guarantee that one AutomationRun can never have more
  // than one Message row — defense in depth alongside the application-level
  // idempotency check in executeAutomationRun (src/lib/automation/executor.ts)
  // that looks up an existing Message by automationRunId before sending.
  // Postgres unique indexes treat NULL as distinct from NULL, so any number
  // of manual-send Messages (automationRunId: null) remain unaffected.
  @@unique([automationRunId])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([customerId])
  @@index([leadId])
  @@index([providerMessageId])
  @@map("messages")
}

model ReviewRequest {
  id                 String              @id @default(uuid())
  businessId         String              @map("business_id")
  customerId         String?             @map("customer_id")
  serviceName        String?             @map("service_name")
  message            String?
  status             ReviewRequestStatus @default(pending)
  googleReviewLink   String?             @map("google_review_link")
  // Unused by any current code path — appears to have been a stub for the
  // exact feature this migration adds. Left untouched rather than
  // repurposed: it's typed as a full URL (frontend-domain-dependent, and no
  // production domain is configured yet — see the public-review-token
  // fields below, which store a lookup id + hash instead of a URL).
  privateFeedbackUrl String?             @map("private_feedback_url")
  sentAt             DateTime?           @map("sent_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  // Public review/feedback link — lets an unauthenticated customer open
  // GET /public/reviews/:token and submit POST .../feedback with no
  // Chakusa account. Mirrors src/lib/authTokens.ts's existing opaque-token
  // pattern (used for refresh/reset tokens): the raw token handed to the
  // customer is never stored — only publicTokenId (a random lookup key,
  // NOT this row's own id, so the public URL never encodes an internal
  // primary key) and publicTokenHash (SHA-256 of the full raw token,
  // verified with a timing-safe comparison) are persisted. One token per
  // review request — see reviews.service.ts's generatePublicReviewLink for
  // why lazy (re)generation, not a token minted eagerly at creation time,
  // is the right default.
  publicTokenId         String?   @unique @map("public_token_id")
  publicTokenHash       String?   @map("public_token_hash")
  publicTokenExpiresAt  DateTime? @map("public_token_expires_at")
  // Set the instant a feedback submission is accepted through the public
  // token — this is the idempotency claim guard (see
  // publicReviews.service.ts's submitPublicFeedback) that makes a second
  // submission attempt (retry, double-tap, or two concurrent requests) a
  // safe no-op instead of a duplicate Feedback row.
  publicTokenConsumedAt DateTime? @map("public_token_consumed_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  feedback Feedback[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@map("review_requests")
}

model Feedback {
  id              String             @id @default(uuid())
  businessId      String             @map("business_id")
  customerId      String?            @map("customer_id")
  reviewRequestId String?            @map("review_request_id")
  rating          Int
  comment         String?
  sentiment       FeedbackSentiment?
  status          FeedbackStatus     @default(new)
  createdAt       DateTime           @default(now()) @map("created_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reviewRequest ReviewRequest? @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@map("feedback")
}

model Reminder {
  id            String         @id @default(uuid())
  businessId    String         @map("business_id")
  customerId    String?        @map("customer_id")
  serviceName   String?        @map("service_name")
  lastVisitDate DateTime?      @map("last_visit_date")
  dueDate       DateTime       @map("due_date")
  message       String?
  status        ReminderStatus @default(due)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, dueDate])
  @@index([customerId])
  @@map("reminders")
}

model MessageTemplate {
  id           String      @id @default(uuid())
  businessId   String      @map("business_id")
  templateType MessageType @map("template_type")
  name         String
  body         String
  tone         MessageTone @default(friendly)
  isDefault    Boolean     @default(false) @map("is_default")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, templateType])
  @@map("message_templates")
}

model ActivityEvent {
  id         String            @id @default(uuid())
  businessId String            @map("business_id")
  actorId    String?           @map("actor_id")
  eventType  ActivityEventType @map("event_type")
  entityType String            @map("entity_type")
  entityId   String            @map("entity_id")
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_events")
}

// One Subscription per Business — the sole source of truth for plan
// entitlement (see src/lib/entitlements.ts). The provider/transaction/period
// fields are the future billing foundation only; nothing in this codebase
// writes them yet (no StoreKit/Play Billing verification exists), so they
// stay nullable and unused until that integration lands.
model Subscription {
  id                    String                @id @default(uuid())
  businessId            String                @unique @map("business_id")
  plan                  Plan                  @default(FREE)
  status                SubscriptionStatus    @default(ACTIVE)
  provider              SubscriptionProvider?
  providerProductId     String?               @map("provider_product_id")
  originalTransactionId String?               @map("original_transaction_id")
  latestTransactionId   String?               @map("latest_transaction_id")
  currentPeriodStart    DateTime?             @map("current_period_start")
  currentPeriodEnd      DateTime?             @map("current_period_end")
  cancelAtPeriodEnd     Boolean               @default(false) @map("cancel_at_period_end")
  trialEndsAt           DateTime?             @map("trial_ends_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// A customer refusing messages from one business must never opt them out
// of another business's messages — every row is scoped to a single
// businessId, deliberately with no global/cross-tenant opt-out concept.
// This is a foundation-only model for this phase: nothing produces these
// rows yet (no inbound STOP handling, no webhook, no UI) and nothing reads
// them yet (no automation engine to check them against). It exists now so
// the schema contract is settled before the engine that depends on it is
// built.
model CustomerOptOut {
  id         String        @id @default(uuid())
  businessId String        @map("business_id")
  customerId String?       @map("customer_id")
  // Raw phone as received (webhook "From", or manual entry) — not
  // necessarily E.164, since the source of an opt-out (e.g. a provider
  // webhook) may not always report the number in normalized form. Stored
  // as given; normalization happens on the read side when matching against
  // Customer.phoneE164 rather than being enforced here.
  phone      String
  channel    OptOutChannel
  // Freeform provenance ("customer_reply", "manual", "provider_webhook", …)
  // — not an enum yet because nothing produces these rows yet, so the real
  // set of sources isn't known until inbound processing exists.
  source     String
  createdAt  DateTime      @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([businessId, phone, channel])
  @@index([businessId])
  @@index([customerId])
  @@map("customer_opt_outs")
}

// A configured-but-inert automation policy. Creating or enabling a row here
// has no side effect — nothing in the codebase reads AutomationRule to
// decide whether to send anything (no listener, no worker, no cron; see the
// Phase 3 report). `config` intentionally carries all trigger-specific
// detail (e.g. which LeadStatus to wait for, minimum delay since last
// visit) instead of dedicated columns, so a new *variant* of an existing
// AutomationTriggerType never requires a migration — only a genuinely new
// trigger type does, which is deliberately rare (four values today).
model AutomationRule {
  id           String                @id @default(uuid())
  businessId   String                @map("business_id")
  name         String
  enabled      Boolean               @default(false)
  triggerType  AutomationTriggerType @map("trigger_type")
  channel      AutomationChannel     @default(SMS)
  // Seconds to wait after the trigger event before the (future) worker may
  // act. A plain Int rather than a Duration/Interval type — matches
  // Business.reminderDays' precedent of using a primitive for a
  // business-configurable time offset rather than modeling calendar
  // semantics that don't apply (this is a fixed delay, not "N business
  // days").
  delaySeconds Int                   @default(0) @map("delay_seconds")
  // Trigger-specific conditions/config (e.g. { "leadStatuses": ["new"],
  // "minDaysSinceVisit": 30 }). Validated at the Zod layer per triggerType,
  // not by the database — see automation.schemas.ts.
  config       Json                  @default("{}")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs     AutomationRun[]

  // At most one rule per (businessId, triggerType, channel). Nothing in this
  // codebase creates or expects more than one — scheduleMissedCallFollowUp
  // (src/lib/automation/scheduler.ts) resolves the LEAD_CREATED+SMS rule via
  // a bare `findFirst`, which silently picks an arbitrary row if duplicates
  // existed; a client-side "check then create" preflight (see the mobile
  // Automation screen) is not itself a guarantee under concurrent requests.
  // This constraint is what actually makes "one rule per trigger/channel"
  // true, and createAutomationRule (automation.service.ts) surfaces a
  // violation as 409 Conflict, the same P2002-to-409 pattern already used
  // for AutomationRun's dedupeKey and account registration's email.
  @@unique([businessId, triggerType, channel])
  @@index([businessId])
  @@index([businessId, enabled])
  @@index([businessId, triggerType])
  @@map("automation_rules")
}

// One prospective (or, once the future engine exists, actual) execution of
// an AutomationRule against one triggering event. Rows are created only by
// internal code/tests in this phase — there is no client-reachable
// "execute" endpoint (see automation.routes.ts) and nothing ever
// automatically inserts one (no listener wired to Lead/Customer/ReviewRequest
// creation yet).
//
// dedupeKey is this model's idempotency contract: a future worker deciding
// whether "this exact automation should only be scheduled once for this
// event" does a create() guarded by the unique constraint below rather than
// a racy find-then-create — see the Phase 3 report for why a unique
// constraint was chosen over an application-level lock.
model AutomationRun {
  id               String              @id @default(uuid())
  businessId       String              @map("business_id")
  automationRuleId String              @map("automation_rule_id")
  customerId       String?             @map("customer_id")
  leadId           String?             @map("lead_id")
  status           AutomationRunStatus @default(PENDING)
  // Deterministically derived by the future scheduler from
  // (automationRuleId, triggering entity, trigger occurrence) — e.g.
  // `${automationRuleId}:lead:${leadId}` for a one-shot lead trigger. Unique
  // per business so the same event can never produce two PENDING/RUNNING
  // runs for the same rule, which is exactly the duplicate-execution case
  // this phase must make structurally impossible to create, even though
  // nothing creates runs automatically yet.
  dedupeKey        String              @map("dedupe_key")
  scheduledFor     DateTime            @map("scheduled_for")
  startedAt        DateTime?           @map("started_at")
  completedAt      DateTime?           @map("completed_at")
  cancelledAt      DateTime?           @map("cancelled_at")
  errorMessage     String?             @map("error_message")
  // Number of send attempts made so far — incremented on each transient
  // provider failure that gets requeued (RUNNING -> PENDING with a
  // backed-off scheduledFor). Bounded by MAX_ATTEMPTS in
  // src/lib/automation/executor.ts; once reached, the run is marked FAILED
  // instead of being requeued again.
  attemptCount     Int                 @default(0) @map("attempt_count")
  // Execution lease: set to now + LEASE_DURATION_SECONDS (see executor.ts)
  // the instant a run is claimed (PENDING -> RUNNING), cleared back to null
  // whenever the run leaves RUNNING for any reason. A RUNNING row whose
  // lease has passed is presumed to belong to a crashed/killed worker — it
  // never got the chance to reach a terminal status — and is eligible for
  // stale-run recovery (RUNNING -> PENDING) so a live worker can reclaim
  // it. Never used to recover a run merely because it's old; only once
  // this specific deadline has passed.
  leaseExpiresAt   DateTime?           @map("lease_expires_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  automationRule AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@unique([businessId, dedupeKey])
  @@index([businessId])
  @@index([businessId, status])
  // The GET /automation/runs history endpoint (automation.service.ts's
  // listAutomationRunHistory) filters by businessId and orders by createdAt
  // DESC — this composite index covers that scan directly instead of a
  // businessId-only index plus a per-page sort, the same reasoning already
  // applied to the (status, scheduledFor) index below for the worker's claim
  // query. At "many runs per business" scale this is the query that would
  // otherwise degrade first, since it's the one a human waits on.
  @@index([businessId, createdAt])
  @@index([automationRuleId])
  @@index([customerId])
  @@index([leadId])
  @@index([status, leaseExpiresAt])
  // The worker's primary claim query (claimDueAutomationRuns in
  // executor.ts) filters on status = PENDING AND scheduledFor <= now,
  // ordered by scheduledFor — this composite index covers that scan
  // directly. Missing before this pass (P1 scale audit finding); without
  // it, that query falls back to the (status, leaseExpiresAt) index or a
  // sequential scan as PENDING rows accumulate across many businesses.
  @@index([status, scheduledFor])
  @@map("automation_runs")
}
