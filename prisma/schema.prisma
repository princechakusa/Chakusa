  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model DeviceToken {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  token         String
  platform      DevicePlatform
  provider      PushProvider   @default(expo)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  lastUsedAt    DateTime       @default(now()) @map("last_used_at")
  revokedAt     DateTime?      @map("revoked_at")
  revokedReason String?        @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A physical device token must never be active for more than one user at
  // once (e.g. re-installed app, token reassigned after a different user
  // signs in). This is additionally enforced at the database level by a
  // partial unique index on (token) WHERE is_active — see the
  // add_device_token_active_uniqueness migration; Prisma's schema DSL
  // cannot express a filtered unique index without the extendedIndexes
  // preview feature, so it is not declared here, but it exists in the
  // database and is the true source of the ownership guarantee.
  @@unique([userId, token])
  @@index([userId])
  @@index([userId, isActive])
  @@map("device_tokens")
}

model Business {
  id                                String                 @id @default(uuid())
  ownerId                           String                 @map("owner_id")
  name                              String
  industry                          String?
  phone                             String?
  // Best-effort E.164 normalization of `phone`, computed opportunistically
  // at write time (see src/lib/phone.ts) — never required, never validated
  // against `phone` staying in sync, and never blocks a write when it can't
  // be derived. `phone` remains the raw, freeform value every existing
  // client already reads/writes; this is purely an additive derived field
  // for the future messaging/automation layer, which needs a dialable
  // address and has no use for a string it can't send to.
  phoneE164                         String?                @map("phone_e164")
  // ISO 3166-1 alpha-2 (e.g. "ZW", "ZA"), IANA timezone (e.g.
  // "Africa/Harare"), ISO 4217 (e.g. "USD", "ZWL"). All nullable: existing
  // businesses predate these fields, and this phase adds no onboarding flow
  // to collect them — they're foundational for future
  // country/timezone-aware automation (provider routing, quiet hours), not
  // read by anything yet.
  country                           String?
  timezone                          String?
  currency                          String?
  googleReviewLink                  String?                @map("google_review_link")
  // Shown on the public business profile page (see publicSlug below) as a
  // short "about this business" summary — distinct from `industry` (a
  // category) and `defaultServices` (a list), this is free-text the owner
  // writes in their own words. Never required; the public page renders
  // fine without it.
  description                       String?
  workingHours                      Json?                  @map("working_hours")
  defaultServices                   Json?                  @map("default_services")
  reminderDays                      Int                    @default(42) @map("reminder_days")
  preferredTone                     MessageTone            @default(friendly) @map("preferred_tone")
  // Permanent, shareable slug for this business's public profile page
  // (chakusa.app/b/:publicSlug — see src/modules/public/publicBusinessProfile.service.ts).
  // Generated once at business-creation time (src/lib/publicSlug.ts) and
  // never regenerated afterward: an already-shared link (on a storefront,
  // a Google listing, a customer's phone) must keep resolving forever, so
  // nothing in this codebase ever updates this field after creation.
  publicSlug                        String?                @unique @map("public_slug")
  onboardingCompletedAt             DateTime?              @map("onboarding_completed_at")
  betaCohort                        String?                @map("beta_cohort")
  platformStatus                    BusinessPlatformStatus @default(ACTIVE) @map("platform_status")
  verifiedAt                        DateTime?              @map("verified_at")
  suspendedAt                       DateTime?              @map("suspended_at")
  suspensionReason                  String?                @map("suspension_reason")
  bookingMinNoticeMinutes           Int                    @default(60) @map("booking_min_notice_minutes")
  bookingWindowDays                 Int                    @default(90) @map("booking_window_days")
  slotIntervalMinutes               Int                    @default(15) @map("slot_interval_minutes")
  cancellationNoticeMinutes         Int                    @default(1440) @map("cancellation_notice_minutes")
  defaultAppointmentReminderMinutes Int                    @default(1440) @map("default_appointment_reminder_minutes")
  stripeAccountId                   String?                @unique @map("stripe_account_id")
  messagingConsentConfirmedAt       DateTime?              @map("messaging_consent_confirmed_at")
  paymentRemindersEnabled           Boolean                @default(false) @map("payment_reminders_enabled")
  createdAt                         DateTime               @default(now()) @map("created_at")
  updatedAt                         DateTime               @updatedAt @map("updated_at")

  owner                          User                            @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                        BusinessMember[]
  customers                      Customer[]
  leads                          Lead[]
  messages                       Message[]
  reviewRequests                 ReviewRequest[]
  feedback                       Feedback[]
  reminders                      Reminder[]
  messageTemplates               MessageTemplate[]
  activityEvents                 ActivityEvent[]
  subscription                   Subscription?
  customerOptOuts                CustomerOptOut[]
  automationRules                AutomationRule[]
  automationRuns                 AutomationRun[]
  billingEvents                  BillingEvent[]
  teamInvitations                TeamInvitation[]
  customerTags                   CustomerTag[]
  appointments                   Appointment[]
  serviceOfferings               ServiceOffering[]
  bookingBlocks                  BookingBlock[]
  publicBookingAccess            PublicBookingAccess[]
  appointmentPaymentTransactions AppointmentPaymentTransaction[]
  weeklyOwnerReports             WeeklyOwnerReport[]
  externalCalendarSubscriptions  ExternalCalendarSubscription[]
  supportTickets                 SupportTicket[]
  betaFeedback                   BetaFeedback[]
  subscriptionEvents             SubscriptionEvent[]

  @@index([ownerId])
  @@index([createdAt])
  @@index([platformStatus, createdAt])
  @@index([betaCohort])
  @@map("businesses")
}

