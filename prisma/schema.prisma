// Which store environment produced a verified transaction/purchase — read
// directly from the provider's own signed payload (Apple's `data.environment`,
// Google's `purchases.subscriptionsv2.get` testPurchase field), never
// guessed. Exists so a sandbox/test transaction can never be mistaken for a
// real production entitlement (see billingConfig.ts / the Phase report's
// "sandbox/production separation" section).
enum SubscriptionEnvironment {
  SANDBOX
  PRODUCTION
}

enum ActivityEventType {
  LEAD_CREATED
  LEAD_CONTACTED
  LEAD_BOOKED
  LEAD_WON
  LEAD_LOST
  MESSAGE_COPIED
  MESSAGE_MARKED_SENT
  REVIEW_REQUEST_CREATED
  REVIEW_REQUEST_SENT
  REVIEW_OPENED
  REVIEW_RECEIVED
  FEEDBACK_RECEIVED
  FEEDBACK_STATUS_UPDATED
  REMINDER_CREATED
  REMINDER_SENT
  REMINDER_COMPLETED
  REMINDER_DISMISSED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  // Schema contract for the future automation engine (not yet implemented —
  // see src/lib/messaging/messagingProvider.ts and Phase 1 docs). Nothing
  // in the codebase emits these yet; recordActivity() is never called with
  // them until the automation engine exists.
  AUTOMATION_MESSAGE_SCHEDULED
  AUTOMATION_MESSAGE_SENT
  AUTOMATION_MESSAGE_FAILED
  // Business v1 team events — see teamInvitations.service.ts /
  // teamMembers.service.ts. Additive to this enum, same as the automation
  // values above.
  TEAM_MEMBER_INVITED
  TEAM_MEMBER_JOINED
  TEAM_MEMBER_ROLE_CHANGED
  TEAM_MEMBER_REMOVED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELED
  APPOINTMENT_NO_SHOW
}

// Whether a customer opted out of a specific channel or every channel a
// business might message them on. A dedicated ALL value (rather than a
// nullable `channel`) is deliberate: Postgres treats NULL as distinct from
// NULL in a unique index, so two "opted out of everything" rows for the
// same (business, phone) could otherwise both be inserted — an enum value
// keeps the uniqueness guarantee in CustomerOptOut.@@unique real.
enum OptOutChannel {
  SMS
  WHATSAPP
  ALL
}

// Every trigger justified by an existing domain event this codebase already
// models. Deliberately not "missed call" only — see Phase 3 report. Each
// value maps to one of Chakusa's three KPIs (Recovery, Reviews & Reputation,
// Retention); trigger-specific configuration (e.g. which LeadStatus to wait
// for, which delay) lives in AutomationRule.config, not in this enum, so a
// new *variant* of an existing trigger never requires a schema migration —
// only a genuinely new class of triggering event does.
enum AutomationTriggerType {
  LEAD_CREATED // Recovery — includes missed-call leads (Lead.source), not a separate trigger
  LEAD_FOLLOW_UP // Recovery — lead has sat in a non-terminal status too long
  REVIEW_REQUEST_FOLLOW_UP // Reviews & Reputation — a sent ReviewRequest hasn't converted
  CUSTOMER_RETENTION // Retention — mirrors the existing Reminder/reminderDays concept
}

// SMS is the only real channel Phase 2 can send today (Twilio). WHATSAPP is
// declared now so AutomationRule rows don't need a channel migration when
// WhatsApp ships — see Phase 1's OptOutChannel.WHATSAPP, which exists for
// the identical reason.
enum AutomationChannel {
  SMS
  WHATSAPP
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id              String            @id @default(uuid())
  email           String
  normalizedEmail String            @unique @map("normalized_email")
  passwordHash    String?           @map("password_hash")
  emailVerifiedAt DateTime?         @map("email_verified_at")
  accountStatus   UserAccountStatus @default(ACTIVE) @map("account_status")
  fullName        String            @map("full_name")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  ownedBusinesses     Business[]           @relation("BusinessOwner")
  memberships         BusinessMember[]
  activityEvents      ActivityEvent[]      @relation("ActivityActor")
  authIdentities      AuthIdentity[]
  authSessions        AuthSession[]
  authChallenges      AuthChallenge[]
  passwordResets      PasswordResetToken[]
  deviceTokens        DeviceToken[]
  sentTeamInvitations TeamInvitation[]     @relation("TeamInvitationInviter")
  supportTickets      SupportTicket[]
  betaFeedback        BetaFeedback[]
  adminMembership     AdminMembership?

  @@index([createdAt])
  @@map("users")
}

model AuthIdentity {
  id                    String       @id @default(uuid())
  userId                String       @map("user_id")
  provider              AuthProvider
  providerSubject       String       @map("provider_subject")
  providerEmail         String?      @map("provider_email")
  providerEmailVerified Boolean      @default(false) @map("provider_email_verified")
  encryptedRefreshToken String?      @map("encrypted_refresh_token")
  credentialUpdatedAt   DateTime?    @map("credential_updated_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_identities")
}

model AuthChallenge {
  id        String               @id @default(uuid())
  userId    String?              @map("user_id")
  purpose   AuthChallengePurpose
  nonceHash String               @unique @map("nonce_hash")
  stateHash String               @unique @map("state_hash")
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model AuthSession {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  tokenHash     String           @unique @map("token_hash")
  familyId      String           @map("family_id")
  expiresAt     DateTime         @map("expires_at")
  lastUsedAt    DateTime?        @map("last_used_at")
  rotatedAt     DateTime?        @map("rotated_at")
  replacedById  String?          @unique @map("replaced_by_id")
  revokedAt     DateTime?        @map("revoked_at")
  revokeReason  String?          @map("revoke_reason")
  scope         AuthSessionScope @default(PRODUCT)
  csrfTokenHash String?          @map("csrf_token_hash")
  ipAddress     String?          @map("ip_address")
  userAgent     String?          @map("user_agent")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthSession?  @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   AuthSession[] @relation("SessionRotation")

  @@index([userId])
  @@index([userId, scope])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Platform-level access for Chakusa staff. This is intentionally separate
/// from BusinessMember/BusinessRole, which only grants authority inside one
/// tenant. A user must enter through the dedicated ADMIN-scoped login flow;
/// product sessions can never authorize an admin route.
model AdminMembership {
  id            String                @id @default(uuid())
  userId        String                @unique @map("user_id")
  role          AdminRole
  status        AdminMembershipStatus @default(ACTIVE)
  mfaRequired   Boolean               @default(false) @map("mfa_required")
  mfaEnrolledAt DateTime?             @map("mfa_enrolled_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, role])
  @@map("admin_memberships")
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Durable event ledger. Rows are written in the caller's transaction only;
/// publication/queue consumption is intentionally deferred to a later stage.
model OutboxEvent {
  id             String          @id @default(uuid())
  dedupeKey      String          @unique @map("dedupe_key")
  aggregateType  String          @map("aggregate_type")
  aggregateId    String          @map("aggregate_id")
  eventType      String          @map("event_type")
  eventVersion   Int             @default(1) @map("event_version")
  tenantId       String          @map("tenant_id")
  businessId     String          @map("business_id")
  payload        Json
  metadata       Json?
  correlationId  String?         @map("correlation_id")
  causationId    String?         @map("causation_id")
  status         OutboxStatus    @default(PENDING)
  retryCount     Int             @default(0) @map("retry_count")
  nextAttemptAt  DateTime        @default(now()) @map("next_attempt_at")
  leaseOwner     String?         @map("lease_owner")
  leaseExpiresAt DateTime?       @map("lease_expires_at")
  lastError      String?         @map("last_error")
  publishedAt    DateTime?       @map("published_at")
  lastAttemptAt  DateTime?       @map("last_attempt_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  deliveries     EventDelivery[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([businessId, status, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([businessId, aggregateType, aggregateId, createdAt, status])
  @@index([eventType, createdAt])
  @@map("outbox_events")
}

model EventSubscription {
  id          String          @id @default(uuid())
  name        String          @unique
  eventType   String          @map("event_type")
  version     Int             @default(1)
  active      Boolean         @default(true)
  maxAttempts Int             @default(8) @map("max_attempts")
  createdAt   DateTime        @default(now()) @map("created_at")
  deliveries  EventDelivery[]

  @@index([eventType, active])
  @@map("event_subscriptions")
}

model EventDelivery {
  id             String              @id @default(uuid())
  eventId        String              @map("event_id")
  subscriptionId String              @map("subscription_id")
  status         EventDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  leaseOwner     String?             @map("lease_owner")
  leaseExpiresAt DateTime?           @map("lease_expires_at")
  lastError      String?             @map("last_error")
  nextAttemptAt  DateTime            @default(now()) @map("next_attempt_at")
  deliveredAt    DateTime?           @map("delivered_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  event          OutboxEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription   EventSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([eventId, subscriptionId])
  @@index([status, nextAttemptAt, leaseExpiresAt, createdAt])
  @@index([subscriptionId, status, eventId])
  @@map("event_deliveries")
}

model Workflow {
  id                     String              @id @default(uuid())
  businessId             String              @map("business_id")
  name                   String
  description            String?
  status                 WorkflowStatus      @default(DRAFT)
  createdById            String              @map("created_by_id")
  scheduleEnabled        Boolean?            @map("schedule_enabled")
  nextTriggerAt          DateTime?           @map("next_trigger_at")
  scheduleLeaseOwner     String?             @map("schedule_lease_owner")
  scheduleLeaseExpiresAt DateTime?           @map("schedule_lease_expires_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  versions               WorkflowVersion[]
  executions             WorkflowExecution[]

  @@index([businessId, status])
  @@index([status, scheduleEnabled, nextTriggerAt, scheduleLeaseExpiresAt])
  @@map("workflows")
}

model WorkflowVersion {
  id          String    @id @default(uuid())
  workflowId  String    @map("workflow_id")
  version     Int
  definition  Json
  checksum    String
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId, publishedAt])
  @@map("workflow_versions")
}

model WorkflowExecution {
  id                 String                   @id @default(uuid())
  workflowId         String                   @map("workflow_id")
  version            Int
  businessId         String                   @map("business_id")
  triggerEventId     String?                  @map("trigger_event_id")
  status             WorkflowExecutionStatus  @default(PENDING)
  state              Json
  idempotencyKey     String                   @unique @map("idempotency_key")
  attempts           Int                      @default(0)
  retryCount         Int                      @default(0) @map("retry_count")
  currentNodeId      String?                  @map("current_node_id")
  leaseOwner         String?                  @map("lease_owner")
  leaseExpiresAt     DateTime?                @map("lease_expires_at")
  nextAttemptAt      DateTime                 @default(now()) @map("next_attempt_at")
  timeoutAt          DateTime?                @map("timeout_at")
  cancelledAt        DateTime?                @map("cancelled_at")
  cancellationReason String?                  @map("cancellation_reason")
  scheduledFor       DateTime?                @map("scheduled_for")
  startedAt          DateTime?                @map("started_at")
  completedAt        DateTime?                @map("completed_at")
  lastError          String?                  @map("last_error")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  workflow           Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  history            WorkflowExecutionEvent[]
  actionAttempts     WorkflowActionAttempt[]

  @@index([businessId, status, nextAttemptAt])
  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([workflowId, createdAt])
  @@index([businessId, createdAt, status])
  @@map("workflow_executions")
}

model WorkflowActionAttempt {
  id             String            @id @default(uuid())
  executionId    String            @map("execution_id")
  businessId     String            @map("business_id")
  nodeId         String            @map("node_id")
  actionName     String            @map("action_name")
  idempotencyKey String            @unique @map("idempotency_key")
  status         String            @default("PENDING")
  attempts       Int               @default(0)
  output         Json?
  lastError      String?           @map("last_error")
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  execution      WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, nodeId])
  @@index([businessId, status, updatedAt])
  @@map("workflow_action_attempts")
}

model WorkflowExecutionEvent {
  id          String            @id @default(uuid())
  executionId String            @map("execution_id")
  businessId  String            @map("business_id")
  type        String
  nodeId      String?           @map("node_id")
  durationMs  Int?              @map("duration_ms")
  retryCount  Int               @default(0) @map("retry_count")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([businessId, type, createdAt])
  @@index([executionId, createdAt])
  @@map("workflow_execution_events")
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  key         String
  version     Int
  name        String
  description String?
  definition  Json
  checksum    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([key, version])
  @@index([active, key])
  @@map("workflow_templates")
}

model AutomationTask {
  id               String    @id @default(uuid())
  idempotencyKey   String    @unique @map("idempotency_key")
  businessId       String    @map("business_id")
  executionId      String?   @map("execution_id")
  title            String
  description      String?
  assignedMemberId String?   @map("assigned_member_id")
  status           String    @default("OPEN")
  dueAt            DateTime? @map("due_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([businessId, status, dueAt])
  @@map("automation_tasks")
}

/// Server-controlled rollout and capability metadata. Target identifiers are
/// optional by scope so one table supports platform, business, user, and
/// internal cohorts without duplicating flag entities.
model FeatureFlag {
  id             String           @id @default(uuid())
  key            String
  scope          FeatureFlagScope
  businessId     String?          @map("business_id")
  userId         String?          @map("user_id")
  enabled        Boolean          @default(false)
  status         String           @default("DISABLED")
  rolloutPercent Int              @default(100) @map("rollout_percent")
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([key, scope])
  @@index([businessId, key])
  @@index([userId, key])
  @@map("feature_flags")
}

/// Append-only platform audit ledger. Actor identity and role are snapshotted
/// as strings instead of foreign keys so account deletion or role changes can
/// never rewrite or cascade-delete historical evidence.
model AdminAuditLog {
  id                String   @id @default(uuid())
  adminMembershipId String?  @map("admin_membership_id")
  adminUserId       String?  @map("admin_user_id")
  adminEmail        String   @map("admin_email")
  adminRole         String   @map("admin_role")
  action            String
  targetType        String   @map("target_type")
