enum MessageType {
  missed_call
  booking_confirmation
  review_request
  private_feedback
  comeback_reminder
  custom
  // Automated follow-up for a lead submitted through a business's public
  // profile contact form (src/modules/public/publicBusinessProfile.service.ts)
  // — distinct from missed_call because the copy is wrong otherwise ("sorry
  // we missed your call" makes no sense for a customer who just proactively
  // reached out). See src/lib/leadSources.ts for the automation-eligibility
  // gate this template type is paired with.
  public_profile_inquiry
  // Automated nudge for a lead that has sat in a non-terminal status
  // (new/contacted/booked) too long — the Customer Lifecycle Automation
  // Engine's LEAD_FOLLOW_UP trigger (src/lib/automation/scheduler.ts).
  // Distinct from missed_call: by the time this fires, the lead has
  // usually already been contacted once, so "sorry we missed your call"
  // is no longer accurate — this is a "still interested?" check-in.
  lead_follow_up
  appointment_reminder
  appointment_same_day_reminder
  appointment_rescheduled
  appointment_canceled
  appointment_follow_up
  payment_reminder
}

