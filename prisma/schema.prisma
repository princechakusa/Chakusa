generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: runtime connection used by PrismaClient (API + worker,
// both — see src/lib/prisma.ts, which reads no other env var). In
// production this points at Supabase's connection pooler (transaction
// mode), since it's what many short-lived queries from the API/worker
// processes actually want.
//
// DIRECT_URL: used only by the Prisma CLI (`prisma migrate deploy`/`dev`,
// `prisma db pull`, etc.) for schema/migration operations, which need a
// direct session-mode connection — DDL and Prisma's migration advisory
// locks don't work reliably through a transaction-mode pooler. Never read
// by PrismaClient at runtime, so it is deliberately NOT part of
// src/lib/config.ts's application env validation — see that file's
// comment near DATABASE_URL. Locally, both variables point at the same
// docker-compose Postgres instance; there's no pooler in local dev, so
// there's nothing to split.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// ADMIN added for Business v1 (team operations) — see BusinessMember below
// and src/lib/authorization.ts. v1 deliberately keeps team-management
// actions (invite/remove/role-change) OWNER-only regardless of ADMIN vs
// STAFF; ADMIN exists as a distinct, assignable label now so a future phase
// can grant it real additional operational permissions without another
// enum migration, but no route currently treats ADMIN differently from
// STAFF — see the Business Phase 1 report's "role model" section.
enum BusinessRole {
  OWNER
  ADMIN
  STAFF
}

// A member's access state, independent of BusinessRole. ACTIVE is the only
// state that existed implicitly before Business v1 (every member always
// had full access). SUSPENDED is new: it represents a non-owner member
// whose access is currently disabled because the business no longer holds
// Business-tier entitlement (see src/plugins/tenant.ts's downgrade-sync
// logic) — the row and all historical data it's linked to are preserved,
// only authorization is affected. The owner's own membership is never
// SUSPENDED (see Business.ownerId's doc comment on the ownership
// invariant).
enum BusinessMemberStatus {
  ACTIVE
  SUSPENDED
}

// Lifecycle of one team invitation. EXPIRED is computed at read/accept time
// from `expiresAt` rather than written by a background job — see
// TeamInvitation's doc comment — but is still a real status value so an
// invite that's found to be expired at accept time can be durably recorded
// as such (a claim-guard update, not a cron).
enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum AuthChallengePurpose {
  APPLE_SIGN_IN
  APPLE_LINK
  APPLE_DELETE
}

enum DevicePlatform {
  ios
  android
  web
}

enum PushProvider {
  expo
}

enum LeadStatus {
  new
  contacted
  booked
  won
  lost
}

enum LeadUrgency {
  low
  medium
  high
}

// Tracking only, never a payment rail — set manually by the business when
// closing out a won lead. Lets Recovered Revenue distinguish a verified
// amount from a self-reported estimate, and lets a new Outstanding Revenue
// metric exist without Chakusa ever touching money movement.
enum LeadPaymentStatus {
  unpaid
  partially_paid
  paid
}

enum MessageType {
  missed_call
  booking_confirmation
  review_request
  private_feedback
  comeback_reminder
  custom
  // Automated follow-up for a lead submitted through a business's public
  // profile contact form (src/modules/public/publicBusinessProfile.service.ts)
  // — distinct from missed_call because the copy is wrong otherwise ("sorry
  // we missed your call" makes no sense for a customer who just proactively
  // reached out). See src/lib/leadSources.ts for the automation-eligibility
  // gate this template type is paired with.
  public_profile_inquiry
  // Automated nudge for a lead that has sat in a non-terminal status
  // (new/contacted/booked) too long — the Customer Lifecycle Automation
  // Engine's LEAD_FOLLOW_UP trigger (src/lib/automation/scheduler.ts).
  // Distinct from missed_call: by the time this fires, the lead has
  // usually already been contacted once, so "sorry we missed your call"
  // is no longer accurate — this is a "still interested?" check-in.
  lead_follow_up
}

enum MessageChannel {
  sms
  whatsapp
  call
  email
  other
}

enum MessageStatus {
  draft
  copied
  sent
  failed
}

enum ReviewRequestStatus {
  pending
  sent
  opened
  reviewed
  feedback_received
}

enum FeedbackSentiment {
  positive
  neutral
  negative
}

enum FeedbackStatus {
  new
  acknowledged
  resolved
}

enum ReminderStatus {
  due
  sent
  completed
  dismissed
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum MessageTone {
  friendly
  professional
  casual
}

// BUSINESS inherits every PRO feature plus TEAM_MANAGEMENT — see
// entitlements.ts's PLAN_FEATURES, which builds BUSINESS's feature set by
// spreading PRO's rather than duplicating it. Adding this value is
// additive at the database level (`ALTER TYPE ... ADD VALUE`, applied via
// a normal migration) and does not touch any existing FREE/PRO row.
enum Plan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  GRACE_PERIOD
  EXPIRED
  CANCELED
}

enum SubscriptionProvider {
  APPLE
  GOOGLE
}

// Which store environment produced a verified transaction/purchase — read
// directly from the provider's own signed payload (Apple's `data.environment`,
// Google's `purchases.subscriptionsv2.get` testPurchase field), never
// guessed. Exists so a sandbox/test transaction can never be mistaken for a
// real production entitlement (see billingConfig.ts / the Phase report's
// "sandbox/production separation" section).
enum SubscriptionEnvironment {
  SANDBOX
  PRODUCTION
}

enum ActivityEventType {
  LEAD_CREATED
  LEAD_CONTACTED
  LEAD_BOOKED
  LEAD_WON
  LEAD_LOST
  MESSAGE_COPIED
  MESSAGE_MARKED_SENT
  REVIEW_REQUEST_CREATED
  REVIEW_REQUEST_SENT
  REVIEW_OPENED
  REVIEW_RECEIVED
  FEEDBACK_RECEIVED
  FEEDBACK_STATUS_UPDATED
  REMINDER_CREATED
  REMINDER_SENT
  REMINDER_COMPLETED
  REMINDER_DISMISSED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  // Schema contract for the future automation engine (not yet implemented —
  // see src/lib/messaging/messagingProvider.ts and Phase 1 docs). Nothing
  // in the codebase emits these yet; recordActivity() is never called with
  // them until the automation engine exists.
  AUTOMATION_MESSAGE_SCHEDULED
  AUTOMATION_MESSAGE_SENT
  AUTOMATION_MESSAGE_FAILED
  // Business v1 team events — see teamInvitations.service.ts /
  // teamMembers.service.ts. Additive to this enum, same as the automation
  // values above.
  TEAM_MEMBER_INVITED
  TEAM_MEMBER_JOINED
  TEAM_MEMBER_ROLE_CHANGED
  TEAM_MEMBER_REMOVED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELED
  APPOINTMENT_NO_SHOW
}

// Whether a customer opted out of a specific channel or every channel a
// business might message them on. A dedicated ALL value (rather than a
// nullable `channel`) is deliberate: Postgres treats NULL as distinct from
// NULL in a unique index, so two "opted out of everything" rows for the
// same (business, phone) could otherwise both be inserted — an enum value
// keeps the uniqueness guarantee in CustomerOptOut.@@unique real.
enum OptOutChannel {
  SMS
  WHATSAPP
  ALL
}

// Every trigger justified by an existing domain event this codebase already
// models. Deliberately not "missed call" only — see Phase 3 report. Each
// value maps to one of Chakusa's three KPIs (Recovery, Reviews & Reputation,
// Retention); trigger-specific configuration (e.g. which LeadStatus to wait
// for, which delay) lives in AutomationRule.config, not in this enum, so a
// new *variant* of an existing trigger never requires a schema migration —
// only a genuinely new class of triggering event does.
enum AutomationTriggerType {
  LEAD_CREATED // Recovery — includes missed-call leads (Lead.source), not a separate trigger
  LEAD_FOLLOW_UP // Recovery — lead has sat in a non-terminal status too long
  REVIEW_REQUEST_FOLLOW_UP // Reviews & Reputation — a sent ReviewRequest hasn't converted
  CUSTOMER_RETENTION // Retention — mirrors the existing Reminder/reminderDays concept
}

// SMS is the only real channel Phase 2 can send today (Twilio). WHATSAPP is
// declared now so AutomationRule rows don't need a channel migration when
// WhatsApp ships — see Phase 1's OptOutChannel.WHATSAPP, which exists for
// the identical reason.
enum AutomationChannel {
  SMS
  WHATSAPP
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String
  normalizedEmail String    @unique @map("normalized_email")
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  fullName        String    @map("full_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  ownedBusinesses     Business[]           @relation("BusinessOwner")
  memberships         BusinessMember[]
  activityEvents      ActivityEvent[]      @relation("ActivityActor")
  authIdentities      AuthIdentity[]
  authSessions        AuthSession[]
  authChallenges      AuthChallenge[]
  passwordResets      PasswordResetToken[]
  deviceTokens        DeviceToken[]
  sentTeamInvitations TeamInvitation[]     @relation("TeamInvitationInviter")

  @@map("users")
}

model AuthIdentity {
  id                    String       @id @default(uuid())
  userId                String       @map("user_id")
  provider              AuthProvider
  providerSubject       String       @map("provider_subject")
  providerEmail         String?      @map("provider_email")
  providerEmailVerified Boolean      @default(false) @map("provider_email_verified")
  encryptedRefreshToken String?      @map("encrypted_refresh_token")
  credentialUpdatedAt   DateTime?    @map("credential_updated_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_identities")
}

model AuthChallenge {
  id        String               @id @default(uuid())
  userId    String?              @map("user_id")
  purpose   AuthChallengePurpose
  nonceHash String               @unique @map("nonce_hash")
  stateHash String               @unique @map("state_hash")
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model AuthSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  rotatedAt    DateTime? @map("rotated_at")
  replacedById String?   @unique @map("replaced_by_id")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthSession?  @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   AuthSession[] @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model DeviceToken {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  token         String
  platform      DevicePlatform
  provider      PushProvider   @default(expo)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  lastUsedAt    DateTime       @default(now()) @map("last_used_at")
  revokedAt     DateTime?      @map("revoked_at")
  revokedReason String?        @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A physical device token must never be active for more than one user at
  // once (e.g. re-installed app, token reassigned after a different user
  // signs in). This is additionally enforced at the database level by a
  // partial unique index on (token) WHERE is_active — see the
  // add_device_token_active_uniqueness migration; Prisma's schema DSL
  // cannot express a filtered unique index without the extendedIndexes
  // preview feature, so it is not declared here, but it exists in the
  // database and is the true source of the ownership guarantee.
  @@unique([userId, token])
  @@index([userId])
  @@index([userId, isActive])
  @@map("device_tokens")
}

model Business {
  id               String      @id @default(uuid())
  ownerId          String      @map("owner_id")
  name             String
  industry         String?
  phone            String?
  // Best-effort E.164 normalization of `phone`, computed opportunistically
  // at write time (see src/lib/phone.ts) — never required, never validated
  // against `phone` staying in sync, and never blocks a write when it can't
  // be derived. `phone` remains the raw, freeform value every existing
  // client already reads/writes; this is purely an additive derived field
  // for the future messaging/automation layer, which needs a dialable
  // address and has no use for a string it can't send to.
  phoneE164        String?     @map("phone_e164")
  // ISO 3166-1 alpha-2 (e.g. "ZW", "ZA"), IANA timezone (e.g.
  // "Africa/Harare"), ISO 4217 (e.g. "USD", "ZWL"). All nullable: existing
  // businesses predate these fields, and this phase adds no onboarding flow
  // to collect them — they're foundational for future
  // country/timezone-aware automation (provider routing, quiet hours), not
  // read by anything yet.
  country          String?
  timezone         String?
  currency         String?
  googleReviewLink String?     @map("google_review_link")
  // Shown on the public business profile page (see publicSlug below) as a
  // short "about this business" summary — distinct from `industry` (a
  // category) and `defaultServices` (a list), this is free-text the owner
  // writes in their own words. Never required; the public page renders
  // fine without it.
  description      String?
  workingHours     Json?       @map("working_hours")
  defaultServices  Json?       @map("default_services")
  reminderDays     Int         @default(42) @map("reminder_days")
  preferredTone    MessageTone @default(friendly) @map("preferred_tone")
  // Permanent, shareable slug for this business's public profile page
  // (chakusa.app/b/:publicSlug — see src/modules/public/publicBusinessProfile.service.ts).
  // Generated once at business-creation time (src/lib/publicSlug.ts) and
  // never regenerated afterward: an already-shared link (on a storefront,
  // a Google listing, a customer's phone) must keep resolving forever, so
  // nothing in this codebase ever updates this field after creation.
  publicSlug       String?     @unique @map("public_slug")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  owner            User              @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          BusinessMember[]
  customers        Customer[]
  leads            Lead[]
  messages         Message[]
  reviewRequests   ReviewRequest[]
  feedback         Feedback[]
  reminders        Reminder[]
  messageTemplates MessageTemplate[]
  activityEvents   ActivityEvent[]
  subscription     Subscription?
  customerOptOuts  CustomerOptOut[]
  automationRules  AutomationRule[]
  automationRuns   AutomationRun[]
  billingEvents    BillingEvent[]
  teamInvitations  TeamInvitation[]
  customerTags     CustomerTag[]
  appointments     Appointment[]

  @@index([ownerId])
  @@map("businesses")
}

model BusinessMember {
  id         String               @id @default(uuid())
  businessId String               @map("business_id")
  userId     String               @map("user_id")
  role       BusinessRole         @default(OWNER)
  // See BusinessMemberStatus's doc comment. Defaults ACTIVE — every
  // pre-existing row (all OWNER, from before Business v1) is unaffected by
  // this additive column.
  status     BusinessMemberStatus @default(ACTIVE)
  createdAt  DateTime             @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("business_members")
}

// One invitation for one email to join one business at one role. Mirrors
// the existing opaque-token pattern (src/lib/authTokens.ts, already used
// for refresh/reset/public-review tokens): `tokenId` is the lookup key,
// `tokenHash` is the only thing persisted of the secret itself — the raw
// token is returned to the inviting owner exactly once, at creation, and
// never stored or logged again (same guarantee as
// reviews.service.ts's generatePublicReviewLink).
//
// `status` starts PENDING and moves to ACCEPTED or REVOKED via explicit,
// claim-guarded transitions (see teamInvitations.service.ts) — the same
// atomic-updateMany-with-a-WHERE-guard concurrency pattern used throughout
// this codebase. EXPIRED is derived from `expiresAt` at read/accept time
// rather than written by a background job (no cron infrastructure exists
// for this), but is recorded durably the first time an expired PENDING
// invite is actually touched (accepted-against or explicitly checked), so
// a stale-forever PENDING row never misleads a later listing.
//
// Duplicate-pending-invite and existing-member prevention are enforced at
// the application layer inside a Serializable transaction (see
// entitlements.ts's withLimitCheck, reused for seat-limit + duplicate
// checks together) rather than a partial unique index, since Prisma's
// schema DSL cannot express "unique only where status = PENDING" and this
// codebase already has an established pattern for exactly this kind of
// concurrency-safe check.
model TeamInvitation {
  id              String               @id @default(uuid())
  businessId      String               @map("business_id")
  invitedEmail    String               @map("invited_email")
  // Never OWNER — enforced in teamInvitations.schemas.ts's Zod schema, not
  // just convention.
  role            BusinessRole         @map("role")
  tokenId         String               @unique @map("token_id")
  tokenHash       String               @map("token_hash")
  status          TeamInvitationStatus @default(PENDING)
  invitedByUserId String               @map("invited_by_user_id")
  expiresAt       DateTime             @map("expires_at")
  acceptedAt      DateTime?            @map("accepted_at")
  revokedAt       DateTime?            @map("revoked_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("TeamInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, invitedEmail, status])
  @@map("team_invitations")
}

model Customer {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  phone      String?
  // See Business.phoneE164 — same best-effort, non-blocking derivation,
  // normalized against the owning business's `country` as the default
  // region when the raw value isn't already in international (+…) form.
  phoneE164  String?  @map("phone_e164")
  email      String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads          Lead[]
  referredLeads  Lead[]           @relation("LeadReferredBy")
  messages       Message[]
  reviewRequests ReviewRequest[]
  feedback       Feedback[]
  reminders      Reminder[]
  optOuts        CustomerOptOut[]
  automationRuns AutomationRun[]
  tagAssignments CustomerTagAssignment[]
  appointments   Appointment[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@map("customers")
}

model Appointment {
  id               String            @id @default(uuid())
  businessId       String            @map("business_id")
  customerId       String?           @map("customer_id")
  assignedMemberId String?           @map("assigned_member_id")
  serviceName      String            @map("service_name")
  startsAt         DateTime          @map("starts_at")
  endsAt           DateTime          @map("ends_at")
  status           AppointmentStatus @default(SCHEDULED)
  price            Decimal?          @db.Decimal(10, 2)
  notes            String?
  reminderMinutes  Int?              @map("reminder_minutes")
  createdByUserId  String            @map("created_by_user_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedMember BusinessMember? @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)

  @@index([businessId, startsAt])
  @@index([businessId, status, startsAt])
  @@index([customerId, startsAt])
  @@index([assignedMemberId, startsAt])
  @@map("appointments")
}

// Owner-created labels for organising contacts. System audience labels are
// calculated at read time (lifecycle/payment/review/reminder state) and are
// intentionally not stored here, so they can never become stale.
model CustomerTag {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments CustomerTagAssignment[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("customer_tags")
}

model CustomerTagAssignment {
  customerId String @map("customer_id")
  tagId      String @map("tag_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
  @@map("customer_tag_assignments")
}

model Lead {
  id               String      @id @default(uuid())
  businessId       String      @map("business_id")
  customerId       String?     @map("customer_id")
  source           String?
  // Set only by an automated recovery-source connector (e.g. the Android
  // missed-call detector) that may retry ingestion after a network failure
  // or replay an offline-queued event — this is what makes that replay safe.
  // Manual/API-created leads always leave this null; Postgres unique indexes
  // permit unlimited NULLs, so they're never constrained by each other here.
  clientEventId    String?     @map("client_event_id")
  missedCallTime   DateTime?   @map("missed_call_time")
  serviceRequested String?     @map("service_requested")
  urgency          LeadUrgency @default(medium)
  status           LeadStatus  @default(new)
  estimatedValue   Decimal?    @map("estimated_value") @db.Decimal(10, 2)
  // Manually set by the business when closing out a won lead — never
  // written by anything else. Distinguishes a verified paid amount from
  // estimatedValue's self-reported guess, and lets Outstanding Revenue
  // exist as a real metric (sum of estimatedValue across won-but-unpaid
  // leads) without Chakusa processing any payment itself.
  paymentStatus    LeadPaymentStatus @default(unpaid) @map("payment_status")
  paidAmount       Decimal?    @map("paid_amount") @db.Decimal(10, 2)
  // Attribution only — the referral program tracks word-of-mouth, it never
  // moves money or grants a reward through Chakusa itself. Set when a lead
  // arrives through a customer's personal referral link (see
  // src/modules/public/publicBusinessProfile.service.ts); always validated
  // against the same business as the lead (see leads.service.ts's
  // assertCustomerInBusiness) so a link can never attribute a lead to a
  // customer of a different business.
  referredByCustomerId String?  @map("referred_by_customer_id")
  notes            String?
  generatedReply   String?     @map("generated_reply")
  contactedAt      DateTime?   @map("contacted_at")
  bookedAt         DateTime?   @map("booked_at")
  wonAt            DateTime?   @map("won_at")
  lostAt           DateTime?   @map("lost_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  referredBy     Customer?       @relation("LeadReferredBy", fields: [referredByCustomerId], references: [id], onDelete: SetNull)
  messages       Message[]
  automationRuns AutomationRun[]

  @@unique([businessId, clientEventId])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([customerId])
  @@index([referredByCustomerId])
  @@map("leads")
}

model Message {
  id                String         @id @default(uuid())
  businessId        String         @map("business_id")
  customerId        String?        @map("customer_id")
  leadId            String?        @map("lead_id")
  messageType       MessageType    @map("message_type")
  channel           MessageChannel @default(sms)
  body              String
  status            MessageStatus  @default(draft)
  sentAt            DateTime?      @map("sent_at")
  // Which MessagingProvider handled this send (e.g. "twilio") and that
  // provider's own message id — populated only for messages actually sent
  // through Chakusa (Phase 2 manual send); rows logged for the pre-existing
  // manual copy/paste flow have neither. Nullable, additive: existing rows
  // (there are none in production yet — Message was unused before Phase 2)
  // and any future non-provider message types are unaffected.
  provider          String?        @map("provider")
  providerMessageId String?        @map("provider_message_id")
  // Set only for messages created by the automation executor — the exact
  // AutomationRun this send belongs to. This is what makes
  // executeAutomationRun idempotent regardless of how many times it's
  // invoked for the same run (fresh claim vs. reclaimed after stale-run
  // recovery): before ever calling the provider, it checks whether a
  // Message already carries this run's id, and if so treats that as the
  // authoritative outcome instead of sending again. Nullable — manual
  // sends (Phase 2) never set it.
  automationRunId   String?        @map("automation_run_id")
  createdAt         DateTime       @default(now()) @map("created_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  automationRun AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)

  // Database-level guarantee that one AutomationRun can never have more
  // than one Message row — defense in depth alongside the application-level
  // idempotency check in executeAutomationRun (src/lib/automation/executor.ts)
  // that looks up an existing Message by automationRunId before sending.
  // Postgres unique indexes treat NULL as distinct from NULL, so any number
  // of manual-send Messages (automationRunId: null) remain unaffected.
  @@unique([automationRunId])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([customerId])
  @@index([leadId])
  @@index([providerMessageId])
  @@map("messages")
}

model ReviewRequest {
  id                 String              @id @default(uuid())
  businessId         String              @map("business_id")
  customerId         String?             @map("customer_id")
  serviceName        String?             @map("service_name")
  message            String?
  status             ReviewRequestStatus @default(pending)
  googleReviewLink   String?             @map("google_review_link")
  // Unused by any current code path — appears to have been a stub for the
  // exact feature this migration adds. Left untouched rather than
  // repurposed: it's typed as a full URL (frontend-domain-dependent, and no
  // production domain is configured yet — see the public-review-token
  // fields below, which store a lookup id + hash instead of a URL).
  privateFeedbackUrl String?             @map("private_feedback_url")
  sentAt             DateTime?           @map("sent_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  // Public review/feedback link — lets an unauthenticated customer open
  // GET /public/reviews/:token and submit POST .../feedback with no
  // Chakusa account. Mirrors src/lib/authTokens.ts's existing opaque-token
  // pattern (used for refresh/reset tokens): the raw token handed to the
  // customer is never stored — only publicTokenId (a random lookup key,
  // NOT this row's own id, so the public URL never encodes an internal
  // primary key) and publicTokenHash (SHA-256 of the full raw token,
  // verified with a timing-safe comparison) are persisted. One token per
  // review request — see reviews.service.ts's generatePublicReviewLink for
  // why lazy (re)generation, not a token minted eagerly at creation time,
  // is the right default.
  publicTokenId         String?   @unique @map("public_token_id")
  publicTokenHash       String?   @map("public_token_hash")
  publicTokenExpiresAt  DateTime? @map("public_token_expires_at")
  // Set the instant a feedback submission is accepted through the public
  // token — this is the idempotency claim guard (see
  // publicReviews.service.ts's submitPublicFeedback) that makes a second
  // submission attempt (retry, double-tap, or two concurrent requests) a
  // safe no-op instead of a duplicate Feedback row.
  publicTokenConsumedAt DateTime? @map("public_token_consumed_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  feedback Feedback[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@map("review_requests")
}

model Feedback {
  id              String             @id @default(uuid())
  businessId      String             @map("business_id")
  customerId      String?            @map("customer_id")
  reviewRequestId String?            @map("review_request_id")
  rating          Int
  comment         String?
  sentiment       FeedbackSentiment?
  status          FeedbackStatus     @default(new)
  createdAt       DateTime           @default(now()) @map("created_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reviewRequest ReviewRequest? @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@map("feedback")
}

model Reminder {
  id            String         @id @default(uuid())
  businessId    String         @map("business_id")
  customerId    String?        @map("customer_id")
  serviceName   String?        @map("service_name")
  lastVisitDate DateTime?      @map("last_visit_date")
  dueDate       DateTime       @map("due_date")
  message       String?
  status        ReminderStatus @default(due)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, dueDate])
  @@index([customerId])
  @@map("reminders")
}

model MessageTemplate {
  id           String      @id @default(uuid())
  businessId   String      @map("business_id")
  templateType MessageType @map("template_type")
  name         String
  body         String
  tone         MessageTone @default(friendly)
  isDefault    Boolean     @default(false) @map("is_default")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, templateType])
  @@map("message_templates")
}

model ActivityEvent {
  id         String            @id @default(uuid())
  businessId String            @map("business_id")
  actorId    String?           @map("actor_id")
  eventType  ActivityEventType @map("event_type")
  entityType String            @map("entity_type")
  entityId   String            @map("entity_id")
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_events")
}

// One Subscription per Business — the sole source of truth for plan
// entitlement (see src/lib/entitlements.ts). The provider/transaction/period
// fields are the future billing foundation only; nothing in this codebase
// writes them yet (no StoreKit/Play Billing verification exists), so they
// stay nullable and unused until that integration lands.
model Subscription {
  id                    String                   @id @default(uuid())
  businessId            String                   @unique @map("business_id")
  plan                  Plan                     @default(FREE)
  status                SubscriptionStatus       @default(ACTIVE)
  provider              SubscriptionProvider?
  providerProductId     String?                  @map("provider_product_id")
  // Apple's stable per-subscription identity (constant across renewals,
  // upgrades, and downgrades within the same subscription) — the
  // reconciliation key used to look up a business from an Apple App Store
  // Server Notification, which carries no Chakusa businessId. Unique (not
  // per-business-unique) because it is a store-wide identity: a Postgres
  // unique index on a nullable column allows any number of NULL rows (every
  // FREE/never-purchased business), so this is safe to add before any real
  // billing data exists. Set only once, at first successful verification
  // (see subscriptionReconciliation.ts) — never overwritten afterward.
  originalTransactionId String?                  @unique @map("original_transaction_id")
  latestTransactionId   String?                  @map("latest_transaction_id")
  // Google's reconciliation key, the RTDN equivalent of
  // originalTransactionId above — Play Real-time Developer Notifications
  // carry a purchaseToken + subscriptionId, never a Chakusa businessId.
  // Google can issue a *new* purchaseToken on some plan changes (unlike
  // Apple's stable originalTransactionId), so this is intentionally
  // overwritten on every successful re-verification, not set-once.
  googlePurchaseToken   String?                  @unique @map("google_purchase_token")
  environment           SubscriptionEnvironment? @map("environment")
  currentPeriodStart    DateTime?                @map("current_period_start")
  currentPeriodEnd      DateTime?                @map("current_period_end")
  cancelAtPeriodEnd     Boolean                  @default(false) @map("cancel_at_period_end")
  trialEndsAt           DateTime?                @map("trial_ends_at")
  // The provider's own effective timestamp (Apple's `signedDate`, Google's
  // purchase/notification time) for the snapshot currently applied to this
  // row — NOT `updatedAt`, which only reflects when Postgres last wrote the
  // row. This is the event-ordering guard: reconciliation compares an
  // incoming snapshot's effective time against this value and refuses to
  // apply an older one, so a delayed/out-of-order webhook can never
  // overwrite newer state that a later, faster-arriving call already
  // applied. See subscriptionReconciliation.ts.
  providerEventAt       DateTime?                @map("provider_event_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// Idempotency + audit ledger for every Apple/Google billing event this
// backend processes — both webhook deliveries (App Store Server
// Notifications V2, Play RTDN) and authenticated verify-endpoint calls.
// (provider, providerEventId) is the idempotency guard: a duplicate
// notification (provider retries are expected and normal) or a re-sent
// verify request produces a second row that fails the unique constraint,
// which callers treat as "already processed" rather than an error — see
// subscriptionReconciliation.ts.
//
// businessId is nullable with onDelete: SetNull (not Cascade), deliberately
// different from every other business-owned table in this schema: if the
// owning account is deleted, this row survives as a minimal, no-longer-
// business-linked audit trail (provider + eventType + transaction/purchase
// identity + when it was processed) rather than disappearing along with
// everything else — see the Phase report's "account deletion" section for
// why. It carries no customer PII and no raw provider payload.
model BillingEvent {
  id              String               @id @default(uuid())
  businessId      String?              @map("business_id")
  provider        SubscriptionProvider
  providerEventId String               @map("provider_event_id")
  eventType       String               @map("event_type")
  transactionId   String?              @map("transaction_id")
  purchaseToken   String?              @map("purchase_token")
  processedAt     DateTime?            @map("processed_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([businessId])
  @@map("billing_events")
}

// A customer refusing messages from one business must never opt them out
// of another business's messages — every row is scoped to a single
// businessId, deliberately with no global/cross-tenant opt-out concept.
// This is a foundation-only model for this phase: nothing produces these
// rows yet (no inbound STOP handling, no webhook, no UI) and nothing reads
// them yet (no automation engine to check them against). It exists now so
// the schema contract is settled before the engine that depends on it is
// built.
model CustomerOptOut {
  id         String        @id @default(uuid())
  businessId String        @map("business_id")
  customerId String?       @map("customer_id")
  // Raw phone as received (webhook "From", or manual entry) — not
  // necessarily E.164, since the source of an opt-out (e.g. a provider
  // webhook) may not always report the number in normalized form. Stored
  // as given; normalization happens on the read side when matching against
  // Customer.phoneE164 rather than being enforced here.
  phone      String
  channel    OptOutChannel
  // Freeform provenance ("customer_reply", "manual", "provider_webhook", …)
  // — not an enum yet because nothing produces these rows yet, so the real
  // set of sources isn't known until inbound processing exists.
  source     String
  createdAt  DateTime      @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([businessId, phone, channel])
  @@index([businessId])
  @@index([customerId])
  @@map("customer_opt_outs")
}

// A configured-but-inert automation policy. Creating or enabling a row here
// has no side effect — nothing in the codebase reads AutomationRule to
// decide whether to send anything (no listener, no worker, no cron; see the
// Phase 3 report). `config` intentionally carries all trigger-specific
// detail (e.g. which LeadStatus to wait for, minimum delay since last
// visit) instead of dedicated columns, so a new *variant* of an existing
// AutomationTriggerType never requires a migration — only a genuinely new
// trigger type does, which is deliberately rare (four values today).
model AutomationRule {
  id           String                @id @default(uuid())
  businessId   String                @map("business_id")
  name         String
  enabled      Boolean               @default(false)
  triggerType  AutomationTriggerType @map("trigger_type")
  channel      AutomationChannel     @default(SMS)
  // Seconds to wait after the trigger event before the (future) worker may
  // act. A plain Int rather than a Duration/Interval type — matches
  // Business.reminderDays' precedent of using a primitive for a
  // business-configurable time offset rather than modeling calendar
  // semantics that don't apply (this is a fixed delay, not "N business
  // days").
  delaySeconds Int                   @default(0) @map("delay_seconds")
  // Trigger-specific conditions/config (e.g. { "leadStatuses": ["new"],
  // "minDaysSinceVisit": 30 }). Validated at the Zod layer per triggerType,
  // not by the database — see automation.schemas.ts.
  config       Json                  @default("{}")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs     AutomationRun[]

  // At most one rule per (businessId, triggerType, channel). Nothing in this
  // codebase creates or expects more than one — scheduleMissedCallFollowUp
  // (src/lib/automation/scheduler.ts) resolves the LEAD_CREATED+SMS rule via
  // a bare `findFirst`, which silently picks an arbitrary row if duplicates
  // existed; a client-side "check then create" preflight (see the mobile
  // Automation screen) is not itself a guarantee under concurrent requests.
  // This constraint is what actually makes "one rule per trigger/channel"
  // true, and createAutomationRule (automation.service.ts) surfaces a
  // violation as 409 Conflict, the same P2002-to-409 pattern already used
  // for AutomationRun's dedupeKey and account registration's email.
  @@unique([businessId, triggerType, channel])
  @@index([businessId])
  @@index([businessId, enabled])
  @@index([businessId, triggerType])
  @@map("automation_rules")
}

// One prospective (or, once the future engine exists, actual) execution of
// an AutomationRule against one triggering event. Rows are created only by
// internal code/tests in this phase — there is no client-reachable
// "execute" endpoint (see automation.routes.ts) and nothing ever
// automatically inserts one (no listener wired to Lead/Customer/ReviewRequest
// creation yet).
//
// dedupeKey is this model's idempotency contract: a future worker deciding
// whether "this exact automation should only be scheduled once for this
// event" does a create() guarded by the unique constraint below rather than
// a racy find-then-create — see the Phase 3 report for why a unique
// constraint was chosen over an application-level lock.
model AutomationRun {
  id               String              @id @default(uuid())
  businessId       String              @map("business_id")
  automationRuleId String              @map("automation_rule_id")
  customerId       String?             @map("customer_id")
  leadId           String?             @map("lead_id")
  status           AutomationRunStatus @default(PENDING)
  // Deterministically derived by the future scheduler from
  // (automationRuleId, triggering entity, trigger occurrence) — e.g.
  // `${automationRuleId}:lead:${leadId}` for a one-shot lead trigger. Unique
  // per business so the same event can never produce two PENDING/RUNNING
  // runs for the same rule, which is exactly the duplicate-execution case
  // this phase must make structurally impossible to create, even though
  // nothing creates runs automatically yet.
  dedupeKey        String              @map("dedupe_key")
  scheduledFor     DateTime            @map("scheduled_for")
  startedAt        DateTime?           @map("started_at")
  completedAt      DateTime?           @map("completed_at")
  cancelledAt      DateTime?           @map("cancelled_at")
  errorMessage     String?             @map("error_message")
  // Number of send attempts made so far — incremented on each transient
  // provider failure that gets requeued (RUNNING -> PENDING with a
  // backed-off scheduledFor). Bounded by MAX_ATTEMPTS in
  // src/lib/automation/executor.ts; once reached, the run is marked FAILED
  // instead of being requeued again.
  attemptCount     Int                 @default(0) @map("attempt_count")
  // Execution lease: set to now + LEASE_DURATION_SECONDS (see executor.ts)
  // the instant a run is claimed (PENDING -> RUNNING), cleared back to null
  // whenever the run leaves RUNNING for any reason. A RUNNING row whose
  // lease has passed is presumed to belong to a crashed/killed worker — it
  // never got the chance to reach a terminal status — and is eligible for
  // stale-run recovery (RUNNING -> PENDING) so a live worker can reclaim
  // it. Never used to recover a run merely because it's old; only once
  // this specific deadline has passed.
  leaseExpiresAt   DateTime?           @map("lease_expires_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  automationRule AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@unique([businessId, dedupeKey])
  @@index([businessId])
  @@index([businessId, status])
  // The GET /automation/runs history endpoint (automation.service.ts's
  // listAutomationRunHistory) filters by businessId and orders by createdAt
  // DESC — this composite index covers that scan directly instead of a
  // businessId-only index plus a per-page sort, the same reasoning already
  // applied to the (status, scheduledFor) index below for the worker's claim
  // query. At "many runs per business" scale this is the query that would
  // otherwise degrade first, since it's the one a human waits on.
  @@index([businessId, createdAt])
  @@index([automationRuleId])
  @@index([customerId])
  @@index([leadId])
  @@index([status, leaseExpiresAt])
  // The worker's primary claim query (claimDueAutomationRuns in
  // executor.ts) filters on status = PENDING AND scheduledFor <= now,
  // ordered by scheduledFor — this composite index covers that scan
  // directly. Missing before this pass (P1 scale audit finding); without
  // it, that query falls back to the (status, leaseExpiresAt) index or a
  // sequential scan as PENDING rows accumulate across many businesses.
  @@index([status, scheduledFor])
  @@map("automation_runs")
}
