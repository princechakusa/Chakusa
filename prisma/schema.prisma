// BUSINESS inherits every PRO feature plus TEAM_MANAGEMENT — see
// entitlements.ts's PLAN_FEATURES, which builds BUSINESS's feature set by
// spreading PRO's rather than duplicating it. Adding this value is
// additive at the database level (`ALTER TYPE ... ADD VALUE`, applied via
// a normal migration) and does not touch any existing FREE/PRO row.
enum Plan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  GRACE_PERIOD
  EXPIRED
  CANCELED
}

