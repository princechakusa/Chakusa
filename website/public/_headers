# Public share links (/b, /r, /q, /i, /team-invite) are served by the app's web build as the
# 404 fallback. react-native-web writes inline styles, so these paths allow inline styles; only
# /b (business profile) shows the Leaflet map in a srcdoc iframe, which inherits this policy and
# needs inline script + unpkg. No COEP: business photos and map tiles are cross-origin.
/b/*
  ! Cross-Origin-Embedder-Policy
  ! Content-Security-Policy
  Content-Security-Policy: script-src 'self' 'unsafe-inline' https://unpkg.com https://static.cloudflareinsights.com; frame-src 'self'; default-src 'self'; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://auth.chakusarecovery.com https://chakusa-api.onrender.com https://*.ingest.de.sentry.io https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'; upgrade-insecure-requests

