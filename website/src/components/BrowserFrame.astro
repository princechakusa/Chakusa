---
// Distinct from PhoneMockup — signals "this is what your customer sees in
// their own browser," not the owner's app. Used for the public,
// unauthenticated review/feedback link.
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}
const { src, alt, width = 1400, height = 1000 } = Astro.props;
---
<div class="browser-frame">
  <div class="browser-frame-bar" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <img src={src} width={width} height={height} alt={alt} decoding="async" loading="lazy" />
</div>
