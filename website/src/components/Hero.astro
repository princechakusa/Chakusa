---
import JourneyChips from "./JourneyChips.astro";
import VideoSlot from "./VideoSlot.astro";
---
<main id="top">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Customer recovery, made simple</p>
      <h1 id="hero-title"><span>Recover customers.</span><span>Build your reputation.</span><span>Bring them back.</span></h1>
      <p class="hero-support" id="how-it-works">Follow up with missed opportunities, request reviews, and keep customers coming back from one simple app.</p>
      <div class="hero-actions" aria-label="Get started">
        <a class="button button-primary" href="/get-started">Start free</a>
        <a class="button button-secondary" href="#dashboard">See how it works <span aria-hidden="true">→</span></a>
      </div>
      <p class="trust-line">No contracts. No hidden fees. Cancel anytime.</p>
      <JourneyChips />
    </div>
    <div class="hero-visual" id="dashboard">
      <VideoSlot label="See Chakusa in action" />
    </div>
  </section>
</main>
