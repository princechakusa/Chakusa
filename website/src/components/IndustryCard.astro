---
// Index-page teaser only, links out to the category's own full page
// (src/pages/industries/[slug].astro) rather than piling workflow detail
// into this card.
interface Props {
  id: string;
  title: string;
  examples: string[];
  copy: string;
}
const { id, title, examples, copy } = Astro.props;
---
<a class="industry-card" href={`/industries/${id}`} aria-labelledby={`${id}-title`}>
  <h3 id={`${id}-title`}>{title}</h3>
  <p class="industry-card-examples">{examples.join(", ")}</p>
  <p class="industry-card-copy">{copy}</p>
  <span class="industry-card-link">See how it works for {title.toLowerCase()} <span aria-hidden="true">→</span></span>
</a>
