---
interface Props {
  id: string;
  title: string;
  examples: string[];
  copy: string;
  workflow?: string[];
}
const { id, title, examples, copy, workflow } = Astro.props;
---
<section class="industry-card" id={id} aria-labelledby={`${id}-title`}>
  <h3 id={`${id}-title`}>{title}</h3>
  <p class="industry-card-examples">{examples.join(" · ")}</p>
  <p class="industry-card-copy">{copy}</p>
  {workflow && workflow.length > 0 && (
    <ul class="industry-card-workflow">
      {workflow.map((item) => <li>{item}</li>)}
    </ul>
  )}
</section>
