---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  priority?: boolean;
}
const { src, alt, width = 1170, height = 2532, priority = false } = Astro.props;
---
<div class="phone-frame">
  <img
    src={src}
    width={width}
    height={height}
    alt={alt}
    decoding="async"
    fetchpriority={priority ? "high" : "auto"}
    loading={priority ? "eager" : "lazy"}
  />
</div>
