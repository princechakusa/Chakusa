---
// Same honesty rule as MessagePreview.astro — an illustrative example of
// the real Reminder data shape, clearly labeled, never presented as a
// captured screen.
---
<div class="reminder-preview">
  <p class="reminder-preview-label">Example reminder</p>
  <div class="reminder-preview-card">
    <div class="reminder-preview-row">
      <span class="reminder-preview-name">Amina Yusuf</span>
      <span class="reminder-preview-due">Due back</span>
    </div>
    <p class="reminder-preview-meta">Last visit: 43 days ago · Usual interval: 42 days</p>
  </div>
</div>
