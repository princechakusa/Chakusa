---
interface NavChild { href: string; label: string; description: string }
interface NavLink { href: string; label: string; id: string; children?: NavChild[] }
interface Props { current?: string }
const { current } = Astro.props;

const links: NavLink[] = [
  {
    href: "/product", label: "Product", id: "product",
    children: [
      { href: "/product#customer-response", label: "Respond", description: "Turn an enquiry into a customer relationship." },
      { href: "/product#reviews", label: "Review", description: "Ask for a review while the visit is still fresh." },
      { href: "/product#business-control", label: "Grow", description: "Know what needs attention next." },
    ],
  },
  { href: "/pricing", label: "Pricing", id: "pricing" },
  {
    href: "/industries", label: "Industries", id: "industries",
    children: [
      { href: "/industries/beauty", label: "Beauty", description: "Salons, barbers, spas, and beauty clinics." },
      { href: "/industries/home-services", label: "Home services", description: "Plumbers, electricians, cleaners, contractors." },
      { href: "/industries/automotive", label: "Automotive", description: "Mechanics, car washes, detailing." },
      { href: "/industries/professional", label: "Professional", description: "Dentists, photographers, consultants." },
    ],
  },
  { href: "/about", label: "About", id: "about" },
];
---
<header class="site-header">
  <nav class="site-nav content-shell" aria-label="Primary navigation">
    <a class="wordmark" href="/" aria-label="Chakusa home"><span class="wordmark-mark" aria-hidden="true">C</span><span>CHAKUSA</span></a>
    <div class="desktop-nav-links">
      {links.map((link) => (
        link.children ? (
          <div class="nav-item">
            <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>
            <button
              type="button"
              class="nav-trigger"
              aria-expanded="false"
              aria-controls={`dropdown-${link.id}`}
              aria-label={`${link.label} menu`}
              data-nav-trigger={link.id}
            >
              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3 5 6.5 8.5 3" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <div class="nav-dropdown" id={`dropdown-${link.id}`} data-nav-dropdown={link.id} hidden>
              {link.children.map((child) => (
                <a href={child.href}>
                  <span class="nav-dropdown-label">{child.label}</span>
                  <span class="nav-dropdown-description">{child.description}</span>
                </a>
              ))}
              <a class="nav-dropdown-viewall" href={link.href}>See all of {link.label.toLowerCase()} <span aria-hidden="true">→</span></a>
            </div>
          </div>
        ) : (
          <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>
        )
      ))}
    </div>
    <div class="nav-actions">
      <a class="nav-signin" href="/login">Sign in</a>
      <a class="nav-cta" href="/get-started">Start free trial</a>
      <button
        type="button"
        class="mobile-nav-toggle"
        id="mobile-nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="content-shell mobile-nav-inner">
      {links.map((link) => (
        <>
          <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>
          {link.children && link.children.map((child) => (
            <a href={child.href} class="mobile-nav-sub">{child.label}</a>
          ))}
        </>
      ))}
      <a href="/login" class="mobile-nav-signin">Sign in</a>
    </div>
  </div>
</header>

<script>
  // Dropdown triggers use click or tap. CSS hover never fires here.
  // on touch devices, which made the menu unusable on mobile/tablet.
  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-nav-trigger]");

  function closeAll(except?: string) {
    triggers.forEach((t) => {
      if (t.dataset.navTrigger === except) return;
      t.setAttribute("aria-expanded", "false");
      const id = t.getAttribute("aria-controls");
      const panel = id ? document.getElementById(id) : null;
      if (panel) panel.hidden = true;
    });
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.getAttribute("aria-controls");
      const panel = id ? document.getElementById(id) : null;
      if (!panel) return;
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      closeAll(trigger.dataset.navTrigger);
      trigger.setAttribute("aria-expanded", String(!isOpen));
      panel.hidden = isOpen;
    });
  });

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Node)) return;
    if (!Array.from(triggers).some((t) => t.contains(e.target as Node) || document.getElementById(t.getAttribute("aria-controls") ?? "")?.contains(e.target as Node))) {
      closeAll();
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });

  const toggle = document.getElementById("mobile-nav-toggle");
  const panel = document.getElementById("mobile-nav");
  if (toggle && panel) {
    const close = () => {
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
    };
    const open = () => {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close menu");
    };
    toggle.addEventListener("click", () => (panel.hidden ? open() : close()));
    panel.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) close();
    });
  }
</script>
