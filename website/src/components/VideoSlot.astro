---
interface Props {
  label?: string;
}
const { label = "Product video" } = Astro.props;
---
<div class="video-slot" role="img" aria-label={`${label}, shown with the Chakusa business dashboard`}>
  <img src="/images/how-it-works/chakusa-dashboard-desktop.png" width="1536" height="1024" alt="" fetchpriority="high" />
  <div class="video-slot-caption"><p class="video-slot-label">{label}</p><span>Enquiries, bookings, customers, and follow-up in one workspace</span></div>
</div>
