---
type Scene = "mission" | "customer" | "business";
interface Props { scene: Scene; }
const { scene } = Astro.props;
---
<div class={`about-scene about-scene--${scene}`} aria-hidden="true">
  <div class="about-scene__grid"></div>
  {scene === "mission" && (
    <>
      <div class="about-scene__person"><span class="head"></span><span class="body"></span><span class="arm"></span></div>
      <div class="about-scene__phone"><span></span><i></i><b></b></div>
      <div class="about-scene__flow">
        <div class="flow-card flow-card--enquiry"><small>NEW ENQUIRY</small><strong>Haircut tomorrow</strong><span>Customer request captured</span></div>
        <div class="flow-line flow-line--one"><i></i></div>
        <div class="flow-card flow-card--booking"><small>BOOKING</small><strong>10:30 AM confirmed</strong><span>Calendar updated</span></div>
        <div class="flow-line flow-line--two"><i></i></div>
        <div class="flow-card flow-card--return"><small>AFTER SERVICE</small><strong>Review + return</strong><span>Relationship continues</span></div>
      </div>
      <div class="about-scene__status"><i></i><span><strong>One connected journey</strong><small>Discovery to repeat business</small></span></div>
    </>
  )}
  {scene === "customer" && (
    <>
      <div class="about-scene__customer"><span class="head"></span><span class="hair"></span><span class="body"></span></div>
      <div class="about-scene__app">
        <div class="app-top"><i></i><strong>Local services</strong><span>⌖ Nearby</span></div>
        <div class="app-business"><b>Barber Studio</b><small>Haircut · Beard trim</small><span>Available today</span></div>
        <div class="app-slots"><i>10:30</i><i>12:00</i><i>14:30</i></div>
        <div class="app-action">Confirm 10:30</div>
      </div>
      <div class="about-scene__confirm"><i>✓</i><span><strong>Booking confirmed</strong><small>10:30 AM · Added to schedule</small></span></div>
    </>
  )}
  {scene === "business" && (
    <>
      <div class="about-scene__trade"><span class="head"></span><span class="cap"></span><span class="body"></span><span class="tool"></span></div>
      <div class="about-scene__dashboard">
        <div class="dash-head"><strong>Today</strong><span>Business workspace</span></div>
        <div class="dash-row"><i class="coral"></i><span><b>3 new enquiries</b><small>Needs attention</small></span><em>Open</em></div>
        <div class="dash-row"><i class="teal"></i><span><b>10:30 booking</b><small>Calendar confirmed</small></span><em>Ready</em></div>
        <div class="dash-row"><i class="gold"></i><span><b>2 customers</b><small>Due for a return reminder</small></span><em>Review</em></div>
      </div>
      <div class="about-scene__ai"><small>AI DRAFT</small><strong>Reply prepared</strong><span>Waiting for your approval</span><button type="button" tabindex="-1">Review draft</button></div>
    </>
  )}
</div>

<style>
.about-scene{position:relative;min-height:32rem;overflow:hidden;border:1px solid #dbe3ef;border-radius:1.6rem;background:linear-gradient(145deg,#fff 0%,#f6f8ff 55%,#fff4f0 100%);box-shadow:0 28px 70px rgba(25,35,55,.14);isolation:isolate}.about-scene__grid{position:absolute;inset:0;background-image:linear-gradient(rgba(40,48,68,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(40,48,68,.055) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,#000 50%,transparent 92%)}.about-scene::before{content:"";position:absolute;width:19rem;height:19rem;border-radius:50%;background:#ffd9d2;right:-4rem;top:-5rem;opacity:.65;animation:about-breathe 5s ease-in-out infinite}.about-scene::after{content:"";position:absolute;width:15rem;height:15rem;border-radius:50%;background:#ccf4ed;left:-5rem;bottom:-5rem;opacity:.65;animation:about-breathe 5.5s ease-in-out infinite reverse}.about-scene__person,.about-scene__customer,.about-scene__trade{position:absolute;z-index:2;left:7%;bottom:0;width:10rem;height:22rem}.head{position:absolute;width:5.2rem;height:5.8rem;border-radius:48% 48% 44% 44%;background:#8d5b45;left:2.5rem;top:1.5rem;box-shadow:inset -8px -4px rgba(0,0,0,.08)}.body{position:absolute;width:10rem;height:15rem;border-radius:5rem 5rem 1.5rem 1.5rem;background:#ef5d43;left:0;top:7rem}.arm{position:absolute;width:2.2rem;height:9rem;border-radius:2rem;background:#8d5b45;right:-1.5rem;top:9rem;rotate:-24deg}.about-scene__phone{position:absolute;z-index:5;left:20%;bottom:7.2rem;width:3.2rem;height:6rem;border:.35rem solid #172033;border-radius:.75rem;background:#fff;rotate:-8deg;box-shadow:0 10px 24px #17203333;animation:about-phone 4s ease-in-out infinite}.about-scene__phone span{display:block;height:1.1rem;background:#0d9488}.about-scene__phone i,.about-scene__phone b{display:block;height:.35rem;margin:.65rem .45rem;border-radius:1rem;background:#dbe3ef}.about-scene__phone b{width:55%;background:#ee5d43}.about-scene__flow{position:absolute;z-index:4;inset:2.4rem 1.5rem auto 36%;height:23rem}.flow-card{position:absolute;width:min(15rem,55%);padding:1rem 1.05rem;border:1px solid #dce4ef;border-radius:1rem;background:rgba(255,255,255,.94);box-shadow:0 15px 32px #2830441c;backdrop-filter:blur(10px);animation:about-card 4.8s ease-in-out infinite}.flow-card small,.about-scene__ai small{display:block;color:#0d9488;font-size:.58rem;font-weight:900;letter-spacing:.1em}.flow-card strong{display:block;margin:.28rem 0;font-size:.78rem}.flow-card span{display:block;color:#687184;font-size:.62rem}.flow-card--enquiry{top:0;left:0}.flow-card--booking{top:8.1rem;right:0;animation-delay:-1.5s}.flow-card--return{top:16.2rem;left:0;animation-delay:-3s}.flow-line{position:absolute;width:6rem;height:3.8rem;border-right:2px dashed #0d9488;border-bottom:2px dashed #0d9488;opacity:.6}.flow-line--one{top:4.9rem;left:28%}.flow-line--two{top:13rem;right:25%;transform:scaleX(-1)}.flow-line i{position:absolute;width:.5rem;height:.5rem;border-radius:50%;background:#ee5d43;animation:about-dot 2.4s linear infinite}.about-scene__status,.about-scene__confirm{position:absolute;z-index:7;display:flex;align-items:center;gap:.7rem;padding:.85rem 1rem;border:1px solid #a5d6d1;border-radius:1rem;background:#fffffff2;box-shadow:0 15px 30px #28304424;backdrop-filter:blur(12px)}.about-scene__status{right:1.5rem;bottom:1.4rem}.about-scene__status i{width:.65rem;height:.65rem;border-radius:50%;background:#0d9488;box-shadow:0 0 0 .35rem #ccf4ed}.about-scene__status span,.about-scene__confirm span{display:grid}.about-scene__status strong,.about-scene__confirm strong{font-size:.7rem}.about-scene__status small,.about-scene__confirm small{color:#687184;font-size:.58rem}.about-scene__customer{left:4%;width:11rem}.about-scene__customer .hair{position:absolute;z-index:2;width:6.2rem;height:3rem;border-radius:4rem 4rem 1rem 1rem;background:#172033;left:2rem;top:.5rem}.about-scene__customer .body{background:#0d9488}.about-scene__app{position:absolute;z-index:4;right:5%;top:3rem;width:61%;padding:1rem;border:1px solid #dce4ef;border-radius:1.2rem;background:#fff;box-shadow:0 18px 40px #28304420;animation:about-card 5s ease-in-out infinite}.app-top{display:flex;align-items:center;gap:.5rem;padding-bottom:.8rem;border-bottom:1px solid #edf0f5;font-size:.65rem}.app-top i{width:.65rem;height:.65rem;border-radius:50%;background:#ee5d43}.app-top span{margin-left:auto;color:#0d9488}.app-business{display:grid;gap:.2rem;margin:1rem 0;padding:1rem;border-radius:.8rem;background:#f7f8fc}.app-business b{font-size:.82rem}.app-business small{color:#687184}.app-business span{margin-top:.35rem;color:#0d9488;font-size:.62rem;font-weight:800}.app-slots{display:flex;gap:.4rem}.app-slots i{padding:.5rem .55rem;border:1px solid #dce4ef;border-radius:.55rem;font-size:.62rem;font-style:normal}.app-slots i:first-child{border-color:#0d9488;background:#e2f7f3;color:#006a61}.app-action{margin-top:.8rem;padding:.65rem;border-radius:.6rem;background:#ee5d43;color:#fff;text-align:center;font-size:.68rem;font-weight:800}.about-scene__confirm{right:2%;bottom:2rem;animation:about-pop 4s ease-in-out infinite}.about-scene__confirm>i{display:grid;width:2rem;height:2rem;place-items:center;border-radius:50%;background:#0d9488;color:#fff;font-style:normal;font-weight:900}.about-scene__trade{left:5%}.about-scene__trade .head{background:#7b4a36}.about-scene__trade .cap{position:absolute;z-index:3;width:6rem;height:2.2rem;border-radius:4rem 4rem .4rem .4rem;background:#172033;left:2rem;top:.5rem}.about-scene__trade .body{background:#283044}.about-scene__trade .tool{position:absolute;width:1.2rem;height:9rem;border-radius:1rem;background:#94a3b8;right:-.8rem;top:10rem;rotate:28deg}.about-scene__dashboard{position:absolute;z-index:4;right:4%;top:2.5rem;width:62%;padding:1rem;border:1px solid #dce4ef;border-radius:1.2rem;background:#fff;box-shadow:0 18px 40px #28304420;animation:about-card 5.2s ease-in-out infinite}.dash-head{display:flex;align-items:end;justify-content:space-between;padding-bottom:.7rem;border-bottom:1px solid #edf0f5}.dash-head strong{font-size:.9rem}.dash-head span{color:#687184;font-size:.58rem}.dash-row{display:flex;align-items:center;gap:.65rem;padding:.75rem 0;border-bottom:1px solid #edf0f5}.dash-row>i{width:.55rem;height:.55rem;border-radius:50%}.dash-row .coral{background:#ee5d43}.dash-row .teal{background:#0d9488}.dash-row .gold{background:#d79b26}.dash-row span{display:grid;flex:1}.dash-row b{font-size:.67rem}.dash-row small{color:#687184;font-size:.55rem}.dash-row em{padding:.25rem .4rem;border-radius:.4rem;background:#f2f3ff;color:#334155;font-size:.5rem;font-style:normal;font-weight:800}.about-scene__ai{position:absolute;z-index:7;right:3%;bottom:1.5rem;width:13rem;padding:.85rem 1rem;border:1px solid #f2b8aa;border-radius:1rem;background:#fff8f5;box-shadow:0 15px 30px #28304424;animation:about-pop 4.4s ease-in-out infinite}.about-scene__ai strong,.about-scene__ai span{display:block}.about-scene__ai strong{margin:.25rem 0;font-size:.72rem}.about-scene__ai span{color:#687184;font-size:.58rem}.about-scene__ai button{margin-top:.6rem;padding:.45rem .6rem;border:0;border-radius:.5rem;background:#172033;color:#fff;font-size:.55rem;font-weight:800}@keyframes about-card{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}@keyframes about-breathe{0%,100%{transform:scale(1);opacity:.55}50%{transform:scale(1.08);opacity:.8}}@keyframes about-phone{0%,100%{transform:translateY(0) rotate(-8deg)}50%{transform:translateY(-7px) rotate(-5deg)}}@keyframes about-dot{0%{left:0;top:0}50%{left:calc(100% - .5rem);top:0}100%{left:calc(100% - .5rem);top:calc(100% - .5rem)}}@keyframes about-pop{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-5px) scale(1.015)}}@media(max-width:700px){.about-scene{min-height:28rem}.about-scene__person,.about-scene__customer,.about-scene__trade{left:-1rem;transform:scale(.82);transform-origin:bottom left}.about-scene__flow{inset:1.5rem .8rem auto 30%;height:21rem}.flow-card{width:65%;padding:.75rem}.flow-card--booking{top:7rem}.flow-card--return{top:14rem}.about-scene__app,.about-scene__dashboard{right:3%;width:70%}.about-scene__status{right:.6rem;bottom:.6rem}.about-scene__confirm{right:.5rem;bottom:1rem}.about-scene__ai{right:.5rem;bottom:.7rem;width:11.5rem}}@media(prefers-reduced-motion:reduce){.about-scene *,.about-scene::before,.about-scene::after{animation:none!important}}
</style>