---
import Button from "../foundation/Button.astro";
import StoryIcon from "../homepage/StoryIcon.astro";
---
<section class="business-cta" aria-labelledby="business-cta-title">
  <div class="business-shell business-cta__inner">
    <p>Start with one connected workspace</p>
    <h2 id="business-cta-title">Give every customer moment a clear next step.</h2>
    <div>Start with a 14-day free trial. Starter is $9.99 per month after the trial, and you can choose a different plan as your team grows.</div>
    <div class="business-actions">
      <Button href="/get-started">Start free trial <StoryIcon name="arrow_forward" /></Button>
      <Button href="/pricing" variant="secondary">Compare plans</Button>
    </div>
    <ul><li>No credit card required</li><li>Human-reviewed automation</li><li>Built for service businesses</li></ul>
  </div>
</section>
