---
import Button from "../foundation/Button.astro";
import StoryIcon from "../homepage/StoryIcon.astro";
import { businessModules } from "../../data/business";
---
<section class="business-hero" aria-labelledby="business-title">
  <div class="business-shell business-hero__grid">
    <div class="business-hero__copy">
      <p class="business-pill">Built for service businesses</p>
      <h1 id="business-title">Your whole customer journey, in one working view.</h1>
      <p class="business-hero__lede">Chakusa connects enquiries, bookings, customer records, reviews, and repeat business so your team always knows what needs attention next.</p>
      <div class="business-actions">
        <Button href="/get-started">Start 14-day free trial <StoryIcon name="arrow_forward" /></Button>
        <Button href="/how-it-works" variant="secondary">See how it works</Button>
      </div>
      <ul class="business-assurances" aria-label="Trial details">
        <li>Simple setup</li>
        <li>No credit card required</li>
        <li>Cancel anytime</li>
      </ul>
    </div>
    <aside class="business-hero__summary" aria-label="Connected business workflow">
      <span>One connected workspace</span>
      <strong>Enquiry to repeat visit</strong>
      <p>The same customer context follows every step.</p>
      <ol>
        <li><b>1</b> Capture</li>
        <li><b>2</b> Book</li>
        <li><b>3</b> Serve</li>
        <li><b>4</b> Bring back</li>
      </ol>
    </aside>
  </div>
  <nav class="business-modules business-shell" aria-label="Business platform sections">
    {businessModules.map((item, index) => <a class:list={[index === 0 && "is-active"]} href={item.href}><StoryIcon name={item.icon} /><span>{item.label}</span></a>)}
  </nav>
</section>
