---
import StoryIcon from "../homepage/StoryIcon.astro";
import { businessCapabilities } from "../../data/business";
---
<section class="business-workspace business-shell" id="workspace" aria-labelledby="workspace-title">
  <header class="business-heading business-heading--split">
    <div><p>Business control center</p><h2 id="workspace-title">See the day clearly. Act from one place.</h2></div>
    <span>Real Chakusa dashboard</span>
  </header>
  <figure class="business-dashboard">
    <img src="/images/how-it-works/chakusa-dashboard-desktop.png" width="1536" height="1024" alt="Chakusa business dashboard showing the calendar, leads, reviews, customer activity, and business attention items" loading="eager" fetchpriority="high" />
    <figcaption>One workspace for the business profile, enquiries, bookings, customers, reviews, and follow-up.</figcaption>
  </figure>
  <div class="business-capabilities">
    {businessCapabilities.map((item) => <article>
      <span class="business-icon"><StoryIcon name={item.icon} /></span>
      <p>{item.eyebrow}</p>
      <h3>{item.title}</h3>
      <div>{item.body}</div>
      <a href={item.href}>Explore {item.eyebrow.toLowerCase()} <StoryIcon name="arrow_forward" /></a>
    </article>)}
  </div>
</section>
