---
interface Field { name: string; label: string; type?: "text" | "email" | "number" | "datetime-local" | "textarea"; required?: boolean; placeholder?: string; options?: string[] }
interface Props { realm: "business" | "client"; eyebrow: string; title: string; intro: string; endpoint: string; kind: string; createLabel?: string; fields?: Field[]; manageCapability?: string }
const { realm, eyebrow, title, intro, endpoint, kind, createLabel, fields = [], manageCapability } = Astro.props;
---
<section class="dashboard-loading" data-module-loading><span></span><p>Opening this secure workspace...</p></section>
<section class="dashboard-auth-required" data-module-auth hidden><h1>Sign in required</h1><p>Your secure session is missing or has expired.</p><a href="/login">Return to sign in</a></section>
<div class="dashboard-content dashboard-module" data-module hidden data-endpoint={endpoint} data-kind={kind} data-realm={realm} data-manage-capability={manageCapability}>
  <header class="dashboard-welcome"><div><p class="dashboard-eyebrow">{eyebrow}</p><h1>{title}</h1><p>{intro}</p></div>{createLabel && <button class="dashboard-action dashboard-action--button" type="button" data-create-toggle>{createLabel}</button>}</header>
  {createLabel && <section class="dashboard-panel dashboard-create" data-create-panel hidden><div class="dashboard-section-heading"><div><h2>{createLabel}</h2><p>Saved directly to your protected Chakusa workspace.</p></div><button type="button" data-create-close aria-label="Close form">Close</button></div><form class="dashboard-form" data-create-form>{fields.map(field => <label>{field.label}{field.options ? <select name={field.name} required={field.required}>{field.options.map(value => <option value={value}>{value}</option>)}</select> : field.type === "textarea" ? <textarea name={field.name} required={field.required} placeholder={field.placeholder}></textarea> : <input name={field.name} type={field.type || "text"} required={field.required} placeholder={field.placeholder}/>}</label>)}<div class="dashboard-form__actions"><button type="button" data-create-close>Cancel</button><button type="submit">Save</button></div><p class="setup-message" data-create-message role="status"></p></form></section>}
  <section class="dashboard-panel"><div class="dashboard-section-heading"><div><h2>All {title.toLowerCase()}</h2><p data-module-count>Loading records...</p></div><button type="button" data-refresh>Refresh</button></div><div class="dashboard-records" data-records></div></section>
</div>
<script>
  import { can } from "../../scripts/capabilities.js";
  const gateway="https://auth.chakusarecovery.com";
  const moduleRoot=document.querySelector<HTMLElement>("[data-module]");
  const loading=document.querySelector<HTMLElement>("[data-module-loading]");
  const auth=document.querySelector<HTMLElement>("[data-module-auth]");
  const records=document.querySelector<HTMLElement>("[data-records]");
  const count=document.querySelector<HTMLElement>("[data-module-count]");
  const clean=(value:unknown)=>String(value??"").replaceAll("_"," ").toLowerCase().replace(/\b\w/g,letter=>letter.toUpperCase());
  const date=(value:unknown)=>{if(!value)return "";const parsed=new Date(String(value));return Number.isNaN(parsed.valueOf())?"":parsed.toLocaleString();};
  const itemsFrom=(payload:any):any[]=>Array.isArray(payload)?payload:Array.isArray(payload?.items)?payload.items:Array.isArray(payload?.data)?payload.data:[];
  const details=(item:any,kind:string)=>{
    if(kind==="customers")return [item.name||"Unnamed customer",item.phone||item.email||"No contact details",item.createdAt?`Added ${date(item.createdAt)}`:""];
    if(kind==="leads")return [item.serviceRequested||item.customer?.name||"New opportunity",`${clean(item.status||"new")} | ${clean(item.urgency||"medium")} priority`,item.estimatedValue!=null?`Estimated value ${item.estimatedValue}`:item.notes||""];
    if(kind==="bookings")return [item.serviceName||"Service booking",item.customer?.name||item.business?.name||"Customer",`${date(item.startsAt)} | ${clean(item.status||"scheduled")}`];
    if(kind==="reviews")return [item.customer?.name||item.serviceName||"Review request",clean(item.status||"pending"),item.createdAt?date(item.createdAt):""];
    if(kind==="quotes")return [`${clean(item.documentType||"Quote")} ${item.documentNumber||""}`.trim(),item.customer?.name||clean(item.status||"draft"),item.total!=null?String(item.total):item.createdAt?date(item.createdAt):""];
    if(kind==="invoices")return [`Invoice ${item.invoiceNumber||item.documentNumber||""}`.trim(),item.business?.name||item.customer?.name||clean(item.status||"draft"),item.total!=null?String(item.total):item.dueAt?`Due ${date(item.dueAt)}`:date(item.createdAt)];
    if(kind==="businesses"){const business=item.business||item;return [business?.name||"Business",business?.industry||"Service provider",item.favourite?"Saved business":"Connected business"];}
    if(kind==="notifications")return [item.title||clean(item.type||"Update"),item.message||item.body||"Account update",date(item.createdAt)];
    if(kind==="messages")return [item.customer?.name||item.title||item.contactName||"Conversation",clean(item.status||"open"),item.lastMessageAt?date(item.lastMessageAt):item.updatedAt?date(item.updatedAt):""];
    if(kind==="reminders")return [item.customer?.name||item.serviceName||"Comeback reminder",clean(item.status||"due"),item.dueDate?date(item.dueDate):item.createdAt?date(item.createdAt):""];
    if(kind==="automation")return [item.name||"Workflow",clean(item.status||"draft"),item.description||""];
    if(kind==="inventory")return [item.name||"Stock item",`${item.currentStock??"0"} ${item.unit||"on hand"}${item.lowStock?" | low stock":""}`,item.lowStockThreshold!=null?`Reorder at ${item.lowStockThreshold}`:(item.sku?`SKU ${item.sku}`:"")];
    if(kind==="reports")return [item.title||item.periodLabel||"Weekly report",item.status||"Business summary",item.createdAt?date(item.createdAt):""];
    return [item.name||item.title||item.email||"Workspace record",item.role||item.status||"Active",item.createdAt?date(item.createdAt):""];
  };
  // #22 — per-row state transitions. Each still passes through the gateway
  // allowlist + backend capability/validation; the `cap` here only decides
  // whether to render the button.
  type RowAction={label:string;path:(id:string)=>string;body?:Record<string,unknown>;cap:string};
  const ROW_ACTIONS:Record<string,RowAction[]>={
    leads:[
      {label:"Contacted",path:id=>`/v1/business/leads/${id}/mark-contacted`,cap:"leads.manage"},
      {label:"Booked",path:id=>`/v1/business/leads/${id}/mark-booked`,cap:"leads.manage"},
      {label:"Won",path:id=>`/v1/business/leads/${id}/mark-won`,cap:"leads.manage"},
      {label:"Lost",path:id=>`/v1/business/leads/${id}/mark-lost`,cap:"leads.manage"},
    ],
    bookings:[
      {label:"Confirm",path:id=>`/v1/business/appointments/${id}/status`,body:{status:"CONFIRMED"},cap:"appointments.manage"},
      {label:"Complete",path:id=>`/v1/business/appointments/${id}/status`,body:{status:"COMPLETED"},cap:"appointments.manage"},
      {label:"No-show",path:id=>`/v1/business/appointments/${id}/status`,body:{status:"NO_SHOW"},cap:"appointments.manage"},
      {label:"Cancel",path:id=>`/v1/business/appointments/${id}/status`,body:{status:"CANCELED"},cap:"appointments.manage"},
    ],
  };
  let currentRole:string|null=null;
  const runAction=async(action:RowAction,id:string,button:HTMLButtonElement)=>{
    button.disabled=true;const original=button.textContent;button.textContent="Saving…";
    try{
      const response=await fetch(`${gateway}${action.path(id)}`,{method:"POST",credentials:"include",headers:{"content-type":"application/json"},body:JSON.stringify(action.body??{})});
      if(!response.ok){const payload=await response.json().catch(()=>({}));throw new Error(typeof payload.error==="string"?payload.error:"That action could not be completed.");}
      await load();
    }catch(error){button.disabled=false;button.textContent=original;button.title=error instanceof Error?error.message:"Failed";}
  };
  const render=(payload:any)=>{if(!records||!moduleRoot)return;records.replaceChildren();const kind=moduleRoot.dataset.kind||"records";const items=itemsFrom(payload);if(count)count.textContent=`${items.length} record${items.length===1?"":"s"}`;if(!items.length){const empty=document.createElement("div");empty.className="dashboard-empty";empty.textContent=`No ${kind} yet. New activity will appear here.`;records.append(empty);return;}const actions=ROW_ACTIONS[kind]?.filter(a=>can(currentRole,a.cap))??[];for(const item of items){const values=details(item,kind);const article=document.createElement("article");article.className="dashboard-record";const mark=document.createElement("span");mark.className="dashboard-record__mark";mark.textContent=values[0].slice(0,1).toUpperCase();const copy=document.createElement("div");const strong=document.createElement("strong");strong.textContent=values[0];const meta=document.createElement("span");meta.textContent=values[1];const small=document.createElement("small");small.textContent=values[2];copy.append(strong,meta,small);article.append(mark,copy);if(actions.length&&typeof item.id==="string"){const bar=document.createElement("div");bar.className="dashboard-record__actions";for(const action of actions){const button=document.createElement("button");button.type="button";button.textContent=action.label;button.addEventListener("click",()=>void runAction(action,item.id,button));bar.append(button);}article.append(bar);}records.append(article);}};
  // #22 — hide the create control unless the signed-in member's role holds the
  // required capability. Backend/gateway authorization stays authoritative;
  // this is a usability hint only.
  const applyCapability=(role:unknown)=>{
    const cap=moduleRoot?.dataset.manageCapability;
    if(!cap||can(typeof role==="string"?role:null,cap))return;
    for(const node of document.querySelectorAll<HTMLElement>("[data-create-toggle],[data-create-panel],[data-create-form]")) node.hidden=true;
  };
  const load=async()=>{if(!moduleRoot)return;try{
    const [response,identity]=await Promise.all([
      fetch(`${gateway}${moduleRoot.dataset.endpoint}`,{credentials:"include"}),
      fetch(`${gateway}/v1/dashboard`,{credentials:"include"}).then(r=>r.ok?r.json():null).catch(()=>null),
    ]);
    currentRole=typeof identity?.account?.role==="string"?identity.account.role:null;
    applyCapability(currentRole);
    if(response.status===401)throw new Error("auth");const payload=await response.json().catch(()=>({}));if(!response.ok)throw new Error(typeof payload.error==="string"?payload.error:"Unable to load this workspace.");render(payload);loading!.hidden=true;moduleRoot.hidden=false;}catch(error){loading!.hidden=true;if(error instanceof Error&&error.message==="auth")auth!.hidden=false;else{auth!.hidden=false;const copy=auth!.querySelector("p");if(copy)copy.textContent=error instanceof Error?error.message:"Unable to load this workspace.";}}};
  document.querySelectorAll<HTMLElement>("[data-create-close]").forEach(button=>button.addEventListener("click",()=>{const panel=document.querySelector<HTMLElement>("[data-create-panel]");if(panel)panel.hidden=true;}));
  document.querySelector<HTMLElement>("[data-create-toggle]")?.addEventListener("click",()=>{const panel=document.querySelector<HTMLElement>("[data-create-panel]");if(panel){panel.hidden=false;panel.scrollIntoView({behavior:"smooth",block:"start"});}});
  document.querySelector<HTMLElement>("[data-refresh]")?.addEventListener("click",()=>void load());
  const createForm=document.querySelector<HTMLFormElement>("[data-create-form]");createForm?.addEventListener("submit",async event=>{event.preventDefault();if(!moduleRoot)return;const form=createForm;const submit=form.querySelector<HTMLButtonElement>("[type=submit]");const message=form.querySelector<HTMLElement>("[data-create-message]");const body:Record<string,unknown>={};const NUMS=new Set(["estimatedValue","price","lowStockThreshold","openingQuantity","quantity"]);for(const [key,value] of new FormData(form)){if(value==="")continue;if(key==="startsAt"||key==="endsAt")body[key]=new Date(String(value)).toISOString();else if(NUMS.has(key))body[key]=Number(value);else if(value==="on")body[key]=true;else body[key]=value;}if(submit)submit.disabled=true;if(message)message.textContent="Saving securely...";try{const response=await fetch(`${gateway}${moduleRoot.dataset.endpoint}`,{method:"POST",credentials:"include",headers:{"content-type":"application/json"},body:JSON.stringify(body)});const payload=await response.json().catch(()=>({}));if(!response.ok)throw new Error(typeof payload.error==="string"?payload.error:"The record could not be saved.");form.reset();if(message)message.textContent="Saved.";await load();}catch(error){if(message)message.textContent=error instanceof Error?error.message:"The record could not be saved.";}finally{if(submit)submit.disabled=false;}});
  void load();
</script>
