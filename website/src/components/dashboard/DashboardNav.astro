const groups = realm === "business" ? businessGroups : clientGroups;
---
<nav slot="sidebar" class="dash-nav" aria-label={`${realm === "business" ? "Business" : "Client"} dashboard`}>
  {groups.map(([heading, links]) => (
    <div class="dash-nav__group">
      {heading && <p class="dash-nav__heading">{heading}</p>}
      {links.map(([key, href, label, cap, feature]) => (
        <a href={href} aria-current={active === key ? "page" : undefined} data-nav-cap={cap} data-nav-feature={feature}>
          <svg class="dash-nav__icon" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[key] ?? ICONS.overview} /></svg>
          <span class="dash-nav__label">{label}</span>
          {feature && <span class="dash-nav__badge" data-nav-badge hidden></span>}
        </a>
      ))}
    </div>
  ))}
</nav>
