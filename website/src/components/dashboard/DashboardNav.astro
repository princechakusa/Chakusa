// the link for roles without it; a plan feature shows a plan badge when the
// business's plan doesn't include it (DashboardLayout applies both, client
// side, for usability only - the gateway and API enforce access regardless).
type Link = [string, string, string, string?, string?];
const businessGroups: [string, Link[]][] = [
