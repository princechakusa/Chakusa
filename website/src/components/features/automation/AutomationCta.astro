---
import Button from "../../foundation/Button.astro";
import AutomationIcon from "./AutomationIcon.astro";
import { automationCta } from "../../../data/automation";
---
<section class="at-cta" aria-labelledby="automation-cta-title"><div class="at-shell"><div class="at-cta__panel"><p class="at-label at-label--light">{automationCta.label}</p><h2 id="automation-cta-title">{automationCta.title}</h2><p>{automationCta.body}</p><div class="at-actions"><Button href="/get-started"><span>Start free</span><AutomationIcon name="arrow-right"/></Button><Button href="/product" variant="secondary">Explore all features</Button></div><ul><li>No credit card required</li><li>No workflow builder needed</li><li>Your team reviews every send</li></ul></div></div></section>
