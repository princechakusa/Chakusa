---
import Button from "../../foundation/Button.astro";
import BookingsIcon from "./BookingsIcon.astro";
---
<section class="bk-hero" aria-labelledby="bookings-title"><div class="bk-shell bk-hero__grid"><div class="bk-hero__copy"><p class="bk-badge">Connected scheduling infrastructure</p><h1 id="bookings-title">Frictionless self-booking for clients. <em>Clear calendar control</em> for you.</h1><p>Connect customer discovery to real service availability, the team schedule, booking notice, and appointment reminders without phone tag.</p><div class="bk-actions"><Button href="#booking-flow"><span>Explore booking flow</span><BookingsIcon name="arrow-down"/></Button><Button href="#scheduling-controls" variant="secondary"><BookingsIcon name="calendar"/><span>View calendar example</span></Button></div><dl class="bk-proof"><div><dt>Availability</dt><dd>Business hours</dd></div><div><dt>Calendar</dt><dd>ICS feed</dd></div><div><dt>Changes</dt><dd>Reschedule or cancel</dd></div></dl></div><div class="bk-telemetry" role="img" aria-label="Example booking activity showing a customer selecting an available time, booking rules being checked, and an appointment entering the business calendar"><header><span>Booking activity</span><small>Example status</small></header><ul><li><BookingsIcon name="touch"/><div><strong>Customer selects a time</strong><span>From current availability</span></div><b>Open</b></li><li><BookingsIcon name="clock"/><div><strong>Booking rules apply</strong><span>Notice and working hours</span></div><b>Checked</b></li><li><BookingsIcon name="calendar"/><div><strong>Appointment is confirmed</strong><span>Added to the business calendar</span></div><b>Ready</b></li></ul><div class="bk-telemetry__line"><span>Booking path</span><svg viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path d="M0 17 Q18 5 34 12 T65 7 T100 3"/></svg></div></div></div></section>
