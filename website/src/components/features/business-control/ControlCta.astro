---
import Button from "../../foundation/Button.astro";
import BusinessControlIcon from "./BusinessControlIcon.astro";
import { controlCta } from "../../../data/businessControl";
---
<section class="bc-cta" aria-labelledby="control-cta-title"><div class="bc-shell"><div class="bc-cta__panel"><p class="bc-label bc-label--light">{controlCta.label}</p><h2 id="control-cta-title">{controlCta.title}</h2><p>{controlCta.body}</p><div class="bc-actions"><Button href="/get-started"><span>Start free trial</span><BusinessControlIcon name="arrow-right"/></Button><Button href="/product" variant="secondary">Explore all features</Button></div><ul><li>No credit card required</li><li>Everything in one dashboard</li><li>Nothing sent without review</li></ul></div></div></section>
