---
// Compact trade examples (TradeCycler) replacing the card grid. Same
// verified copy from data/customers.ts, now one springing panel.
import TradeCycler from "../../motion/TradeCycler.astro";
import { customerIndustries } from "../../../data/customers";
const items = customerIndustries.map((it) => ({ title: it.title, example: `${it.body} ${it.fields.map(([k, v]) => `${k}: ${v}.`).join(" ")}` }));
---
<TradeCycler id="cu-trades" kicker="Adapts to your trade" title="Flexible enough for how your business actually works." {items} />
