---
import Button from "../../foundation/Button.astro";
import { lifecycleStages, enquiriesProof } from "../../../data/enquiries";
---
<section class="enq-hero container" aria-labelledby="enq-title">
  <div class="enq-hero__copy">
    <p class="product-kicker">Enquiries & leads</p>
    <h1 id="enq-title">Keep every customer enquiry moving.</h1>
    <p>A missed call, a message through your public profile, or a walk-in enquiry becomes a lead the moment it happens, with the customer's details and what they asked about attached, so it stays visible until someone follows up.</p>
    <div class="enq-hero__actions">
      <Button href="/get-started">Start free</Button>
      <Button href="#capture" variant="secondary">See how it works</Button>
    </div>
    <dl class="enq-hero__proof">{enquiriesProof.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>
  </div>
  <div class="enq-hero__visual">
    <div class="enq-hero__dashboard">
      <div class="enq-hero__windowbar" aria-hidden="true"><span></span><span></span><span></span><small>Chakusa workspace</small></div>
      <img src="/images/how-it-works/chakusa-dashboard-desktop.png" width="1536" height="1024" alt="Chakusa business dashboard showing leads, bookings, reviews, and items needing attention" fetchpriority="high" />
    </div>
    <div class="enq-hero__signal" aria-label="An enquiry remains visible until the business responds">
      <span>New enquiry</span>
      <strong>Visible until you respond</strong>
    </div>
    <ul class="enq-lifecycle-pills" aria-label="Lead status progression">
      {lifecycleStages.map((stage, index) => <li data-active={index === 0 ? "true" : "false"}>{stage.label}</li>)}
    </ul>
  </div>
</section>
