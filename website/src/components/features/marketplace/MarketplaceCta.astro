---
import Button from "../../foundation/Button.astro";
import MarketplaceIcon from "./MarketplaceIcon.astro";
import { marketplaceCta } from "../../../data/marketplace";
---
<section class="mp-cta" aria-labelledby="marketplace-cta-title"><div class="mp-shell"><div class="mp-cta__panel"><p class="mp-label">{marketplaceCta.label}</p><h2 id="marketplace-cta-title">{marketplaceCta.title}</h2><p>{marketplaceCta.body}</p><div class="mp-actions"><Button href="/get-started"><span>Start free</span><MarketplaceIcon name="arrow-right"/></Button><Button href="/product" variant="secondary">Explore all features</Button></div><ul><li>No credit card required</li><li>Your own pricing</li><li>Bookable in minutes</li></ul></div></div></section>
