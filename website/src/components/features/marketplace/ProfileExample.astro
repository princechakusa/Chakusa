---
import { profileExample } from "../../../data/marketplace";
---
<section class="mp-profile" id="profile-example" aria-labelledby="marketplace-profile-title"><div class="mp-shell"><div class="mp-heading"><p class="mp-label">{profileExample.label}</p><h2 id="marketplace-profile-title">What a customer sees.</h2><p>{profileExample.note}</p></div><div class="mp-profile__card"><header><strong>{profileExample.name}</strong><span>{profileExample.hours}</span></header><ul>{profileExample.services.map((service) => <li><span>{service.name}</span><em>{service.duration}</em><b>{service.price}</b></li>)}</ul><footer>Book directly, no account required.</footer></div></div></section>
