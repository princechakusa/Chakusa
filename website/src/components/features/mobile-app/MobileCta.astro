---
import Button from "../../foundation/Button.astro";
import MobileIcon from "./MobileIcon.astro";
import { mobileCta } from "../../../data/mobileApp";
---
<section class="ma-cta" aria-labelledby="mobile-cta-title"><div class="ma-shell"><div class="ma-cta__panel"><p class="ma-label ma-label--light">{mobileCta.label}</p><h2 id="mobile-cta-title">{mobileCta.title}</h2><p>{mobileCta.body}</p><div class="ma-badges"><span>iOS release planned</span><span>Android release planned</span></div><div class="ma-actions"><Button href="/get-started"><span>Start free on the web</span><MobileIcon name="arrow-right"/></Button><Button href="/product" variant="secondary">Explore all features</Button></div></div></div></section>
