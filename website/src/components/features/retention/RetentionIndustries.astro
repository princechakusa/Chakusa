---
import RetentionIcon from "./RetentionIcon.astro";
import { retentionIndustries } from "../../../data/retention";
---
<section class="rt-industries" id="cadences" aria-labelledby="retention-industries-title"><div class="rt-shell"><div class="rt-heading rt-heading--center"><p class="rt-label">Every trade has its own cadence</p><h2 id="retention-industries-title">A dental recall schedule shouldn't run a barber's rebooking clock.</h2><p>Set the rebooking window that fits how each trade actually gets revisited.</p></div><div class="rt-industries__grid">{retentionIndustries.map((item, i) => <article><div class:list={["rt-icon", i % 2 === 1 && "rt-icon--alt"]}><RetentionIcon name={item.icon}/></div><h3>{item.title}</h3><p>{item.body}</p><span class="rt-industries__cadence">{item.cadence}</span></article>)}</div></div></section>
