---
// Compact trade examples (TradeCycler) replacing the card grid. Same
// verified copy from data/reviews.ts, now one springing panel.
import TradeCycler from "../../motion/TradeCycler.astro";
import { reviewIndustries } from "../../../data/reviews";
const items = reviewIndustries.map((it) => ({ title: it.title, example: `${it.body} ${it.points.join(". ")}.` }));
---
<TradeCycler id="rv-trades" kicker="Works the same way everywhere" title="Tailored to how your industry actually books." {items} />
