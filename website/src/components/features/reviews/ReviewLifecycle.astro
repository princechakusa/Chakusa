---
import ReviewsIcon from "./ReviewsIcon.astro";
import { reviewSteps } from "../../../data/reviews";
---
<section class="rv-lifecycle" id="review-journey" aria-labelledby="reviews-lifecycle-title"><div class="rv-shell"><div class="rv-heading rv-heading--split"><div><p class="rv-label">Lifecycle automation</p><h2 id="reviews-lifecycle-title">From completed visit to public trust.</h2></div><p>The same review path applies to every completed visit, without predicting which customers will leave a high score.</p></div><ol class="rv-lifecycle__grid">{reviewSteps.map((step) => <li><header><span class="rv-lifecycle__number">Step {step.number}</span><span class="rv-lifecycle__status">{step.tag}</span></header><div class="rv-lifecycle__icon"><ReviewsIcon name={step.icon}/></div><strong>{step.title}</strong><p>{step.body}</p><footer><ReviewsIcon name="check"/><span>{step.tag}</span></footer></li>)}</ol></div></section>
