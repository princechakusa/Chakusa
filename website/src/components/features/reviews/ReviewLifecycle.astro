---
import ReviewsIcon from "./ReviewsIcon.astro";
import { reviewSteps } from "../../../data/reviews";
---
<section class="rv-lifecycle" aria-labelledby="reviews-lifecycle-title"><div class="rv-shell"><div class="rv-heading"><p class="rv-label">From visit to public review</p><h2 id="reviews-lifecycle-title">Nothing is filtered before it goes out.</h2><p>The same four steps run for every completed visit, regardless of how it's expected to go.</p></div><ol class="rv-lifecycle__grid">{reviewSteps.map((step) => <li><span class="rv-lifecycle__number">{step.number}</span><div class="rv-lifecycle__icon"><ReviewsIcon name={step.icon}/></div><strong>{step.title}</strong><p>{step.body}</p><span class="rv-lifecycle__tag">{step.tag}</span></li>)}</ol></div></section>
