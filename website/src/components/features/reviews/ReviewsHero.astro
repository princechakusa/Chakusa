---
import Button from "../../foundation/Button.astro";
import ReviewsIcon from "./ReviewsIcon.astro";
import { reviewsHero, reviewsProof } from "../../../data/reviews";
---
<section class="rv-hero" aria-labelledby="reviews-title">
  <div class="rv-hero__glow rv-hero__glow--coral" aria-hidden="true"></div>
  <div class="rv-hero__glow rv-hero__glow--teal" aria-hidden="true"></div>
  <div class="rv-shell rv-hero__inner">
    <p class="rv-badge"><ReviewsIcon name="shield" />{reviewsHero.badge}</p>
    <h1 id="reviews-title">{reviewsHero.title.replace(reviewsHero.emphasis, "")}<em>{reviewsHero.emphasis}</em></h1>
    <p>{reviewsHero.body}</p>
    <div class="rv-actions"><Button href="#ledger-preview"><span>Explore reviews</span><ReviewsIcon name="arrow-right"/></Button><Button href="#review-journey" variant="secondary"><ReviewsIcon name="play"/><span>View sample flow</span></Button></div>
    <dl class="rv-proof">{reviewsProof.map((item) => <div><dd>{item.value}</dd><dt>{item.label}</dt><span>{item.detail}</span></div>)}</dl>
  </div>
</section>
