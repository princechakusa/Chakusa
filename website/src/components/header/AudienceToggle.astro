---
// "For Clients / For Businesses" audience toggle, matching the
// approved Stitch header's distinction between the two real Chakusa
// audiences. Both sides now have a real, dedicated landing page:
// /client (customer-facing: discover, book, review) and /business
// (business-facing: enquiries, bookings, CRM). Active state is a
// filled red pill (var(--primary)), not the low-contrast dark/white
// treatment used before, since users reported confusion about which
// side they were currently on.
const path = Astro.url.pathname;
const isClientSide = path.startsWith("/client") || path.startsWith("/industries");
---
<div class="audience-toggle" role="group" aria-label="Choose your experience">
  <a href="/client" aria-current={isClientSide ? "page" : undefined}>For clients</a>
  <a href="/business" aria-current={isClientSide ? undefined : "page"}>For businesses</a>
</div>
