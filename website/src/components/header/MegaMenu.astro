---
import MegaMenuIcon from "./MegaMenuIcon.astro";
import { megaMenuQuadrants } from "../../data/megaMenu";
interface Props { id: string }
const { id } = Astro.props;
const featureLinks = megaMenuQuadrants.flatMap((group) =>
  group.links.map((link) => ({ ...link, icon: group.icon, group: group.title })),
).slice(0, 6);
---
<div class="nav-menu" data-menu-root>
  <button class="nav-menu__trigger nav-menu__trigger--label" type="button" aria-expanded="false" aria-controls={`menu-${id}`} aria-label="Open Features menu" data-menu-trigger>
    <span>Features</span>
    <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  </button>
  <div class="mega-menu" id={`menu-${id}`} hidden data-menu-panel>
    <div class="mega-menu__label">
      <span>Core platform features</span>
    </div>
    <div class="mega-menu__list">
      {featureLinks.map((link, index) => <a class:list={["mega-menu__item", { "mega-menu__item--active": index === 0 }]} href={link.href}>
        <span class="mega-menu__icon"><MegaMenuIcon name={link.icon}/></span>
        <span><strong>{link.label}</strong><small>{link.group}</small></span>
      </a>)}
    </div>
    <a class="mega-menu__all" href="/features/enquiries"><span>Explore all platform features</span><MegaMenuIcon name="arrow-right"/></a>
  </div>
</div>
