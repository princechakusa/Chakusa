---
interface Child { label: string; href: string; description: string }
interface Props { label: string; href: string; children: Child[]; id: string }
const { label, href, children, id } = Astro.props;
---
<div class="nav-menu" data-menu-root>
  <a href={href}>{label}</a>
  <button class="nav-menu__trigger" type="button" aria-expanded="false" aria-controls={`menu-${id}`} aria-label={`Open ${label} menu`} data-menu-trigger>
    <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  </button>
  <div class="nav-menu__panel" id={`menu-${id}`} hidden data-menu-panel>
    {children.map((child) => <a href={child.href}><strong>{child.label}</strong><span>{child.description}</span></a>)}
  </div>
</div>
