---
import Button from "../foundation/Button.astro";
import HeroTrust from "./HeroTrust.astro";
---
<div class="hero-content">
  <p class="eyebrow">Every customer step, connected</p>
  <h1 id="hero-title">Turn every conversation into <em>lasting growth.</em></h1>
  <p class="hero-lead">Chakusa gives service businesses one place to respond, book, remind, collect feedback, and bring customers back. Your team stays in control.</p>
  <div class="hero-actions" aria-label="Get started with Chakusa"><Button href="/get-started">Start free</Button><Button href="/product" variant="secondary">Explore the product</Button></div>
  <HeroTrust />
</div>
