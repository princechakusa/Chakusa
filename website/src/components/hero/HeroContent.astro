---
import Button from "../foundation/Button.astro";
import HeroTrust from "./HeroTrust.astro";
---
<div class="hero-content">
  <p class="eyebrow">Built for service businesses</p>
  <h1 id="hero-title">Respond faster. Book more. <em>Bring customers back.</em></h1>
  <p class="hero-lead">Chakusa keeps enquiries, bookings, reminders, reviews, and return visits moving in one place. Your team decides what happens next.</p>
  <div class="hero-actions" aria-label="Get started with Chakusa"><Button href="/get-started">Start free</Button><Button href="/product" variant="secondary">Explore the product</Button></div>
  <HeroTrust />
</div>
