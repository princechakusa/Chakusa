---
import HeroDashboard from "./HeroDashboard.astro";
import HeroPhone from "./HeroPhone.astro";
import HeroJourneyRibbon from "./HeroJourneyRibbon.astro";
---
<div class="hero-poster" id="hero-poster" role="img" aria-label="Chakusa product preview showing a customer enquiry, an assisted response, an appointment confirmation, and a scheduled follow-up">
  <div class="poster-label"><span></span>Live customer journey</div>
  <div class="poster-context" aria-hidden="true"><span>Enquiry received</span><strong>Response ready</strong></div>
  <HeroDashboard />
  <HeroPhone />
  <HeroJourneyRibbon />
</div>
