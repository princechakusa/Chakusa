---
import Button from "../foundation/Button.astro";
const categories = ["Beauty", "Home services", "Automotive", "Professional services"];
---
<section class="discovery-experience" aria-labelledby="discovery-title"><div class="container discovery-experience__grid"><div class="discovery-experience__copy"><p class="story-kicker">Customer discovery</p><h2 id="discovery-title">Help the right customer find the right business.</h2><p>Chakusa connects marketplace discovery and public business profiles with the conversation that follows. Customers can understand the service, contact the business, and continue toward a booking without losing context.</p><div class="discovery-experience__actions"><Button href="/product#customer-response">Explore customer response</Button><a href="/industries">See supported industries <span aria-hidden="true">→</span></a></div></div><div class="discovery-map" aria-label="Customer discovery path from marketplace to business enquiry"><div class="discovery-map__top"><span>Marketplace discovery</span><strong>Find a service business</strong></div><div class="discovery-map__categories">{categories.map(category => <span>{category}</span>)}</div><ol><li><span>01</span><strong>Discover</strong><small>Browse relevant services</small></li><li><span>02</span><strong>Understand</strong><small>View the business profile</small></li><li><span>03</span><strong>Enquire</strong><small>Start the conversation</small></li></ol></div></div></section>
