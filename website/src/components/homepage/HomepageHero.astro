---
// Homepage hero.
// History: Stage 3B centred this hero to match the Stitch reference. The
// 2026-09 motion pass returns to a split layout at the owner's request:
// the centred text wall pushed the product below the fold. Copy stays on
// the left; the live app demo (HeroLoopDemo) sits on the right, above the
// fold on desktop. On mobile the two stack, copy first.
import Button from "../foundation/Button.astro";
import StoryIcon from "./StoryIcon.astro";
import HeroLoopDemo from "./HeroLoopDemo.astro";
import { heroCopy, heroTrust } from "../../data/homepageStory";
// Every trade listed here has a live /industries page.
const trades = ["barbers", "hair salons", "cleaners", "mechanics", "photographers", "spas", "dentists", "electricians"];
---
<section class="hero2" data-spotlight aria-labelledby="story-hero-title">
  <div class="hero2__bg" aria-hidden="true">
    <span class="hero2__aurora hero2__aurora--a"></span>
    <span class="hero2__aurora hero2__aurora--b"></span>
    <span class="hero2__aurora hero2__aurora--c"></span>
    <span class="hero2__grid"></span>
  </div>
  <div class="container hero2__inner">
    <div class="hero2__copy">
      <p class="hero2__badge"><span class="hero2__badge-dot"></span>{heroCopy.eyebrow}</p>
      <h1 id="story-hero-title" data-split data-accent="5,6">{heroCopy.title}</h1>
      <p class="hero2__lede">{heroCopy.lede}</p>
      <p class="hero2__for">Built for <span class="hero2__rotate" data-rotate={trades.join("|")}>{trades[0]}</span></p>
      <div class="hero2__actions">
        <Button href="/get-started">Start free trial <StoryIcon name="arrow_forward" class="hero2__arrow" /></Button>
        <Button href="/how-it-works" variant="secondary">See how it works</Button>
      </div>
      <ul class="hero2__trust">
        {heroTrust.map((item) => <li><StoryIcon name={item.icon} class="hero2__trust-icon" />{item.label}</li>)}
        <li><StoryIcon name="event_available" class="hero2__trust-icon" />14-day free trial</li>
      </ul>
    </div>
    <div class="hero2__demo">
      <HeroLoopDemo />
    </div>
  </div>
</section>
