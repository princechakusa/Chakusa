---
// PROGRAM: CHAKUSA WEBSITE FRONTEND MIGRATION, STAGE 3B.
// Corrected from Stage 3: Stitch's hero is centered, single narrow
// column, with the customer/business cards stacked BELOW the text, not
// beside it in a two-column split. Stage 3 built a left-aligned
// side-by-side layout, which the owner's visual review correctly flagged.
import Button from "../foundation/Button.astro";
import StoryIcon from "./StoryIcon.astro";
import { heroCopy, heroTrust } from "../../data/homepageStory";
---
<section class="story-hero container" aria-labelledby="story-hero-title">
  <div class="story-hero__copy">
    <p class="story-kicker">{heroCopy.eyebrow}</p>
    <h1 id="story-hero-title">{heroCopy.title}</h1>
    <p>{heroCopy.body}</p>
    <div class="story-hero__actions">
      <Button href="/get-started">Start free</Button>
      <Button href="/how-it-works" variant="secondary">See how it works</Button>
    </div>
    <ul class="story-hero__trust">
      {heroTrust.map((item) => <li><StoryIcon name={item.icon} class="story-hero__trust-icon" />{item.label}</li>)}
    </ul>
  </div>
  <div class="story-hero__visual" aria-hidden="true">
    <div class="story-hero__card">
      <span class="story-hero__card-label"><StoryIcon name="person" class="story-hero__card-icon" />Customer view</span>
      <strong>Find a business, see real availability, book directly.</strong>
      <span class="story-hero__card-meta">No phone tag</span>
    </div>
    <div class="story-hero__card story-hero__card--business">
      <span class="story-hero__card-label"><StoryIcon name="storefront" class="story-hero__card-icon" />Business view</span>
      <strong>Today's bookings, new enquiries, and who's due back.</strong>
      <span class="story-hero__card-meta">One working view</span>
    </div>
  </div>
</section>
