---
import StoryIcon from "./StoryIcon.astro";
import { platformModules } from "../../data/homepageStory";
---
<section class="story-modules container" aria-labelledby="story-modules-title">
  <div class="story-section-heading story-section-heading--center">
    <p class="story-kicker">Core platform modules</p>
    <h2 id="story-modules-title" data-split>Built to run operations without friction.</h2>
    <p>Six connected modules, instead of six separate subscriptions that don't talk to each other.</p>
  </div>
  <div class="story-modules__grid" data-stagger>
    {platformModules.map((module) => <div class="story-modules__card" data-tilt="6">
      <div class="story-modules__head">
        <div class="story-modules__badge"><StoryIcon name={module.icon} class="story-modules__icon" /></div>
        <strong>{module.title}</strong>
      </div>
      <p>{module.copy}</p>
      <div class="story-modules__preview" data-inview>
        <div class="mdemo" data-demo={module.icon} aria-hidden="true">
          {module.icon === "inbox" && <div class="mdemo-inbox"><i class="mdemo-inbox__row mdemo-inbox__row--new"><b>Missed call</b><em></em></i><i class="mdemo-inbox__row"><b>WhatsApp</b><em></em></i><i class="mdemo-inbox__row"><b>Website form</b><em></em></i></div>}
          {module.icon === "calendar_month" && <div class="mdemo-cal"><div class="mdemo-cal__grid">{Array.from({ length: 15 }, (_, i) => <i class={i === 7 ? "is-target" : i % 4 === 1 ? "is-busy" : ""}></i>)}</div><span class="mdemo-cal__sync">✓ Synced</span></div>}
          {module.icon === "account_box" && <div class="mdemo-tl">{["Enquiry", "Booking", "Visit", "Review"].map((l) => <span><i></i>{l}</span>)}</div>}
          {module.icon === "star_rate" && <div class="mdemo-stars">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24"><path d="m12 3 2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L12 3Z" /></svg>)}<em>Request sent for every visit</em></div>}
          {module.icon === "repeat" && <div class="mdemo-ring"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" /><circle class="mdemo-ring__fill" cx="20" cy="20" r="16" /></svg><span><b>4 wks</b> since last visit</span><em>Due back</em></div>}
          {module.icon === "forum" && <div class="mdemo-msg"><span class="mdemo-msg__dots"><i></i><i></i><i></i></span><span class="mdemo-msg__bubble">Hi Sam, your usual slot is free Friday. Want it?</span><span class="mdemo-msg__send">Review &amp; send</span></div>}
        </div>
        <p class="sr-only">{module.previewLabel}: {module.previewBody}</p>
      </div>
      <div class="story-modules__stat"><span>{module.statLabel}</span><span>{module.statValue}</span></div>
    </div>)}
  </div>
</section>
