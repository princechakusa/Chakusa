---
// Reusable flat-vector "trade worker" character illustration, matching
// Stitch's large-character-illustration treatment (a capped, bearded
// worker in a coral apron/coverall, phone in hand) instead of a small
// icon badge. Pure inline SVG, no external asset, so it stays
// production-safe (no hotlinked Stitch image, no runtime dependency).
// Deliberately generic/faceless-neutral, not modeled on any real
// person, consistent with every illustrative example elsewhere on the
// site never implying a specific real individual.
---
<svg class="trade-character" viewBox="0 0 240 320" role="img" aria-label="Illustration of a local service worker holding a phone">
  <circle class="trade-character__halo" cx="120" cy="110" r="86" />
  <g class="trade-character__figure">
    <path class="trade-character__body" d="M70 320V210c0-33 22-58 50-58s50 25 50 58v110Z" />
    <rect class="trade-character__neck" x="108" y="128" width="24" height="26" rx="6" />
    <circle class="trade-character__head" cx="120" cy="96" r="42" />
    <path class="trade-character__cap" d="M76 92a44 44 0 0 1 88 0v6H76Z" />
    <rect class="trade-character__cap-brim" x="70" y="94" width="100" height="10" rx="5" />
    <path class="trade-character__beard" d="M92 104c0 26 12 46 28 46s28-20 28-46Z" />
    <path class="trade-character__strap" d="M96 152 82 118M144 152l14-34" />
    <g class="trade-character__arm">
      <path d="M158 190c18 6 30 20 34 40l4 24" />
      <rect class="trade-character__phone" x="182" y="248" width="34" height="56" rx="7" />
      <circle class="trade-character__phone-dot" cx="199" cy="288" r="2.4" />
    </g>
  </g>
</svg>
<style>
.trade-character{width:100%;height:auto;overflow:visible}
.trade-character__halo{fill:var(--secondary);opacity:.12}
.trade-character__body{fill:var(--primary)}
.trade-character__neck,.trade-character__head{fill:#f0b088}
.trade-character__cap,.trade-character__cap-brim{fill:var(--heading)}
.trade-character__beard{fill:#3d2b22}
.trade-character__strap{fill:none;stroke:var(--heading);stroke-width:5;stroke-linecap:round}
.trade-character__arm path{fill:none;stroke:var(--primary);stroke-width:16;stroke-linecap:round}
.trade-character__phone{fill:var(--secondary)}
.trade-character__phone-dot{fill:#fff}
</style>
