---
// Reusable flat-vector "trade worker" character illustration, matching
// Stitch's own illustration style for this exact composition (a
// bowler-capped, bearded worker with a pen behind the cap, in a coral
// coat, one arm extended holding a phone) - confirmed flat vector, not
// painterly raster art, so this is a faithful reproduction technique,
// not an approximation. Pure inline SVG, no external asset, so it
// stays production-safe (no hotlinked Stitch image, no runtime
// dependency). Deliberately generic/faceless-neutral, not modeled on
// any real person, consistent with every illustrative example
// elsewhere on the site never implying a specific real individual.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class:list={["trade-character", className]} viewBox="0 0 240 340" role="img" aria-label="Illustration of a local service worker holding a phone">
  <circle class="trade-character__halo" cx="118" cy="112" r="82" />
  <g class="trade-character__figure">
    <!-- coat -->
    <path class="trade-character__body" d="M60 340V232c0-38 26-66 58-66s58 28 58 66v108Z" />
    <path class="trade-character__collar" d="M96 172h44l-10 22h-24Z" />
    <!-- neck -->
    <rect class="trade-character__neck" x="104" y="150" width="28" height="30" rx="6" />
    <!-- head + beard -->
    <circle class="trade-character__head" cx="118" cy="112" r="46" />
    <path class="trade-character__beard" d="M78 118c0 30 16 54 40 54s40-24 40-54Z" />
    <!-- cap -->
    <path class="trade-character__cap" d="M72 108a46 46 0 0 1 92 0v8H72Z" />
    <rect class="trade-character__cap-brim" x="66" y="110" width="104" height="11" rx="5.5" />
    <!-- pen behind cap -->
    <rect class="trade-character__pen" x="150" y="70" width="8" height="34" rx="3" transform="rotate(28 154 87)" />
    <!-- arm + phone -->
    <path class="trade-character__arm" d="M164 240c22 4 38 18 46 40l8 26" />
    <g class="trade-character__phone-group" transform="translate(196 292) rotate(8)">
      <rect class="trade-character__phone" x="0" y="0" width="38" height="62" rx="8" />
      <circle class="trade-character__phone-dot" cx="19" cy="46" r="2.6" />
    </g>
  </g>
</svg>
<style>
.trade-character{width:100%;height:auto;overflow:visible;display:block}
.trade-character__halo{fill:var(--secondary);opacity:.12}
.trade-character__body{fill:var(--primary)}
.trade-character__collar{fill:#f0b088}
.trade-character__neck,.trade-character__head{fill:#e8a878}
.trade-character__cap,.trade-character__cap-brim{fill:var(--heading)}
.trade-character__beard{fill:#2c2018}
.trade-character__pen{fill:var(--primary)}
.trade-character__arm{fill:none;stroke:var(--primary);stroke-width:18;stroke-linecap:round}
.trade-character__phone{fill:var(--secondary)}
.trade-character__phone-dot{fill:#fff}
</style>
