---
import { businessAttention } from "../../data/how-it-works";
---
<section class="hiw-attention container" aria-labelledby="attention-title"><div class="hiw-attention__grid"><div class="hiw-attention__copy"><p class="hiw-kicker">{businessAttention.eyebrow}</p><h2 id="attention-title">{businessAttention.title}</h2><p>{businessAttention.copy}</p><ul>{businessAttention.points.map(point => <li>{point}</li>)}</ul></div>{businessAttention.visual ? <div class="hiw-attention__visual"><img src={businessAttention.visual} width="1536" height="1024" alt={`Chakusa ${businessAttention.visualLabel}`} loading="lazy" /></div> : <div class="product-screenshot product-screenshot--pending" data-production-asset="awaiting-production-screenshot"><div class="product-screenshot__pending" aria-label={`${businessAttention.visualLabel} screenshot awaiting production capture`}><span>Chakusa product</span><strong>{businessAttention.visualLabel}</strong><small>Production capture in preparation</small></div></div>}</div></section>
