---
import { businessAttention } from "../../data/how-it-works";
---
<section class="hiw-attention container" aria-labelledby="attention-title"><div class="hiw-attention__grid"><div class="hiw-attention__copy"><p class="hiw-kicker">{businessAttention.eyebrow}</p><h2 id="attention-title">{businessAttention.title}</h2><p>{businessAttention.copy}</p><ul>{businessAttention.points.map(point => <li>{point}</li>)}</ul></div><div class="hiw-attention__visual"><img src={businessAttention.visual} width="1536" height="1024" alt={`Chakusa ${businessAttention.visualLabel}`} loading="lazy" /></div></div></section>
