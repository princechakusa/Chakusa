---
import ProductScreenshot from "../product/ProductScreenshot.astro";
import type { JourneyChapter } from "../../data/how-it-works";
interface Props { chapter: JourneyChapter; index: number; }
const { chapter, index } = Astro.props;
---
<section class:list={["hiw-chapter", { "hiw-chapter--reverse": index % 2 === 1 }]} id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
  <div class="container hiw-chapter__grid">
    <div class="hiw-chapter__copy">
      <span class="hiw-chapter__number">{chapter.number}</span>
      <p class="hiw-chapter__label">{chapter.title}</p>
      <h2 id={`${chapter.id}-title`}>{chapter.headline}</h2>
      <p>{chapter.copy}</p>
      <ul>{chapter.points.map(point => <li>{point}</li>)}</ul>
    </div>
    <ProductScreenshot src={chapter.visual} label={chapter.visualLabel} />
  </div>
</section>
