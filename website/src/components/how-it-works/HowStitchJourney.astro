---
// Synchronized journey stepper. One row of seven step tabs drives two
// panels at once, customer side and business side, so the visitor sees
// both halves of the same moment together. Replaces two tall parallel
// columns (~1,700px). Auto-advances while visible; any interaction hands
// control to the visitor. Touchpoint steps pulse the connector between
// the two panels. Content: data/howItWorksStitch.ts (verified).
import StoryIcon from "../homepage/StoryIcon.astro";
import { customerJourney, businessJourney } from "../../data/howItWorksStitch";
const pairs = customerJourney.map((c, i) => ({ c, b: businessJourney[i] }));
---
<section class="hsync hw-shell" aria-labelledby="parallel-title" data-hsync>
  <header class="hsync__head">
    <p>Two sides, one record</p>
    <h2 id="parallel-title">Every step, from both sides at once.</h2>
  </header>
  <div class="hsync__tabs" role="tablist" aria-label="Journey step">
    {pairs.map(({ c, b }, i) => <button type="button" role="tab" id={`hsync-tab-${i}`} aria-controls="hsync-panel" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-i={i}>
      <b>{c.number}</b><span>{c.label}</span><i class="hsync__bar"><i></i></i>
    </button>)}
  </div>
  <div class="hsync__stage" id="hsync-panel" role="tabpanel" aria-live="polite">
    {pairs.map(({ c, b }, i) => <div class="hsync__pair" data-p={i} data-touch={c.touchpoint || b.touchpoint ? "true" : undefined} hidden={i !== 0}>
      <article class="hsync__card hsync__card--customer">
        <p class="hsync__side"><StoryIcon name="person" />Customer</p>
        <h3>{c.title}</h3>
        <p>{c.body}</p>
        <div class="hsync__ui"><strong>{c.detail}</strong><small>{c.meta}</small></div>
      </article>
      <div class="hsync__link" aria-hidden="true"><span></span><em>{c.touchpoint || b.touchpoint ? "Both sides" : "In step"}</em></div>
      <article class="hsync__card hsync__card--business">
        <p class="hsync__side"><StoryIcon name="storefront" />Business</p>
        <h3>{b.title}</h3>
        <p>{b.body}</p>
        <div class="hsync__ui"><strong>{b.detail}</strong><small>{b.meta}</small></div>
      </article>
    </div>)}
  </div>
  <p class="hsync__note">Names shown are illustrative demo data.</p>
</section>

<style is:global>
  .hsync{padding-block:clamp(2.5rem,5vw,3.5rem)}
  .hsync__head p{margin:0;color:var(--primary);font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .hsync__head h2{margin:.5rem 0 0;font-family:var(--font-heading);font-size:clamp(1.9rem,4vw,2.9rem);font-weight:800;letter-spacing:-.035em;line-height:1.08;color:var(--heading)}
  .hsync__tabs{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:.35rem;margin-top:1.75rem;overflow-x:auto;scrollbar-width:none}
  .hsync__tabs button{position:relative;display:grid;gap:.1rem;justify-items:start;min-width:6.5rem;padding:.7rem .8rem .9rem;border:0;border-radius:.9rem;background:#fff;box-shadow:0 0 0 1px var(--hairline);font:inherit;text-align:left;cursor:pointer;overflow:hidden;transition:background .25s,box-shadow .25s,transform .35s cubic-bezier(.34,1.56,.64,1)}
  .hsync__tabs button:hover{transform:translateY(-2px)}
  .hsync__tabs b{color:var(--primary);font-size:.7rem}
  .hsync__tabs span{color:var(--heading);font-size:.88rem;font-weight:700}
  .hsync__tabs button[aria-selected="true"]{background:var(--heading);box-shadow:none}
  .hsync__tabs button[aria-selected="true"] span{color:#fff}
  .hsync__tabs button[aria-selected="true"] b{color:#ff9a7a}
  .hsync__tabs button:focus-visible{outline:none;box-shadow:var(--focus)}
  .hsync__bar{position:absolute;left:.8rem;right:.8rem;bottom:.4rem;height:2px;border-radius:2px;background:rgba(255,255,255,.18)}
  .hsync__bar i{display:block;height:100%;background:#ff9a7a;transform-origin:left;transform:scaleX(var(--t,0))}
  .hsync__tabs button:not([aria-selected="true"]) .hsync__bar{display:none}
  .hsync__stage{display:grid;margin-top:1rem}
  .hsync__pair{grid-area:1/1;display:grid;gap:.75rem}
  .hsync__card{padding:clamp(1.1rem,2.5vw,1.6rem);border-radius:1.25rem;background:#fff;box-shadow:0 0 0 1px var(--hairline),0 24px 50px -36px rgba(15,23,42,.4)}
  .hsync__card--business{background:var(--heading);color:#fff;box-shadow:none}
  .hsync__side{display:flex;align-items:center;gap:.4rem;margin:0;font-size:.72rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted-text)}
  .hsync__side svg{width:1rem;height:1rem;color:var(--primary)}
  .hsync__card--business .hsync__side{color:#9ba3b4}
  .hsync__card h3{margin:.6rem 0 0;font-family:var(--font-heading);font-size:1.25rem;letter-spacing:-.02em;color:var(--heading)}
  .hsync__card--business h3{color:#fff}
  .hsync__card>p:not(.hsync__side){margin:.45rem 0 0;color:var(--body-text);line-height:1.6;font-size:.95rem}
  .hsync__card--business>p:not(.hsync__side){color:#c9ccd3}
  .hsync__ui{display:grid;gap:.15rem;margin-top:.9rem;padding:.7rem .85rem;border-radius:.8rem;background:var(--page-surface)}
  .hsync__card--business .hsync__ui{background:rgba(255,255,255,.08)}
  .hsync__ui strong{font-size:.88rem;color:var(--heading)}
  .hsync__card--business .hsync__ui strong{color:#fff}
  .hsync__ui small{font-size:.75rem;color:var(--secondary);font-weight:700}
  .hsync__card--business .hsync__ui small{color:#6fe0cf}
  .hsync__link{display:grid;place-items:center;gap:.3rem}
  .hsync__link span{width:2px;height:1.5rem;background:repeating-linear-gradient(var(--primary) 0 4px,transparent 4px 8px)}
  .hsync__link em{font-style:normal;font-size:.68rem;font-weight:800;color:var(--muted-text);text-transform:uppercase;letter-spacing:.06em}
  .hsync__pair[data-touch] .hsync__link em{color:var(--primary)}
  .hsync__pair[data-touch] .hsync__link span{animation:hsync-pulse 1.2s ease-in-out infinite}
  @keyframes hsync-pulse{50%{opacity:.35}}
  .hsync__note{margin:.75rem 0 0;color:var(--muted-text);font-size:.75rem}
  @media (min-width:56rem){
    .hsync__pair{grid-template-columns:1fr 7rem 1fr;align-items:stretch}
    .hsync__link span{width:100%;height:2px;background:repeating-linear-gradient(90deg,var(--primary) 0 6px,transparent 6px 11px)}
  }
  @media (prefers-reduced-motion:reduce){.hsync__pair[data-touch] .hsync__link span{animation:none}}
</style>

<script>
  import { animate, inView } from "motion";
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-hsync]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const pairs = [...root.querySelectorAll<HTMLElement>(".hsync__pair")];
    let cur = 0; let auto = !reduced; let visible = false; let t0 = performance.now(); let tAt = 0;
    const DWELL = 5200;
    function select(i: number, focus = false) {
      if (i === cur) return;
      const prev = pairs[cur]; cur = i; tAt = 0;
      tabs.forEach((t, k) => { t.setAttribute("aria-selected", String(k === i)); t.tabIndex = k === i ? 0 : -1; t.style.setProperty("--t", "0"); });
      if (focus) tabs[i].focus();
      tabs[i].scrollIntoView({ block: "nearest", inline: "nearest" });
      prev.hidden = true; pairs[i].hidden = false;
      if (reduced) return;
      const [c, link, b] = [...pairs[i].children] as HTMLElement[];
      animate(c, { opacity: [0, 1], x: [-28, 0] }, { type: "spring", stiffness: 260, damping: 24 });
      animate(b, { opacity: [0, 1], x: [28, 0] }, { type: "spring", stiffness: 260, damping: 24, delay: 0.08 });
      animate(link, { opacity: [0, 1], scale: [0.6, 1] }, { type: "spring", stiffness: 400, damping: 18, delay: 0.16 });
      t0 = performance.now();
    }
    const stop = () => { auto = false; tabs.forEach((t) => t.style.setProperty("--t", "0")); };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => { stop(); select(i); });
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) { e.preventDefault(); stop(); select((cur + d + tabs.length) % tabs.length, true); }
      });
    });
    root.addEventListener("focusin", stop);
    inView(root, () => { visible = true; t0 = performance.now() - tAt * DWELL; return () => { visible = false; }; }, { amount: 0.4 });
    const tick = (now: number) => {
      if (auto && visible && !document.hidden) {
        tAt = Math.min(1, (now - t0) / DWELL);
        tabs[cur].style.setProperty("--t", String(tAt));
        if (tAt >= 1) select((cur + 1) % tabs.length);
      } else t0 = now - tAt * DWELL;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
