---
import StoryIcon from "../homepage/StoryIcon.astro";
import { touchpoints } from "../../data/howItWorksStitch";
---
<section class="hw-touchpoints hw-shell" aria-labelledby="touchpoints-title"><div class="hw-touchpoints__panel"><header><p>Where the two sides meet</p><h2 id="touchpoints-title">Four moments both sides see.</h2><div>The same event shows up for the customer and in the business app, from one shared record.</div></header><div class="hw-touchpoints__grid">{touchpoints.map((item) => <article><i><StoryIcon name={item.icon} /></i><span>Handshake {item.number}</span><h3>{item.title}</h3><p>{item.body}</p><footer>{item.meta}</footer></article>)}</div></div></section>
