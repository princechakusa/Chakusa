---
import "../../styles/industries/industry-motion.css";
import StoryIcon from "../homepage/StoryIcon.astro";
import { barberProblems, barberWorkflow, barberFeatures } from "../../data/barbersIndustry";
---
<section class="ib-section ib-shell ivp-reality" aria-labelledby="barber-realities"><header class="ib-heading"><p>The realities of the shop floor</p><h2 id="barber-realities">Shears in one hand, comb in the other. Your phone should work for you.</h2><span>Small moments around the chair decide whether a new enquiry becomes a regular customer.</span></header><div class="ivp-fixes" data-stagger>{barberProblems.map((item)=><article data-tilt="5"><i><StoryIcon name={item.icon} /></i><h3>{item.title}</h3><p>{item.body}</p><footer><span aria-hidden="true">→</span>{item.note}</footer></article>)}</div></section>
<section class="ib-workflow ivp-flow" id="barber-workflow" aria-labelledby="barber-workflow-title"><div class="ib-shell"><header class="ib-heading"><p>The connected chair loop</p><h2 id="barber-workflow-title">How Chakusa protects your chairs, schedule, and customer relationships.</h2></header><ol class="ivp-flow__line" data-scroll-progress style={`--count:${barberWorkflow.length}`}>{barberWorkflow.map((item,index)=><li style={`--i:${index}`}><span class="ivp-flow__dot"><StoryIcon name={item.icon} /></span><strong>{item.title}</strong><p>{item.body}</p></li>)}</ol></div></div></section>
<section class="ib-section ib-shell ivp-features" aria-labelledby="barber-features"><header class="ib-heading"><p>Features that matter</p><h2 id="barber-features">Built around the working rhythm of a barbershop.</h2></header><div class="ivp-feature-grid" data-stagger>{barberFeatures.map((item)=><article><i><StoryIcon name={item.icon} /></i><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></section>
