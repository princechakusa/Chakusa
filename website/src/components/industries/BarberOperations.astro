---
import TradeCharacterAlt from "../homepage/TradeCharacterAlt.astro";
import StoryIcon from "../homepage/StoryIcon.astro";
import { barberProblems, barberWorkflow, barberFeatures } from "../../data/barbersIndustry";
---
<section class="ib-section ib-shell" aria-labelledby="barber-realities"><header class="ib-heading"><p>The realities of the shop floor</p><h2 id="barber-realities">Shears in one hand, comb in the other. Your phone should work for you.</h2><span>Small moments around the chair decide whether a new enquiry becomes a regular customer.</span></header><div class="ib-card-grid">{barberProblems.map((item)=><article><i><StoryIcon name={item.icon} /></i><h3>{item.title}</h3><p>{item.body}</p><footer>{item.note}</footer></article>)}</div></section>
<section class="ib-workflow" id="barber-workflow" aria-labelledby="barber-workflow-title"><div class="ib-shell"><header class="ib-heading"><p>The connected chair loop</p><h2 id="barber-workflow-title">How Chakusa protects your chairs, schedule, and customer relationships.</h2></header><div class="ib-workflow__grid"><div class="ib-workflow__steps">{barberWorkflow.map((item,index)=><article><span>{String(index+1).padStart(2,"0")}</span><i><StoryIcon name={item.icon} /></i><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div><div class="ib-scene ib-scene--workflow" aria-label="Animated illustration of a shop owner reviewing the working day"><div class="ib-scene__grid"></div><div class="ib-scene__halo"></div><TradeCharacterAlt class="ib-scene__character" /><aside class="ib-scene__booking"><StoryIcon name="task_alt" /><span><small>Customer journey</small><strong>Enquiry to return visit</strong></span><b>SYNCED</b></aside></div></div></div></section>
<section class="ib-section ib-shell" aria-labelledby="barber-features"><header class="ib-heading"><p>Features that matter</p><h2 id="barber-features">Built around the working rhythm of a barbershop.</h2></header><div class="ib-feature-grid">{barberFeatures.map((item)=><article><i><StoryIcon name={item.icon} /></i><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></section>
