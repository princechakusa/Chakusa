---
import TradeCycler from "../motion/TradeCycler.astro";
import { barberStories } from "../../data/barbersIndustry";
const items = barberStories.map((story) => ({ title: story.title, parts: [["The situation", story.situation], ["What Chakusa does", story.action], ["Practical result", story.result]] as [string, string][] }));
---
<TradeCycler id="barber-cases" kicker="Practical use cases" title="Real situations on the barber floor." href={null} {items} />
