---
import IndustrySubnav from "./IndustrySubnav.astro";
import TradeCharacterAlt from "../homepage/TradeCharacterAlt.astro";
import TradeCharacter from "../homepage/TradeCharacter.astro";
import StoryIcon from "../homepage/StoryIcon.astro";
import SpaScene from "./SpaScene.astro";
import ElectricianScene from "./ElectricianScene.astro";
import TradeObjectScene from "./TradeObjectScene.astro";
import TradeCycler from "../motion/TradeCycler.astro";
import "../../styles/industries/industry-motion.css";
import type { BeautyVertical } from "../../data/beautyVerticals";
interface Props { vertical: BeautyVertical; visual: "woman" | "man" | "spa" | "electrical" | "carwash" | "mechanic" | "photographer" | "mover" | "restaurant" | "contractor" }
const { vertical, visual } = Astro.props;
---
<IndustrySubnav activeHref={`/industries/${vertical.id}`} />
<section class="ib-hero beauty-vertical-hero"><div class="ib-shell ib-hero__grid"><div class="ib-hero__copy"><p class="ib-kicker">{vertical.kicker}</p><h1>{vertical.headline}</h1><p class="ib-lede">{vertical.intro}</p><div class="ib-actions"><a class="ui-button ui-button--primary" href="/get-started">Start free trial <StoryIcon name="arrow_forward" /></a><a class="ui-button ui-button--secondary" href={`#${vertical.id}-workflow`}>See how Chakusa works</a></div><p class="ib-proof">First 14 days free. Choose the plan that fits your business.</p><dl class="ib-metrics">{vertical.metrics.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div><div class="ib-scene ib-scene--flat" aria-label={`Animated flat illustration for ${vertical.label}`}>{visual === "woman" ? <><div class="ib-scene__halo"></div><TradeCharacterAlt class="ib-scene__character" /></> : visual === "man" ? <><div class="ib-scene__halo"></div><TradeCharacter class="ib-scene__character" /></> : visual === "electrical" ? <ElectricianScene /> : visual === "spa" ? <SpaScene /> : <TradeObjectScene kind={visual} />}</div></div></section>
<section class="ib-section ib-shell ivp-reality" aria-labelledby={`${vertical.id}-realities`}><header class="ib-heading"><p>The working reality</p><h2 id={`${vertical.id}-realities`}>{vertical.realitiesTitle}</h2><span>{vertical.realitiesIntro}</span></header><div class="ivp-fixes" data-stagger>{vertical.problems.map((item)=><article data-tilt="5"><i><StoryIcon name={item.icon}/></i><h3>{item.title}</h3><p>{item.body}</p><footer><span aria-hidden="true">→</span>{item.note}</footer></article>)}</div></section>
<section class="ib-workflow ivp-flow" id={`${vertical.id}-workflow`}><div class="ib-shell"><header class="ib-heading"><p>The connected journey</p><h2>{vertical.workflowTitle}</h2></header><ol class="ivp-flow__line" data-scroll-progress style={`--count:${vertical.workflow.length}`}>{vertical.workflow.map((item,index)=><li style={`--i:${index}`}><span class="ivp-flow__dot"><StoryIcon name={item.icon}/></span><strong>{item.title}</strong><p>{item.body}</p></li>)}</ol></div></section>
<slot name="showcase" />
<section class="ib-section ib-shell ivp-features"><header class="ib-heading"><p>Features that matter</p><h2>{vertical.featuresTitle}</h2></header><div class="ivp-feature-grid" data-stagger>{vertical.features.map((item)=><article><i><StoryIcon name={item.icon}/></i><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></section>
<TradeCycler id={`${vertical.id}-cases`} kicker="Practical use cases" title={vertical.storiesTitle} href={null} items={vertical.stories.map((story)=>({ title: story.title, parts: [["The situation", story.situation],["What Chakusa does", story.action],["Practical result", story.result]] }))} />
<section class="ib-faq ib-shell"><header class="ib-heading"><p>Common questions</p><h2>Frequently asked questions.</h2></header><div class="faq-columns">{vertical.faqs.map((item)=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
<section class="ib-cta"><div class="ib-shell"><p>Ready when you are</p><h2>{vertical.cta}</h2><span>{vertical.ctaSupport}</span><ul class="ivp-reasons">{vertical.reasons.map((reason)=><li>{reason}</li>)}</ul><div><a class="ui-button ui-button--primary" href="/get-started">Start free trial</a><a class="ui-button ui-button--secondary" href="/pricing">View pricing</a></div><small>First 14 days free. Choose the plan that fits your business.</small></div></section>