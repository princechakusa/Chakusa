---
import IndustrySubnav from "./IndustrySubnav.astro";
import TradeCharacterAlt from "../homepage/TradeCharacterAlt.astro";
import TradeCharacter from "../homepage/TradeCharacter.astro";
import StoryIcon from "../homepage/StoryIcon.astro";
import SpaScene from "./SpaScene.astro";
import ElectricianScene from "./ElectricianScene.astro";
import type { BeautyVertical } from "../../data/beautyVerticals";
interface Props { vertical: BeautyVertical; visual: "woman" | "man" | "spa" | "electrical" }
const { vertical, visual } = Astro.props;
---
<IndustrySubnav activeHref={`/industries/${vertical.id}`} />
<section class="ib-hero beauty-vertical-hero"><div class="ib-shell ib-hero__grid"><div class="ib-hero__copy"><p class="ib-kicker">{vertical.kicker}</p><h1>{vertical.headline}</h1><p class="ib-lede">{vertical.intro}</p><div class="ib-actions"><a class="ui-button ui-button--primary" href="/get-started">Start free trial <StoryIcon name="arrow_forward" /></a><a class="ui-button ui-button--secondary" href={`#${vertical.id}-workflow`}>See how Chakusa works</a></div><p class="ib-proof">First 14 days free. Choose the plan that fits your business.</p><dl class="ib-metrics">{vertical.metrics.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div><div class="ib-scene ib-scene--flat" aria-label={`Animated flat illustration for ${vertical.label}`}>{visual === "woman" ? <><div class="ib-scene__halo"></div><TradeCharacterAlt class="ib-scene__character" /></> : visual === "man" ? <><div class="ib-scene__halo"></div><TradeCharacter class="ib-scene__character" /></> : visual === "electrical" ? <ElectricianScene /> : <SpaScene />}</div></div></section>
<section class="ib-section ib-shell" aria-labelledby={`${vertical.id}-realities`}><header class="ib-heading"><p>The working reality</p><h2 id={`${vertical.id}-realities`}>{vertical.realitiesTitle}</h2><span>{vertical.realitiesIntro}</span></header><div class="ib-card-grid">{vertical.problems.map((item)=><article><i><StoryIcon name={item.icon}/></i><h3>{item.title}</h3><p>{item.body}</p><footer>{item.note}</footer></article>)}</div></section>
<section class="ib-workflow" id={`${vertical.id}-workflow`}><div class="ib-shell"><header class="ib-heading"><p>The connected journey</p><h2>{vertical.workflowTitle}</h2></header><div class="ib-workflow__steps ib-workflow__steps--wide">{vertical.workflow.map((item,index)=><article><span>{String(index+1).padStart(2,"0")}</span><i><StoryIcon name={item.icon}/></i><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></div></section>
<slot name="showcase" />
<section class="ib-section ib-shell"><header class="ib-heading"><p>Features that matter</p><h2>{vertical.featuresTitle}</h2></header><div class="ib-feature-grid">{vertical.features.map((item)=><article><i><StoryIcon name={item.icon}/></i><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></section>
<section class="ib-stories"><div class="ib-shell"><header class="ib-heading"><p>Practical use cases</p><h2>{vertical.storiesTitle}</h2></header><div class="ib-stories__list">{vertical.stories.map((story)=><article><div><span>Case study {story.number}</span><h3>{story.title}</h3><p>{story.situation}</p></div><div><strong>What Chakusa does</strong><p>{story.action}</p></div><div><strong>Practical result</strong><p>{story.result}</p></div></article>)}</div></div></section>
<section class="ib-ownership"><div class="ib-shell"><div><p>Why businesses choose Chakusa</p><h2>Stay in control of every customer relationship.</h2><span>Chakusa supports the operating journey while the business remains responsible for professional decisions and communication.</span><ul>{vertical.reasons.map((reason)=><li>{reason}</li>)}</ul></div></div></section>
<section class="ib-faq ib-shell"><header class="ib-heading"><p>Common questions</p><h2>Frequently asked questions.</h2></header><div>{vertical.faqs.map((item)=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
<section class="ib-cta"><div class="ib-shell"><p>Ready when you are</p><h2>{vertical.cta}</h2><span>{vertical.ctaSupport}</span><div><a class="ui-button ui-button--primary" href="/get-started">Start free trial</a><a class="ui-button ui-button--secondary" href="/pricing">View pricing</a></div><small>First 14 days free. Choose the plan that fits your business.</small></div></section>
