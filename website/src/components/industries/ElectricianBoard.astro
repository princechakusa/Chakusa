---
const jobs=[
  {time:"08:30",title:"EV charger site assessment",status:"Site visit",tone:"teal"},
  {time:"11:15",title:"Service panel upgrade consultation",status:"Confirmed",tone:"coral"},
  {time:"14:40",title:"Kitchen remodel rough-in inspection",status:"Follow-up",tone:"teal"},
];
---
<section class="electrician-board" aria-labelledby="electrician-board-title"><div class="ib-shell"><header class="ib-heading"><p>The electrician's operational board</p><h2 id="electrician-board-title">Today’s electrical service run.</h2><span>A clear working view of customer requests and agreed appointments, not an autonomous dispatch or diagnostic system.</span></header><div class="electrician-board__panel">{jobs.map((job,index)=><article><span>{job.time}</span><i class:list={[`electrician-board__number`, `is-${job.tone}`]}>{String(index+1).padStart(2,"0")}</i><div><strong>{job.title}</strong><small>Customer and site context attached</small></div><b>{job.status}</b></article>)}</div></div></section>
