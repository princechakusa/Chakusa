---
import TradeCycler from "../motion/TradeCycler.astro";
import "../../styles/industries/industry-motion.css";
import StoryIcon from "../homepage/StoryIcon.astro";
import { salonProblems, salonWorkflow, salonFeatures, salonStories, salonFaqs } from "../../data/hairSalonsIndustry";
---
<section class="ib-section ib-shell ivp-reality" aria-labelledby="salon-realities"><header class="ib-heading"><p>The realities of a busy salon</p><h2 id="salon-realities">Hands with a client. Appointments still need attention.</h2><span>Small moments around every chair decide whether a new enquiry becomes a returning client.</span></header><div class="ivp-fixes" data-stagger>{salonProblems.map((item)=><article data-tilt="5"><i><StoryIcon name={item.icon} /></i><h3>{item.title}</h3><p>{item.body}</p><footer><span aria-hidden="true">→</span>{item.note}</footer></article>)}</div></section>
<section class="ib-workflow ivp-flow" id="salon-workflow" aria-labelledby="salon-workflow-title"><div class="ib-shell"><header class="ib-heading"><p>The connected salon loop</p><h2 id="salon-workflow-title">How Chakusa connects the first enquiry to the next visit.</h2></header><ol class="ivp-flow__line" data-scroll-progress style={`--count:${salonWorkflow.length}`}>{salonWorkflow.map((item,index)=><li style={`--i:${index}`}><span class="ivp-flow__dot"><StoryIcon name={item.icon} /></span><strong>{item.title}</strong><p>{item.body}</p></li>)}</ol></div></div></section>
<section class="ib-section ib-shell ivp-features" aria-labelledby="salon-features"><header class="ib-heading"><p>Features that matter</p><h2 id="salon-features">Built around the working rhythm of a salon.</h2></header><div class="ivp-feature-grid" data-stagger>{salonFeatures.map((item)=><article><i><StoryIcon name={item.icon} /></i><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></section>
<TradeCycler id="salon-cases" kicker="Practical use cases" title="Real situations around the salon floor." href={null} items={salonStories.map((story)=>({ title: story.title, parts: [["The situation", story.situation],["What Chakusa does", story.action],["Practical result", story.result]] as [string, string][] }))} />
<section class="ib-faq ib-shell" aria-labelledby="salon-faq"><header class="ib-heading"><p>Common questions</p><h2 id="salon-faq">Frequently asked by salon owners and teams.</h2></header><div class="faq-columns">{salonFaqs.map((item)=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
<section class="ib-cta"><div class="ib-shell"><p>Built for busy chairs</p><h2>Keep every enquiry, appointment, and return visit connected.</h2><span>Set up your salon, connect the client journey, and keep the next action visible.</span><div><a class="ui-button ui-button--primary" href="/get-started">Start free trial</a><a class="ui-button ui-button--secondary" href="/pricing">View pricing</a></div><small>First 14 days free. Choose the plan that fits your business.</small></div></section>
