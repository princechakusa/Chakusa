---
import TradeCharacterAlt from "../homepage/TradeCharacterAlt.astro";
import StoryIcon from "../homepage/StoryIcon.astro";
import { salonProblems, salonWorkflow, salonFeatures, salonStories, salonFaqs } from "../../data/hairSalonsIndustry";
---
<section class="ib-section ib-shell" aria-labelledby="salon-realities"><header class="ib-heading"><p>The realities of a busy salon</p><h2 id="salon-realities">Hands with a client. Appointments still need attention.</h2><span>Small moments around every chair decide whether a new enquiry becomes a returning client.</span></header><div class="ib-card-grid">{salonProblems.map((item)=><article><i><StoryIcon name={item.icon} /></i><h3>{item.title}</h3><p>{item.body}</p><footer>{item.note}</footer></article>)}</div></section>
<section class="ib-workflow" id="salon-workflow" aria-labelledby="salon-workflow-title"><div class="ib-shell"><header class="ib-heading"><p>The connected salon loop</p><h2 id="salon-workflow-title">How Chakusa connects the first enquiry to the next visit.</h2></header><div class="ib-workflow__grid"><div class="ib-workflow__steps">{salonWorkflow.map((item,index)=><article><span>{String(index+1).padStart(2,"0")}</span><i><StoryIcon name={item.icon} /></i><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div><div class="ib-scene ib-scene--workflow ib-scene--flat" aria-label="Animated flat illustration of a salon owner reviewing the working day"><div class="ib-scene__halo"></div><TradeCharacterAlt class="ib-scene__character" /></div></div></div></section>
<section class="ib-section ib-shell" aria-labelledby="salon-features"><header class="ib-heading"><p>Features that matter</p><h2 id="salon-features">Built around the working rhythm of a salon.</h2></header><div class="ib-feature-grid">{salonFeatures.map((item)=><article><i><StoryIcon name={item.icon} /></i><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></section>
<section class="ib-stories"><div class="ib-shell"><header class="ib-heading"><p>Practical use cases</p><h2>Real situations around the salon floor.</h2></header><div class="ib-stories__list">{salonStories.map((story)=><article><div><span>Case study {story.number}</span><h3>{story.title}</h3><p>{story.situation}</p></div><div><strong>What Chakusa does</strong><p>{story.action}</p></div><div><strong>Practical result</strong><p>{story.result}</p></div></article>)}</div></div></section>
<section class="ib-ownership"><div class="ib-shell"><div><p>Built for hands at work</p><h2>Your clients belong to your salon.</h2><span>Chakusa gives the business one connected place for customer relationships without turning the workday into admin.</span><ul><li>Direct customer relationships</li><li>Exportable business records</li><li>Clear team access</li><li>No marketplace commission on bookings</li></ul></div></div></section>
<section class="ib-faq ib-shell" aria-labelledby="salon-faq"><header class="ib-heading"><p>Common questions</p><h2 id="salon-faq">Frequently asked by salon owners and teams.</h2></header><div>{salonFaqs.map((item)=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
<section class="ib-cta"><div class="ib-shell"><p>Built for busy chairs</p><h2>Keep every enquiry, appointment, and return visit connected.</h2><span>Set up your salon, connect the client journey, and keep the next action visible.</span><div><a class="ui-button ui-button--primary" href="/get-started">Start free trial</a><a class="ui-button ui-button--secondary" href="/pricing">View pricing</a></div><small>First 14 days free. Choose the plan that fits your business.</small></div></section>
