---
interface Props { kind: "carwash" | "mechanic" | "photographer" | "mover" | "restaurant" | "contractor" }
const { kind } = Astro.props;
---
{kind === "carwash" && <svg class="trade-object-scene" viewBox="0 0 360 340" role="img" aria-label="Animated flat illustration of a car in a wash bay"><circle class="tos-halo" cx="180" cy="145" r="116"/><path class="tos-car" d="M55 224h25l24-58h151l27 58h23c18 0 30 13 30 30v40H25v-40c0-17 12-30 30-30Z"/><path class="tos-window" d="m119 179-17 45h160l-21-45Z"/><circle class="tos-wheel" cx="91" cy="294" r="25"/><circle class="tos-wheel" cx="272" cy="294" r="25"/><g class="tos-water"><path d="M78 77c-19 25-22 39-7 46 17 7 28-13 7-46ZM282 58c-17 23-20 35-6 42 15 6 25-12 6-42ZM226 91c-15 20-17 31-5 36 13 6 22-10 5-36Z"/></g><path class="tos-brush" d="M38 129h54v92H38zM268 129h54v92h-54z"/> </svg>}
{kind === "mechanic" && <svg class="trade-object-scene" viewBox="0 0 360 340" role="img" aria-label="Animated flat illustration of a vehicle on a workshop lift"><circle class="tos-halo" cx="180" cy="145" r="116"/><path class="tos-lift" d="M50 272h260v22H50zM65 160h20v112H65zM275 160h20v112h-20z"/><path class="tos-car" d="M65 184h28l22-48h135l24 48h24c15 0 25 11 25 25v35H40v-35c0-14 10-25 25-25Z"/><path class="tos-window" d="m127 149-15 35h139l-17-35Z"/><circle class="tos-wheel" cx="98" cy="244" r="23"/><circle class="tos-wheel" cx="267" cy="244" r="23"/><path class="tos-wrench" d="M245 48c-15 2-26 14-27 29l-72 72 25 25 72-72c15-1 27-12 29-27l-17 10-20-20Z"/></svg>}
{kind === "photographer" && <svg class="trade-object-scene" viewBox="0 0 360 340" role="img" aria-label="Animated flat illustration of a professional camera and studio light"><circle class="tos-halo" cx="180" cy="145" r="116"/><path class="tos-camera" d="M58 128h66l18-27h76l18 27h66v133H58Z"/><circle class="tos-lens" cx="180" cy="194" r="58"/><circle class="tos-lens-inner" cx="180" cy="194" r="35"/><path class="tos-tripod" d="M180 252v45m0-21-46 45m46-45 46 45"/><path class="tos-flash" d="M253 80h55v34h-55zM280 114v31"/><circle class="tos-spark" cx="280" cy="67" r="18"/></svg>}
{kind === "mover" && <svg class="trade-object-scene" viewBox="0 0 360 340" role="img" aria-label="Animated flat illustration of a moving truck carrying labelled-free boxes"><circle class="tos-halo" cx="180" cy="145" r="116"/><g class="tos-motion"><path d="M20 112h70M10 145h55M31 178h46"/></g><path class="tos-truck-box" d="M66 95h170v153H66z"/><path class="tos-truck-cab" d="M236 154h55l41 45v49h-96z"/><path class="tos-window" d="M254 168h29l29 31h-58z"/><path class="tos-bumper" d="M50 238h282v18H50z"/><circle class="tos-wheel" cx="113" cy="260" r="27"/><circle class="tos-wheel" cx="278" cy="260" r="27"/><g class="tos-boxes"><path d="M92 128h54v45H92zM151 139h54v45h-54zM111 178h64v50h-64z"/><path d="M119 128v45m59-34v45m-35-6v50"/></g></svg>}
{kind === "restaurant" && <svg class="trade-object-scene" viewBox="0 0 360 340" role="img" aria-label="Animated flat illustration of a restaurant table setting with serving cloche"><circle class="tos-halo" cx="180" cy="145" r="116"/><circle class="tos-plate" cx="180" cy="194" r="86"/><circle class="tos-plate-inner" cx="180" cy="194" r="58"/><path class="tos-cloche" d="M126 194c2-42 25-67 54-67s52 25 54 67Z"/><path class="tos-cloche-handle" d="M164 124c0-13 7-22 16-22s16 9 16 22"/><path class="tos-cutlery" d="M71 99v190m-15-190v54c0 17 30 17 30 0V99m203 0v190m0-190c-24 17-29 55 0 71"/><g class="tos-steam"><path d="M145 90c-13-14 12-25 0-40M181 82c-13-14 12-25 0-40M217 90c-13-14 12-25 0-40"/></g></svg>}
{kind === "contractor" && <svg class="trade-object-scene" viewBox="0 0 360 340" role="img" aria-label="Animated flat illustration of a small contractor jobsite with house frame, hard hat, and hammer"><circle class="tos-halo" cx="180" cy="145" r="116"/><path class="tos-house" d="m58 179 122-96 122 96v117H58z"/><path class="tos-house-cutout" d="M88 180v86h184v-86l-92-72z"/><path class="tos-beam" d="M169 111h22v155h-22zM88 172h184v21H88z"/><path class="tos-helmet" d="M96 92c2-35 22-57 52-57s50 22 52 57h14v20H82V92Z"/><path class="tos-hammer" d="m239 63 64 64-19 19-64-64zM275 48l47 47-24 24-47-47z"/><g class="tos-sparks"><path d="m307 151 22 12m-27 5 12 22m-28-16-5 24"/></g></svg>}
