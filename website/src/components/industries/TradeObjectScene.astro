---
interface Props { kind: "carwash" | "mechanic" | "photographer" }
const { kind } = Astro.props;
---
{kind === "carwash" && <svg class="trade-object-scene" viewBox="0 0 360 340" role="img" aria-label="Animated flat illustration of a car in a wash bay"><circle class="tos-halo" cx="180" cy="145" r="116"/><path class="tos-car" d="M55 224h25l24-58h151l27 58h23c18 0 30 13 30 30v40H25v-40c0-17 12-30 30-30Z"/><path class="tos-window" d="m119 179-17 45h160l-21-45Z"/><circle class="tos-wheel" cx="91" cy="294" r="25"/><circle class="tos-wheel" cx="272" cy="294" r="25"/><g class="tos-water"><path d="M78 77c-19 25-22 39-7 46 17 7 28-13 7-46ZM282 58c-17 23-20 35-6 42 15 6 25-12 6-42ZM226 91c-15 20-17 31-5 36 13 6 22-10 5-36Z"/></g><path class="tos-brush" d="M38 129h54v92H38zM268 129h54v92h-54z"/> </svg>}
{kind === "mechanic" && <svg class="trade-object-scene" viewBox="0 0 360 340" role="img" aria-label="Animated flat illustration of a vehicle on a workshop lift"><circle class="tos-halo" cx="180" cy="145" r="116"/><path class="tos-lift" d="M50 272h260v22H50zM65 160h20v112H65zM275 160h20v112h-20z"/><path class="tos-car" d="M65 184h28l22-48h135l24 48h24c15 0 25 11 25 25v35H40v-35c0-14 10-25 25-25Z"/><path class="tos-window" d="m127 149-15 35h139l-17-35Z"/><circle class="tos-wheel" cx="98" cy="244" r="23"/><circle class="tos-wheel" cx="267" cy="244" r="23"/><path class="tos-wrench" d="M245 48c-15 2-26 14-27 29l-72 72 25 25 72-72c15-1 27-12 29-27l-17 10-20-20Z"/></svg>}
{kind === "photographer" && <svg class="trade-object-scene" viewBox="0 0 360 340" role="img" aria-label="Animated flat illustration of a professional camera and studio light"><circle class="tos-halo" cx="180" cy="145" r="116"/><path class="tos-camera" d="M58 128h66l18-27h76l18 27h66v133H58Z"/><circle class="tos-lens" cx="180" cy="194" r="58"/><circle class="tos-lens-inner" cx="180" cy="194" r="35"/><path class="tos-tripod" d="M180 252v45m0-21-46 45m46-45 46 45"/><path class="tos-flash" d="M253 80h55v34h-55zM280 114v31"/><circle class="tos-spark" cx="280" cy="67" r="18"/></svg>}
