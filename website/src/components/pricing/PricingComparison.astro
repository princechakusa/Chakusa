---
// Categorized comparison table. Each cell is tagged with the API limit or
// feature it shows (data-limit / data-feature) and filled from GET /plans by
// scripts/planFeatures.ts, so it is always what the server enforces. The text
// below is only the fallback until that loads, matching the API's defaults.
type Row = { label: string; limit?: string; feature?: string; starter: string; pro: string; business: string };
const groups: Array<{ title: string; rows: Row[] }> = [
  {
    title: "Booking & scheduling",
    rows: [
      { label: "Customers", limit: "customers", starter: "1,000", pro: "Unlimited", business: "Unlimited" },
      { label: "Open reminders", limit: "openReminders", starter: "150", pro: "Unlimited", business: "Unlimited" },
      { label: "Team seats", limit: "staffSeats", starter: "1", pro: "1", business: "Up to 10" },
      { label: "Team management (roles & invitations)", feature: "TEAM_MANAGEMENT", starter: "No", pro: "No", business: "Yes" },
    ],
  },
  {
    title: "Customer relationship & records",
    rows: [
      { label: "Custom templates per type", limit: "customTemplatesPerType", starter: "3", pro: "Unlimited", business: "Unlimited" },
      { label: "Extended activity history", feature: "EXTENDED_HISTORY", starter: "Yes", pro: "Yes", business: "Yes" },
      { label: "Advanced analytics", feature: "ADVANCED_ANALYTICS", starter: "No", pro: "Yes", business: "Yes" },
    ],
  },
  {
    title: "Lead recovery & automation",
    rows: [
      { label: "Leads per month", limit: "leadsPerMonth", starter: "150", pro: "Unlimited", business: "Unlimited" },
      { label: "Automation (follow-ups, win-back)", feature: "AUTOMATION", starter: "No", pro: "Yes", business: "Yes" },
      { label: "Send messages directly through Chakusa", feature: "OUTBOUND_MESSAGING", starter: "No", pro: "Yes", business: "Yes" },
    ],
  },
  {
    title: "Reviews & trust",
    rows: [
      { label: "Review requests per month", limit: "reviewRequestsPerMonth", starter: "150", pro: "Unlimited", business: "Unlimited" },
    ],
  },
];
---
<section class="pr-compare" aria-labelledby="pricing-compare-title"><div class="pr-shell"><div class="pr-heading pr-heading--center"><p class="pr-label">Granular breakdown</p><h2 id="pricing-compare-title">Compare plan capabilities, side by side.</h2><p>Every limit comes straight from the plan rules in the app.</p></div><details class="pr-compare__toggle"><summary><span>Compare every feature</span><i aria-hidden="true"></i></summary><div class="pr-compare__wrap"><table class="pr-compare__table"><thead><tr><th scope="col">Feature</th><th scope="col">Starter</th><th scope="col">Pro</th><th scope="col">Business</th></tr></thead>{groups.map((group, i) => <tbody><tr class="pr-compare__group"><th scope="colgroup" colspan="4">{i + 1}. {group.title}</th></tr>{group.rows.map((row) => <tr><th scope="row">{row.label}</th>{(["STARTER", "PRO", "BUSINESS"] as const).map((plan) => <td data-plan={plan} data-limit={row.limit} data-feature={row.feature}>{plan === "STARTER" ? row.starter : plan === "PRO" ? row.pro : row.business}</td>)}</tr>)}</tbody>)}</table></div></details></div></section>
