---
import FaqSchema from "../FaqSchema.astro";
const faqs = [
  { question: "How does billing work?", answer: "Pro and Business are billed as a native subscription through the App Store or Google Play, not a separate web checkout. The price shown on this page is directional, and the store's localized price is always the final one." },
  { question: "What happens if I go over my Free plan limits?", answer: "You'll be prompted to upgrade to Pro to add more. Nothing you've already tracked is ever deleted or hidden." },
  { question: "Is Business pricing available yet?", answer: "Not yet. Business tier pricing hasn't been finalized. Reach out and we'll follow up once it is." },
];
---
<section class="pr-faq" aria-labelledby="pricing-faq-title"><div class="pr-shell"><div class="pr-heading"><p class="pr-label">Questions</p><h2 id="pricing-faq-title">Billing, answered.</h2></div><div class="pr-faq__list">{faqs.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div><FaqSchema items={faqs}/></section>
