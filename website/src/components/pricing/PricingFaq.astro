---
import FaqSchema from "../FaqSchema.astro";
const faqs = [
  { question: "How does the free trial work?", answer: "Starter starts with a free trial, shown on its plan card above. After the trial it renews at the Starter monthly price unless you cancel. You can cancel anytime during or after the trial." },
  { question: "How does billing work?", answer: "Every plan is billed as a native subscription through the App Store or Google Play, not a separate web checkout. The price on this page is the monthly base price, and your store shows the final price in your local currency before you confirm." },
  { question: "What happens if I reach my plan limits?", answer: "You'll be offered the next plan up to add more. Nothing you've already tracked is ever deleted or hidden." },
];
---
<section class="pr-faq" aria-labelledby="pricing-faq-title"><div class="pr-shell"><div class="pr-heading pr-heading--center"><p class="pr-label">Common inquiries</p><h2 id="pricing-faq-title">Frequently asked questions.</h2><p>Everything you need to know about billing, client data rights, and operational onboarding.</p></div><div class="pr-faq__list">{faqs.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div><FaqSchema items={faqs}/></section>
