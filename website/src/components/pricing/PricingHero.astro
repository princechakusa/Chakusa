import PricingIcon from "./PricingIcon.astro";
---
<section class="pr-hero" aria-labelledby="pricing-title"><div class="pr-shell pr-hero__inner"><p class="pr-badge">Transparent, predictable pricing</p><h1 id="pricing-title">Straightforward pricing built to grow with your craft.</h1><p>No hidden booking fees, no customer surcharges, and no hostage client databases. Choose the tier that fits how your business works, with transparent terms and full data ownership.</p><ul class="pr-hero__trust"><li><PricingIcon name="shield" class="pr-hero__trust-icon"/>Cancel anytime</li><li><PricingIcon name="csvexport" class="pr-hero__trust-icon"/>Your data, exportable anytime</li></ul></div></section>
