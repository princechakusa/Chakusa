---
import Button from "../foundation/Button.astro";
import PricingIcon from "./PricingIcon.astro";
import { pricingTiers } from "../../data/pricing";
// Mirrors Stitch's 3-value-prop strip below the plan cards. Real facts
// (data export, no rating-based review filtering, no store markup),
// not Stitch's specific "100%"/"Zero" framed claims about fees never
// confirmed to exist.
const valueProps = [
  { icon: "csvexport", title: "Your data, exportable", body: "CSV export, anytime, no lock-in." },
  { icon: "shield", title: "No hidden tiers", body: "Every plan's limits are listed here, in full." },
  { icon: "check", title: "Cancel anytime", body: "No long-term contract, on any plan." },
];
// Stitch's per-card eyebrow ("Solo Artisan Tier," "Studio / Shop Tier,
// High Capacity," "Build & Franchise Tier, Multi-Location") sits above
// the card, outside its border, distinct from the "Most Popular" badge
// on the featured card. Reproduced here with real Chakusa framing.
const eyebrows: Record<string, string> = {
  Starter: "For independent operators",
  Pro: "For growing businesses",
  Business: "For teams with more than one person",
};
---
<section class="pr-plans" id="plans" aria-labelledby="pricing-plans-title"><div class="pr-shell"><h2 class="visually-hidden" id="pricing-plans-title">Plans</h2><div class="pr-plans__grid">{pricingTiers.map((tier) => <div class="pr-plan__col"><p class:list={["pr-plan__eyebrow", tier.featured && "pr-plan__eyebrow--featured"]}>{tier.featured ? "Most popular" : eyebrows[tier.name]}</p><div class:list={["pr-plan", tier.featured && "pr-plan--featured"]}><strong>{tier.name}</strong><p class="pr-plan__tagline">{tier.tagline}</p><p class="pr-plan__price">{tier.price}</p>{tier.priceNote && <p class="pr-plan__note">{tier.priceNote}</p>}<p class="pr-plan__included">Included:</p><ul>{tier.features.map((feature) => <li><PricingIcon name="check"/>{feature}</li>)}</ul><Button href={tier.ctaHref} variant={tier.featured ? "primary" : "secondary"}>{tier.ctaLabel}</Button></div></div>)}</div><div class="pr-valueprops">{valueProps.map((item) => <div><PricingIcon name={item.icon}/><div><strong>{item.title}</strong><p>{item.body}</p></div></div>)}</div></div></section>
