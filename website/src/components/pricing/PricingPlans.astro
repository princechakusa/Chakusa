---
import Button from "../foundation/Button.astro";
import PricingIcon from "./PricingIcon.astro";
import { pricingTiers } from "../../data/pricing";
import { PRICING_FALLBACK } from "../../data/pricingDefaults";
import TrialDays from "./TrialDays.astro";
// Mirrors Stitch's 3-value-prop strip below the plan cards. Real facts
// (data export, no rating-based review filtering, no store markup),
// not Stitch's specific "100%"/"Zero" framed claims about fees never
// confirmed to exist.
const valueProps = [
  { icon: "csvexport", title: "Your data, exportable", body: "CSV export, anytime, no lock-in." },
  { icon: "shield", title: "No hidden tiers", body: "Every plan's limits are listed here, in full." },
  { icon: "check", title: "Cancel anytime", body: "No long-term contract, on any plan." },
];
---
<section class="pr-plans" id="plans" aria-labelledby="pricing-plans-title"><div class="pr-shell">
  <h2 class="visually-hidden" id="pricing-plans-title">Plans</h2>
  <div class="pr-billing-toggle" role="group" aria-label="Billing frequency">
    <button type="button" class="is-active" aria-pressed="true">Monthly billing</button>
  </div>
  <p class="pr-billing-note"><PricingIcon name="shield"/>Monthly billing with clear plan limits</p>
  <div class="pr-plans__grid" data-stagger>{pricingTiers.map((tier) => <div class:list={["pr-plan", tier.featured && "pr-plan--featured"]} data-plan-card={tier.plan}>
    {tier.featured && <p class="pr-plan__badge"><PricingIcon name="check"/>Most popular</p>}
    <div class="pr-plan__head"><strong>{tier.name}</strong><span class="pr-plan__chip">{tier.chip}</span></div>
    <p class="pr-plan__tagline">{tier.tagline}</p>
    <p class="pr-plan__price"><span data-cfg-price={tier.plan}>{tier.price}</span><em>/ month</em></p>
    <p class="pr-plan__trial" data-cfg-trial-block={tier.plan} hidden={PRICING_FALLBACK.trialDays[tier.plan] === 0}><PricingIcon name="check"/><span><TrialDays plan={tier.plan} />-day free trial</span></p>
    {tier.priceNote && <p class="pr-plan__note">{tier.priceNote}</p>}
    <p class="pr-plan__included">{tier.includedLabel}</p>
    <ul data-plan-features={tier.plan}>{tier.features.map((feature) => <li><span class="pr-plan__check"><PricingIcon name="check"/></span>{feature}</li>)}</ul>
    <Button href={tier.ctaHref} variant={tier.featured ? "primary" : "secondary"}>{tier.ctaLabel}</Button>
    <p class="pr-plan__footnote">{tier.ctaFootnote}</p>
  </div>)}</div>
  <div class="pr-valueprops">{valueProps.map((item) => <div><PricingIcon name={item.icon}/><div><strong>{item.title}</strong><p>{item.body}</p></div></div>)}</div>
</div></section>
