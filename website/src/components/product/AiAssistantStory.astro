---
import { aiAssistant } from "../../data/product";
---
<section class="product-ai" id="ai-assistant" aria-labelledby="ai-title"><div class="container product-ai__grid"><div class="product-ai__copy"><p class="product-kicker product-kicker--light">{aiAssistant.eyebrow}</p><h2 id="ai-title">{aiAssistant.title}</h2><p>{aiAssistant.copy}</p></div><ul class="product-ai__list">{aiAssistant.features.map(feature => <li>{feature}</li>)}</ul></div></section>
