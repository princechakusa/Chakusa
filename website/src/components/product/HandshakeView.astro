---
// Mirrors Stitch's "dual-experience ecosystem" split-screen panel
// structure (Patron Mobile Experience / Artisan Hub Console) exactly,
// with one substitution: Stitch's panel used a named customer/business
// ("Liam Vance", "Marcus Webb", "$55.00", "+55 Pts Earned" loyalty
// points) presented as if real. No loyalty-points feature is confirmed
// to exist, so it's replaced with a plain "Illustrative example" label
// and generic content, same convention as every other feature page's
// illustrative panels.
import ProductIcon from "./ProductIcon.astro";
---
<section class="pd-handshake" aria-labelledby="pd-handshake-title"><div class="container pd-section-heading pd-section-heading--center"><p class="product-kicker product-kicker--light">Dual-experience ecosystem</p><h2 id="pd-handshake-title">The instant handshake between customer and business.</h2><p>An action on the customer side reaches the business side immediately.</p></div><div class="container pd-handshake__grid"><div class="pd-handshake__panel"><div class="pd-handshake__panel-head"><span class="pd-handshake__dot pd-handshake__dot--primary"></span><strong>Customer view</strong></div><div class="pd-handshake__sim"><div class="pd-handshake__sim-row"><strong>Example Barber Co.</strong><span class="pd-handshake__badge">4.9 &#9733;</span></div><p class="pd-handshake__meta"><ProductIcon name="storefront"/>Public profile &middot; Real reviews</p><div class="pd-handshake__card"><div class="pd-handshake__card-row"><span>Signature Cut &amp; Styling</span><b>$45</b></div><p>45 min</p></div><div class="pd-handshake__slots"><span class="is-selected">Today, 3:15 PM</span><span>Tomorrow, 10:00 AM</span></div><button class="pd-handshake__cta" type="button" tabindex="-1">Confirm booking</button></div><p class="pd-handshake__note">No account required to book.</p></div><div class="pd-handshake__panel pd-handshake__panel--dark"><div class="pd-handshake__panel-head"><span class="pd-handshake__dot pd-handshake__dot--secondary"></span><strong>Business view</strong></div><div class="pd-handshake__sim pd-handshake__sim--dark"><div class="pd-handshake__notif"><div class="pd-handshake__avatar">EB</div><div><strong>New booking received</strong><span>Just now</span></div></div><div class="pd-handshake__profile"><div class="pd-handshake__profile-head"><span>Customer profile</span><span>3 previous visits</span></div><div class="pd-handshake__profile-grid"><div><span>Notes</span><b>Prefers the 3pm slot</b></div><div><span>Preferences</span><b>SMS reminders</b></div></div></div><div class="pd-handshake__actions"><button type="button" tabindex="-1">Send confirmation</button><button type="button" class="is-primary" tabindex="-1">Check in</button></div></div><p class="pd-handshake__note">Ready before the customer walks in, no manual lookup.</p></div></div></section>
