---
import Button from "../foundation/Button.astro";
import ProductIcon from "./ProductIcon.astro";
---
<section class="pd-cta container" aria-labelledby="product-cta-title"><div class="pd-cta__panel"><span class="pd-cta__blob pd-cta__blob--a" aria-hidden="true"></span><span class="pd-cta__blob pd-cta__blob--b" aria-hidden="true"></span><div class="pd-cta__inner"><p class="pd-cta__badge"><ProductIcon name="task"/>No lock-in, your data stays yours</p><h2 id="product-cta-title">Ready to see the entire platform in action?</h2><p>Bring enquiries, bookings, reviews, and return visits into one connected system.</p><div class="pd-cta__actions"><Button href="/get-started">Start free</Button><Button href="/pricing" variant="secondary">See pricing</Button></div><p class="pd-cta__footnote">No credit card required.</p></div></div></section>
