import Button from "../foundation/Button.astro";
---
<section class="product-hero container" aria-labelledby="product-title"><div class="product-hero__copy"><p class="product-kicker">The complete Chakusa product</p><h1 id="product-title">From first enquiry to the next visit.</h1><p>Chakusa connects customer conversations, profiles, bookings, reminders, reviews, follow-ups, and business insight in one service-business platform.</p><div class="product-hero__actions"><Button href="/get-started">Start free</Button><Button href="#product-journey" variant="secondary">Follow the journey</Button></div></div><div class="product-hero__visual"><div class="product-hero__frame"><img src="/images/product/chakusa-dashboard.png" width="1170" height="2532" alt="Chakusa dashboard showing customer follow-up actions" fetchpriority="high" /></div><p>One focused view of what needs attention.</p></div></section>
