---
import Button from "../foundation/Button.astro";
import ProductIcon from "./ProductIcon.astro";
import ArchitectureBridge from "./ArchitectureBridge.astro";
import { productProof } from "../../data/product";
---
<section class="pd-hero container" aria-labelledby="product-title"><div class="pd-hero__top"><p class="pd-badge"><ProductIcon name="repeat"/>The unified local commerce platform</p><h1 id="product-title">One connected ecosystem. <span>From first discovery to lasting loyalty.</span></h1><p>Chakusa brings customer discovery, self-booking, lead recovery, and business operations under one connected system.</p><div class="product-hero__actions"><Button href="#engines">Explore the platform</Button><Button href="/how-it-works" variant="secondary">See how it works</Button></div><dl class="product-hero__proof">{productProof.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl></div><ArchitectureBridge/></section>
