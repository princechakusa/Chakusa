---
import ProductIcon from "./ProductIcon.astro";
import { productIndustryCards } from "../../data/product";
---
<section class="pd-industries container" aria-labelledby="pd-industries-title"><div class="pd-section-heading"><p class="product-kicker">Cross-sector architecture</p><h2 id="pd-industries-title">Built for hands-on work, not generic offices.</h2><p>Chakusa adapts to how each trade actually books, follows up, and brings customers back.</p></div><div class="pd-industries__grid">{productIndustryCards.map((item) => <article class="pd-industries__card"><div class="pd-industries__head"><ProductIcon name={item.icon}/><h3>{item.label}</h3></div><p>{item.body}</p><footer>{item.tag}<ProductIcon name="arrow-right" class="pd-industries__arrow"/></footer></article>)}</div><p><a href="/industries">See all supported industries <span aria-hidden="true">&rarr;</span></a></p></section>
