---
import ProductIcon from "./ProductIcon.astro";
import { productIndustryCards } from "../../data/product";
---
<section class="pd-industries container" aria-labelledby="pd-industries-title"><div class="pd-section-heading pd-section-heading--center"><p class="product-kicker">Made for local service businesses</p><h2 id="pd-industries-title">Built for hands-on work, not generic offices.</h2></div><div class="pd-industries__grid">{productIndustryCards.map((item, i) => <div class:list={["pd-industries__card", i % 2 === 1 && "pd-industries__card--alt"]}><ProductIcon name={item.icon}/><span>{item.label}</span></div>)}</div><p><a href="/industries">See all supported industries <span aria-hidden="true">&rarr;</span></a></p></section>
