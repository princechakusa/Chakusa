---
const product = { "@context":"https://schema.org", "@type":"Product", name:"Chakusa", category:"Business software", url:new URL("/product", Astro.site).toString(), brand:{ "@type":"Brand", name:"Chakusa" }, description:"Customer growth platform connecting enquiries, customer profiles, bookings, messaging, reviews, follow-ups, automation, and analytics for service businesses." };
const breadcrumb = { "@context":"https://schema.org", "@type":"BreadcrumbList", itemListElement:[{ "@type":"ListItem", position:1, name:"Home", item:String(Astro.site) },{ "@type":"ListItem", position:2, name:"Product", item:new URL("/product", Astro.site).toString() }] };
const faq = { "@context":"https://schema.org", "@type":"FAQPage", mainEntity:[{ "@type":"Question", name:"Is Chakusa only an AI receptionist?", acceptedAnswer:{ "@type":"Answer", text:"No. Assisted responses are one part of a broader platform connecting customer profiles, booking, messaging, reviews, follow-ups, automation, and analytics." } },{ "@type":"Question", name:"Can a team stay in control of automation?", acceptedAnswer:{ "@type":"Answer", text:"Yes. Chakusa supports human approval and business controls where a workflow or message needs review." } },{ "@type":"Question", name:"Is Chakusa built for service businesses?", acceptedAnswer:{ "@type":"Answer", text:"Yes. The product is designed around enquiries, appointments, visits, reviews, and repeat customer relationships." } }] };
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(product)} /><script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} /><script type="application/ld+json" is:inline set:html={JSON.stringify(faq)} />
