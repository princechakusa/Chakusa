---
import { productFaqs } from "../../data/product";
const product = { "@context":"https://schema.org", "@type":"Product", name:"Chakusa", category:"Business software", url:new URL("/product", Astro.site).toString(), brand:{ "@type":"Brand", name:"Chakusa" }, description:"Customer growth and business management platform connecting enquiries, customer profiles, bookings, messaging, reviews, follow-ups, automation, and analytics for local service businesses." };
const breadcrumb = { "@context":"https://schema.org", "@type":"BreadcrumbList", itemListElement:[{ "@type":"ListItem", position:1, name:"Home", item:String(Astro.site) },{ "@type":"ListItem", position:2, name:"Product", item:new URL("/product", Astro.site).toString() }] };
const faq = { "@context":"https://schema.org", "@type":"FAQPage", mainEntity: productFaqs.map(item => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) };
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(product)} /><script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} /><script type="application/ld+json" is:inline set:html={JSON.stringify(faq)} />
