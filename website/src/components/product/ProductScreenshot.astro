---
interface Props { src?: string | null; label: string; }
const { src, label } = Astro.props;
---
<div class:list={["product-screenshot", { "product-screenshot--pending": !src }]} data-production-asset={src ? "available" : "awaiting-production-screenshot"}>{src ? <img src={src} width="1170" height="2532" alt={`Chakusa ${label} product screen`} loading="lazy" /> : <div class="product-screenshot__pending" aria-label={`${label} screenshot awaiting production capture`}><span>Chakusa product</span><strong>{label}</strong><small>Production capture in preparation</small></div>}</div>
