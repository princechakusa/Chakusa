---
import ProductIcon from "./ProductIcon.astro";
import { productStories, productStoryIcons } from "../../data/product";
---
<section class="pd-engines container" id="engines" aria-labelledby="pd-engines-title"><div class="pd-section-heading pd-section-heading--center"><p class="product-kicker">Six connected engines</p><h2 id="pd-engines-title">Everything a local service business needs, in one system.</h2><p>No disconnected tools to reconcile, no separate subscriptions that don't talk to each other.</p></div><div class="pd-engines__grid">{productStories.map((story) => <a class="pd-engines__card" href={`/features/${story.id === "customer-response" ? "enquiries" : story.id === "booking" ? "bookings" : story.id === "customer-profiles" ? "customers" : story.id}`}><div class="pd-icon"><ProductIcon name={productStoryIcons[story.id]}/></div><strong>{story.title}</strong><p>{story.copy}</p><span class="pd-engines__tags">{story.features.map((f) => <em>{f}</em>)}</span></a>)}</div></section>
