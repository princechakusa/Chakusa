---
import ProductIcon from "./ProductIcon.astro";
import { productStories, productStoryIcons, productStoryStats } from "../../data/product";
const hrefFor = (id: string) => `/features/${id === "customer-response" ? "enquiries" : id === "booking" ? "bookings" : id === "customer-profiles" ? "customers" : id}`;
---
<section class="pd-engines container" id="engines" aria-labelledby="pd-engines-title"><div class="pd-section-heading"><p class="product-kicker">Synchronized engine topology</p><h2 id="pd-engines-title">Six connected engines. Zero disconnected clutter.</h2><p>Instead of taping together separate subscriptions for messaging, booking, reviews, and reminders, Chakusa runs on one connected system.</p></div><div class="pd-engines__grid">{productStories.map((story) => <a class="pd-engines__card" href={hrefFor(story.id)}><div class="pd-engines__top"><span class="pd-engines__badge">Engine {story.step}</span><div class="pd-icon"><ProductIcon name={productStoryIcons[story.id]}/></div></div><strong>{story.title}</strong><p>{story.copy}</p><div class="pd-engines__stat"><span>{productStoryStats[story.id].label}</span><b>{productStoryStats[story.id].value}</b></div></a>)}</div></section>
