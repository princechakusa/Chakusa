---
import "@fontsource-variable/inter/wght.css"; import "@fontsource-variable/plus-jakarta-sans/wght.css"; import "../styles/homepage/tokens.css"; import "../styles/homepage/foundation.css"; import "../styles/homepage/visual-system.css"; import "../styles/homepage/header.css"; import "../styles/homepage/header-layout.css"; import "../styles/homepage/hero.css"; import "../styles/homepage/poster.css"; import "../styles/homepage/footer.css"; import "../styles/homepage/responsive.css"; import "../styles/homepage/app-brand.css"; import "../styles/homepage/premium-overrides.css"; import "../styles/fx.css"; import SeoHead from "../components/seo/SeoHead.astro"; import chakusaAppIcon from "../assets/chakusa-app-icon.png";
interface Props { title: string; description: string } const { title, description } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#ee5d43"/><link rel="icon" href={chakusaAppIcon.src} type="image/png"/><SeoHead {title} {description}/><title>{title}</title><script is:inline>if(!matchMedia("(prefers-reduced-motion: reduce)").matches){document.documentElement.classList.add("fx-pending");setTimeout(function(){document.documentElement.classList.remove("fx-pending")},2500)}</script></head><body><slot/><script src="../scripts/motionFx.ts"></script></body></html>
