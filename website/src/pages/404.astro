---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import TradeCharacter from "../components/homepage/TradeCharacter.astro";

const title = "Page not found | Chakusa";
const description = "This page doesn't exist.";
---
<MarketingLayout {title} {description}>
  <SkipLink />
  <Header />
  <main id="main-content">
    <section class="notfound container" aria-labelledby="not-found-title">
      <div class="notfound__illustration" aria-hidden="true"><TradeCharacter /></div>
      <p class="notfound__code">404</p>
      <h1 id="not-found-title">This page doesn't exist.</h1>
      <p>The link might be old, or mistyped. Here's where you probably meant to go.</p>
      <div class="notfound__actions">
        <a class="ui-button ui-button--primary" href="/">Back to home</a>
        <a class="ui-button ui-button--secondary" href="/product">See the product</a>
      </div>
    </section>
  </main>
  <Footer />
</MarketingLayout>
<style>
.notfound{padding-block:5rem 6rem;text-align:center;max-width:36rem}
.notfound__illustration{width:9rem;margin:0 auto 1.5rem;padding:1.25rem 1.25rem 2.5rem;border:1px solid var(--hairline);border-radius:var(--r-xl);background:linear-gradient(160deg,#fff,var(--page-surface));box-shadow:var(--shadow-overlay)}
.notfound__code{margin:0 0 .5rem;color:var(--secondary);font-family:var(--font-heading);font-size:.85rem;font-weight:800;letter-spacing:.08em}
.notfound h1{margin:0;color:var(--heading);font-family:var(--font-heading);font-size:clamp(1.9rem,4vw,2.4rem);line-height:1.2;letter-spacing:-.025em}
.notfound>p:not(.notfound__code){margin:1rem 0 0;color:var(--body-text);font-size:1rem;line-height:1.6}
.notfound__actions{display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;margin-top:2rem}
</style>
