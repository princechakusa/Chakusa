---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import Button from "../components/foundation/Button.astro";
import TradeCharacterAlt from "../components/homepage/TradeCharacterAlt.astro";
import StoryIcon from "../components/homepage/StoryIcon.astro";

const title = "About | Chakusa";
const description = "Built for the trades that shape our neighborhoods. See how Chakusa connects discovery, enquiries, bookings, reviews, and retention.";

const lifecycle = [
  ["01", "Marketplace discovery", "Customers find local specialists by service and location.", "Organic search"],
  ["02", "Structured intake", "Enquiries arrive with the details a business needs to respond.", "Less phone tag"],
  ["03", "Service delivery", "The customer and business stay connected through the visit.", "Clear context"],
  ["04", "Verified proof", "Completed visits can lead to fair, ungated review requests.", "Earned trust"],
  ["05", "Compounding value", "Timely reminders help good customers remember to return.", "Repeat business"],
];
const principles = [
  ["tune", "Quiet utility over SaaS noise", "Useful tools should work quickly and stay out of the way of the craft.", "RULE_01 // CLARITY"],
  ["repeat", "Zero lead tax", "A clear subscription, not bidding for access to your own customers.", "RULE_02 // FAIRNESS"],
  ["shield", "Client data sovereignty", "Your customer relationships stay yours, with exportable records and no artificial lock-in.", "RULE_03 // SOVEREIGNTY"],
  ["event_available", "Synchronized scheduling", "Booking information stays connected across the customer and business experience.", "RULE_04 // CONTINUITY"],
];
---
<MarketingLayout {title} {description}>
  <SkipLink /><Header />
  <main id="main-content" class="st-about">
    <section class="st-about__hero"><div class="st-about__shell st-about__hero-grid">
      <div class="st-about__hero-copy">
        <p class="st-about__eyebrow"><span></span>Our mission &amp; foundation</p>
        <h1>Built for the trades that shape our neighborhoods.</h1>
        <p class="st-about__lede">Chakusa connects local-service discovery with a dependable operating workspace, bringing enquiries, bookings, customer relationships, reviews, and retention into one continuous experience.</p>
        <div class="st-about__tags" aria-label="Chakusa platform capabilities"><span>Enquiries</span><span>Precision booking</span><span>Customer profiles</span><span>Verified reviews</span><span>Customer retention</span><span>Marketplace presence</span></div>
        <div class="st-about__actions"><Button href="/get-started">Join the Chakusa network</Button><Button href="/how-it-works" variant="secondary">Explore how it works</Button></div>
      </div>
      <div class="st-about__hero-illustration" aria-hidden="true">
        <TradeCharacterAlt />
        <div class="st-about__hero-badge"><i></i><span><strong>10:30 AM confirmed</strong><small>Booking synced to the calendar</small></span></div>
      </div>
    </div></section>

    <section class="st-about__section st-about__section--white"><div class="st-about__shell">
      <header class="st-about__heading"><p>The operational dilemma</p><h2>The local-service reality</h2><span>Independent trades deliver excellent work while wrestling with fragmented operational noise. Chakusa is designed to reduce that administrative drag.</span></header>
      <div class="st-about__reality-grid">
        <article class="st-about__comparison st-about__comparison--problem"><div class="st-about__comparison-top"><em>&times;&nbsp; Fragmented status quo</em><small>Operational drag</small></div><h3>Scattered leads, forgotten follow-ups, and calendar collisions.</h3><ul><li>Messages spread across calls, texts, and social inboxes.</li><li>Booking requests missing the context needed to confirm quickly.</li><li>Customer history trapped in paper notes or stale spreadsheets.</li><li>Good customers drifting away without a timely reminder.</li></ul></article>
        <article class="st-about__comparison st-about__comparison--solution"><div class="st-about__comparison-top"><em>&checkmark; Chakusa unified flow</em><small>Connected view</small></div><h3>Integrated discovery through repeat business.</h3><ul><li>Enquiries arrive as structured opportunities.</li><li>Availability and bookings stay in one shared calendar.</li><li>Customer profiles carry useful visit and conversation history.</li><li>Review and return reminders follow completed service.</li></ul></article>
      </div>
    </div></section>

    <section class="st-about__section st-about__section--tint"><div class="st-about__shell">
      <header class="st-about__heading st-about__heading--center"><p>Continuity architecture</p><h2>The connected customer lifecycle</h2><span>A connected journey designed to turn a first discovery into a lasting customer relationship.</span></header>
      <ol class="st-about__lifecycle">{lifecycle.map((step) => <li><b>{step[0]}</b><h3>{step[1]}</h3><p>{step[2]}</p><small>{step[3]}</small></li>)}</ol>
    </div></section>

    <section class="st-about__section st-about__section--white"><div class="st-about__shell st-about__perspectives">
      <article class="st-about__perspective">
        <div class="st-about__mockup" aria-hidden="true">
          <div class="st-about__mockup-bar"><span></span><span></span><span></span><strong>Chakusa</strong></div>
          <div class="st-about__mockup-body">
            <p class="st-about__mockup-label"><StoryIcon name="storefront" />Rosa's Barbershop</p>
            <div class="st-about__mockup-row"><StoryIcon name="event_available" /><span>Today, 2:30 PM &middot; Available</span></div>
            <div class="st-about__mockup-row"><StoryIcon name="rate_review" /><span>4 recent reviews from real visits</span></div>
            <div class="st-about__mockup-cta">Book now</div>
          </div>
        </div>
        <div class="st-about__perspective-copy"><em>Consumer perspective</em><h2>For customers: frictionless booking with zero ambiguity.</h2><p>Finding and booking a trusted local specialist should not require phone tag or uncertain availability. Chakusa gives customers a clear route from discovery to confirmation.</p><div class="st-about__feature-grid"><div><strong>Clear service details</strong><span>Know what is offered before booking.</span></div><div><strong>Visible availability</strong><span>Choose from the times a business opens.</span></div><div><strong>Trusted profiles</strong><span>See useful business and service context.</span></div><div><strong>Easy rebooking</strong><span>Return to a business you already know.</span></div></div></div>
      </article>
      <article class="st-about__perspective st-about__perspective--reverse">
        <div class="st-about__perspective-copy"><em>Provider perspective</em><h2>For businesses: one working view, not five separate tools.</h2><p>From barbers and mechanics to cleaners and photographers, Chakusa creates one working view for enquiries, bookings, customer context, and the next action.</p><div class="st-about__feature-grid"><div><strong>Working calendar</strong><span>Keep availability and appointments together.</span></div><div><strong>Supervised AI help</strong><span>Draft responses with a person in control.</span></div><div><strong>Customer ownership</strong><span>Your customer records remain yours.</span></div><div><strong>Useful reminders</strong><span>Know who needs attention and when.</span></div></div></div>
        <div class="st-about__mockup" aria-hidden="true">
          <div class="st-about__mockup-bar"><span></span><span></span><span></span><strong>Dashboard</strong></div>
          <div class="st-about__mockup-body">
            <p class="st-about__mockup-label"><StoryIcon name="contact_phone" />3 new enquiries</p>
            <div class="st-about__mockup-row"><StoryIcon name="tune" /><span>Today's schedule, one calendar</span></div>
            <div class="st-about__mockup-row"><StoryIcon name="repeat" /><span>2 customers due for a reminder</span></div>
            <div class="st-about__mockup-cta st-about__mockup-cta--dark">Open dashboard</div>
          </div>
        </div>
      </article>
    </div></section>

    <section class="st-about__section st-about__section--tint"><div class="st-about__shell"><header class="st-about__heading"><p>Design philosophy</p><h2>Grounded product principles</h2><span>We build practical infrastructure for the real demands of local service work.</span></header><div class="st-about__principles">{principles.map((item) => <article><span class="st-about__principle-icon"><StoryIcon name={item[0]} /></span><h3>{item[1]}</h3><p>{item[2]}</p><small>{item[3]}</small></article>)}</div></div></section>

    <section class="st-about__section st-about__section--white st-about__cta-wrap"><div class="st-about__shell"><div class="st-about__cta"><p>Empowering local commerce</p><h2>Step into a modern standard for independent service trade.</h2><span>Whether you run a local service business or want a dependable way to find one, Chakusa is where neighborhood trade connects.</span><div><Button href="/get-started">Get started with Chakusa</Button><Button href="/product" variant="secondary">See the product</Button></div></div></div></section>
  </main>
  <Footer />
</MarketingLayout>

<style>
.st-about{background:var(--page-surface);color:var(--heading)}
.st-about__shell{width:min(100% - 2rem,76rem);margin-inline:auto}
.st-about__hero{overflow:hidden;background:#f2f3ff;padding:4rem 0}
.st-about__hero-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(14rem,3fr);gap:3rem;align-items:center}
.st-about__eyebrow,.st-about__heading>p,.st-about__perspective-copy>em,.st-about__cta>p{display:inline-flex;align-items:center;gap:.55rem;margin:0;color:var(--secondary);font:800 .72rem/1.2 var(--font);letter-spacing:.1em;text-transform:uppercase}
.st-about__eyebrow{padding:.55rem .8rem;border-radius:999px;background:#fff;box-shadow:0 4px 16px rgba(15,23,42,.05)}
.st-about__eyebrow span{width:.45rem;height:.45rem;border-radius:50%;background:var(--primary)}
.st-about__hero h1{max-width:38rem;margin:1rem 0 .85rem;font:700 clamp(2.3rem,4.6vw,3.6rem)/1.1 var(--font-heading);letter-spacing:-.035em}
.st-about__lede{max-width:38rem;margin:0;color:var(--body-text);font-size:1.05rem;line-height:1.65}
.st-about__tags{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.35rem}
.st-about__tags span{padding:.45rem .7rem;border-radius:.55rem;background:#eaedff;color:var(--heading);font-size:.72rem;font-weight:700}
.st-about__actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.6rem}
.st-about__hero-illustration{position:relative;width:11rem;margin-inline:auto;padding:1.5rem 1.5rem 2.75rem;border:1px solid var(--hairline);border-radius:var(--r-xl);background:linear-gradient(160deg,#fff,var(--page-surface));box-shadow:var(--shadow-overlay)}
.st-about__hero-illustration :global(svg){width:100%;display:block}
.st-about__hero-badge{position:absolute;left:1rem;right:1rem;bottom:-1rem;display:flex;align-items:center;gap:.55rem;padding:.6rem .75rem;border-radius:.85rem;background:#fff;box-shadow:var(--shadow-hover);text-align:left}
.st-about__hero-badge i{display:grid;place-items:center;width:1.5rem;height:1.5rem;flex:none;border-radius:50%;background:var(--secondary);color:#fff}
.st-about__hero-badge i::before{content:"\2713";font-size:.7rem;font-weight:900}
.st-about__hero-badge strong{display:block;font-size:.68rem;color:var(--heading)}
.st-about__hero-badge small{color:var(--muted-text,#687184);font-size:.6rem}
.st-about__section{padding:4.4rem 0}
.st-about__section--white{background:var(--page-surface)}
.st-about__section--tint{background:#f2f3ff}
.st-about__heading{max-width:48rem;margin-bottom:2rem}
.st-about__heading--center{margin-inline:auto;text-align:center}
.st-about__heading--center>p{justify-content:center}
.st-about__heading h2{margin:.45rem 0 .6rem;font:700 clamp(1.9rem,3vw,2.5rem)/1.18 var(--font-heading);letter-spacing:-.03em}
.st-about__heading>span{display:block;color:var(--body-text);line-height:1.65}
.st-about__reality-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
.st-about__comparison{display:flex;flex-direction:column;padding:1.6rem;border-radius:1.25rem;background:#fff;box-shadow:0 7px 22px rgba(15,23,42,.04)}
.st-about__comparison-top{display:flex;justify-content:space-between;gap:1rem;align-items:center}
.st-about__comparison-top em{padding:.35rem .6rem;border-radius:999px;font-size:.68rem;font-style:normal;font-weight:800}
.st-about__comparison--problem em{background:#ffdad6;color:#93000a}
.st-about__comparison--solution em{background:#d7f6ee;color:var(--secondary)}
.st-about__comparison-top small{color:var(--muted-text,#687184)}
.st-about__comparison h3{margin:1.2rem 0 .6rem;font:650 1.2rem/1.3 var(--font-heading)}
.st-about__comparison ul{display:grid;gap:.8rem;margin:.5rem 0 0;padding:0;list-style:none;color:var(--body-text)}
.st-about__comparison li{position:relative;padding-left:1.5rem;font-size:.88rem;line-height:1.5}
.st-about__comparison li::before{position:absolute;left:0;font-weight:900}
.st-about__comparison--problem li::before{content:'\25B3';color:#ba1a1a}
.st-about__comparison--solution li::before{content:'\2713';color:var(--secondary)}
.st-about__lifecycle{display:grid;grid-template-columns:repeat(5,1fr);gap:.8rem;padding:0;list-style:none}
.st-about__lifecycle li{display:flex;flex-direction:column;padding:1.35rem;border-radius:1rem;background:#fff;box-shadow:0 5px 18px rgba(15,23,42,.04)}
.st-about__lifecycle b{display:grid;width:2.25rem;height:2.25rem;place-items:center;border-radius:.5rem;background:#eaedff;color:var(--primary);font-size:.7rem}
.st-about__lifecycle h3{margin:1rem 0 .55rem;font:650 1rem/1.3 var(--font-heading)}
.st-about__lifecycle p{margin:0;color:var(--body-text);font-size:.77rem;line-height:1.55}
.st-about__lifecycle small{margin-top:auto;padding-top:.75rem;color:var(--secondary);font-size:.68rem;font-weight:800;text-transform:uppercase}
.st-about__perspectives{display:grid;gap:5rem}
.st-about__perspective{display:grid;grid-template-columns:5fr 7fr;gap:2.4rem;align-items:center}
.st-about__perspective--reverse{grid-template-columns:7fr 5fr}
.st-about__mockup{overflow:hidden;border:1px solid var(--hairline);border-radius:var(--r-xl);background:#fff;box-shadow:var(--shadow-overlay)}
.st-about__mockup-bar{display:flex;align-items:center;gap:.35rem;padding:.7rem .9rem;background:var(--page-surface);border-bottom:1px solid var(--hairline)}
.st-about__mockup-bar span{width:.5rem;height:.5rem;border-radius:50%;background:var(--hairline)}
.st-about__mockup-bar strong{margin-left:auto;color:var(--muted-text,#687184);font-size:.68rem;font-weight:700}
.st-about__mockup-body{display:grid;gap:.75rem;padding:1.25rem}
.st-about__mockup-label{display:flex;align-items:center;gap:.5rem;margin:0;color:var(--heading);font-weight:700;font-size:.88rem}
.st-about__mockup-label :global(svg){width:1.1rem;color:var(--primary)}
.st-about__mockup-row{display:flex;align-items:center;gap:.6rem;padding:.65rem .75rem;border-radius:.65rem;background:var(--page-surface);color:var(--body-text);font-size:.78rem}
.st-about__mockup-row :global(svg){width:1.05rem;flex:none;color:var(--secondary)}
.st-about__mockup-cta{margin-top:.25rem;padding:.65rem;border-radius:.6rem;background:var(--primary);color:#fff;text-align:center;font-size:.8rem;font-weight:700}
.st-about__mockup-cta--dark{background:var(--heading)}
.st-about__perspective-copy>em{padding:.38rem .65rem;border-radius:999px;background:#eaedff;font-style:normal}
.st-about__perspective-copy h2{margin:.75rem 0 .8rem;font:700 clamp(1.8rem,3vw,2.35rem)/1.2 var(--font-heading);letter-spacing:-.03em}
.st-about__perspective-copy>p{color:var(--body-text);font-size:1rem;line-height:1.65}
.st-about__feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:1.25rem}
.st-about__feature-grid>div{padding:1rem;border-radius:.85rem;background:#f2f3ff}
.st-about__feature-grid strong,.st-about__feature-grid span{display:block}
.st-about__feature-grid strong{font-size:.78rem}
.st-about__feature-grid span{margin-top:.25rem;color:var(--body-text);font-size:.7rem;line-height:1.45}
.st-about__principles{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
.st-about__principles article{display:flex;flex-direction:column;padding:1.4rem;border-radius:1.1rem;background:#fff}
.st-about__principle-icon{display:grid;width:3rem;height:3rem;place-items:center;border-radius:.8rem;background:#eaedff;color:var(--primary)}
.st-about__principle-icon :global(svg){width:1.35rem}
.st-about__principles h3{margin:1rem 0 .5rem;font:650 1rem/1.3 var(--font-heading)}
.st-about__principles p{margin:0;color:var(--body-text);font-size:.77rem;line-height:1.5}
.st-about__principles small{margin-top:auto;padding-top:.75rem;color:var(--muted-text,#687184);font:700 .58rem/1.2 ui-monospace,monospace}
.st-about__cta-wrap{padding-top:2.5rem}
.st-about__cta{overflow:hidden;padding:3.5rem;border-radius:1.5rem;background:var(--heading);color:#fff}
.st-about__cta>p{color:#7dd8cc}
.st-about__cta h2{max-width:42rem;margin:.8rem 0;font:700 clamp(1.9rem,3.6vw,2.9rem)/1.15 var(--font-heading);letter-spacing:-.035em}
.st-about__cta>span{display:block;max-width:38rem;color:#c9ccd3;line-height:1.65}
.st-about__cta>div{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.6rem}
@media(max-width:64rem){
  .st-about__hero-grid{grid-template-columns:1fr}
  .st-about__hero-illustration{margin-inline:auto}
  .st-about__perspective,.st-about__perspective--reverse{grid-template-columns:1fr}
  .st-about__lifecycle{grid-template-columns:repeat(2,1fr)}
  .st-about__principles{grid-template-columns:repeat(2,1fr)}
  .st-about__perspective--reverse .st-about__perspective-copy{order:2}
  .st-about__perspective--reverse .st-about__mockup{order:1}
}
@media(max-width:40rem){
  .st-about__hero{padding:2.8rem 0}
  .st-about__section{padding:3.2rem 0}
  .st-about__reality-grid,.st-about__lifecycle,.st-about__feature-grid,.st-about__principles{grid-template-columns:1fr}
  .st-about__cta{padding:2rem}
}
</style>
