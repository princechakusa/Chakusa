---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import Button from "../components/foundation/Button.astro";
import TradeCharacter from "../components/homepage/TradeCharacter.astro";
import TradeCharacterAlt from "../components/homepage/TradeCharacterAlt.astro";
import StoryIcon from "../components/homepage/StoryIcon.astro";

const title = "About | Chakusa";
const description = "Built for the trades that shape our neighborhoods. See how Chakusa connects discovery, enquiries, bookings, reviews, and retention.";
const lifecycle = [
  ["01", "Marketplace Discovery", "Customers find local specialists by service and location.", "Organic search"],
  ["02", "Structured Intake", "Enquiries arrive with the details a business needs to respond.", "Less phone tag"],
  ["03", "Service Delivery", "The customer and business stay connected through the visit.", "Clear context"],
  ["04", "Verified Proof", "Completed visits can lead to fair, ungated review requests.", "Earned trust"],
  ["05", "Compounding Value", "Timely reminders help good customers remember to return.", "Repeat business"],
];
const principles = [
  ["tune", "Quiet Utility over SaaS Noise", "Useful tools should work quickly and stay out of the way of the craft.", "RULE_01 // CLARITY"],
  ["repeat", "Zero Lead Tax", "A clear subscription, not bidding for access to your own customers.", "RULE_02 // FAIRNESS"],
  ["shield", "Client Data Sovereignty", "Your customer relationships stay yours, with exportable records and no artificial lock-in.", "RULE_03 // SOVEREIGNTY"],
  ["event_available", "Synchronized Scheduling", "Booking information stays connected across customer and business experiences.", "RULE_04 // CONTINUITY"],
];
---
<MarketingLayout {title} {description}>
  <SkipLink /><Header />
  <main id="main-content" class="st-about">
    <section class="st-about__hero"><div class="st-about__shell st-about__hero-grid">
      <div class="st-about__hero-copy">
        <p class="st-about__eyebrow">Our mission &amp; foundation</p>
        <h1>Built for the trades that shape our neighborhoods.</h1>
        <p class="st-about__lede">Chakusa connects local-service discovery with a dependable operating workspace, bringing enquiries, bookings, customer relationships, reviews, and retention into one continuous experience.</p>
        <div class="st-about__tags" aria-label="Chakusa platform capabilities"><span>Enquiries</span><span>Precision booking</span><span>Customer profiles</span><span>Verified reviews</span><span>Customer retention</span><span>Marketplace presence</span></div>
        <div class="st-about__actions"><Button href="/get-started">Join the Chakusa network</Button><Button href="/how-it-works" variant="secondary">Explore how it works</Button></div>
      </div>
      <div class="st-about__character-stage" aria-label="Animated flat illustration of a woman using Chakusa"><div class="st-about__halo"></div><TradeCharacterAlt class="st-about__woman" /></div>
    </div></section>

    <section class="st-about__section st-about__section--white"><div class="st-about__shell">
      <header class="st-about__heading"><p>The operational dilemma</p><h2>The Local-Service Reality</h2><span>Independent trades deliver excellent work while wrestling with fragmented operational noise. Chakusa is designed to reduce that administrative drag.</span></header>
      <div class="st-about__reality-grid">
        <article class="st-about__comparison st-about__comparison--problem"><div class="st-about__comparison-top"><em>× &nbsp; Fragmented status quo</em><small>Operational drag</small></div><h3>Scattered leads, forgotten follow-ups, and calendar collisions.</h3><ul><li>Messages spread across calls, texts, and social inboxes.</li><li>Booking requests missing the context needed to confirm quickly.</li><li>Customer history trapped in paper notes or stale spreadsheets.</li><li>Good customers drifting away without a timely reminder.</li></ul><footer><span>Time lost to disconnected admin</span><strong>Every week</strong></footer></article>
        <article class="st-about__comparison st-about__comparison--solution"><div class="st-about__comparison-top"><em>✓ &nbsp; Chakusa unified flow</em><small>Connected view</small></div><h3>Integrated discovery through repeat business.</h3><ul><li>Enquiries arrive as structured opportunities.</li><li>Availability and bookings stay in one shared calendar.</li><li>Customer profiles carry useful visit and conversation history.</li><li>Review and return reminders follow completed service.</li></ul><footer><span>Focus returned to the work</span><strong>One system</strong></footer></article>
      </div>
    </div></section>

    <section class="st-about__section st-about__section--tint"><div class="st-about__shell">
      <header class="st-about__heading st-about__heading--center"><p>Continuity architecture</p><h2>The Connected Customer Lifecycle</h2><span>A connected journey designed to turn a first discovery into a lasting customer relationship.</span></header>
      <ol class="st-about__lifecycle">{lifecycle.map((step) => <li><b>{step[0]}</b><h3>{step[1]}</h3><p>{step[2]}</p><small>{step[3]}</small></li>)}</ol>
    </div></section>

    <section class="st-about__section st-about__section--white"><div class="st-about__shell st-about__perspectives">
      <article class="st-about__perspective"><div class="st-about__portrait" aria-label="Animated flat illustration of a woman booking a service"><TradeCharacterAlt class="st-about__woman" /></div><div class="st-about__perspective-copy"><em>Consumer perspective</em><h2>For Modern Patrons: Frictionless booking with zero ambiguity.</h2><p>Finding and booking a trusted local specialist should not require phone tag or uncertain availability. Chakusa gives customers a clear route from discovery to confirmation.</p><div class="st-about__feature-grid"><div><strong>Clear service details</strong><span>Know what is offered before booking.</span></div><div><strong>Visible availability</strong><span>Choose from the times a business opens.</span></div><div><strong>Trusted profiles</strong><span>See useful business and service context.</span></div><div><strong>Easy rebooking</strong><span>Return to a business you already know.</span></div></div></div></article>
      <article class="st-about__perspective st-about__perspective--reverse"><div class="st-about__perspective-copy"><em>Provider perspective</em><h2>For Masters & Trades: Total autonomy without operational overhead.</h2><p>From barbers and mechanics to cleaners and photographers, Chakusa creates one working view for enquiries, bookings, customer context, and the next action.</p><div class="st-about__feature-grid"><div><strong>Working calendar</strong><span>Keep availability and appointments together.</span></div><div><strong>Supervised AI help</strong><span>Draft responses with a person in control.</span></div><div><strong>Customer ownership</strong><span>Your customer records remain yours.</span></div><div><strong>Useful reminders</strong><span>Know who needs attention and when.</span></div></div></div><div class="st-about__character-stage st-about__character-stage--man" aria-label="Animated flat illustration of a male local-service professional"><div class="st-about__halo"></div><TradeCharacter class="st-about__man" /></div></article>
    </div></section>

    <section class="st-about__section st-about__section--tint"><div class="st-about__shell"><header class="st-about__heading"><p>Design philosophy</p><h2>Grounded Product Principles</h2><span>We build practical infrastructure for the real demands of local service work.</span></header><div class="st-about__principles">{principles.map((item) => <article><span class="st-about__principle-icon"><StoryIcon name={item[0]} /></span><h3>{item[1]}</h3><p>{item[2]}</p><small>{item[3]}</small></article>)}</div></div></section>

    <section class="st-about__section st-about__section--white st-about__cta-wrap"><div class="st-about__shell"><div class="st-about__cta"><p>Empowering local commerce</p><h2>Step into the modern standard for independent service trade.</h2><span>Whether you run a local service business or want a dependable way to find one, Chakusa is where neighborhood trade connects.</span><div><Button href="/get-started">Get started with Chakusa</Button><Button href="/features/marketplace" variant="secondary">Explore the marketplace</Button></div></div></div></section>
  </main>
  <Footer />
</MarketingLayout>

<style>
.st-about{background:#faf8ff;color:#131b2e}.st-about__shell{width:min(100% - 2rem,76rem);margin-inline:auto}.st-about__hero{overflow:hidden;background:#f2f3ff;padding:4rem 0}.st-about__hero-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(20rem,5fr);gap:3rem;align-items:center}.st-about__eyebrow,.st-about__heading>p,.st-about__perspective-copy>em,.st-about__cta>p{display:inline-flex;align-items:center;gap:.55rem;margin:0;color:#006a61;font:800 .72rem/1.2 var(--font);letter-spacing:.1em;text-transform:uppercase}.st-about__hero h1{max-width:42rem;margin:1rem 0 .85rem;font:700 clamp(2.45rem,5.2vw,4.6rem)/1.06 var(--font-heading);letter-spacing:-.045em}.st-about__lede{max-width:43rem;margin:0;color:#59413c;font-size:1.08rem;line-height:1.65}.st-about__tags{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.35rem}.st-about__tags span{padding:.45rem .7rem;border-radius:.55rem;background:#eaedff;color:#283044;font-size:.72rem;font-weight:700}.st-about__actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.6rem}.st-about__character-stage{position:relative;min-height:31rem;overflow:hidden;border:1px solid #dae2fd;border-radius:1.5rem;background:#fff;box-shadow:0 24px 60px #2830441a}.st-about__gridlines{position:absolute;inset:0;background-image:linear-gradient(#2830440d 1px,transparent 1px),linear-gradient(90deg,#2830440d 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(to bottom,#000 55%,transparent)}.st-about__halo{position:absolute;width:13rem;height:13rem;left:50%;top:2rem;translate:-50% 0;border-radius:50%;background:#ffdad3;opacity:.65;animation:st-breathe 4s ease-in-out infinite}.st-about__woman,.st-about__man{position:absolute!important;z-index:2;left:50%;bottom:-4rem;width:15rem!important;translate:-50% 0;filter:drop-shadow(0 16px 16px #2830441a);animation:st-float 4.5s ease-in-out infinite}.st-about__man{bottom:-3.5rem;width:16rem!important}.st-about__mini-card,.st-about__booking-card,.st-about__trade-card{position:absolute;z-index:4;display:flex;align-items:center;border:1px solid #a5d6d1;background:#fffffff2;box-shadow:0 12px 28px #2830441a;backdrop-filter:blur(10px);animation:st-card-float 4s ease-in-out infinite}.st-about__mini-card{top:1.1rem;right:1rem;gap:.55rem;padding:.65rem .75rem;border-radius:.85rem}.st-about__mini-card i{width:.55rem;height:.55rem;border-radius:50%;background:#00a394}.st-about__mini-card span,.st-about__booking-card span{display:grid}.st-about__mini-card strong,.st-about__booking-card strong{font-size:.7rem}.st-about__mini-card small,.st-about__booking-card small{color:#596273;font-size:.58rem}.st-about__mini-card b,.st-about__booking-card b{margin-left:.55rem;color:#00867b;font-size:.54rem}.st-about__booking-card{left:1.25rem;right:1.25rem;bottom:1.2rem;gap:.75rem;padding:.9rem 1rem;border-radius:1rem;animation-delay:-1.7s}.st-about__booking-card>i{display:grid;width:2.2rem;height:2.2rem;place-items:center;border-radius:50%;background:#008f82;color:#fff;font-style:normal;font-weight:900}.st-about__section{padding:4.4rem 0}.st-about__section--white{background:#faf8ff}.st-about__section--tint{background:#f2f3ff}.st-about__heading{max-width:48rem;margin-bottom:2rem}.st-about__heading--center{margin-inline:auto;text-align:center}.st-about__heading--center>p{justify-content:center}.st-about__heading h2{margin:.45rem 0 .6rem;font:700 clamp(2rem,3vw,2.75rem)/1.15 var(--font-heading);letter-spacing:-.035em}.st-about__heading>span{display:block;color:#59413c;line-height:1.65}.st-about__reality-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}.st-about__comparison{display:flex;min-height:27rem;flex-direction:column;padding:1.6rem;border-radius:1.25rem;background:#fff;box-shadow:0 7px 22px #2830440b}.st-about__comparison-top{display:flex;justify-content:space-between;gap:1rem;align-items:center}.st-about__comparison-top em{padding:.35rem .6rem;border-radius:999px;font-size:.68rem;font-style:normal;font-weight:800}.st-about__comparison--problem em{background:#ffdad6;color:#93000a}.st-about__comparison--solution em{background:#86f2e4;color:#006f66}.st-about__comparison-top small{color:#687184}.st-about__comparison h3{margin:1.2rem 0 .6rem;font:650 1.25rem/1.3 var(--font-heading)}.st-about__comparison ul{display:grid;gap:.8rem;margin:.5rem 0 1.5rem;padding:0;list-style:none;color:#59413c}.st-about__comparison li{position:relative;padding-left:1.5rem;font-size:.88rem;line-height:1.5}.st-about__comparison li::before{position:absolute;left:0;font-weight:900}.st-about__comparison--problem li::before{content:'△';color:#ba1a1a}.st-about__comparison--solution li::before{content:'✓';color:#006a61}.st-about__comparison footer{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:auto;padding:1rem;border-radius:.75rem;background:#f2f3ff;font-size:.75rem}.st-about__comparison--solution footer{background:#dff9f4;color:#006a61}.st-about__lifecycle{display:grid;grid-template-columns:repeat(5,1fr);gap:.8rem;padding:0;list-style:none}.st-about__lifecycle li{display:flex;min-height:18rem;flex-direction:column;padding:1.35rem;border-radius:1rem;background:#fff;box-shadow:0 5px 18px #2830440b}.st-about__lifecycle b{display:grid;width:2.25rem;height:2.25rem;place-items:center;border-radius:.5rem;background:#eaedff;color:#ab2d19;font-size:.7rem}.st-about__lifecycle h3{margin:1rem 0 .55rem;font:650 1rem/1.3 var(--font-heading)}.st-about__lifecycle p{margin:0;color:#59413c;font-size:.77rem;line-height:1.55}.st-about__lifecycle small{margin-top:auto;color:#006a61;font-size:.68rem;font-weight:800;text-transform:uppercase}.st-about__perspectives{display:grid;gap:5rem}.st-about__perspective{display:grid;grid-template-columns:5fr 7fr;gap:2.4rem;align-items:center}.st-about__perspective--reverse{grid-template-columns:7fr 5fr}.st-about__portrait{position:relative;min-height:27rem;overflow:hidden;border:.55rem solid #fff;border-radius:1.25rem;background:#fff3dc;box-shadow:0 18px 38px #2830441c}.st-about__portrait .st-about__woman{bottom:-4.5rem;width:16rem!important}.st-about__portrait>span{position:absolute;z-index:5;top:1rem;right:1rem;display:flex;gap:.45rem;align-items:center;padding:.45rem .65rem;border-radius:999px;background:#fffffff0;font-size:.65rem;font-weight:800;box-shadow:0 5px 15px #28304418}.st-about__portrait>span i{width:.45rem;height:.45rem;border-radius:50%;background:#00a394}.st-about__perspective-copy>em{padding:.38rem .65rem;border-radius:999px;background:#eaedff;font-style:normal}.st-about__perspective-copy h2{margin:.75rem 0 .8rem;font:700 clamp(2rem,3.3vw,2.7rem)/1.12 var(--font-heading);letter-spacing:-.035em}.st-about__perspective-copy>p{color:#59413c;font-size:1rem;line-height:1.65}.st-about__feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:1.25rem}.st-about__feature-grid>div{padding:1rem;border-radius:.85rem;background:#f2f3ff}.st-about__feature-grid strong,.st-about__feature-grid span{display:block}.st-about__feature-grid strong{font-size:.78rem}.st-about__feature-grid span{margin-top:.25rem;color:#59413c;font-size:.7rem;line-height:1.45}.st-about__character-stage--man{min-height:29rem}.st-about__trade-card{right:1rem;bottom:1rem;left:1rem;display:grid;gap:.3rem;padding:1rem;border-radius:1rem}.st-about__trade-card span{color:#006a61;font-size:.62rem;font-weight:800;text-transform:uppercase}.st-about__trade-card b{font-size:.8rem}.st-about__trade-card small{color:#596273;font-size:.68rem}.st-about__principles{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.st-about__principles article{display:flex;min-height:17rem;flex-direction:column;padding:1.4rem;border-radius:1.1rem;background:#fff}.st-about__principle-icon{display:grid;width:3rem;height:3rem;place-items:center;border-radius:.8rem;background:#eaedff;color:#ab2d19}.st-about__principle-icon svg{width:1.35rem}.st-about__principles h3{margin:1rem 0 .5rem;font:650 1rem/1.3 var(--font-heading)}.st-about__principles p{margin:0;color:#59413c;font-size:.77rem;line-height:1.5}.st-about__principles small{margin-top:auto;color:#687184;font:700 .58rem/1.2 ui-monospace,monospace}.st-about__cta-wrap{padding-top:2.5rem}.st-about__cta{overflow:hidden;padding:3.5rem;border-radius:1.5rem;background:linear-gradient(135deg,#131b2e,#231c31);color:#fff;box-shadow:0 22px 50px #131b2e33}.st-about__cta>p{color:#86f2e4}.st-about__cta h2{max-width:52rem;margin:.8rem 0;font:700 clamp(2.25rem,4.8vw,4.1rem)/1.05 var(--font-heading);letter-spacing:-.045em}.st-about__cta>span{display:block;max-width:40rem;color:#d2d9f4;line-height:1.65}.st-about__cta>div{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.6rem}
@keyframes st-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}@keyframes st-card-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}@keyframes st-breathe{0%,100%{transform:scale(1);opacity:.55}50%{transform:scale(1.06);opacity:.8}}@keyframes st-pulse{0%,100%{opacity:.35;transform:scale(.8)}50%{opacity:1;transform:scale(1)}}
.st-about__character-stage,.st-about__portrait{overflow:visible;border:0;border-radius:0;background:transparent;box-shadow:none}.st-about__gridlines,.st-about__mini-card,.st-about__booking-card,.st-about__trade-card,.st-about__portrait>span{display:none}.st-about__portrait::before{content:"";position:absolute;left:50%;top:3rem;width:13rem;height:13rem;translate:-50%;border-radius:50%;background:#dff9f4}.st-about__woman,.st-about__man{filter:drop-shadow(0 12px 12px #28304412)}
@media(max-width:64rem){.st-about__hero-grid,.st-about__perspective,.st-about__perspective--reverse{grid-template-columns:1fr}.st-about__character-stage{width:min(100%,34rem);margin-inline:auto}.st-about__lifecycle{grid-template-columns:repeat(2,1fr)}.st-about__principles{grid-template-columns:repeat(2,1fr)}.st-about__perspective--reverse .st-about__perspective-copy{order:2}.st-about__perspective--reverse .st-about__character-stage{order:1}}
@media(max-width:40rem){.st-about__hero{padding:2.8rem 0}.st-about__hero-grid{gap:2rem}.st-about__hero h1{font-size:2.55rem}.st-about__character-stage{min-height:27rem}.st-about__booking-card{left:.65rem;right:.65rem}.st-about__mini-card{display:none}.st-about__section{padding:3.2rem 0}.st-about__reality-grid,.st-about__lifecycle,.st-about__feature-grid,.st-about__principles{grid-template-columns:1fr}.st-about__comparison{min-height:auto}.st-about__lifecycle li{min-height:13rem}.st-about__portrait{min-height:24rem}.st-about__cta{padding:2rem}.st-about__cta h2{font-size:2.35rem}}
@media(prefers-reduced-motion:reduce){.st-about__woman,.st-about__man,.st-about__mini-card,.st-about__booking-card,.st-about__halo{animation:none}}
</style>
