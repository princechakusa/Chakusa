---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import Button from "../components/foundation/Button.astro";
import StoryIcon from "../components/homepage/StoryIcon.astro";
import AboutSemanticScene from "../components/about/AboutSemanticScene.astro";

const title = "About | Chakusa";
const description = "Built for the trades that shape our neighborhoods. See how Chakusa connects discovery, enquiries, bookings, reviews, and retention.";
const lifecycle = [
  ["01", "Marketplace Discovery", "Customers find local specialists by service and location.", "Organic search"],
  ["02", "Structured Intake", "Enquiries arrive with the details a business needs to respond.", "Less phone tag"],
  ["03", "Service Delivery", "The customer and business stay connected through the visit.", "Clear context"],
  ["04", "Verified Proof", "Completed visits can lead to fair, ungated review requests.", "Earned trust"],
  ["05", "Compounding Value", "Timely reminders help good customers remember to return.", "Repeat business"],
];
const principles = [
  ["tune", "Quiet Utility over SaaS Noise", "Useful tools should work quickly and stay out of the way of the craft.", "RULE_01 // CLARITY"],
  ["repeat", "Zero Lead Tax", "A clear subscription, not bidding for access to your own customers.", "RULE_02 // FAIRNESS"],
  ["shield", "Client Data Sovereignty", "Your customer relationships stay yours, with exportable records and no artificial lock-in.", "RULE_03 // SOVEREIGNTY"],
  ["event_available", "Synchronized Scheduling", "Booking information stays connected across customer and business experiences.", "RULE_04 // CONTINUITY"],
];
---
<MarketingLayout {title} {description}>
  <SkipLink /><Header />
  <main id="main-content" class="st-about">
    <section class="st-about__hero"><div class="st-about__shell st-about__hero-grid">
      <div class="st-about__hero-copy">
        <p class="st-about__eyebrow"><span></span>Our mission &amp; foundation</p>
        <h1>Built for the trades that shape our neighborhoods.</h1>
        <p class="st-about__lede">Chakusa connects local-service discovery with a dependable operating workspace, bringing enquiries, bookings, customer relationships, reviews, and retention into one continuous experience.</p>
        <div class="st-about__tags" aria-label="Chakusa platform capabilities"><span>Enquiries</span><span>Precision booking</span><span>Customer profiles</span><span>Verified reviews</span><span>Customer retention</span><span>Marketplace presence</span></div>
        <div class="st-about__actions"><Button href="/get-started">Join the Chakusa network</Button><Button href="/how-it-works" variant="secondary">Explore how it works</Button></div>
      </div>
      <AboutSemanticScene scene="mission" />
    </div></section>

    <section class="st-about__section st-about__section--white"><div class="st-about__shell">
      <header class="st-about__heading"><p>The operational dilemma</p><h2>The Local-Service Reality</h2><span>Independent trades deliver excellent work while wrestling with fragmented operational noise. Chakusa is designed to reduce that administrative drag.</span></header>
      <div class="st-about__reality-grid">
        <article class="st-about__comparison st-about__comparison--problem"><div class="st-about__comparison-top"><em>× &nbsp; Fragmented status quo</em><small>Operational drag</small></div><h3>Scattered leads, forgotten follow-ups, and calendar collisions.</h3><ul><li>Messages spread across calls, texts, and social inboxes.</li><li>Booking requests missing the context needed to confirm quickly.</li><li>Customer history trapped in paper notes or stale spreadsheets.</li><li>Good customers drifting away without a timely reminder.</li></ul><footer><span>Time lost to disconnected admin</span><strong>Every week</strong></footer></article>
        <article class="st-about__comparison st-about__comparison--solution"><div class="st-about__comparison-top"><em>✓ &nbsp; Chakusa unified flow</em><small>Connected view</small></div><h3>Integrated discovery through repeat business.</h3><ul><li>Enquiries arrive as structured opportunities.</li><li>Availability and bookings stay in one shared calendar.</li><li>Customer profiles carry useful visit and conversation history.</li><li>Review and return reminders follow completed service.</li></ul><footer><span>Focus returned to the work</span><strong>One system</strong></footer></article>
      </div>
    </div></section>

    <section class="st-about__section st-about__section--tint"><div class="st-about__shell">
      <header class="st-about__heading st-about__heading--center"><p>Continuity architecture</p><h2>The Connected Customer Lifecycle</h2><span>A connected journey designed to turn a first discovery into a lasting customer relationship.</span></header>
      <ol class="st-about__lifecycle">{lifecycle.map((step) => <li><b>{step[0]}</b><h3>{step[1]}</h3><p>{step[2]}</p><small>{step[3]}</small></li>)}</ol>
    </div></section>

    <section class="st-about__section st-about__section--white"><div class="st-about__shell st-about__perspectives">
      <article class="st-about__perspective"><div class="st-about__visual"><AboutSemanticScene scene="customer" /></div><div class="st-about__perspective-copy"><em>Consumer perspective</em><h2>For Modern Patrons: Frictionless booking with zero ambiguity.</h2><p>Finding and booking a trusted local specialist should not require phone tag or uncertain availability. Chakusa gives customers a clear route from discovery to confirmation.</p><div class="st-about__feature-grid"><div><strong>Clear service details</strong><span>Know what is offered before booking.</span></div><div><strong>Visible availability</strong><span>Choose from the times a business opens.</span></div><div><strong>Trusted profiles</strong><span>See useful business and service context.</span></div><div><strong>Easy rebooking</strong><span>Return to a business you already know.</span></div></div></div></article>
      <article class="st-about__perspective st-about__perspective--reverse"><div class="st-about__perspective-copy"><em>Provider perspective</em><h2>For Masters &amp; Trades: Total autonomy without operational overhead.</h2><p>From barbers and mechanics to cleaners and photographers, Chakusa creates one working view for enquiries, bookings, customer context, and the next action.</p><div class="st-about__feature-grid"><div><strong>Working calendar</strong><span>Keep availability and appointments together.</span></div><div><strong>Supervised AI help</strong><span>Draft responses with a person in control.</span></div><div><strong>Customer ownership</strong><span>Your customer records remain yours.</span></div><div><strong>Useful reminders</strong><span>Know who needs attention and when.</span></div></div></div><div class="st-about__visual"><AboutSemanticScene scene="business" /></div></article>
    </div></section>

    <section class="st-about__section st-about__section--tint"><div class="st-about__shell"><header class="st-about__heading"><p>Design philosophy</p><h2>Grounded Product Principles</h2><span>We build practical infrastructure for the real demands of local service work.</span></header><div class="st-about__principles">{principles.map((item) => <article><span class="st-about__principle-icon"><StoryIcon name={item[0]} /></span><h3>{item[1]}</h3><p>{item[2]}</p><small>{item[3]}</small></article>)}</div></div></section>

    <section class="st-about__section st-about__section--white st-about__cta-wrap"><div class="st-about__shell"><div class="st-about__cta"><p>Empowering local commerce</p><h2>Step into the modern standard for independent service trade.</h2><span>Whether you run a local service business or want a dependable way to find one, Chakusa is where neighborhood trade connects.</span><div><Button href="/get-started">Get started with Chakusa</Button><Button href="/features/marketplace" variant="secondary">Explore the marketplace</Button></div></div></div></section>
  </main>
  <Footer />
</MarketingLayout>

<style>
.st-about{background:#faf8ff;color:#131b2e}.st-about__shell{width:min(100% - 2rem,76rem);margin-inline:auto}.st-about__hero{overflow:hidden;background:#f2f3ff;padding:4.5rem 0}.st-about__hero-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(22rem,5fr);gap:3.2rem;align-items:center}.st-about__eyebrow,.st-about__heading>p,.st-about__perspective-copy>em,.st-about__cta>p{display:inline-flex;align-items:center;gap:.55rem;margin:0;color:#006a61;font:800 .72rem/1.2 var(--font);letter-spacing:.1em;text-transform:uppercase}.st-about__eyebrow{padding:.55rem .8rem;border-radius:999px;background:#fff;box-shadow:0 4px 16px #2830440d}.st-about__eyebrow span{width:.45rem;height:.45rem;border-radius:50%;background:#ee5d43;animation:st-pulse 1.8s ease-in-out infinite}.st-about__hero h1{max-width:42rem;margin:1rem 0 .85rem;font:700 clamp(2.45rem,5.2vw,4.6rem)/1.06 var(--font-heading);letter-spacing:-.045em}.st-about__lede{max-width:43rem;margin:0;color:#59413c;font-size:1.08rem;line-height:1.65}.st-about__tags{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.35rem}.st-about__tags span{padding:.45rem .7rem;border-radius:.55rem;background:#eaedff;color:#283044;font-size:.72rem;font-weight:700}.st-about__actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.6rem}.st-about__section{padding:4.8rem 0}.st-about__section--white{background:#faf8ff}.st-about__section--tint{background:#f2f3ff}.st-about__heading{max-width:48rem;margin-bottom:2rem}.st-about__heading--center{margin-inline:auto;text-align:center}.st-about__heading--center>p{justify-content:center}.st-about__heading h2{margin:.45rem 0 .6rem;font:700 clamp(2rem,3vw,2.75rem)/1.15 var(--font-heading);letter-spacing:-.035em}.st-about__heading>span{display:block;color:#59413c;line-height:1.65}.st-about__reality-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}.st-about__comparison{display:flex;min-height:27rem;flex-direction:column;padding:1.6rem;border-radius:1.25rem;background:#fff;box-shadow:0 7px 22px #2830440b}.st-about__comparison-top{display:flex;justify-content:space-between;gap:1rem;align-items:center}.st-about__comparison-top em{padding:.35rem .6rem;border-radius:999px;font-size:.68rem;font-style:normal;font-weight:800}.st-about__comparison--problem em{background:#ffdad6;color:#93000a}.st-about__comparison--solution em{background:#86f2e4;color:#006f66}.st-about__comparison-top small{color:#687184}.st-about__comparison h3{margin:1.2rem 0 .6rem;font:650 1.25rem/1.3 var(--font-heading)}.st-about__comparison ul{display:grid;gap:.8rem;margin:.5rem 0 1.5rem;padding:0;list-style:none;color:#59413c}.st-about__comparison li{position:relative;padding-left:1.5rem;font-size:.88rem;line-height:1.5}.st-about__comparison li::before{position:absolute;left:0;font-weight:900}.st-about__comparison--problem li::before{content:'△';color:#ba1a1a}.st-about__comparison--solution li::before{content:'✓';color:#006a61}.st-about__comparison footer{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:auto;padding:1rem;border-radius:.75rem;background:#f2f3ff;font-size:.75rem}.st-about__comparison--solution footer{background:#dff9f4;color:#006a61}.st-about__lifecycle{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin:2.5rem 0 0;padding:0;list-style:none}.st-about__lifecycle li{position:relative;min-height:15rem;padding:1.2rem 1rem;border-top:2px solid #a5d6d1;background:#fff}.st-about__lifecycle li:first-child{border-radius:1rem 0 0 1rem}.st-about__lifecycle li:last-child{border-radius:0 1rem 1rem 0}.st-about__lifecycle li:not(:last-child)::after{content:'›';position:absolute;z-index:2;right:-.55rem;top:1rem;display:grid;width:1.1rem;height:1.1rem;place-items:center;border-radius:50%;background:#0d9488;color:#fff;font-weight:900}.st-about__lifecycle b{color:#ee5d43;font:800 .72rem var(--font)}.st-about__lifecycle h3{margin:1.1rem 0 .55rem;font:700 .95rem var(--font-heading)}.st-about__lifecycle p{margin:0;color:#59413c;font-size:.76rem;line-height:1.5}.st-about__lifecycle small{display:inline-block;margin-top:1rem;padding:.3rem .45rem;border-radius:.4rem;background:#f2f3ff;color:#596273;font-size:.58rem;font-weight:800}.st-about__perspectives{display:grid;gap:5rem}.st-about__perspective{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:4rem;align-items:center}.st-about__perspective--reverse{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.st-about__visual{min-width:0}.st-about__visual :global(.about-scene){min-height:30rem}.st-about__perspective-copy h2{margin:.55rem 0 1rem;font:700 clamp(1.8rem,3vw,2.65rem)/1.15 var(--font-heading);letter-spacing:-.035em}.st-about__perspective-copy>p{color:#59413c;line-height:1.65}.st-about__feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:1.25rem}.st-about__feature-grid>div{padding:.9rem;border:1px solid #e0e5ee;border-radius:.75rem;background:#fff}.st-about__feature-grid strong,.st-about__feature-grid span{display:block}.st-about__feature-grid strong{font-size:.78rem}.st-about__feature-grid span{margin-top:.25rem;color:#687184;font-size:.68rem;line-height:1.45}.st-about__principles{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.st-about__principles article{min-height:16rem;padding:1.35rem;border:1px solid #dfe5ef;border-radius:1rem;background:#fff}.st-about__principle-icon{display:grid;width:2.6rem;height:2.6rem;place-items:center;border-radius:.75rem;background:#ffdad3;color:#ab2d19}.st-about__principles h3{margin:1.2rem 0 .55rem;font:700 1rem var(--font-heading)}.st-about__principles p{color:#59413c;font-size:.76rem;line-height:1.55}.st-about__principles small{display:block;margin-top:1rem;color:#00867b;font-size:.56rem;font-weight:900;letter-spacing:.07em}.st-about__cta{position:relative;overflow:hidden;padding:3.5rem;border-radius:1.5rem;background:#172033;color:#fff}.st-about__cta::after{content:'';position:absolute;width:18rem;height:18rem;right:-4rem;top:-7rem;border-radius:50%;background:#ee5d43;opacity:.25}.st-about__cta h2{position:relative;z-index:1;max-width:45rem;margin:.6rem 0 .8rem;font:700 clamp(2rem,4vw,3.4rem)/1.08 var(--font-heading);letter-spacing:-.04em}.st-about__cta>span{position:relative;z-index:1;display:block;max-width:43rem;color:#dbe3ef;line-height:1.6}.st-about__cta>div{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.5rem}@keyframes st-pulse{50%{opacity:.35;transform:scale(.8)}}@media(max-width:900px){.st-about__hero-grid,.st-about__perspective,.st-about__perspective--reverse{grid-template-columns:1fr}.st-about__hero-grid{gap:2.5rem}.st-about__perspective--reverse .st-about__perspective-copy{order:2}.st-about__perspective--reverse .st-about__visual{order:1}.st-about__principles{grid-template-columns:1fr 1fr}.st-about__lifecycle{grid-template-columns:1fr}.st-about__lifecycle li{min-height:0;border-top:0;border-left:2px solid #a5d6d1;border-radius:0!important}.st-about__lifecycle li:not(:last-child)::after{right:auto;left:-.65rem;top:auto;bottom:-.55rem;rotate:90deg}}@media(max-width:650px){.st-about__shell{width:min(100% - 1.25rem,76rem)}.st-about__hero{padding:2.8rem 0}.st-about__section{padding:3.5rem 0}.st-about__reality-grid,.st-about__feature-grid,.st-about__principles{grid-template-columns:1fr}.st-about__comparison{min-height:0}.st-about__perspectives{gap:3.5rem}.st-about__cta{padding:2rem 1.25rem}.st-about__actions,.st-about__cta>div{align-items:stretch;flex-direction:column}.st-about__actions :global(a),.st-about__cta :global(a){justify-content:center}}@media(prefers-reduced-motion:reduce){.st-about__eyebrow span{animation:none}}
</style>