---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import BusinessHero from "../components/business/BusinessHero.astro";
import BusinessWorkspace from "../components/business/BusinessWorkspace.astro";
import BusinessFlow from "../components/business/BusinessFlow.astro";
import BusinessIntelligence from "../components/business/BusinessIntelligence.astro";
import BusinessCta from "../components/business/BusinessCta.astro";
import "../styles/business/business.css";

const title = "Chakusa for service businesses | Enquiries, bookings and repeat customers";
const description = "Run enquiries, bookings, customer records, reviews, follow-up, and repeat customer activity from one connected Chakusa workspace.";
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: String(Astro.site) },
    { "@type": "ListItem", position: 2, name: "For businesses", item: new URL("/business", Astro.site).toString() },
  ],
};
---
<MarketingLayout {title} {description}>
  <SkipLink />
  <Header />
  <main id="main-content">
    <BusinessHero />
    <BusinessWorkspace />
    <BusinessFlow />
    <BusinessIntelligence />
    <BusinessCta />
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
</MarketingLayout>
