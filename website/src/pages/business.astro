---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import BusinessStitchHeader from "../components/business/BusinessStitchHeader.astro";
import BusinessStitchDashboard from "../components/business/BusinessStitchDashboard.astro";
import BusinessStitchWorkflow from "../components/business/BusinessStitchWorkflow.astro";
import BusinessStitchControls from "../components/business/BusinessStitchControls.astro";
import BusinessStitchSpotlight from "../components/business/BusinessStitchSpotlight.astro";
import BusinessStitchCta from "../components/business/BusinessStitchCta.astro";
import "../styles/business/business-stitch.css";
import "../styles/business/business-stitch-fixes.css";

const title = "Chakusa for service businesses | Enquiries, bookings and repeat customers";
const description = "Run enquiries, bookings, customer records, reviews, follow-up, and repeat customer activity from one connected Chakusa workspace.";
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: String(Astro.site) },
    { "@type": "ListItem", position: 2, name: "For businesses", item: new URL("/business", Astro.site).toString() },
  ],
};
---
<MarketingLayout {title} {description}>
  <SkipLink />
  <Header />
  <main id="main-content">
    <BusinessStitchHeader />
    <BusinessStitchDashboard />
    <BusinessStitchWorkflow />
    <BusinessStitchControls />
    <BusinessStitchSpotlight />
    <BusinessStitchCta />
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
</MarketingLayout>
