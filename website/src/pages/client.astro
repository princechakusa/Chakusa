---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import ClientStitchHeader from "../components/client/ClientStitchHeader.astro";
import ClientStitchDashboard from "../components/client/ClientStitchDashboard.astro";
import ClientStitchWorkflow from "../components/client/ClientStitchWorkflow.astro";
import ClientStitchControls from "../components/client/ClientStitchControls.astro";
import ClientStitchSpotlight from "../components/client/ClientStitchSpotlight.astro";
import ClientStitchCta from "../components/client/ClientStitchCta.astro";
import "../styles/business/business-stitch.css";
import "../styles/business/business-stitch-fixes.css";
import "../styles/client/client-stitch-fixes.css";

const title = "Chakusa for customers | Discover and book local businesses";
const description = "Browse local businesses, see real availability, book directly, and leave ungated reviews, all in the Chakusa app, no account required to start.";
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: String(Astro.site) },
    { "@type": "ListItem", position: 2, name: "For clients", item: new URL("/client", Astro.site).toString() },
  ],
};
---
<MarketingLayout {title} {description}>
  <SkipLink />
  <Header />
  <main id="main-content">
    <ClientStitchHeader />
    <ClientStitchDashboard />
    <ClientStitchWorkflow />
    <ClientStitchControls />
    <ClientStitchSpotlight />
    <ClientStitchCta />
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
</MarketingLayout>
