---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import ContactHero from "../components/contact/ContactHero.astro";
import ContactChannels from "../components/contact/ContactChannels.astro";
import ContactDispatch from "../components/contact/ContactDispatch.astro";
import ContactFaq from "../components/contact/ContactFaq.astro";
import "../styles/contact/contact-stitch.css";

const title = "Contact and Support | Chakusa";
const description = "Contact the Chakusa team for business onboarding, booking assistance, account support, privacy requests, partnerships, and product feedback.";
---
<MarketingLayout {title} {description}>
  <SkipLink />
  <Header />
  <main id="main-content">
    <ContactHero />
    <ContactChannels />
    <ContactDispatch />
    <ContactFaq />
  </main>
  <Footer />
</MarketingLayout>
