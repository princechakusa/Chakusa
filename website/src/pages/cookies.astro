---
import LegalLayout from "../components/legal/LegalLayout.astro";
import LegalToc from "../components/legal/LegalToc.astro";
import LegalDisclaimer from "../components/legal/LegalDisclaimer.astro";
import LegalContactPanel from "../components/legal/LegalContactPanel.astro";

const title = "Cookie Policy | Chakusa";
const description = "What this website does and does not store in your browser — and why the honest answer is 'nothing.'";

// Reproduces the approved Stitch cookie-page anatomy (hero band,
// sticky table-of-contents, a category-by-category breakdown, an FAQ,
// cross-links to the other legal pages, a contact block) but not its
// content. The Stitch source invents a full consent-management system
// with named cookies (__chk_auth_vault, __chk_perf_vitals, a
// telemetry.chakusa.io subdomain, IndexedDB "offline calendar caches",
// a 12-month consent-storage window, toggle switches that imply a
// working preference center) - none of that exists. Verified by grep
// across this entire website source: zero uses of document.cookie,
// localStorage, or sessionStorage. The real, and much simpler, answer
// is that this static marketing site sets nothing at all - that's the
// headline, not a category table dressed up to look substantial.
//
// The old hand-rolled "Related legal documents" section was removed
// when this page migrated onto LegalLayout, which now auto-appends a
// RelatedLegalDocuments component covering all other legal/trust docs
// (not just the 3 this page used to link) - see that component instead
// of duplicating it here. Remaining TOC entries were renumbered
// accordingly.
const lastUpdated = "Draft dated 2026-09-01";

const toc: Array<[string, string]> = [
  ["short", "1. The short version"],
  ["categories", "2. Cookie categories on this site"],
  ["storage", "3. Local storage & similar technology"],
  ["app", "4. The mobile app is different"],
  ["controls", "5. Your browser's own controls"],
  ["changes", "6. If that changes"],
  ["contact", "7. Questions"],
];

const categories = [
  ["Strictly necessary", "Not used", "This site doesn't set a session cookie, an auth token, or a CSRF cookie — there's no sign-in or checkout flow on the marketing website itself."],
  ["Preferences", "Not used", "Nothing is remembered between visits — no saved theme, no remembered tab, no dismissed banner."],
  ["Analytics", "Not used", "No page-view tracking, no performance telemetry, no third-party analytics script of any kind."],
  ["Marketing / advertising", "Not used", "No ad network, no referral-attribution cookie, no cross-site tracking pixel."],
];
---
<LegalLayout
  title={title}
  description={description}
  current="cookies"
  hero={{
    title: "Cookie Policy",
    lede: "What this website stores in your browser. The honest, verified answer is: nothing beyond what your browser needs to render the page.",
    status: "Engineering draft — not attorney-reviewed",
    lastUpdated: lastUpdated,
  }}
>
  <Fragment slot="hero-disclaimer">
    <LegalDisclaimer>Verified directly against this site's source code as of 2026-09-01 — there is no <code>document.cookie</code>, <code>localStorage</code>, or <code>sessionStorage</code> call anywhere in it. This is a factual statement about the current build, not a legal document, and hasn't been reviewed by a licensed attorney.</LegalDisclaimer>
  </Fragment>

  <div class="ck-grid">
    <LegalToc items={toc} ctaHref="mailto:privacy@chakusarecovery.com" ctaLabel="Ask a question" />

    <div class="ck-content">
      <article class="ck-quote">
        <p>“This website does not use tracking cookies, advertising cookies, or analytics cookies. There's no third-party tracking script on this site at all, so there's nothing to opt out of.”</p>
      </article>

      <section id="short">
        <h2>1. The short version</h2>
        <p>chakusarecovery.com sets no cookies and uses no browser storage to track, identify, or remember you across visits. There's no cookie banner on this site because there's nothing for it to ask permission for.</p>
      </section>

      <section id="categories">
        <h2>2. Cookie categories on this site</h2>
        <p>Most cookie policies list what each category does. Ours can say plainly that every category is unused:</p>
        <div class="ck-table-wrap"><table class="ck-table">
          <thead><tr><th>Category</th><th>Status</th><th>Why</th></tr></thead>
          <tbody>{categories.map(([cat, status, why]) => <tr><td>{cat}</td><td><span class="ck-status">{status}</span></td><td>{why}</td></tr>)}</tbody>
        </table></div>
      </section>

      <section id="storage">
        <h2>3. Local storage &amp; similar technology</h2>
        <p>Beyond cookies, some sites use <code>localStorage</code>, <code>sessionStorage</code>, or IndexedDB to remember things client-side. This site's code doesn't call any of those either — every page is static HTML with no client-side state to persist.</p>
      </section>

      <section id="app">
        <h2>4. The mobile app is different</h2>
        <p>The Chakusa mobile app doesn't use browser cookies at all — apps don't work that way — but it does store some information securely on your device (like your login session) to keep you signed in. That's covered in the <a href="/privacy">Privacy Policy</a>, not here.</p>
      </section>

      <section id="controls">
        <h2>5. Your browser's own controls</h2>
        <p>Because this site sets nothing, there's nothing here to clear. If you'd like to check for yourself, every modern browser has a way to inspect and clear site data (Chrome, Safari, Firefox, and Edge all expose this under their privacy or site-settings menus) — you'll find chakusarecovery.com has none stored.</p>
      </section>

      <section id="changes">
        <h2>6. If that changes</h2>
        <p>If we ever add analytics or a similar tool to this website, we'll update this page to say exactly what it does — the categories, the names, the retention — before it goes live, not after.</p>
      </section>

      <section id="contact" class="ck-contact">
        <h2>7. Questions</h2>
        <LegalContactPanel label="Questions about this policy" />
      </section>
    </div>
  </div>
</LegalLayout>

<style>
.ck-grid{width:min(100% - 2rem,72rem);margin-inline:auto;padding:3rem 0 5rem;display:grid;grid-template-columns:16rem minmax(0,1fr);gap:3rem;align-items:start}
.ck-content{min-width:0;display:grid;gap:2.5rem}
.ck-content>*{min-width:0}
.ck-quote{margin:0;padding:1.5rem 1.75rem;border-left:4px solid var(--secondary);border-radius:0 var(--r-lg) var(--r-lg) 0;background:#fff}
.ck-quote p{margin:0;color:var(--heading);font:600 1.1rem/1.55 var(--font-heading)}
.ck-content section{scroll-margin-top:6rem}
.ck-content h2{margin:0 0 .85rem;font:700 1.35rem/1.3 var(--font-heading);letter-spacing:-.02em}
.ck-content p{margin:0 0 .85rem;color:var(--body-text);font-size:.95rem;line-height:1.7}
.ck-content p:last-child{margin-bottom:0}
.ck-content a{color:var(--secondary);font-weight:700}
.ck-content code{padding:.1rem .3rem;border-radius:.3rem;background:#fff;border:1px solid var(--hairline);font-size:.85em}
.ck-table-wrap{min-width:0;overflow-x:auto;border:1px solid var(--hairline);border-radius:var(--r-lg)}
.ck-table{width:100%;border-collapse:collapse;font-size:.86rem}
.ck-table th{padding:.75rem 1rem;background:var(--page-surface);text-align:left;font:700 .72rem/1.2 var(--font);text-transform:uppercase;letter-spacing:.04em;color:var(--muted-text,#687184)}
.ck-table td{padding:.85rem 1rem;border-top:1px solid var(--hairline);vertical-align:top;color:var(--body-text)}
.ck-table td:first-child{white-space:nowrap;font-weight:700;color:var(--heading)}
.ck-status{display:inline-flex;padding:.2rem .55rem;border-radius:.4rem;background:#d7f6ee;color:var(--secondary);font-size:.78rem;font-weight:700}
@media(max-width:64rem){
  .ck-grid{grid-template-columns:1fr}
}
</style>
