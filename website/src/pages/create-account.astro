---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import RegistrationForm from "../components/auth/RegistrationForm.astro";
const title = "Create your Chakusa account";
const description = "Create a secure Chakusa client account or business workspace.";
---
<MarketingLayout {title} {description}><SkipLink /><Header />
  <main id="main-content" class="registration-page"><section class="registration-hero"><div class="container registration-shell">
    <header><p class="registration-kicker">Start securely</p><h1>Choose how you use Chakusa</h1><p>Create a personal client account, or open a workspace for the business you run.</p></header>
    <div class="realm-tabs" role="tablist" aria-label="Account type"><button role="tab" aria-selected="true" data-realm-tab="client"><span>For clients</span><small>Book and manage services</small></button><button role="tab" aria-selected="false" data-realm-tab="business"><span>For businesses</span><small>Run and grow your work</small></button></div>
    <div class="registration-card" data-registration-panel="client"><div class="registration-card__heading"><span class="registration-mark registration-mark--client" aria-hidden="true">C</span><div><p>Personal account</p><h2>Create your client profile</h2><span>Keep bookings, businesses, and service activity in one place.</span></div></div><RegistrationForm realm="client" /></div>
    <div class="registration-card" data-registration-panel="business" hidden><div class="registration-card__heading"><span class="registration-mark registration-mark--business" aria-hidden="true">B</span><div><p>Owner workspace</p><h2>Create your business</h2><span>Start with your identity and trade, then complete your operating setup.</span></div></div><RegistrationForm realm="business" /></div>
    <aside class="registration-security"><strong>Protected registration</strong><span>Cloudflare Turnstile blocks automated abuse. Chakusa hashes passwords with Argon2id and keeps session tokens in secure HttpOnly cookies.</span></aside>
    <p class="registration-login">Already have an account? <a href="/login">Sign in securely</a></p>
  </div></section></main><Footer />
</MarketingLayout>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script>
  const AUTH_GATEWAY="https://auth.chakusarecovery.com";const TURNSTILE_SITEKEY="0x4AAAAAAEpe472lujrUft2Q";
  type TurnstileApi={render:(node:HTMLElement,options:Record<string,unknown>)=>string;reset:(id:string)=>void};declare global{interface Window{turnstile?:TurnstileApi;chakusaRegistrationTurnstileReady?:boolean}}
  const tabs=[...document.querySelectorAll<HTMLButtonElement>("[data-realm-tab]")];const panels=[...document.querySelectorAll<HTMLElement>("[data-registration-panel]")];
  const selectRealm=(realm:string)=>{tabs.forEach(tab=>tab.setAttribute("aria-selected",String(tab.dataset.realmTab===realm)));panels.forEach(panel=>panel.hidden=panel.dataset.registrationPanel!==realm);const url=new URL(location.href);url.searchParams.set("type",realm);history.replaceState({},"",url);};tabs.forEach(tab=>tab.addEventListener("click",()=>selectRealm(tab.dataset.realmTab||"client")));selectRealm(new URLSearchParams(location.search).get("type")==="business"?"business":"client");
  document.querySelectorAll<HTMLButtonElement>("[data-password-toggle]").forEach(button=>button.addEventListener("click",()=>{const input=button.parentElement?.querySelector<HTMLInputElement>("input");if(!input)return;const visible=input.type==="text";input.type=visible?"password":"text";button.textContent=visible?"Show":"Hide";}));
  const initialise=()=>{if(!window.turnstile||window.chakusaRegistrationTurnstileReady)return false;window.chakusaRegistrationTurnstileReady=true;document.querySelectorAll<HTMLFormElement>("[data-registration-form]").forEach(form=>{const slot=form.querySelector<HTMLElement>("[data-turnstile]");const submit=form.querySelector<HTMLButtonElement>("[type=submit]");if(!slot||!submit)return;const id=window.turnstile!.render(slot,{sitekey:TURNSTILE_SITEKEY,action:"chakusa_register",theme:"light",callback:(token:string)=>{form.dataset.turnstileToken=token;submit.disabled=false;},"expired-callback":()=>{delete form.dataset.turnstileToken;submit.disabled=true;},"error-callback":()=>{delete form.dataset.turnstileToken;submit.disabled=true;}});form.dataset.widgetId=id;});return true;};const timer=window.setInterval(()=>{if(initialise())clearInterval(timer);},150);setTimeout(()=>clearInterval(timer),15000);
  document.querySelectorAll<HTMLFormElement>("[data-registration-form]").forEach(form=>form.addEventListener("submit",async event=>{event.preventDefault();const submit=form.querySelector<HTMLButtonElement>("[type=submit]");const message=form.querySelector<HTMLElement>("[data-form-message]");const data=new FormData(form);const password=String(data.get("password")||"");if(!submit||!message||!form.dataset.turnstileToken)return;if(password!==data.get("confirmPassword")){message.dataset.kind="error";message.textContent="The passwords do not match.";return;}if(!/(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{12,}/.test(password)){message.dataset.kind="error";message.textContent="Use at least 12 characters with uppercase, lowercase, and a number.";return;}submit.disabled=true;submit.setAttribute("aria-busy","true");message.dataset.kind="";message.textContent="Creating your secure account...";const payload:{[key:string]:unknown}={realm:form.dataset.realm,fullName:data.get("fullName"),email:data.get("email"),password,acceptedLegal:data.get("acceptedLegal")==="on",remember:data.get("remember")==="on",turnstileToken:form.dataset.turnstileToken};if(form.dataset.realm==="business"){payload.businessName=data.get("businessName");payload.industry=data.get("industry");}else{payload.displayName=data.get("displayName");payload.phone=data.get("phone");}try{const response=await fetch(`${AUTH_GATEWAY}/v1/register`,{method:"POST",credentials:"include",headers:{"content-type":"application/json"},body:JSON.stringify(payload)});const body=await response.json().catch(()=>({}));if(!response.ok)throw new Error(typeof body.error==="string"?body.error:"Account creation failed.");message.textContent="Account created. Opening your secure workspace...";location.assign(typeof body.next==="string"?body.next:`/dashboard/${form.dataset.realm}`);}catch(error){message.dataset.kind="error";message.textContent=error instanceof Error?error.message:"Account creation failed.";const id=form.dataset.widgetId;if(id)window.turnstile?.reset(id);delete form.dataset.turnstileToken;}finally{submit.removeAttribute("aria-busy");}}));
</script>
<style is:global>
.registration-page{background:#f7f8fb}.registration-hero{padding:4rem 0 5rem;background:radial-gradient(circle at 12% 18%,rgba(22,168,150,.14),transparent 28rem),radial-gradient(circle at 92% 10%,rgba(239,93,69,.13),transparent 26rem)}.registration-shell{max-width:52rem}.registration-shell>header{text-align:center}.registration-kicker{margin:0 0 .7rem;color:#0b7d6d;font-size:.73rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.registration-shell h1{margin:0;color:#172033;font:800 clamp(2.25rem,5vw,3.5rem)/1.06 var(--font-heading);letter-spacing:-.045em}.registration-shell>header>p:last-child{max-width:36rem;margin:1rem auto 0;color:#626d7e;line-height:1.65}.realm-tabs{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;margin:2rem auto 1rem;padding:.4rem;border:1px solid #e1e5eb;border-radius:1rem;background:#eceff4}.realm-tabs button{display:grid;gap:.18rem;padding:.85rem;border:0;border-radius:.72rem;background:transparent;color:#687282;cursor:pointer}.realm-tabs button[aria-selected=true]{background:#fff;color:#172033;box-shadow:0 .25rem .75rem rgba(31,39,56,.08)}.realm-tabs span{font-weight:800}.realm-tabs small{font-size:.73rem}.registration-card{padding:2rem;border:1px solid #e2e6ec;border-radius:1.35rem;background:#fff;box-shadow:0 1.4rem 3.5rem rgba(31,39,56,.09)}.registration-card__heading{display:flex;align-items:center;gap:1rem;padding-bottom:1.4rem;margin-bottom:1.4rem;border-bottom:1px solid #e8ebf0}.registration-mark{display:grid;place-items:center;width:3.4rem;height:3.4rem;border-radius:1rem;color:#fff;font:800 1.15rem var(--font-heading)}.registration-mark--client{background:#0d8b7c}.registration-mark--business{background:#d9452e}.registration-card__heading p{margin:0 0 .2rem;color:#718095;font-size:.68rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.registration-card__heading h2{margin:0;color:#172033;font:750 1.35rem/1.25 var(--font-heading)}.registration-card__heading div>span{display:block;margin-top:.28rem;color:#687282;font-size:.8rem}.registration-form{display:grid;gap:1rem}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.registration-form label:not(.legal-check):not(.remember){display:grid;gap:.42rem;color:#293246;font-size:.79rem;font-weight:750}.registration-form label>span:not(.password-field){color:#8490a0;font-weight:500}.registration-form input:not([type=checkbox]),.registration-form select{width:100%;min-height:3rem;padding:.75rem .85rem;border:1px solid #dce1e8;border-radius:.72rem;background:#fafbfc;color:#20242b;font:500 .9rem var(--font);outline:none}.registration-form input:focus,.registration-form select:focus{border-color:#5d6d81;background:#fff;box-shadow:0 0 0 3px rgba(75,95,119,.12)}.password-field{position:relative;display:block}.password-field input{padding-right:4rem!important}.password-field button{position:absolute;top:50%;right:.45rem;transform:translateY(-50%);padding:.4rem;border:0;background:transparent;color:#566276;font-size:.75rem;font-weight:750}.password-guidance{margin:-.35rem 0 0;color:#707b8b;font-size:.73rem}.legal-check,.remember{display:flex;align-items:flex-start;gap:.55rem;color:#586477;font-size:.78rem;line-height:1.5}.legal-check input,.remember input{width:1rem;height:1rem;margin-top:.1rem;accent-color:#172033;flex:none}.legal-check a{color:#9b2e1e;font-weight:750;text-decoration:underline}.turnstile-slot{min-height:4.1rem;display:flex;align-items:center;overflow:hidden}.registration-submit{display:flex;align-items:center;justify-content:center;gap:.7rem;min-height:3.3rem;border:0;border-radius:.76rem;color:#fff;font:800 .9rem var(--font);cursor:pointer}.registration-submit--client{background:#0d8b7c}.registration-submit--business{background:#d9452e}.registration-submit:disabled{opacity:.5;cursor:not-allowed}.form-message{min-height:1.2rem;margin:0;color:#657080;font-size:.8rem}.form-message[data-kind=error]{color:#a52626}.registration-security{display:flex;gap:.65rem;margin:1rem 0 0;padding:1rem 1.2rem;border:1px solid #dfe4eb;border-radius:.9rem;background:#eef2f6;color:#536074;font-size:.76rem;line-height:1.5}.registration-security strong{color:#263246;white-space:nowrap}.registration-login{text-align:center;margin:1.2rem 0 0;color:#687282;font-size:.83rem}.registration-login a{color:#9b2e1e;font-weight:800;text-decoration:underline}
@media(max-width:600px){.registration-hero{padding:2.7rem 0 4rem}.registration-card{padding:1.25rem}.field-grid{grid-template-columns:1fr}.registration-security{display:grid}.realm-tabs small{display:none}.turnstile-slot{transform:scale(.88);transform-origin:left center;width:114%}}
</style>
