---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
const title="Business dashboard | Chakusa";const description="Your private Chakusa business dashboard.";
---
<DashboardLayout {title} {description} realm="business">
  <nav slot="sidebar" aria-label="Business dashboard"><a href="/dashboard/business" aria-current="page"><span>⌂</span>Overview</a><a href="#activity"><span>↗</span>Activity</a><a href="#recovery"><span>◎</span>Recovery</a><a href="/dashboard/business/setup"><span>⚙</span>Business setup</a><a href="/contact"><span>?</span>Support</a></nav>
  <section class="dashboard-loading" data-loading><span></span><p>Opening your secure business dashboard...</p></section>
  <section class="dashboard-auth-required" data-auth-required hidden><h1>Sign in required</h1><p>Your business session is missing or has expired. Sign in again to continue.</p><a href="/login">Return to sign in</a></section>
  <div class="dashboard-content" data-dashboard-content hidden>
    <header class="dashboard-welcome"><div><p class="dashboard-eyebrow" data-business-name>Business workspace</p><h1><span data-greeting>Welcome</span>, <span data-owner-name>owner</span></h1><p>Here is the work that deserves your attention today.</p></div><a class="dashboard-action" href="/dashboard/business/setup">Business settings</a></header>
    <div class="dashboard-banner" data-setup-banner hidden><div><strong>Finish setting up your business</strong><span>Add your phone, opening hours, services, and review link.</span></div><a href="/dashboard/business/setup">Continue setup →</a></div>
    <div class="dashboard-legal" data-legal-warning hidden>Please review the current <a href="/terms">Terms</a>, <a href="/privacy">Privacy Policy</a>, and <a href="/ai-disclosure">AI Disclosure</a> in the Chakusa app.</div>
    <section class="dashboard-metrics" aria-label="Business summary"><article class="dashboard-metric"><span>Recovered revenue</span><strong data-revenue>0</strong><small>Won and collected work</small></article><article class="dashboard-metric"><span>Lead pipeline</span><strong data-leads>0</strong><small>All tracked opportunities</small></article><article class="dashboard-metric"><span>Customers</span><strong data-customers>0</strong><small>Connected customer records</small></article><article class="dashboard-metric"><span>Business health</span><strong data-health>New</strong><small>Operational score</small></article></section>
    <div class="dashboard-grid"><section class="dashboard-panel" id="activity"><h2>Recent activity</h2><div class="dashboard-list" data-activity-list></div></section><section class="dashboard-panel" id="recovery"><h2>Recovery snapshot</h2><div class="dashboard-list" data-recovery-list></div></section></div>
  </div>
</DashboardLayout>
<script>
  const text=(selector:string,value:unknown)=>{const node=document.querySelector<HTMLElement>(selector);if(node)node.textContent=String(value??"");};const money=(value:unknown,currency="USD")=>new Intl.NumberFormat(undefined,{style:"currency",currency,maximumFractionDigits:0}).format(Number(value)||0);
  const row=(mark:string,title:string,detail:string)=>{const item=document.createElement("div");item.className="dashboard-row";const icon=document.createElement("span");icon.className="dashboard-row__mark";icon.textContent=mark;const copy=document.createElement("div");copy.className="dashboard-row__copy";const strong=document.createElement("strong");strong.textContent=title;const small=document.createElement("span");small.textContent=detail;copy.append(strong,small);item.append(icon,copy);return item;};const empty=(message:string)=>{const node=document.createElement("div");node.className="dashboard-empty";node.textContent=message;return node;};
  const load=async()=>{try{const response=await fetch("https://auth.chakusarecovery.com/v1/dashboard",{credentials:"include"});if(response.status===401)throw new Error("unauthorized");const data=await response.json();if(!response.ok||data.realm!=="business")throw new Error("unavailable");const account=data.account||{};const business=data.business||{};const dash=data.dashboard||{};const hour=new Date().getHours();text("[data-greeting]",hour<12?"Good morning":hour<18?"Good afternoon":"Good evening");text("[data-owner-name]",account.user?.fullName?.split(" ")[0]||"owner");text("[data-business-name]",business.name||"Business workspace");text("[data-revenue]",money(dash.recoveredRevenue?.total,business.currency||"USD"));text("[data-leads]",dash.leads?.total||0);text("[data-customers]",dash.customerIntelligence?.totalCustomers||0);text("[data-health]",dash.businessHealth?.score==null?"New":`${dash.businessHealth.score}/100`);if(!business.onboardingCompletedAt)document.querySelector<HTMLElement>("[data-setup-banner]")!.hidden=false;const activity=document.querySelector<HTMLElement>("[data-activity-list]");const recent=Array.isArray(dash.recentActivity)?dash.recentActivity:[];if(activity){if(!recent.length)activity.append(empty("Business activity will appear here as you use Chakusa."));else recent.slice(0,6).forEach((item:any)=>activity.append(row("↗",String(item.type||"Activity").replaceAll("_"," "),item.createdAt?new Date(item.createdAt).toLocaleString():"Recent")));}const recovery=document.querySelector<HTMLElement>("[data-recovery-list]");if(recovery){recovery.append(row("☎","New leads",String(dash.leads?.new||0)));recovery.append(row("★","Reviews received",String(dash.reviews?.reviewsReceived||0)));recovery.append(row("↻","Customers due",String(dash.customersDue||0)));recovery.append(row("$","Outstanding",money(dash.recoveredRevenue?.outstanding,business.currency||"USD")));}const pending=data.legal?.pending;if(Array.isArray(pending)&&pending.length)document.querySelector<HTMLElement>("[data-legal-warning]")!.hidden=false;document.querySelector<HTMLElement>("[data-loading]")!.hidden=true;document.querySelector<HTMLElement>("[data-dashboard-content]")!.hidden=false;}catch{document.querySelector<HTMLElement>("[data-loading]")!.hidden=true;document.querySelector<HTMLElement>("[data-auth-required]")!.hidden=false;}};void load();
</script>
