---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";import DashboardNav from "../../../components/dashboard/DashboardNav.astro";
---
<DashboardLayout title="Payments | Chakusa" description="Protected payment readiness and Stripe connection status." realm="business"><DashboardNav slot="sidebar" realm="business" active="payments"/><section class="dashboard-loading" data-loading><span></span><p>Checking payment readiness securely...</p></section><section class="dashboard-auth-required" data-auth hidden><h1>Sign in required</h1><p>Your session is missing or has expired.</p><a href="/login">Return to sign in</a></section><div class="dashboard-content" data-content hidden><header class="dashboard-welcome"><div><p class="dashboard-eyebrow">Financial controls</p><h1>Payments</h1><p>Stripe payment infrastructure is isolated behind authenticated business and owner checks.</p></div></header><section class="payment-readiness"><article><span>Release state</span><strong data-release>Coming later</strong><p data-release-copy>Money movement stays disabled until Chakusa completes its payment release review.</p></article><article><span>Stripe account</span><strong data-connect-state>Not connected</strong><p data-connect-copy>No Stripe account is connected to this workspace.</p></article><article><span>Protection</span><strong>Cloudflare and API roles</strong><p>Browser tokens are HttpOnly. Business ownership and record tenancy are checked again by the API.</p></article></section><section class="dashboard-panel"><h2>Activation controls</h2><p class="dashboard-panel-copy">When payments are enabled, only a signed-in owner can begin Stripe onboarding. Refunds and appointment payment links are not exposed by this web dashboard before the payment launch.</p><button class="dashboard-action dashboard-action--button" type="button" data-connect hidden>Connect Stripe securely</button><p class="setup-message" data-message role="status"></p></section></div></DashboardLayout>
<script>const load=async()=>{const loading=document.querySelector<HTMLElement>("[data-loading]")!;try{const response=await fetch("https://auth.chakusarecovery.com/v1/business/payments",{credentials:"include"});if(response.status===401)throw new Error("auth");const data=await response.json();if(!response.ok)throw new Error(data.error||"unavailable");document.querySelector<HTMLElement>("[data-release]")!.textContent=data.enabled?"Enabled":"Coming later";document.querySelector<HTMLElement>("[data-release-copy]")!.textContent=data.enabled?"Payment onboarding is available for this environment.":"Payment code is present, but money movement is deliberately disabled in production.";document.querySelector<HTMLElement>("[data-connect-state]")!.textContent=data.connected?"Connected":"Not connected";document.querySelector<HTMLElement>("[data-connect-copy]")!.textContent=data.chargesEnabled&&data.payoutsEnabled?"Charges and payouts are ready.":data.connected?"Stripe onboarding is not yet complete.":"No Stripe account is connected to this workspace.";if(data.enabled&&!data.connected)document.querySelector<HTMLButtonElement>("[data-connect]")!.hidden=false;loading.hidden=true;document.querySelector<HTMLElement>("[data-content]")!.hidden=false;}catch{loading.hidden=true;document.querySelector<HTMLElement>("[data-auth]")!.hidden=false;}};document.querySelector<HTMLButtonElement>("[data-connect]")?.addEventListener("click",async()=>{const message=document.querySelector<HTMLElement>("[data-message]")!;message.textContent="Opening protected Stripe onboarding...";const response=await fetch("https://auth.chakusarecovery.com/v1/business/payments/connect",{method:"POST",credentials:"include",headers:{"content-type":"application/json"},body:"{}"});const data=await response.json();if(response.ok&&typeof data.url==="string")location.assign(data.url);else message.textContent=data.error||"Stripe onboarding is unavailable.";});void load();</script>
