---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import DashboardNav from "../../../components/dashboard/DashboardNav.astro";
import PageStates from "../../../components/dashboard/PageStates.astro";
---
<DashboardLayout title="Payments | Chakusa" description="Get paid online with Stripe." realm="business">
  <DashboardNav slot="sidebar" realm="business" active="payments" />
  <PageStates loadingText="Checking your payment setup..." />
  <div class="dashboard-content catalog" data-page-content hidden>
    <header class="dashboard-welcome"><div><p class="dashboard-eyebrow">Money</p><h1>Payments</h1><p>Take card payments for invoices and deposits through Stripe. Money goes straight to your bank account.</p></div></header>

    <section class="overview__metrics payments__metrics" data-money></section>

    <section class="dashboard-panel payments__status">
      <div class="payments__badge" data-status-badge></div>
      <div>
        <h2 data-status-title>Checking...</h2>
        <p data-status-copy></p>
        <ul class="state-card__benefits payments__steps" data-steps hidden>
          <li>Connect a Stripe account (about 5 minutes)</li>
          <li>Stripe verifies your business and bank details</li>
          <li>Customers can then pay invoices and deposits by card</li>
        </ul>
        <div class="sales-doc__actions"><button class="dashboard-action dashboard-action--button" type="button" data-connect hidden>Connect Stripe</button></div>
        <p class="setup-message" data-message role="status"></p>
      </div>
    </section>

    <section class="dashboard-panel">
      <div class="dashboard-section-heading"><div><h2>How it works</h2></div></div>
      <ul class="suggestions">
        <li class="suggestions__item">Chakusa never stores card numbers. Payments are processed by Stripe.</li>
        <li class="suggestions__item">Payment status on invoices updates automatically when Stripe confirms a payment.</li>
        <li class="suggestions__item">Refunds are issued from the Chakusa app by the owner or an admin.</li>
      </ul>
    </section>
  </div>
</DashboardLayout>

<script>
  import { can } from "../../../scripts/capabilities.js";
  import { api, loadIdentity, pageStates, money, el, AuthRequired } from "../../../scripts/dashboardApi";

  const page = pageStates();
  const $ = <T extends HTMLElement = HTMLElement>(selector: string) => document.querySelector<T>(selector);
  /** Only follow Stripe's own onboarding pages. */
  const stripeUrl = (value: unknown) => {
    if (typeof value !== "string") return null;
    try { const url = new URL(value); return url.protocol === "https:" && /(^|\.)stripe\.com$/.test(url.hostname) ? url.toString() : null; } catch { return null; }
  };

  const load = async () => {
    try {
      const [identity, status] = await Promise.all([loadIdentity(), api("/v1/business/payments")]);
      const currency = identity.business?.currency || "USD";
      const revenue = identity.dashboard?.recoveredRevenue ?? {};
      $("[data-money]")!.replaceChildren(
        el("article", { className: "overview__metric" }, el("span", { text: "Collected from bookings" }), el("strong", { text: money(revenue.appointmentCollected ?? 0, currency) }), el("small", { text: "Recorded payments" })),
        el("article", { className: "overview__metric" }, el("span", { text: "Outstanding" }), el("strong", { text: money(Number(revenue.outstanding ?? 0) + Number(revenue.appointmentOutstanding ?? 0), currency) }), el("small", { text: "Owed to you" })),
      );
      const ready = status.connected && status.chargesEnabled && status.payoutsEnabled;
      const badge = $("[data-status-badge]")!;
      badge.dataset.state = ready ? "ready" : status.connected ? "pending" : "off";
      badge.textContent = ready ? "✓" : status.connected ? "…" : "$";
      if (!status.enabled) {
        $("[data-status-title]")!.textContent = "Online payments are coming soon";
        $("[data-status-copy]")!.textContent = "Card payments aren't switched on for Chakusa yet. You can still record payments you take in person, and we'll let you know as soon as online payments open.";
      } else if (ready) {
        $("[data-status-title]")!.textContent = "You're ready to take payments";
        $("[data-status-copy]")!.textContent = "Your Stripe account is connected and verified. Customers can pay invoices and deposits by card.";
      } else if (status.connected) {
        $("[data-status-title]")!.textContent = "Finish your Stripe setup";
        $("[data-status-copy]")!.textContent = "Stripe still needs some details before you can take payments. Continue where you left off.";
        if (can(identity.role, "payments.manage")) { $("[data-connect]")!.textContent = "Continue Stripe setup"; $("[data-connect]")!.hidden = false; }
      } else {
        $("[data-status-title]")!.textContent = "Get paid online";
        $("[data-status-copy]")!.textContent = "Connect Stripe so customers can pay by card.";
        $("[data-steps]")!.hidden = false;
        if (can(identity.role, "payments.manage")) $("[data-connect]")!.hidden = false;
        else $("[data-message]")!.textContent = "Only the business owner can connect Stripe.";
      }
      page.ready();
    } catch (error) { page.fail(error, () => void load()); }
  };

  $("[data-connect]")!.addEventListener("click", async () => {
    const button = $<HTMLButtonElement>("[data-connect]")!;
    const message = $("[data-message]")!;
    button.disabled = true;
    message.textContent = "Opening Stripe...";
    try {
      const data = await api("/v1/business/payments/connect", { method: "POST", body: {} });
      const target = stripeUrl(data?.url);
      if (!target) throw new Error("Stripe setup isn't available right now. Please try again later.");
      location.assign(target);
    } catch (error) {
      if (error instanceof AuthRequired) return page.fail(error);
      message.textContent = error instanceof Error ? error.message : "Stripe setup isn't available right now.";
      button.disabled = false;
    }
  });

  void load();
</script>
