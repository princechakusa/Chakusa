---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import DashboardNav from "../../../components/dashboard/DashboardNav.astro";
import PageStates from "../../../components/dashboard/PageStates.astro";
const title="Set up your business | Chakusa";const description="Complete your secure Chakusa business setup.";
const industries=[["barber","Barber"],["hair_salon","Hair salon"],["beauty_salon","Beauty salon"],["spa","Spa and massage"],["dentist","Dentist"],["gym","Gym"],["restaurant","Restaurant"],["mechanic","Mechanic"],["car_wash","Car wash"],["cleaning","Cleaning"],["electrician","Electrician"],["photographer","Photographer"],["moving_company","Moving company"],["plumber","Plumber"],["hvac","HVAC"],["home_services","Other home service"]];
---
<DashboardLayout {title} {description} realm="business">
  <DashboardNav slot="sidebar" realm="business" active="setup" />
  <PageStates loadingText="Loading your business settings..." />
  <div class="dashboard-content setup-shell" data-page-content hidden>
    <header class="dashboard-welcome"><div><p class="dashboard-eyebrow">Business setup</p><h1>Make Chakusa fit your business</h1><p>This follows the same core setup as the mobile app. You can change every value later.</p></div></header>
    <div class="setup-progress" aria-label="Setup progress"><span data-progress="1" data-active="true"></span><span data-progress="2"></span><span data-progress="3"></span><span data-progress="4"></span></div>
    <form class="setup-card setup-form" data-step="1"><h2>Business basics</h2><p>Tell customers who you are and how to reach you.</p><div class="setup-fields"><label>Business name<input name="name" maxlength="200" required /></label><label>Industry<select name="industry" required><option value="">Choose your industry</option>{industries.map(([value,label])=><option value={value}>{label}</option>)}</select></label></div><label>Business phone<input name="phone" autocomplete="tel" inputmode="tel" maxlength="40" placeholder="Include your country code" required /></label><div class="setup-actions"><button type="submit">Save and continue</button></div><p class="setup-message" data-setup-message></p></form>
    <form class="setup-card setup-form" data-step="2" hidden><h2>Opening hours</h2><p>Chakusa uses these hours for appointment availability and quiet periods.</p><div class="setup-fields"><label>Opening time<input name="opensAt" type="time" value="09:00" required /></label><label>Closing time<input name="closesAt" type="time" value="17:00" required /></label></div><div class="setup-days"><label><input name="weekdays" type="checkbox" checked disabled /> Monday to Friday</label><label><input name="saturday" type="checkbox" /> Open Saturday</label><label><input name="sunday" type="checkbox" /> Open Sunday</label></div><div class="setup-actions"><button type="button" data-back>Back</button><button type="submit">Save and continue</button></div><p class="setup-message" data-setup-message></p></form>
    <form class="setup-card setup-form" data-step="3" hidden><h2>Your services</h2><p data-services-intro>Add the services customers recognise. Separate each service with a comma.</p><p data-catalogue-note hidden>Your setup is complete, so services are now managed on the <a href="/dashboard/business/services">Services page</a>, with prices, durations, and staff. Continue to finish the remaining settings.</p><label data-services-field>Services<textarea name="services" maxlength="1000" placeholder="Haircut, Beard trim, Hot towel shave" required></textarea></label><div class="setup-actions"><button type="button" data-back>Back</button><button type="submit">Save and continue</button></div><p class="setup-message" data-setup-message></p></form>
    <form class="setup-card setup-form" data-step="4" hidden><h2>Grow your reputation</h2><p>Add the exact Google review page customers should open. You can skip this and finish it later.</p><label>Google review link <span>Optional</span><input name="googleReviewLink" type="url" inputmode="url" placeholder="https://g.page/r/.../review" /></label><div class="setup-actions"><button type="button" data-back>Back</button><button type="submit">Finish setup</button></div><p class="setup-message" data-setup-message></p></form>
  </div>
</DashboardLayout>
<script>
  import { pageStates, AuthRequired } from "../../../scripts/dashboardApi";
  const setupPage = pageStates();

  const GATEWAY="https://auth.chakusarecovery.com";let step=1;let business:{[key:string]:any}={};
  const setStep=(next:number)=>{step=Math.max(1,Math.min(4,next));document.querySelectorAll<HTMLElement>("[data-step]").forEach(card=>card.hidden=Number(card.dataset.step)!==step);document.querySelectorAll<HTMLElement>("[data-progress]").forEach(item=>item.dataset.active=String(Number(item.dataset.progress)<=step));window.scrollTo({top:0,behavior:"smooth"});};
  const request=async(path:string,method:"PATCH"|"POST",body?:unknown)=>{const response=await fetch(`${GATEWAY}${path}`,{method,credentials:"include",headers:body?{"content-type":"application/json"}:undefined,body:body?JSON.stringify(body):undefined});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(typeof data.error==="string"?data.error:"We could not save your changes.");return data;};
  const load=async()=>{try{const response=await fetch(`${GATEWAY}/v1/dashboard`,{credentials:"include"});const data=await response.json().catch(()=>({}));if(response.status===401||(response.ok&&data.realm!=="business"))throw new AuthRequired();if(!response.ok)throw new Error(typeof data.error==="string"?data.error:"Your settings couldn't load.");business=data.business||{};if(business.onboardingCompletedAt){document.querySelector<HTMLElement>("[data-services-field]")!.hidden=true;document.querySelector<HTMLElement>("[data-services-intro]")!.hidden=true;document.querySelector<HTMLElement>("[data-catalogue-note]")!.hidden=false;document.querySelector<HTMLTextAreaElement>('[name="services"]')!.required=false;}const first=document.querySelector<HTMLFormElement>('[data-step="1"]')!;(first.elements.namedItem("name") as HTMLInputElement).value=business.name||"";(first.elements.namedItem("industry") as HTMLSelectElement).value=business.industry||"";(first.elements.namedItem("phone") as HTMLInputElement).value=business.phone||"";const services=document.querySelector<HTMLTextAreaElement>('[name="services"]');if(services&&Array.isArray(business.defaultServices))services.value=business.defaultServices.join(", ");const review=document.querySelector<HTMLInputElement>('[name="googleReviewLink"]');if(review)review.value=business.googleReviewLink||"";setupPage.ready();}catch(error){setupPage.fail(error,()=>void load());}};void load();
  document.querySelectorAll<HTMLButtonElement>("[data-back]").forEach(button=>button.addEventListener("click",()=>setStep(step-1)));
  document.querySelectorAll<HTMLFormElement>("[data-step]").forEach(form=>form.addEventListener("submit",async event=>{event.preventDefault();const message=form.querySelector<HTMLElement>("[data-setup-message]")!;const submit=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;const data=new FormData(form);submit.disabled=true;message.textContent="Saving securely...";try{if(step===1){business=await request("/v1/business","PATCH",{name:String(data.get("name")||"").trim(),industry:data.get("industry"),phone:String(data.get("phone")||"").trim()});setStep(2);}else if(step===2){const opensAt=data.get("opensAt");const closesAt=data.get("closesAt");const day=(enabled:boolean)=>({enabled,opensAt,closesAt});const workingHours={version:1,days:{monday:day(true),tuesday:day(true),wednesday:day(true),thursday:day(true),friday:day(true),saturday:day(data.get("saturday")==="on"),sunday:day(data.get("sunday")==="on")}};business=await request("/v1/business","PATCH",{workingHours});setStep(3);}else if(step===3){if(business.onboardingCompletedAt){message.textContent="";setStep(4);return;}const services=String(data.get("services")||"").split(",").map(item=>item.trim()).filter(Boolean).slice(0,30);if(!services.length)throw new Error("Add at least one service.");business=await request("/v1/business","PATCH",{defaultServices:services});setStep(4);}else{const googleReviewLink=String(data.get("googleReviewLink")||"").trim();if(googleReviewLink)await request("/v1/business","PATCH",{googleReviewLink});await request("/v1/business/onboarding/complete","POST");location.assign("/dashboard/business");}message.textContent="";}catch(error){message.textContent=error instanceof Error?error.message:"We could not save your changes.";}finally{submit.disabled=false;}}));
</script>
