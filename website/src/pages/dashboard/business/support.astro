---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";import DashboardNav from "../../../components/dashboard/DashboardNav.astro";import DashboardCollection from "../../../components/dashboard/DashboardCollection.astro";
---
<DashboardLayout title="Support | Chakusa" description="Contact Chakusa support and track your requests." realm="business"><DashboardNav slot="sidebar" realm="business" active="support"/><DashboardCollection realm="business" eyebrow="Help" title="Support requests" intro="Tell us what is wrong and we will reply by email. Never include passwords or card numbers." endpoint="/v1/business/support" kind="support" createLabel="New support request" fields={[{name:"category",label:"Topic",required:true,options:["account","billing","booking","messaging","technical","other"]},{name:"subject",label:"Subject",required:true,placeholder:"A short summary"},{name:"message",label:"What happened?",type:"textarea",required:true,placeholder:"At least 10 characters"}]}/></DashboardLayout>
