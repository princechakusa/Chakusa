---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";import DashboardNav from "../../../components/dashboard/DashboardNav.astro";
---
<DashboardLayout title="Team | Chakusa" description="View your protected business team." realm="business"><DashboardNav slot="sidebar" realm="business" active="team"/><section class="dashboard-loading" data-loading><span></span><p>Opening your secure team workspace...</p></section><section class="dashboard-auth-required" data-auth hidden><h1>Sign in required</h1><p>Your session is missing or has expired.</p><a href="/login">Return to sign in</a></section><div class="dashboard-content" data-content hidden><header class="dashboard-welcome"><div><p class="dashboard-eyebrow">Access control</p><h1>Team</h1><p>Membership and role information comes directly from Chakusa's protected business API.</p></div></header><section class="dashboard-panel"><h2>Team summary</h2><div class="dashboard-records" data-team></div></section></div></DashboardLayout>
<script>const load=async()=>{const loading=document.querySelector<HTMLElement>("[data-loading]")!;try{const response=await fetch("https://auth.chakusarecovery.com/v1/business/team",{credentials:"include"});if(response.status===401)throw new Error("auth");const data=await response.json();if(!response.ok)throw new Error("unavailable");const root=document.querySelector<HTMLElement>("[data-team]")!;const items=Array.isArray(data.members)?data.members:Array.isArray(data.items)?data.items:[];if(!items.length){root.innerHTML='<div class="dashboard-empty">Your owner membership is active. Invite management remains available in the Chakusa app.</div>';}else for(const item of items){const row=document.createElement("article");row.className="dashboard-record";const name=document.createElement("strong");name.textContent=item.user?.fullName||item.name||"Team member";const role=document.createElement("span");role.textContent=item.role||item.status||"Active";row.append(name,role);root.append(row);}loading.hidden=true;document.querySelector<HTMLElement>("[data-content]")!.hidden=false;}catch{loading.hidden=true;document.querySelector<HTMLElement>("[data-auth]")!.hidden=false;}};void load();</script>
