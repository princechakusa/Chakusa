---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
const title="Client dashboard | Chakusa";const description="Your private Chakusa client dashboard.";
---
<DashboardLayout {title} {description} realm="client">
  <nav slot="sidebar" aria-label="Client dashboard"><a href="/dashboard/client" aria-current="page"><span>⌂</span>Home</a><a href="#upcoming"><span>□</span>Bookings</a><a href="#businesses"><span>♡</span>My businesses</a><a href="/contact"><span>?</span>Support</a></nav>
  <section class="dashboard-loading" data-loading><span></span><p>Opening your secure client dashboard...</p></section>
  <section class="dashboard-auth-required" data-auth-required hidden><h1>Sign in required</h1><p>Your secure session is missing or has expired. Sign in again to continue.</p><a href="/login">Return to sign in</a></section>
  <div class="dashboard-content" data-dashboard-content hidden>
    <header class="dashboard-welcome"><div><p class="dashboard-eyebrow">Client home</p><h1>Welcome, <span data-client-name>there</span></h1><p>Your bookings and trusted businesses, together in one secure place.</p></div><a class="dashboard-action" href="/industries">Find a service</a></header>
    <div class="dashboard-legal" data-legal-warning hidden>Please review the current <a href="/terms">Terms</a>, <a href="/privacy">Privacy Policy</a>, and <a href="/ai-disclosure">AI Disclosure</a> in the Chakusa app.</div>
    <section class="dashboard-metrics" aria-label="Client summary"><article class="dashboard-metric"><span>Upcoming bookings</span><strong data-upcoming-count>0</strong><small>Confirmed and scheduled</small></article><article class="dashboard-metric"><span>Saved businesses</span><strong data-business-count>0</strong><small>Your trusted providers</small></article><article class="dashboard-metric"><span>Unread updates</span><strong data-unread-count>0</strong><small>Account notifications</small></article><article class="dashboard-metric"><span>Account</span><strong data-verified-state>Secure</strong><small>Email verification status</small></article></section>
    <div class="dashboard-grid"><section class="dashboard-panel" id="upcoming"><h2>Upcoming bookings</h2><div class="dashboard-list" data-upcoming-list></div></section><section class="dashboard-panel" id="businesses"><h2>Your businesses</h2><div class="dashboard-list" data-business-list></div></section></div>
  </div>
</DashboardLayout>
<script>
  const text=(selector:string,value:unknown)=>{const node=document.querySelector<HTMLElement>(selector);if(node)node.textContent=String(value??"");};
  const row=(mark:string,title:string,detail:string)=>{const item=document.createElement("div");item.className="dashboard-row";const icon=document.createElement("span");icon.className="dashboard-row__mark";icon.textContent=mark;const copy=document.createElement("div");copy.className="dashboard-row__copy";const strong=document.createElement("strong");strong.textContent=title;const small=document.createElement("span");small.textContent=detail;copy.append(strong,small);item.append(icon,copy);return item;};
  const empty=(message:string)=>{const node=document.createElement("div");node.className="dashboard-empty";node.textContent=message;return node;};
  const load=async()=>{try{const response=await fetch("https://auth.chakusarecovery.com/v1/dashboard",{credentials:"include"});if(response.status===401)throw new Error("unauthorized");const data=await response.json();if(!response.ok||data.realm!=="client")throw new Error("unavailable");const profile=data.account?.profile;const user=data.account?.user;const dashboard=data.dashboard||{};const upcoming=Array.isArray(dashboard.upcomingAppointments)?dashboard.upcomingAppointments:[];const businesses=Array.isArray(dashboard.savedBusinesses)?dashboard.savedBusinesses:Array.isArray(dashboard.businesses)?dashboard.businesses:[];text("[data-client-name]",profile?.displayName||user?.fullName?.split(" ")[0]||"there");text("[data-upcoming-count]",upcoming.length);text("[data-business-count]",businesses.length);text("[data-unread-count]",dashboard.unreadNotifications||0);text("[data-verified-state]",profile?.verified?"Verified":"Pending");const upcomingList=document.querySelector<HTMLElement>("[data-upcoming-list]");if(upcomingList){if(!upcoming.length)upcomingList.append(empty("No bookings yet. Explore local businesses when you are ready."));else upcoming.slice(0,6).forEach((item:any)=>upcomingList.append(row("□",item.serviceName||"Service booking",`${item.business?.name||"Local business"} · ${new Date(item.startsAt).toLocaleString()}`)));}const businessList=document.querySelector<HTMLElement>("[data-business-list]");if(businessList){if(!businesses.length)businessList.append(empty("Businesses you book or save will appear here."));else businesses.slice(0,6).forEach((item:any)=>{const business=item.business||item;businessList.append(row((business.name||"B").slice(0,1).toUpperCase(),business.name||"Business",business.industry||"Saved provider"));});}const pending=data.legal?.pending;if(Array.isArray(pending)&&pending.length)document.querySelector<HTMLElement>("[data-legal-warning]")!.hidden=false;document.querySelector<HTMLElement>("[data-loading]")!.hidden=true;document.querySelector<HTMLElement>("[data-dashboard-content]")!.hidden=false;}catch(error){document.querySelector<HTMLElement>("[data-loading]")!.hidden=true;document.querySelector<HTMLElement>("[data-auth-required]")!.hidden=false;}};void load();
</script>
