---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DashboardNav from "../../components/dashboard/DashboardNav.astro";
import PageStates from "../../components/dashboard/PageStates.astro";
---
<DashboardLayout title="Home | Chakusa" description="Your bookings, invoices and rewards in one place." realm="client">
  <DashboardNav slot="sidebar" realm="client" active="overview" />
  <PageStates realm="client" backHref="/" loadingText="Opening your account..." />
  <div class="dashboard-content overview" data-page-content hidden>
    <header class="dashboard-welcome">
      <div><p class="dashboard-eyebrow">Your Chakusa</p><h1 data-greeting>Welcome</h1><p>Your bookings, invoices and rewards, in one place.</p></div>
      <div class="page-actions"><a class="dashboard-action" href="/industries">Find a service</a></div>
    </header>
    <div class="dashboard-legal" data-legal-warning hidden>Please review the updated <a href="/terms">Terms</a>, <a href="/privacy">Privacy Policy</a> and <a href="/ai-disclosure">AI Disclosure</a>.</div>
    <section class="overview__metrics" aria-label="Summary" data-metrics></section>
    <div class="overview__grid">
      <section class="dashboard-panel">
        <div class="dashboard-section-heading"><div><h2>Coming up</h2></div><a class="section-link" href="/dashboard/client/bookings">All bookings</a></div>
        <div class="dashboard-records" data-upcoming></div>
      </section>
      <section class="dashboard-panel">
        <div class="dashboard-section-heading"><div><h2>Your businesses</h2></div><a class="section-link" href="/dashboard/client/businesses">See all</a></div>
        <div class="dashboard-records" data-businesses></div>
      </section>
    </div>
  </div>
</DashboardLayout>

<script>
  import { api, loadIdentity, pageStates, itemsOf, money, el, AuthRequired } from "../../scripts/dashboardApi";

  const page = pageStates();
  const $ = <T extends HTMLElement = HTMLElement>(selector: string) => document.querySelector<T>(selector);
  const SLUG = /^[a-z0-9][a-z0-9-]{0,79}$/i;
  const greeting = () => { const hour = new Date().getHours(); return hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening"; };
  const optional = <T,>(promise: Promise<T>) => promise.catch((error) => { if (error instanceof AuthRequired) throw error; return null; });

  const load = async () => {
    try {
      const identity = await loadIdentity();
      if (identity.realm !== "client") throw new AuthRequired();
      const [wallet, invoices] = await Promise.all([optional(api("/v1/client/loyalty/wallet")), optional(api("/v1/client/invoices"))]);
      const dashboard = identity.dashboard ?? {};
      const profile = identity.account?.profile;
      const user = identity.account?.user;
      const first = String(profile?.displayName || user?.fullName || "").trim().split(/\s+/)[0];
      $("[data-greeting]")!.textContent = first ? `${greeting()}, ${first}` : greeting();

      const upcoming: any[] = Array.isArray(dashboard.upcomingAppointments) ? dashboard.upcomingAppointments : [];
      const businesses: any[] = Array.isArray(dashboard.savedBusinesses) ? dashboard.savedBusinesses : Array.isArray(dashboard.businesses) ? dashboard.businesses : [];
      const unpaid = itemsOf(invoices).filter((invoice) => Number(invoice.payment?.outstandingBalance ?? 0) > 0 && invoice.status === "SENT");
      const owed = unpaid.reduce((sum, invoice) => sum + Number(invoice.payment.outstandingBalance), 0);
      const metric = (name: string, value: string, note: string, href: string) => el("a", { className: "overview__metric", attrs: { href } }, el("span", { text: name }), el("strong", { text: value }), el("small", { text: note }));
      $("[data-metrics]")!.append(
        metric("Upcoming bookings", String(upcoming.length), upcoming.length ? "Coming up" : "Nothing booked", "/dashboard/client/bookings"),
        metric("To pay", unpaid.length ? money(owed, unpaid[0]?.currency) : "Nothing", unpaid.length ? `${unpaid.length} invoice${unpaid.length === 1 ? "" : "s"}` : "You're all paid up", "/dashboard/client/invoices"),
        metric("Reward points", String(wallet?.totalPoints ?? 0), wallet?.rewards?.issued ? `${wallet.rewards.issued} reward${wallet.rewards.issued === 1 ? "" : "s"} ready to use` : "Earn points when you book", "/dashboard/client/rewards"),
        metric("Updates", String(dashboard.unreadNotifications ?? 0), dashboard.unreadNotifications ? "Unread" : "All caught up", "/dashboard/client/notifications"),
      );

      const upcomingRoot = $("[data-upcoming]")!;
      if (!upcoming.length) upcomingRoot.append(el("div", { className: "dashboard-empty", text: "No upcoming bookings. Find a local business and book in a few taps." }));
      for (const booking of upcoming.slice(0, 6)) {
        const starts = new Date(booking.startsAt);
        upcomingRoot.append(el("article", { className: "dashboard-record" },
          el("span", { className: "overview__time", text: starts.toLocaleDateString(undefined, { month: "short", day: "numeric" }) }),
          el("div", {}, el("strong", { text: booking.serviceName || "Booking" }), el("span", { text: booking.business?.name || "" }), el("small", { text: starts.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" }) }))));
      }

      const businessRoot = $("[data-businesses]")!;
      if (!businesses.length) businessRoot.append(el("div", { className: "dashboard-empty", text: "Businesses you book with or follow appear here." }));
      for (const item of businesses.slice(0, 6)) {
        const business = item.business || item;
        const row = el("article", { className: "dashboard-record" }, el("span", { className: "dashboard-record__mark", text: String(business.name || "B").slice(0, 1).toUpperCase() }), el("div", {}, el("strong", { text: business.name || "Business" }), el("span", { text: business.industry ? String(business.industry).replaceAll("_", " ") : "Service provider" })));
        const slug = business.slug ?? business.publicSlug;
        if (typeof slug === "string" && SLUG.test(slug)) row.append(el("a", { className: "dashboard-record__open", text: "Book again", attrs: { href: `/b/${encodeURIComponent(slug)}` } }));
        businessRoot.append(row);
      }

      $("[data-legal-warning]")!.hidden = !(Array.isArray(identity.legal?.pending) && identity.legal.pending.length > 0);
      page.ready();
    } catch (error) { page.fail(error, () => void load()); }
  };
  void load();
</script>
