---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";import DashboardNav from "../../../components/dashboard/DashboardNav.astro";import PageStates from "../../../components/dashboard/PageStates.astro";
---
<DashboardLayout title="Account | Chakusa" description="Manage your secure Chakusa client profile." realm="client"><DashboardNav slot="sidebar" realm="client" active="account"/><PageStates realm="client" backHref="/dashboard/client" loadingText="Opening your account..." /><div class="dashboard-content setup-shell" data-page-content hidden><header class="dashboard-welcome"><div><p class="dashboard-eyebrow">Personal details</p><h1>Account</h1><p>Update the profile businesses see when you book.</p></div></header><section class="setup-card"><form class="setup-form" data-profile-form><label>Account email<input data-email disabled/></label><label>Display name<input name="displayName" maxlength="80" required/></label><label>Phone<input name="phone" maxlength="40" autocomplete="tel"/></label><label>Preferred timezone<input name="preferredTimezone" maxlength="60"/></label><div class="setup-actions"><button type="submit">Save account</button></div><p class="setup-message" data-message role="status"></p></form></section><section class="setup-card account-page__danger"><h2>Close account</h2><p>Permanently closes your Chakusa client account and signs you out everywhere. Businesses keep the records they need for bookings and invoices you already have with them.</p><form class="setup-form" data-close-form novalidate><label>Type CLOSE to confirm<input name="confirm" autocomplete="off" maxlength="5" required/></label><div class="setup-actions"><button type="submit" class="account-page__delete">Close my account</button></div><p class="setup-message" data-close-message role="status"></p></form></section></div></DashboardLayout>
<script>import { api, pageStates } from "../../../scripts/dashboardApi";const clientPage=pageStates();const gateway="https://auth.chakusarecovery.com";const form=document.querySelector<HTMLFormElement>("[data-profile-form]")!;const load=async()=>{try{const data=await api("/v1/client/profile");(form.elements.namedItem("displayName") as HTMLInputElement).value=data.displayName||"";(form.elements.namedItem("phone") as HTMLInputElement).value=data.phone||"";(form.elements.namedItem("preferredTimezone") as HTMLInputElement).value=data.preferredTimezone||Intl.DateTimeFormat().resolvedOptions().timeZone;(document.querySelector("[data-email]") as HTMLInputElement).value=data.user?.email||"";clientPage.ready();}catch(error){clientPage.fail(error,()=>void load());}};form.addEventListener("submit",async event=>{event.preventDefault();const data=new FormData(form);const message=document.querySelector<HTMLElement>("[data-message]")!;message.textContent="Saving securely...";const response=await fetch(`${gateway}/v1/client/profile`,{method:"PATCH",credentials:"include",headers:{"content-type":"application/json"},body:JSON.stringify({displayName:data.get("displayName"),phone:data.get("phone")||null,preferredTimezone:data.get("preferredTimezone")})});const body=await response.json();message.textContent=response.ok?"Account saved.":body.error||"Account could not be saved.";});const closeForm=document.querySelector<HTMLFormElement>("[data-close-form]")!;closeForm.addEventListener("submit",async event=>{event.preventDefault();const message=document.querySelector<HTMLElement>("[data-close-message]")!;const submit=closeForm.querySelector<HTMLButtonElement>("[type=submit]")!;if((closeForm.elements.namedItem("confirm") as HTMLInputElement).value!=="CLOSE"){message.textContent="Type CLOSE in capitals to confirm.";return;}if(!window.confirm("Close your Chakusa account permanently? This cannot be undone."))return;submit.disabled=true;message.textContent="Closing your account securely...";try{const response=await fetch(`${gateway}/v1/client/account/close`,{method:"POST",credentials:"include",headers:{"content-type":"application/json"},body:"{}"});const body=await response.json().catch(()=>({}));if(!response.ok)throw new Error(typeof body.error==="string"?body.error:"Your account could not be closed.");location.replace("/?account=closed");}catch(error){message.textContent=error instanceof Error?error.message:"Your account could not be closed.";submit.disabled=false;}});void load();</script>
