---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";import DashboardNav from "../../../components/dashboard/DashboardNav.astro";
---
<DashboardLayout title="Account | Chakusa" description="Manage your secure Chakusa client profile." realm="client"><DashboardNav slot="sidebar" realm="client" active="account"/><section class="dashboard-loading" data-loading><span></span><p>Opening your secure account...</p></section><section class="dashboard-auth-required" data-auth hidden><h1>Sign in required</h1><p>Your session is missing or has expired.</p><a href="/login">Return to sign in</a></section><div class="dashboard-content setup-shell" data-content hidden><header class="dashboard-welcome"><div><p class="dashboard-eyebrow">Personal details</p><h1>Account</h1><p>Update the profile businesses see when you book.</p></div></header><section class="setup-card"><form class="setup-form" data-profile-form><label>Account email<input data-email disabled/></label><label>Display name<input name="displayName" maxlength="80" required/></label><label>Phone<input name="phone" maxlength="40" autocomplete="tel"/></label><label>Preferred timezone<input name="preferredTimezone" maxlength="60"/></label><div class="setup-actions"><button type="submit">Save account</button></div><p class="setup-message" data-message role="status"></p></form></section></div></DashboardLayout>
<script>const gateway="https://auth.chakusarecovery.com";const form=document.querySelector<HTMLFormElement>("[data-profile-form]")!;const load=async()=>{const loading=document.querySelector<HTMLElement>("[data-loading]")!;try{const response=await fetch(`${gateway}/v1/client/profile`,{credentials:"include"});if(response.status===401)throw new Error("auth");const data=await response.json();if(!response.ok)throw new Error("unavailable");(form.elements.namedItem("displayName") as HTMLInputElement).value=data.displayName||"";(form.elements.namedItem("phone") as HTMLInputElement).value=data.phone||"";(form.elements.namedItem("preferredTimezone") as HTMLInputElement).value=data.preferredTimezone||Intl.DateTimeFormat().resolvedOptions().timeZone;(document.querySelector("[data-email]") as HTMLInputElement).value=data.user?.email||"";loading.hidden=true;document.querySelector<HTMLElement>("[data-content]")!.hidden=false;}catch{loading.hidden=true;document.querySelector<HTMLElement>("[data-auth]")!.hidden=false;}};form.addEventListener("submit",async event=>{event.preventDefault();const data=new FormData(form);const message=document.querySelector<HTMLElement>("[data-message]")!;message.textContent="Saving securely...";const response=await fetch(`${gateway}/v1/client/profile`,{method:"PATCH",credentials:"include",headers:{"content-type":"application/json"},body:JSON.stringify({displayName:data.get("displayName"),phone:data.get("phone")||null,preferredTimezone:data.get("preferredTimezone")})});const body=await response.json();message.textContent=response.ok?"Account saved.":body.error||"Account could not be saved.";});void load();</script>
