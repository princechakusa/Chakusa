---
import MarketingLayout from "../layouts/MarketingLayout.astro";import Header from "../components/header/Header.astro";import Footer from "../components/footer/Footer.astro";
---
<MarketingLayout title="Forgot password | Chakusa" description="Request a secure, single-use Chakusa password reset link."><Header/><main class="recovery-page"><section class="recovery-card"><p class="dashboard-eyebrow">Account recovery</p><h1>Reset your password</h1><p>Choose your account type and enter its email. For privacy, Chakusa always returns the same response whether the account exists or not.</p><form data-recovery-form><fieldset><legend>Account type</legend><label><input type="radio" name="realm" value="client" checked/> Client</label><label><input type="radio" name="realm" value="business"/> Business</label></fieldset><label>Email address<input name="email" type="email" autocomplete="email" maxlength="254" required/></label><div data-turnstile></div><button type="submit" disabled>Send reset link</button><p data-message role="status"></p></form><a href="/login">Return to sign in</a></section></main><Footer/></MarketingLayout>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script>const form=document.querySelector<HTMLFormElement>("[data-recovery-form]")!;const submit=form.querySelector<HTMLButtonElement>("button")!;const message=form.querySelector<HTMLElement>("[data-message]")!;const timer=setInterval(()=>{const api=(window as any).turnstile;if(!api)return;clearInterval(timer);form.dataset.widget=api.render(form.querySelector("[data-turnstile]"),{sitekey:"0x4AAAAAAEpe472lujrUft2Q",action:"chakusa_forgot",callback:(token:string)=>{form.dataset.token=token;submit.disabled=false;}});},150);form.addEventListener("submit",async event=>{event.preventDefault();if(!form.dataset.token)return;submit.disabled=true;message.textContent="Sending secure reset instructions...";const data=new FormData(form);try{const response=await fetch("https://auth.chakusarecovery.com/v1/forgot-password",{method:"POST",credentials:"include",headers:{"content-type":"application/json"},body:JSON.stringify({realm:data.get("realm"),email:data.get("email"),turnstileToken:form.dataset.token})});const body=await response.json();if(!response.ok)throw new Error(body.error||"Request failed.");message.textContent=body.message;}catch(error){message.textContent=error instanceof Error?error.message:"Request failed.";}finally{const api=(window as any).turnstile;if(form.dataset.widget)api?.reset(form.dataset.widget);delete form.dataset.token;}});</script>
<style is:global>.recovery-page{min-height:70vh;padding:5rem 1rem;background:#f5f7fa}.recovery-card{max-width:34rem;margin:auto;padding:2rem;border:1px solid #e2e6ed;border-radius:1.2rem;background:#fff;box-shadow:0 1rem 3rem rgba(31,39,56,.08)}.recovery-card h1{margin:.3rem 0;font:800 2.2rem var(--font-heading);color:#172033}.recovery-card>p{color:#667184;line-height:1.6}.recovery-card form{display:grid;gap:1rem;margin:1.5rem 0}.recovery-card fieldset{display:flex;gap:1.2rem;border:0;padding:0}.recovery-card legend,.recovery-card form>label{display:grid;gap:.4rem;font-size:.8rem;font-weight:750;color:#354158}.recovery-card fieldset label{display:flex;gap:.4rem}.recovery-card input[type=email],.recovery-card input[type=password]{min-height:3rem;padding:.7rem;border:1px solid #dbe1e8;border-radius:.7rem}.recovery-card button{min-height:3.1rem;border:0;border-radius:.7rem;background:#d9452e;color:#fff;font-weight:800}.recovery-card button:disabled{opacity:.5}.recovery-card [data-message]{min-height:1.2rem;color:#536074;font-size:.8rem}.recovery-card>a{color:#9b2e1e;font-weight:750}</style>
