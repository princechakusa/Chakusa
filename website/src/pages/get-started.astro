---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const title = "Start free | Chakusa";
const description = "Chakusa is a mobile app. Download it to create your account and start on the Free plan, no card required.";
---
<BaseLayout {title} {description}>
  <SiteHeader />
  <main>
    <section class="page-hero content-shell" aria-labelledby="get-started-title">
      <p class="eyebrow">Start free</p>
      <h1 id="get-started-title">Chakusa runs on your phone.</h1>
      <p class="page-hero-support">There's no separate web account to create. Download the app, sign up in a couple of minutes, and you're on the Free plan immediately. No card required.</p>
    </section>

    <section class="get-started-steps content-shell" aria-label="How to get started" data-reveal>
      <ol class="get-started-list">
        <li><span class="get-started-step-num">1</span><div><b>Download Chakusa</b><p>Available for iPhone and Android.</p></div></li>
        <li><span class="get-started-step-num">2</span><div><b>Create your account</b><p>Tell us your business name and industry, takes about two minutes.</p></div></li>
        <li><span class="get-started-step-num">3</span><div><b>Start tracking</b><p>Add your first customer, lead, or reminder right away, on the Free plan.</p></div></li>
      </ol>

      <div class="app-badges" aria-label="Download links">
        <span class="app-badge" aria-disabled="true">App Store: coming soon</span>
        <span class="app-badge" aria-disabled="true">Google Play: coming soon</span>
      </div>
      <p class="provisional-note">Store listings aren't live yet. This page will link directly to them once they are.</p>
    </section>
  </main>
</BaseLayout>
