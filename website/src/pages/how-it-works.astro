---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import HowStitchHero from "../components/how-it-works/HowStitchHero.astro";
import HowStitchJourney from "../components/how-it-works/HowStitchJourney.astro";
import HowStitchTouchpoints from "../components/how-it-works/HowStitchTouchpoints.astro";
import HowStitchTrades from "../components/how-it-works/HowStitchTrades.astro";
import HowStitchFaq from "../components/how-it-works/HowStitchFaq.astro";
import HowStitchCta from "../components/how-it-works/HowStitchCta.astro";
import HowItWorksSchemas from "../components/how-it-works/HowItWorksSchemas.astro";
import "../styles/how-it-works/how-it-works-stitch.css";
const title = "How Chakusa Works | From First Enquiry to the Next Visit";
const description = "See how Chakusa turns a customer enquiry into a booking, a completed visit, a review, and a returning customer, all in one connected workflow for local service businesses.";
---
<MarketingLayout {title} {description}><HowItWorksSchemas /><SkipLink /><Header /><main id="main-content"><HowStitchHero /><HowStitchJourney /><HowStitchTouchpoints /><HowStitchTrades /><HowStitchFaq /><HowStitchCta /></main><Footer /></MarketingLayout>
