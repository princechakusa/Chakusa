---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import IndustryCard from "../components/IndustryCard.astro";
import CTASection from "../components/CTASection.astro";
import { industries } from "../data/industries";

const title = "Industries — Chakusa";
const description = "Chakusa is built for local, appointment-driven businesses — beauty, home services, automotive, and professional services.";
---
<BaseLayout {title} {description}>
  <SiteHeader current="industries" />
  <main>
    <section class="page-hero content-shell" aria-labelledby="industries-hero-title">
      <p class="eyebrow">Industries</p>
      <h1 id="industries-hero-title">Built for businesses that live on repeat customers.</h1>
      <p class="page-hero-support">If your business depends on people coming back — not one-off sales — Chakusa is built for you.</p>
    </section>

    <div class="industries-list content-shell" data-reveal>
      {industries.map((industry) => (
        <IndustryCard id={industry.id} title={industry.title} examples={industry.examples} copy={industry.copy} workflow={industry.workflow} />
      ))}
    </div>

    <CTASection heading="See what Chakusa tracks for your business." />
  </main>
</BaseLayout>
