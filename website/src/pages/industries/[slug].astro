---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import SkipLink from "../../components/foundation/SkipLink.astro";
import Header from "../../components/header/Header.astro";
import Footer from "../../components/footer/Footer.astro";
import CTASection from "../../components/CTASection.astro";
import IndustrySubnav from "../../components/industries/IndustrySubnav.astro";
import { industries } from "../../data/industries";
import { industryGroups, industryProfessionPages } from "../../data/industryNavigation";
import "../../styles/global.css";
import "../../styles/industries/explorer.css";

export function getStaticPaths() {
  const professionPages = industryProfessionPages.filter((industry) => !["barbers", "hair-salons", "beauty-clinics", "spas-massage"].includes(industry.id));
  return [...industries, ...professionPages].map((industry) => ({
    params: { slug: industry.id },
    props: { industry },
  }));
}

const { industry } = Astro.props;
const title = `${industry.title} businesses | Chakusa`;
const description = `${industry.headline} ${industry.detailIntro}`;
const categoryGroup = industryGroups.find((group) => group.overviewHref === `/industries/${industry.id}`);
const activeHref = `/industries/${industry.id}`;

// Workflow items are always written in Recover, Review, Retain order (see
// industries.ts's doc comment), so each index maps to a distinct icon
// instead of three identical checkmarks that differentiate nothing.
const workflowIcons = [
  // Recover: missed call
  '<path d="M4 5c0 7 6 13 13 13l1.5-3-4-2-1.5 1.5c-2-1-3.5-2.5-4.5-4.5L10 8 8 4 5 5.5A1 1 0 0 0 4 5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />',
  // Review: star
  '<path d="M11 3.5 13.2 8l5 .7-3.6 3.4.9 4.9-4.5-2.3-4.5 2.3.9-4.9L3.8 8.7l5-.7L11 3.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />',
  // Retain: clock
  '<path d="M11 5v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><circle cx="11" cy="11" r="7.5" stroke="currentColor" stroke-width="1.5" />',
];
---
<MarketingLayout {title} {description}>
  <SkipLink />
  <Header />
  <main id="main-content">
    <IndustrySubnav {activeHref} />
    <section class="page-hero content-shell" aria-labelledby="industry-detail-title">
      <a class="industry-detail-back" href="/industries">All industries</a>
      <p class="eyebrow">{"categoryLabel" in industry ? industry.categoryLabel : industry.title}</p>
      <h1 id="industry-detail-title">{industry.headline}</h1>
      <p class="page-hero-support">{industry.detailIntro}</p>
      <div class="industry-detail-examples">
        {industry.examples.map((example) => <span class="industry-detail-chip">{example}</span>)}
      </div>
    </section>

    {categoryGroup && (
      <section class="industry-detail-choices content-shell" aria-labelledby="industry-types-title">
        <p class="eyebrow">Choose your industry</p>
        <h2 id="industry-types-title">What type of {categoryGroup.label.toLowerCase()} business do you run?</h2>
        <p class="industry-detail-choices__support">Choose one to open the page built for that type of business.</p>
        <div class="industry-explorer__professions">
          {categoryGroup.professions.map((profession) => (
            <a href={profession.href}>
              <strong>{profession.label}</strong>
              <span>{profession.description}</span>
              <b aria-hidden="true">→</b>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="industry-detail-workflow content-shell" aria-labelledby="industry-workflow-title">
      <p class="eyebrow">How it works</p>
      <h2 id="industry-workflow-title">Recover, review, retain.</h2>
      <div class="problem-grid">
        {industry.workflow.map((item, i) => (
          <div class="problem-card">
            <svg class="problem-card-icon" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" set:html={workflowIcons[i]} />
            <p>{item}</p>
          </div>
        ))}
      </div>
      <p class="industry-detail-note">Don't see your exact business here? If you take appointments or rely on repeat visits, Chakusa most likely still fits. See the full <a href="/product">product breakdown</a>.</p>
    </section>

    <CTASection heading={`Try Starter free for your ${industry.title.toLowerCase()} business.`} support="14-day free trial." />
  </main>
  <Footer />
</MarketingLayout>
