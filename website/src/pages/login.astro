---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import AuthForm from "../components/auth/AuthForm.astro";
const title = "Secure sign in | Chakusa";
const description = "Sign in securely to your Chakusa client or business account.";
---
<MarketingLayout {title} {description}>
  <SkipLink /><Header />
  <main id="main-content" class="auth-page"><section class="auth-hero" aria-labelledby="login-title">
    <div class="auth-glow auth-glow--teal" aria-hidden="true"></div><div class="auth-glow auth-glow--coral" aria-hidden="true"></div>
    <div class="container auth-shell">
      <header class="auth-heading"><p class="auth-kicker"><span></span> Secure authentication gateway</p><h1 id="login-title">Sign in to Chakusa</h1><p>Choose the account you use. Client and business sessions remain separate from sign-in through sign-out.</p></header>
      <div class="auth-status" role="status" aria-live="polite" data-auth-status hidden></div>
      <div class="auth-grid">
        <article class="auth-card auth-card--client"><div class="auth-card__accent"></div><div class="auth-card__body">
          <div class="auth-card__intro"><div><span class="auth-badge">Client account</span><h2>Client portal</h2></div><svg class="auth-person" viewBox="0 0 100 118" role="img" aria-label="Flat illustration of a woman client"><circle cx="50" cy="39" r="27" fill="#ffe5df"/><path d="M28 40c0-19 9-30 23-30 16 0 25 11 25 31v10H28Z" fill="#26354c"/><ellipse cx="50" cy="43" rx="19" ry="22" fill="#d88b66"/><path d="M31 39c2-19 12-25 24-25 10 0 18 6 20 19-13-7-28-4-44 6Z" fill="#26354c"/><circle cx="43" cy="43" r="2" fill="#20242b"/><circle cx="58" cy="43" r="2" fill="#20242b"/><path d="M45 53c4 3 8 3 12 0" fill="none" stroke="#20242b" stroke-linecap="round" stroke-width="2"/><path d="M18 115c1-29 12-43 32-43s31 14 32 43Z" fill="#12998b"/><path d="M43 69h14v15H43z" fill="#d88b66"/><path d="m36 76 14 16 14-16 5 39H31Z" fill="#fff"/></svg></div>
          <p class="auth-card__copy">View booking activity and keep your personal service history connected to your client account.</p>
          <AuthForm realm="client" />
        </div><footer><span>New to Chakusa?</span><a href="/client">Explore the client experience →</a></footer></article>

        <article class="auth-card auth-card--business"><div class="auth-card__accent"></div><div class="auth-card__body">
          <div class="auth-card__intro"><div><span class="auth-badge">Business account</span><h2>Business console</h2></div><svg class="auth-person" viewBox="0 0 100 118" role="img" aria-label="Flat illustration of a man business owner"><circle cx="50" cy="39" r="27" fill="#ffe5df"/><ellipse cx="50" cy="43" rx="19" ry="22" fill="#b96f4e"/><path d="M30 38c0-18 9-27 22-27 15 0 22 10 22 25-7-8-15-12-25-12-7 0-13 5-19 14Z" fill="#26354c"/><path d="M32 34c-4 3-5 10-2 14M71 34c4 3 5 10 2 14" fill="none" stroke="#b96f4e" stroke-width="6"/><circle cx="43" cy="43" r="2" fill="#20242b"/><circle cx="58" cy="43" r="2" fill="#20242b"/><path d="M45 53c4 2 8 2 12 0" fill="none" stroke="#20242b" stroke-linecap="round" stroke-width="2"/><path d="M17 115c2-29 13-43 33-43 21 0 31 14 33 43Z" fill="#ef5d45"/><path d="M43 69h14v15H43z" fill="#b96f4e"/><path d="m36 76 14 16 14-16 4 39H32Z" fill="#fff"/><path d="M48 91h4l2 24h-8Z" fill="#26354c"/></svg></div>
          <p class="auth-card__copy">Access your schedule, enquiries, customers, reviews, and day-to-day business tools.</p>
          <AuthForm realm="business" />
        </div><footer><a href="/contact">Forgot your password?</a><a href="/get-started">Create a business account →</a></footer></article>
      </div>
      <aside class="security-panel" aria-labelledby="security-title"><div class="security-icon" aria-hidden="true">✓</div><div><h2 id="security-title">Protected from the first click</h2><p>Cloudflare checks automated abuse before credentials reach Chakusa. Passwords are verified using Argon2id, short-lived access tokens expire automatically, and rotating refresh tokens stay inside secure HttpOnly cookies.</p></div><ul><li>Separate account sessions</li><li>No browser token storage</li><li>Single-use bot verification</li></ul></aside>
      <p class="auth-help">Having trouble signing in? <a href="/contact">Contact Chakusa support</a> or email <a href="mailto:support@chakusarecovery.com">support@chakusarecovery.com</a>.</p>
    </div>
  </section></main><Footer />
</MarketingLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script>
  const AUTH_GATEWAY = "https://auth.chakusarecovery.com";
  const TURNSTILE_SITEKEY = "0x4AAAAAAEpe472lujrUft2Q";
  type TurnstileApi = { render: (node: HTMLElement, options: Record<string, unknown>) => string; reset: (id: string) => void };
  declare global { interface Window { turnstile?: TurnstileApi; chakusaTurnstileReady?: boolean } }
  const setStatus = (message: string) => { const status=document.querySelector<HTMLElement>("[data-auth-status]"); if(status){status.hidden=false;status.textContent=message;status.scrollIntoView({behavior:"smooth",block:"center"});} };
  const initialise = () => { if(!window.turnstile||window.chakusaTurnstileReady)return false; window.chakusaTurnstileReady=true; document.querySelectorAll<HTMLElement>("[data-auth-form]").forEach(form=>{const slot=form.querySelector<HTMLElement>("[data-turnstile]");const submit=form.querySelector<HTMLButtonElement>("[type=submit]");if(!slot||!submit)return;const widgetId=window.turnstile!.render(slot,{sitekey:TURNSTILE_SITEKEY,action:"chakusa_login",theme:"light",callback:(token:string)=>{form.dataset.turnstileToken=token;submit.disabled=false;},"expired-callback":()=>{delete form.dataset.turnstileToken;submit.disabled=true;},"error-callback":()=>{delete form.dataset.turnstileToken;submit.disabled=true;}});form.dataset.widgetId=widgetId;});return true;};
  const timer=window.setInterval(()=>{if(initialise())window.clearInterval(timer);},150);window.setTimeout(()=>window.clearInterval(timer),15000);
  document.querySelectorAll<HTMLButtonElement>("[data-password-toggle]").forEach(button=>button.addEventListener("click",()=>{const input=button.parentElement?.querySelector<HTMLInputElement>("input");if(!input)return;const showing=input.type==="text";input.type=showing?"password":"text";button.textContent=showing?"Show":"Hide";button.setAttribute("aria-label",showing?"Show password":"Hide password");}));
  document.querySelectorAll<HTMLFormElement>("[data-auth-form]").forEach(form=>form.addEventListener("submit",async event=>{event.preventDefault();const submit=form.querySelector<HTMLButtonElement>("[type=submit]");const message=form.querySelector<HTMLElement>("[data-form-message]");const data=new FormData(form);if(!submit||!message||!form.dataset.turnstileToken)return;submit.disabled=true;submit.setAttribute("aria-busy","true");message.dataset.kind="";message.textContent="Signing you in securely...";try{const response=await fetch(`${AUTH_GATEWAY}/v1/login`,{method:"POST",credentials:"include",headers:{"content-type":"application/json"},body:JSON.stringify({realm:form.dataset.realm,email:data.get("email"),password:data.get("password"),remember:data.get("remember")==="on",turnstileToken:form.dataset.turnstileToken})});const body=await response.json().catch(()=>({}));if(!response.ok)throw new Error(typeof body.error==="string"?body.error:"Sign-in failed. Please try again.");form.reset();form.hidden=true;setStatus(`You are securely signed in to your ${form.dataset.realm} account. Open the Chakusa app to continue.`);}catch(error){message.dataset.kind="error";message.textContent=error instanceof Error?error.message:"Sign-in failed. Please try again.";const widgetId=form.dataset.widgetId;if(widgetId)window.turnstile?.reset(widgetId);delete form.dataset.turnstileToken;}finally{submit.removeAttribute("aria-busy");}}));
</script>

<style is:global>
.auth-page{background:#f8f9fb}.auth-hero{position:relative;overflow:hidden;padding:4.5rem 0 5.5rem;background-image:radial-gradient(circle at 1px 1px,rgba(38,53,76,.08) 1px,transparent 0);background-size:38px 38px}.auth-glow{position:absolute;width:30rem;height:30rem;border-radius:50%;filter:blur(80px);opacity:.24;pointer-events:none}.auth-glow--teal{top:5rem;left:-15rem;background:#80e9dd}.auth-glow--coral{top:-12rem;right:-14rem;background:#ffb5a7}.auth-shell{position:relative;max-width:74rem}.auth-heading{text-align:center;max-width:47rem;margin:0 auto 2rem}.auth-kicker{display:inline-flex;align-items:center;gap:.55rem;margin:0 0 .8rem;padding:.45rem .8rem;border:1px solid #e2e7ef;border-radius:999px;background:rgba(255,255,255,.82);color:#0b7d6d;font-size:.72rem;font-weight:800;letter-spacing:.075em;text-transform:uppercase}.auth-kicker span{width:.5rem;height:.5rem;border-radius:50%;background:#18a995;box-shadow:0 0 0 .25rem rgba(24,169,149,.12)}.auth-heading h1{margin:0;color:#172033;font:800 clamp(2.25rem,5vw,3.7rem)/1.06 var(--font-heading);letter-spacing:-.045em}.auth-heading>p:last-child{max-width:38rem;margin:.9rem auto 0;color:#606a79;font-size:1.05rem;line-height:1.65}.auth-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem;max-width:68rem;margin:0 auto}.auth-card{overflow:hidden;display:flex;flex-direction:column;border:1px solid #e5e8ee;border-radius:1.4rem;background:#fff;box-shadow:0 1.2rem 3rem rgba(31,39,56,.09)}.auth-card__accent{height:.42rem}.auth-card--client .auth-card__accent{background:#16a896}.auth-card--business .auth-card__accent{background:#ef5d45}.auth-card__body{padding:1.8rem}.auth-card__intro{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.auth-badge{display:inline-flex;padding:.36rem .65rem;border-radius:999px;font-size:.72rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase}.auth-card--client .auth-badge{background:#dcf7f2;color:#08776a}.auth-card--business .auth-badge{background:#ffe5df;color:#a43220}.auth-card h2{margin:.7rem 0 0;color:#172033;font:750 1.62rem/1.2 var(--font-heading);letter-spacing:-.025em}.auth-person{width:5.4rem;height:6.4rem;flex:0 0 auto;overflow:visible}.auth-card__copy{min-height:3.25rem;margin:.7rem 0 1.35rem;color:#657080;font-size:.9rem;line-height:1.55}.auth-form{display:grid;gap:1rem}.auth-form>label:not(.remember){display:grid;gap:.42rem;color:#293246;font-size:.79rem;font-weight:750}.auth-form input[type=email],.auth-form input[type=password],.auth-form input[type=text]{width:100%;min-height:3rem;padding:.75rem .85rem;border:1px solid #dce1e8;border-radius:.72rem;background:#fafbfc;color:#20242b;font:500 .92rem/1.2 var(--font);outline:none}.auth-form input:focus{border-color:#5d6d81;background:#fff;box-shadow:0 0 0 3px rgba(75,95,119,.12)}.password-field{position:relative;display:block}.password-field input{padding-right:4rem!important}.password-field button{position:absolute;top:50%;right:.45rem;transform:translateY(-50%);padding:.45rem;border:0;background:transparent;color:#566276;font-size:.76rem;font-weight:750;cursor:pointer}.remember{display:flex;align-items:center;gap:.5rem;color:#5d6878;font-size:.8rem;line-height:1.35}.remember input{width:1rem;height:1rem;accent-color:#172033}.turnstile-slot{min-height:4.1rem;display:flex;align-items:center;overflow:hidden}.auth-submit{display:flex;align-items:center;justify-content:center;gap:.7rem;min-height:3.2rem;padding:.75rem 1rem;border:0;border-radius:.76rem;color:#fff;font:800 .9rem/1 var(--font);cursor:pointer;box-shadow:0 .55rem 1.2rem rgba(30,40,58,.13)}.auth-submit--client{background:#0d8b7c}.auth-submit--business{background:#d9452e}.auth-submit:hover:not(:disabled){filter:brightness(.95);transform:translateY(-1px)}.auth-submit:disabled{cursor:not-allowed;opacity:.5}.form-message{min-height:1.2rem;margin:0;color:#657080;font-size:.8rem;line-height:1.45}.form-message[data-kind=error]{color:#a52626}.auth-card footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:auto;padding:1rem 1.8rem;background:#f5f7fa;color:#667080;font-size:.78rem}.auth-card footer a{color:#334359;font-weight:750}.auth-card--client footer a{color:#08776a}.auth-card--business footer a:first-child{color:#a43220}.security-panel{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;max-width:68rem;margin:1.5rem auto 0;padding:1.2rem 1.35rem;border:1px solid #dde4ec;border-radius:1.15rem;background:rgba(238,242,248,.88)}.security-icon{display:grid;place-items:center;width:2.65rem;height:2.65rem;border-radius:.8rem;background:#fff;color:#08776a;font-size:1.25rem;font-weight:900}.security-panel h2{margin:0 0 .25rem;color:#253044;font:750 .98rem/1.2 var(--font-heading)}.security-panel p{max-width:40rem;margin:0;color:#657080;font-size:.76rem;line-height:1.5}.security-panel ul{display:grid;gap:.38rem;margin:0;padding:0;list-style:none;color:#445064;font-size:.72rem;font-weight:700}.security-panel li::before{content:"✓";margin-right:.4rem;color:#0b8f7f}.auth-help{text-align:center;margin:1.4rem 0 0;color:#687282;font-size:.8rem}.auth-help a{color:#9b2e1e;font-weight:750;text-decoration:underline;text-underline-offset:.2rem}.auth-status{max-width:68rem;margin:0 auto 1rem;padding:1rem 1.2rem;border:1px solid #a6ded4;border-radius:.9rem;background:#e9faf7;color:#076f63;font-size:.9rem;font-weight:700}
@media(max-width:800px){.auth-hero{padding:3rem 0 4rem}.auth-grid{grid-template-columns:1fr;max-width:34rem}.auth-card__copy{min-height:0}.security-panel{grid-template-columns:auto 1fr}.security-panel ul{grid-column:1/-1;padding-left:3.6rem}.auth-card footer{align-items:flex-start;flex-direction:column}.auth-person{width:4.9rem;height:5.8rem}}@media(max-width:430px){.auth-card__body{padding:1.25rem}.auth-card footer{padding:1rem 1.25rem}.auth-person{width:4.2rem;height:5rem}.turnstile-slot{transform:scale(.88);transform-origin:left center;width:114%}.security-panel{grid-template-columns:1fr}.security-panel ul{padding-left:0}.security-icon{display:none}}
</style>
