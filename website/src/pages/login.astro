---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const title = "Sign in | Chakusa";
const description = "Chakusa doesn't have a web dashboard yet. Sign in from the mobile app.";
---
<BaseLayout {title} {description}>
  <SiteHeader />
  <main>
    <section class="page-hero content-shell" aria-labelledby="login-title">
      <p class="eyebrow">Sign in</p>
      <h1 id="login-title">Sign in from the app.</h1>
      <p class="page-hero-support">Chakusa doesn't have a web dashboard today. Everything happens in the mobile app. Open Chakusa on your phone and sign in there with the account you created.</p>
      <a class="button button-primary" href="/get-started" style="margin-top:1.5rem">Don't have the app yet?</a>
    </section>
  </main>
</BaseLayout>
