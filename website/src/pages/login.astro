---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import TradeCharacter from "../components/homepage/TradeCharacter.astro";

const title = "Sign in | Chakusa";
const description = "Chakusa doesn't have a web dashboard yet. Sign in from the mobile app.";
---
<MarketingLayout {title} {description}>
  <SkipLink />
  <Header />
  <main id="main-content">
    <section class="signin container" aria-labelledby="login-title">
      <div class="signin__illustration" aria-hidden="true"><TradeCharacter /></div>
      <p class="signin__eyebrow">Sign in</p>
      <h1 id="login-title">Sign in from the app.</h1>
      <p>Chakusa doesn't have a web dashboard today. Everything happens in the mobile app. Open Chakusa on your phone and sign in there with the account you created.</p>
      <a class="ui-button ui-button--primary" href="/get-started">Don't have the app yet?</a>
    </section>
  </main>
  <Footer />
</MarketingLayout>
<style>
.signin{padding-block:5rem 6rem;text-align:center;max-width:34rem}
.signin__illustration{width:9rem;margin:0 auto 1.5rem;padding:1.25rem 1.25rem 2.5rem;border:1px solid var(--hairline);border-radius:var(--r-xl);background:linear-gradient(160deg,#fff,var(--page-surface));box-shadow:var(--shadow-overlay)}
.signin__eyebrow{margin:0 0 .5rem;color:var(--secondary);font:700 .7rem/1.2 var(--font);letter-spacing:.06em;text-transform:uppercase}
.signin h1{margin:0;color:var(--heading);font-family:var(--font-heading);font-size:clamp(1.9rem,4vw,2.4rem);line-height:1.2;letter-spacing:-.025em}
.signin>p:not(.signin__eyebrow){margin:1rem 0 2rem;color:var(--body-text);font-size:1rem;line-height:1.65}
</style>
