---
import LegalLayout from "../components/legal/LegalLayout.astro";
import LegalToc from "../components/legal/LegalToc.astro";
import LegalDisclaimer from "../components/legal/LegalDisclaimer.astro";
import LegalContactPanel from "../components/legal/LegalContactPanel.astro";

const title = "Privacy Policy | Chakusa";
const description = "How Chakusa collects, stores, and protects data across the CRM, marketplace, booking, loyalty, and AI features, including every third party involved and your rights under GDPR, UK GDPR, CCPA, and other privacy laws.";

// Reproduces the approved Stitch legal-page anatomy (hero band, sticky
// table-of-contents sidebar, numbered sections, a provider card grid,
// a closing contact block) with Chakusa's real facts substituted for
// Stitch's fabricated ones - see git history on this file for the full
// list of what was deliberately excluded (fake certifications, a named
// host that isn't real, invented SLAs). Two later corrections:
// (1) the hero's status badge was a pill-with-pulsing-dot "status
// chip" that read as an obviously templated/AI-generated design
// flourish and didn't match the rest of the site's plain-text kicker
// convention (see .product-kicker, .story-kicker) - removed in favor
// of plain text, here and on ai-disclosure.astro and about.astro.
// (2) the content itself was judged too thin next to a real company's
// privacy policy - expanded with more sections and more concrete
// detail (a definitions section, purpose-by-purpose data use, a named
// retention table, a security-measures list, a data-flow explanation)
// while adding nothing that isn't grounded in the real product.
const lastUpdated = "Draft dated 2026-09-01";

const toc: Array<[string, string]> = [
  ["scope", "1. Scope & definitions"],
  ["accounts", "2. Accounts covered by this policy"],
  ["collected", "3. Information we collect"],
  ["use", "4. How we use information"],
  ["ai", "5. AI features"],
  ["messages", "6. Text messages"],
  ["cookies", "7. Cookies & tracking"],
  ["shared", "8. Who we share it with"],
  ["transfers", "9. International data transfers"],
  ["automated", "10. Automated decisions"],
  ["retention", "11. How long we keep it"],
  ["security", "12. Security measures"],
  ["rights", "13. Your rights"],
  ["children", "14. Children's privacy"],
  ["breach", "15. If something goes wrong"],
  ["changes", "16. Changes to this policy"],
  ["contact", "17. Complaints & contact"],
];

const definitions = [
  ["Personal data", "Any information that identifies or could reasonably identify you — your name, email, phone number, or a booking tied to your account."],
  ["Processing", "Anything done with data: collecting it, storing it, using it to show you a booking, or deleting it."],
  ["Business account", "An account used to run a CRM, marketplace listing, bookings, and loyalty program for a local service business."],
  ["Customer account", "An account used to discover, book, and message businesses through Chakusa."],
  ["Processor / subprocessor", "A company Chakusa uses to help run the product (Section 8) — they only act on our instructions, for our stated purposes."],
];

const collected = [
  ["Business accounts", "Name, email, business details; Google/Apple profile basics if you sign in that way; the customer records you enter into the CRM (names, phone numbers, notes, messages). That data is yours, not ours — you're responsible for having the right to collect and store it.", "Directly from you"],
  ["Customer accounts", "Name, email, optional phone, booking history, loyalty points, marketplace searches and favorites, reviews, and messages/AI conversations.", "Directly from you"],
  ["Location", "Your approximate location, only if you allow it, to show nearby businesses in the marketplace.", "From your device, with permission"],
  ["Bookings & payments", "Appointment details (service, time, price, staff) and payment records (amount, status, refunds). Card details are handled entirely by Stripe — we never see or store them.", "From you and from Stripe"],
  ["Loyalty & referrals", "Points balances and history, redemption codes, membership plan details, and referral codes.", "Generated by the product"],
  ["Messages & AI", "Content of messages sent through Chakusa (SMS/WhatsApp via Twilio), and AI conversation content where an AI feature is used.", "Directly from you"],
  ["Technical", "Device push-notification tokens and error/diagnostic data. This website sets no tracking or advertising cookies (Section 7).", "Automatically, from your device"],
];

const uses = [
  ["Run the product", "Show your leads, bookings, loyalty balances, and marketplace listings."],
  ["Send messages", "Deliver messages you ask us to send, or that automation sends on your behalf, subject to opt-out (Section 6)."],
  ["Generate AI responses", "Where an AI feature is used, to draft or send a reply (Section 5)."],
  ["Notify you", "Push notifications about activity in your account."],
  ["Keep the service secure", "Detect abuse, enforce opt-outs, and investigate reported problems."],
  ["Comply with the law", "Retain financial and tax records where a law requires it."],
];

const providers = [
  ["Twilio", "Sends SMS and WhatsApp messages"],
  ["Stripe", "Processes booking payments, refunds, and business payouts (Stripe Connect)"],
  ["OpenAI / Anthropic", "Generate AI responses when an AI feature is used"],
  ["Expo", "Delivers push notifications"],
  ["Sentry", "Receives error/crash reports, configured to scrub auth tokens first"],
  ["Google / Apple", "Sign-in, and app-store billing for a business's plan"],
  ["Render", "Hosts the application servers"],
  ["Supabase", "Hosts the Postgres database"],
];

const retentionRows = [
  ["Account profile", "While the account is active, plus a reasonable buffer afterward"],
  ["Bookings & payment records", "While the account is active; financial records may be kept longer where tax or accounting law requires it"],
  ["Customer records entered by a business", "Controlled by that business — it's their data, kept per their own settings, not a fixed Chakusa schedule"],
  ["Messages (SMS/WhatsApp)", "While the account is active, plus a reasonable buffer afterward"],
  ["AI conversation content", "Currently indefinite, not on a fixed schedule — see the AI Disclosure for the retention improvement this points to"],
  ["Error/diagnostic logs (Sentry)", "Governed by Sentry's own retention window for our project, not stored separately by Chakusa"],
];

const security = [
  "Passwords are hashed with Argon2 — never stored in plain text, and not reversible.",
  "Sessions are rotated and scoped separately for business accounts, customer accounts, and internal admin access.",
  "Any linked sign-in credentials (Google/Apple) are encrypted at rest.",
  "Connections to Chakusa use HTTPS in transit.",
  "Internal access to production data is limited to what's needed to operate the service.",
  "Administrative actions are logged, including admin views of AI conversation content (see AI Disclosure Section 7).",
];
---
<LegalLayout
  title={title}
  description={description}
  current="privacy"
  hero={{
    title: "Privacy Policy",
    lede: "How Chakusa collects, stores, and protects data across the CRM, marketplace, booking, loyalty, and AI features — and what we deliberately don't do with it.",
    status: "Engineering draft — not attorney-reviewed",
    lastUpdated: lastUpdated,
  }}
>
  <Fragment slot="hero-disclaimer">
    <LegalDisclaimer>This page is grounded in a full backend audit of the actual product (<code>src/modules/*</code>, <code>prisma/schema.prisma</code>) as of 2026-09-01, not written as a legal document. It has not been reviewed by a licensed attorney, and shouldn't be relied on to establish legal compliance. See <a href="https://github.com/princechakusa/Chakusa/blob/master/docs/PRIVACY_ENGINEERING_FOLLOWUPS.md" target="_blank" rel="noopener">open engineering follow-ups</a> this page describes honestly rather than papering over.</LegalDisclaimer>
  </Fragment>

  <div class="pv-grid">
    <LegalToc items={toc} ctaHref="mailto:privacy@chakusarecovery.com" ctaLabel="Email the privacy team" />

    <div class="pv-content">
      <article class="pv-quote">
        <p>“Chakusa does not sell customer data, and does not use it to serve ads. The customer records a business enters are that business's data, not ours.”</p>
      </article>

      <section id="scope">
        <h2>1. Scope &amp; definitions</h2>
        <p>This policy covers chakusarecovery.com and the Chakusa app, for both business and customer accounts. A few terms used throughout, in plain language:</p>
        <div class="pv-table-wrap"><table class="pv-table">
          <tbody>{definitions.map(([term, body]) => <tr><td>{term}</td><td>{body}</td></tr>)}</tbody>
        </table></div>
      </section>

      <section id="accounts">
        <h2>2. Accounts covered by this policy</h2>
        <p>Chakusa has two kinds of accounts: <b>business accounts</b> (running a CRM, marketplace listing, bookings, and loyalty program) and <b>customer accounts</b> (people who discover, book, and message businesses through Chakusa). One person can hold both, and this policy covers both equally.</p>
      </section>

      <section id="collected">
        <h2>3. Information we collect</h2>
        <div class="pv-table-wrap"><table class="pv-table">
          <thead><tr><th>Category</th><th>What's collected</th><th>Source</th></tr></thead>
          <tbody>{collected.map(([cat, body, source]) => <tr><td>{cat}</td><td>{body}</td><td>{source}</td></tr>)}</tbody>
        </table></div>
      </section>

      <section id="use">
        <h2>4. How we use information</h2>
        <div class="pv-table-wrap"><table class="pv-table">
          <thead><tr><th>Purpose</th><th>What that means</th></tr></thead>
          <tbody>{uses.map(([purpose, body]) => <tr><td>{purpose}</td><td>{body}</td></tr>)}</tbody>
        </table></div>
        <p class="pv-note">We don't sell data, and we don't use it to serve ads — that applies to every purpose above, not just some of them.</p>
      </section>

      <section id="ai">
        <h2>5. AI features</h2>
        <p>Chakusa includes AI-powered features: a business-facing assistant that can draft or send replies to a business's customers (a business must turn this on), and an in-app assistant customers can chat with directly. Both send conversation content to a third-party AI provider (OpenAI or Anthropic, depending on configuration) to generate a response.</p>
        <p>Full detail — including which specific actions the AI can take, its default human-approval requirement, an honest description of a current consent gap, its data-retention behavior, and who inside Chakusa can view a conversation — is in the dedicated <a href="/ai-disclosure">AI Disclosure</a>, which is part of this Privacy Policy by reference.</p>
      </section>

      <section id="messages">
        <h2>6. Text messages</h2>
        <p>Message delivery runs through Twilio. Standard message and data rates may apply depending on the recipient's carrier. <strong>The business is responsible for having consent</strong> to message their customer, under whatever law applies where that customer lives (in the US, generally the TCPA; in Canada, CASL). If a customer replies STOP, Chakusa automatically registers that as an opt-out, and our automated messaging checks this before sending anything further.</p>
      </section>

      <section id="cookies">
        <h2>7. Cookies &amp; tracking</h2>
        <p>This marketing website sets no tracking or advertising cookies. The Chakusa app uses only the technical storage needed to keep you signed in and remember basic preferences — nothing sold to or shared with an ad network. See the <a href="/cookies">Cookie Policy</a> for the full, itemized list of what is and isn't set.</p>
      </section>

      <section id="shared">
        <h2>8. Who we share it with</h2>
        <p>We don't sell data to anyone. The services below process data on our behalf, only for the purpose of running Chakusa:</p>
        <div class="pv-providers">
          {providers.map(([name, purpose]) => <div class="pv-provider"><strong>{name}</strong><span>{purpose}</span></div>)}
        </div>
      </section>

      <section id="transfers">
        <h2>9. International data transfers</h2>
        <p>Because the providers above operate infrastructure in multiple countries, your data may be processed outside the country you're in, including the United States — both AI providers' standard endpoints are US-based unless a data-residency-specific configuration is set up in the future. Each provider is responsible for its own compliance with applicable cross-border data-transfer rules; we haven't independently audited their transfer mechanisms beyond relying on their published terms.</p>
      </section>

      <section id="automated">
        <h2>10. Automated decisions</h2>
        <p>When an AI feature is enabled, Chakusa's system automatically decides whether to send an AI-generated reply, hold it for a human to approve, or escalate the conversation to a person, based on confidence and safety rules (see AI Disclosure). A person can always take over. We don't use automated decisions for anything with a legal or similarly significant effect on you — for example, we don't use AI to approve or deny a booking, a refund, or account access, and payment-related actions always require a human, never the AI, by policy.</p>
      </section>

      <section id="retention">
        <h2>11. How long we keep it</h2>
        <div class="pv-table-wrap"><table class="pv-table">
          <thead><tr><th>Data</th><th>Retention</th></tr></thead>
          <tbody>{retentionRows.map(([cat, body]) => <tr><td>{cat}</td><td>{body}</td></tr>)}</tbody>
        </table></div>
        <p class="pv-note">Deletion can be requested sooner, or the law may require longer retention in specific cases (Section 13).</p>
      </section>

      <section id="security">
        <h2>12. Security measures</h2>
        <ul class="pv-list">{security.map((item) => <li>{item}</li>)}</ul>
      </section>

      <section id="rights">
        <h2>13. Your rights</h2>
        <p>Depending on where you are, you may have rights to access, correct, export, or delete your personal data, and to object to or restrict certain uses of it — for example under the EU/UK <b>GDPR</b>, the California <b>CCPA/CPRA</b>, the <b>UAE PDPL</b>, or South Africa's <b>POPIA</b>. To exercise these rights, email us (Section 17); we'll respond within the time required by applicable law. As Chakusa expands to more countries, this section will be updated to name the specific local law that applies.</p>
        <p class="pv-note">Reference: <a href="https://commission.europa.eu/law/law-topic/data-protection_en" target="_blank" rel="noopener">European Commission on data protection (GDPR)</a> · <a href="https://oag.ca.gov/privacy/ccpa" target="_blank" rel="noopener">California Attorney General on the CCPA</a></p>
      </section>

      <section id="children">
        <h2>14. Children's privacy</h2>
        <p>Chakusa is not directed at children, and we don't knowingly collect personal data from anyone under 16.</p>
      </section>

      <section id="breach">
        <h2>15. If something goes wrong</h2>
        <p>If a security incident affecting your personal data occurs, we will notify affected users and the relevant authorities as required by applicable law. We don't have a public incident-history log today; if that changes, this section will link to it.</p>
      </section>

      <section id="changes">
        <h2>16. Changes to this policy</h2>
        <p>If we make a material change to how we handle data, we'll update this page and the date at the top.</p>
      </section>

      <section id="contact" class="pv-contact">
        <h2>17. Complaints &amp; contact</h2>
        <p>If you're not satisfied with how we've handled a request, you can contact us below, or, depending on where you live, lodge a complaint with your local data protection authority.</p>
        <LegalContactPanel label="Privacy questions or a data-rights request" />
      </section>
    </div>
  </div>
</LegalLayout>

<style>
.pv-grid{width:min(100% - 2rem,72rem);margin-inline:auto;padding:3rem 0 5rem;display:grid;grid-template-columns:16rem minmax(0,1fr);gap:3rem;align-items:start}
.pv-content{min-width:0;display:grid;gap:2.5rem}
.pv-content>*{min-width:0}
.pv-quote{margin:0;padding:1.5rem 1.75rem;border-left:4px solid var(--primary);border-radius:0 var(--r-lg) var(--r-lg) 0;background:#fff}
.pv-quote p{margin:0;color:var(--heading);font:600 1.1rem/1.55 var(--font-heading)}
.pv-content section{scroll-margin-top:6rem}
.pv-content h2{margin:0 0 .85rem;font:700 1.35rem/1.3 var(--font-heading);letter-spacing:-.02em}
.pv-content p{margin:0 0 .85rem;color:var(--body-text);font-size:.95rem;line-height:1.7}
.pv-content p:last-child{margin-bottom:0}
.pv-content a{color:var(--secondary);font-weight:700}
.pv-note{font-size:.85rem;color:var(--muted-text,#687184)}
.pv-table-wrap{min-width:0;overflow-x:auto;border:1px solid var(--hairline);border-radius:var(--r-lg);margin-bottom:.85rem}
.pv-table{width:100%;border-collapse:collapse;font-size:.86rem}
.pv-table th{padding:.75rem 1rem;background:var(--page-surface);text-align:left;font:700 .72rem/1.2 var(--font);text-transform:uppercase;letter-spacing:.04em;color:var(--muted-text,#687184)}
.pv-table td{padding:.85rem 1rem;border-top:1px solid var(--hairline);vertical-align:top;color:var(--body-text)}
.pv-table td:first-child{white-space:nowrap;font-weight:700;color:var(--heading)}
.pv-list{display:grid;gap:.6rem;margin:0;padding:0;list-style:none}
.pv-list li{position:relative;padding-left:1.6rem;color:var(--body-text);font-size:.92rem;line-height:1.55}
.pv-list li::before{content:'\2713';position:absolute;left:0;color:var(--secondary);font-weight:900}
.pv-providers{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin:0 0 1rem}
.pv-provider{padding:.9rem;border:1px solid var(--hairline);border-radius:var(--r-md);background:#fff}
.pv-provider strong{display:block;font-size:.85rem;color:var(--heading)}
.pv-provider span{display:block;margin-top:.3rem;font-size:.72rem;color:var(--muted-text,#687184);line-height:1.4}
@media(max-width:64rem){
  .pv-grid{grid-template-columns:1fr}
  .pv-providers{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:40rem){
  .pv-providers{grid-template-columns:1fr}
}
</style>
