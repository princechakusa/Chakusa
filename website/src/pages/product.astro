---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import ProductHero from "../components/product/ProductHero.astro";
import ProductNavigation from "../components/product/ProductNavigation.astro";
import ProductJourney from "../components/product/ProductJourney.astro";
import ProductShowcase from "../components/product/ProductShowcase.astro";
import AiAssistantStory from "../components/product/AiAssistantStory.astro";
import MarketplaceStory from "../components/product/MarketplaceStory.astro";
import BusinessControlStory from "../components/product/BusinessControlStory.astro";
import ProductMobile from "../components/product/ProductMobile.astro";
import ProductIndustries from "../components/product/ProductIndustries.astro";
import ProductFAQ from "../components/product/ProductFAQ.astro";
import ProductFinalCTA from "../components/product/ProductFinalCTA.astro";
import ProductSchemas from "../components/product/ProductSchemas.astro";
import "../styles/product/product.css";
import "../styles/product/product-responsive.css";
const title = "Chakusa Product | One Platform for Every Customer Moment";
const description = "See how Chakusa connects customer discovery, enquiries, bookings, customer profiles, automation, reviews, retention, AI-assisted responses, and business insight for local service businesses.";
---
<MarketingLayout {title} {description}><ProductSchemas /><SkipLink /><Header /><main id="main-content"><ProductHero /><ProductNavigation /><ProductJourney /><ProductShowcase /><AiAssistantStory /><MarketplaceStory /><BusinessControlStory /><ProductMobile /><ProductIndustries /><ProductFAQ /><ProductFinalCTA /></main><Footer /></MarketingLayout>
