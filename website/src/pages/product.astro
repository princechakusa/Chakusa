---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import ProductHero from "../components/product/ProductHero.astro";
import SixEngines from "../components/product/SixEngines.astro";
import HandshakeView from "../components/product/HandshakeView.astro";
import ProductIndustriesGrid from "../components/product/ProductIndustriesGrid.astro";
import ProductFAQ from "../components/product/ProductFAQ.astro";
import ProductFinalCTA from "../components/product/ProductFinalCTA.astro";
import ProductSchemas from "../components/product/ProductSchemas.astro";
import "../styles/product/product.css";
import "../styles/product/product-responsive.css";
const title = "Chakusa Product | One Platform for Every Customer Moment";
const description = "See how Chakusa connects customer discovery, enquiries, bookings, customer profiles, automation, reviews, retention, AI-assisted responses, and business insight for local service businesses.";
---
<MarketingLayout {title} {description}><ProductSchemas /><SkipLink /><Header /><main id="main-content"><ProductHero /><SixEngines /><HandshakeView /><ProductIndustriesGrid /><ProductFAQ /><ProductFinalCTA /></main><Footer /></MarketingLayout>
