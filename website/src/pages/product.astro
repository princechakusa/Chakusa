---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import SkipLink from "../components/foundation/SkipLink.astro";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import ProductHero from "../components/product/ProductHero.astro";
import ProductNavigation from "../components/product/ProductNavigation.astro";
import ProductJourney from "../components/product/ProductJourney.astro";
import ProductShowcase from "../components/product/ProductShowcase.astro";
import ProductMobile from "../components/product/ProductMobile.astro";
import ProductFAQ from "../components/product/ProductFAQ.astro";
import ProductFinalCTA from "../components/product/ProductFinalCTA.astro";
import ProductSchemas from "../components/product/ProductSchemas.astro";
import "../styles/product/product.css";
import "../styles/product/product-responsive.css";
const title = "Chakusa Product | The Complete Customer Journey";
const description = "See how Chakusa connects customer enquiries, profiles, bookings, reminders, reviews, follow-ups, automation, analytics, and mobile tools for service businesses.";
---
<MarketingLayout {title} {description}><ProductSchemas /><SkipLink /><Header /><main id="main-content"><ProductHero /><ProductNavigation /><ProductJourney /><ProductShowcase /><ProductMobile /><ProductFAQ /><ProductFinalCTA /></main><Footer /></MarketingLayout>
