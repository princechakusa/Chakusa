---
import MarketingLayout from "../layouts/MarketingLayout.astro";import Header from "../components/header/Header.astro";import Footer from "../components/footer/Footer.astro";
---
<MarketingLayout title="Choose a new password | Chakusa" description="Complete a secure Chakusa password reset."><Header/><main class="recovery-page"><section class="recovery-card"><p class="dashboard-eyebrow">Secure reset</p><h1>Choose a new password</h1><p>This single-use link expires automatically. Resetting your password revokes existing sessions.</p><form data-reset-form><fieldset><legend>Account type</legend><label><input type="radio" name="realm" value="client" checked/> Client</label><label><input type="radio" name="realm" value="business"/> Business</label></fieldset><label>New password<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="256" required/></label><label>Confirm password<input name="confirm" type="password" autocomplete="new-password" minlength="12" maxlength="256" required/></label><small>Use at least 12 characters with uppercase, lowercase, and a number.</small><div data-turnstile></div><button type="submit" disabled>Reset password</button><p data-message role="status"></p></form><a href="/login">Return to sign in</a></section></main><Footer/></MarketingLayout>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script>const form=document.querySelector<HTMLFormElement>("[data-reset-form]")!;const submit=form.querySelector<HTMLButtonElement>("button")!;const message=form.querySelector<HTMLElement>("[data-message]")!;const token=new URLSearchParams(location.search).get("token")||"";if(!token)message.textContent="This reset link is incomplete. Request a new one.";const timer=setInterval(()=>{const api=(window as any).turnstile;if(!api)return;clearInterval(timer);form.dataset.widget=api.render(form.querySelector("[data-turnstile]"),{sitekey:"0x4AAAAAAEpe472lujrUft2Q",action:"chakusa_reset",callback:(value:string)=>{form.dataset.turnstileToken=value;submit.disabled=!token;}});},150);form.addEventListener("submit",async event=>{event.preventDefault();const data=new FormData(form);const password=String(data.get("password")||"");if(password!==data.get("confirm")){message.textContent="The passwords do not match.";return;}if(!/(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{12,}/.test(password)){message.textContent="Use at least 12 characters with uppercase, lowercase, and a number.";return;}if(!form.dataset.turnstileToken||!token)return;submit.disabled=true;message.textContent="Resetting your password securely...";try{const response=await fetch("https://auth.chakusarecovery.com/v1/reset-password",{method:"POST",credentials:"include",headers:{"content-type":"application/json"},body:JSON.stringify({realm:data.get("realm"),token,password,turnstileToken:form.dataset.turnstileToken})});const body=await response.json();if(!response.ok)throw new Error(body.error||"Reset failed.");message.textContent=body.message;setTimeout(()=>location.assign("/login"),1500);}catch(error){message.textContent=error instanceof Error?error.message:"Reset failed.";}finally{const api=(window as any).turnstile;if(form.dataset.widget)api?.reset(form.dataset.widget);delete form.dataset.turnstileToken;}});</script>
<style is:global>.recovery-page{min-height:70vh;padding:5rem 1rem;background:#f5f7fa}.recovery-card{max-width:34rem;margin:auto;padding:2rem;border:1px solid #e2e6ed;border-radius:1.2rem;background:#fff;box-shadow:0 1rem 3rem rgba(31,39,56,.08)}.recovery-card h1{margin:.3rem 0;font:800 2.2rem var(--font-heading);color:#172033}.recovery-card>p{color:#667184;line-height:1.6}.recovery-card form{display:grid;gap:1rem;margin:1.5rem 0}.recovery-card fieldset{display:flex;gap:1.2rem;border:0;padding:0}.recovery-card legend,.recovery-card form>label{display:grid;gap:.4rem;font-size:.8rem;font-weight:750;color:#354158}.recovery-card fieldset label{display:flex;gap:.4rem}.recovery-card input[type=password]{min-height:3rem;padding:.7rem;border:1px solid #dbe1e8;border-radius:.7rem}.recovery-card button{min-height:3.1rem;border:0;border-radius:.7rem;background:#d9452e;color:#fff;font-weight:800}.recovery-card button:disabled{opacity:.5}.recovery-card small,.recovery-card [data-message]{color:#667184;font-size:.78rem}.recovery-card>a{color:#9b2e1e;font-weight:750}</style>
