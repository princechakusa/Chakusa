---
import LegalLayout from "../components/legal/LegalLayout.astro";
import LegalToc from "../components/legal/LegalToc.astro";

// Public SMS terms and opt-in evidence. This is the "proof of consent" URL
// given to Twilio for toll-free verification, so the consent wording below
// must stay identical to the app's booking checkbox
// (mobile/src/customer/screens/BookingFlowScreen.tsx) and to
// smsConsentDisclosure() in src/lib/messaging/smsConsent.ts.
const title = "SMS Terms & Opt-In | Chakusa";
const description = "How customers opt in to appointment text messages sent through Chakusa, what they receive, how often, and how to stop them with STOP or get help with HELP.";
const lastUpdated = "2026-10-14";

const hero = {
  title: "Appointment text messages",
  lede: "Chakusa is a booking platform for service businesses. Customers only get appointment texts after they tick an unticked consent box when they book, and can stop them at any time by replying STOP.",
  status: "In effect",
  lastUpdated,
};

const toc: Array<[string, string]> = [
  ["program", "1. The SMS program"],
  ["optin", "2. How you opt in"],
  ["messages", "3. What you will receive"],
  ["frequency", "4. Frequency & cost"],
  ["optout", "5. Opting out (STOP)"],
  ["help", "6. Help (HELP)"],
  ["privacy", "7. Your number stays private"],
  ["samples", "8. Sample messages"],
  ["contact", "9. Contact"],
];

const disclosure = "I agree to receive appointment text messages (confirmations, reminders and updates) from [Business name] via Chakusa at the phone number on my account. Message frequency varies. Msg & data rates may apply. Reply STOP to opt out, HELP for help. Consent is not a condition of booking.";

const samples = [
  "Ada Hair Studio: your Haircut appointment is booked for Oct 21, 2026, 2:00 PM. Reply STOP to opt out.",
  "Ada Hair Studio: reminder that your Haircut appointment is at Oct 21, 2026, 2:00 PM.",
  "Ada Hair Studio: your Haircut appointment was moved to Oct 22, 2026, 10:00 AM.",
  "Ada Hair Studio: your Haircut provider is on the way.",
];
---
<LegalLayout {title} {description} current="sms" {hero}>
  <div class="sms__body"><div class="sms__shell sms__grid">
    <LegalToc items={toc} ctaHref="mailto:support@chakusarecovery.com" ctaLabel="Contact support" />

    <div class="sms__content">
      <section id="program">
        <h2>1. The SMS program</h2>
        <p><strong>Program name:</strong> Chakusa Appointment Notifications.</p>
        <p>Chakusa (chakusarecovery.com) is software that independent service businesses, such as salons, barbers and car washes, use to take bookings. When you book with one of these businesses through Chakusa and agree to texts, that business sends you transactional messages about your appointment through Chakusa. Messages come from the business's Chakusa number, including our toll-free number <strong>+1 (844) 604-1271</strong>, and start with the business's name.</p>
        <p>We do not send marketing or promotional text messages through this program.</p>
      </section>

      <section id="optin">
        <h2>2. How you opt in</h2>
        <p>You opt in yourself, in the Chakusa app, on the last step of booking an appointment ("Review &amp; confirm"). Under the booking summary there is a checkbox that is <strong>unticked by default</strong>. Texts are only sent if you tick it. You can book without ticking it.</p>
        <figure class="sms__shot">
          <img src="/sms/booking-consent.png" width="390" height="1100" loading="lazy" alt="The Chakusa app's Review and confirm booking step for an example business, Ada Hair Studio. Below the booking summary is an unticked checkbox reading: Text me about this appointment. I agree to receive appointment text messages (confirmations, reminders and updates) from Ada Hair Studio via Chakusa at the phone number on my account. Message frequency varies. Msg and data rates may apply. Reply STOP to opt out, HELP for help. Consent is not a condition of booking. See chakusarecovery.com/sms. Below it is the Confirm booking button." />
          <figcaption>The consent step in the Chakusa app, shown with the box unticked as every customer first sees it. Ada Hair Studio is an example business; the business's own name appears in its place.</figcaption>
        </figure>
        <p>Exact consent wording shown to the customer:</p>
        <blockquote class="sms__quote">{disclosure}</blockquote>
        <p>We record each choice, ticked or not, with the time, the business, the booking it was made on and the version of this wording. If you don't tick the box, that business won't send you automated appointment texts.</p>
        <p>A business can also add a customer's number itself, for example when you call or walk in. Before a business can send automated texts it must confirm, in its Chakusa settings, that it has its customers' consent to text them. The STOP and HELP rules below apply to every message.</p>
      </section>

      <section id="messages">
        <h2>3. What you will receive</h2>
        <ul class="sms__list">
          <li>Booking confirmations</li>
          <li>Appointment reminders, including on the day</li>
          <li>Notices that an appointment was rescheduled or canceled</li>
          <li>"On the way", "running late" or "arrived" updates for mobile services</li>
          <li>A payment reminder for a service you booked, where the business has enabled it</li>
        </ul>
      </section>

      <section id="frequency">
        <h2>4. Frequency &amp; cost</h2>
        <p>How many messages you get varies with your bookings, usually 1 to 5 per appointment. Message and data rates may apply, depending on your mobile plan. Carriers are not liable for delayed or undelivered messages.</p>
      </section>

      <section id="optout">
        <h2>5. Opting out (STOP)</h2>
        <p>Reply <strong>STOP</strong> to any message to stop receiving texts. <strong>UNSUBSCRIBE</strong>, <strong>CANCEL</strong>, <strong>END</strong> and <strong>QUIT</strong> also work. You will get one final message confirming you've been unsubscribed. After that, no more texts go to your number from that business. Reply <strong>START</strong> to opt back in.</p>
      </section>

      <section id="help">
        <h2>6. Help (HELP)</h2>
        <p>Reply <strong>HELP</strong> to any message for help, or email <a href="mailto:support@chakusarecovery.com">support@chakusarecovery.com</a>. For questions about a specific appointment, contact the business you booked with directly.</p>
      </section>

      <section id="privacy">
        <h2>7. Your number stays private</h2>
        <p><strong>Mobile numbers and SMS opt-in consent are never shared with or sold to third parties or affiliates for marketing or promotional purposes.</strong> Your number is only used to send messages about the appointments you booked. The service providers who deliver the messages, such as our SMS carrier Twilio, process your number only to send them. See our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>.</p>
      </section>

      <section id="samples">
        <h2>8. Sample messages</h2>
        <ul class="sms__list sms__list--samples">
          {samples.map((sample) => <li><code>{sample}</code></li>)}
        </ul>
      </section>

      <section id="contact">
        <h2>9. Contact</h2>
        <p>Chakusa · <a href="mailto:support@chakusarecovery.com">support@chakusarecovery.com</a> · <a href="https://chakusarecovery.com">chakusarecovery.com</a></p>
      </section>
    </div>
  </div></div>
</LegalLayout>

<style>
.sms__body{padding:3rem 0 4rem}
.sms__shell{width:min(72rem,calc(100% - 2rem));margin:0 auto}
.sms__grid{display:grid;grid-template-columns:16rem minmax(0,1fr);gap:3rem;align-items:start}
.sms__content{min-width:0;display:grid;gap:2.5rem}
.sms__content section{scroll-margin-top:6rem}
.sms__content h2{margin:0 0 .85rem;font:700 1.35rem/1.3 var(--font-heading);letter-spacing:-.02em}
.sms__content p{margin:0 0 .85rem;color:var(--body-text);font-size:.95rem;line-height:1.7}
.sms__content p:last-child{margin-bottom:0}
.sms__content a{color:var(--secondary);font-weight:700}
.sms__list{display:grid;gap:.5rem;margin:0;padding-left:1.2rem;color:var(--body-text);font-size:.95rem;line-height:1.6}
.sms__list--samples{list-style:none;padding:0}
.sms__list--samples code{display:block;padding:.75rem 1rem;border:1px solid var(--hairline);border-radius:var(--r-lg);background:var(--page-surface);font-size:.85rem;white-space:normal;color:var(--heading)}
.sms__quote{margin:0 0 .85rem;padding:1rem 1.25rem;border-left:4px solid var(--secondary);background:var(--page-surface);border-radius:0 var(--r-lg) var(--r-lg) 0;color:var(--heading);font-size:.92rem;line-height:1.6}
.sms__shot{margin:0 0 1rem}
.sms__shot img{display:block;width:100%;max-width:20rem;height:auto;border:1px solid var(--hairline);border-radius:1.25rem;box-shadow:0 .75rem 2rem rgba(31,39,56,.08)}
.sms__shot figcaption{margin-top:.6rem;font-size:.8rem;color:var(--muted-text,#687184)}
@media(max-width:64rem){.sms__grid{grid-template-columns:1fr}}
</style>
