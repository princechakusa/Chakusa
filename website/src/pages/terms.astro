---
import LegalLayout from "../components/legal/LegalLayout.astro";
import LegalToc from "../components/legal/LegalToc.astro";
import LegalDisclaimer from "../components/legal/LegalDisclaimer.astro";
import LegalContactPanel from "../components/legal/LegalContactPanel.astro";

const title = "Terms of Service | Chakusa";
const description = "Read the terms governing Chakusa business and customer accounts, marketplace discovery, bookings, messaging, subscriptions, AI assistance, and acceptable use.";
const lastUpdated = "Effective September 4, 2026";

const hero = {
  eyebrow: "Platform agreement",
  title: "Chakusa Terms of Service",
  lede: "The agreement governing how businesses and customers use Chakusa's marketplace, bookings, messaging, and business tools.",
  status: "Engineering draft; not attorney-reviewed",
  lastUpdated,
};

const pillars: Array<[string, string]> = [
  ["Direct relationship", "Businesses provide the services customers book. Chakusa supplies the platform that connects them."],
  ["Clear responsibility", "Businesses control their services and policies. Customers control their account activity and choices."],
  ["Honest participation", "Listings, bookings, messages, and reviews must reflect genuine activity."],
];

const clauses: Array<[string, string]> = [
  ["Agreement and eligibility", "These Terms govern Chakusa's website, marketplace, business tools, customer tools, and related services. By creating an account or using Chakusa, you agree to these Terms and the Privacy Policy. You must be legally able to enter into a contract where you live."],
  ["Business and customer accounts", "One person may use Chakusa as a business and as a customer. Business accounts manage enquiries, services, bookings, customer records, messages, reviews, reminders, and team access. Customer accounts discover businesses, make enquiries and bookings, exchange messages, and leave honest reviews."],
  ["Business responsibilities", "Businesses are responsible for accurate listings, services, prices, availability, qualifications, customer communications, and service policies. Businesses must have any consent required before contacting customers and must honor opt-out requests."],
  ["Customer responsibilities", "Customers must provide accurate information, use bookings responsibly, communicate respectfully, and submit reviews based on genuine interactions. False, misleading, abusive, or manipulated content is prohibited."],
  ["Marketplace and bookings", "Chakusa connects customers with independent service businesses. Unless expressly stated otherwise, Chakusa is not the provider of a booked service and is not a party to the service agreement between a customer and a business."],
  ["Payments and subscriptions", "Where supported, payment processing may be provided by Stripe and remains subject to the payment provider's terms. Paid Chakusa plans may be purchased through the Apple App Store or Google Play, whose billing, renewal, cancellation, and refund rules apply."],
  ["Messaging, automation, and AI", "Chakusa may prepare messages, create workflow tasks, and provide AI-assisted drafts. AI output can be inaccurate. Users must review important information and must not treat AI output as medical, legal, financial, or other professional advice."],
  ["Content and ownership", "You retain ownership of content and business information you provide. You grant Chakusa the limited rights needed to host, process, display, and transmit that content. Chakusa retains ownership of its software, branding, documentation, and platform materials."],
  ["Acceptable use", "Do not use Chakusa for unlawful or deceptive messages, false listings or reviews, unauthorized access, malicious code, security bypasses, harassment, fraud, or infringement of another person's rights."],
  ["Suspension and termination", "You may stop using Chakusa at any time. Chakusa may restrict or terminate access to address fraud, abuse, security risks, legal requirements, non-payment, or material violations of these Terms."],
  ["Availability and liability", "Chakusa is provided on an as-is and as-available basis to the extent permitted by law. Chakusa does not guarantee uninterrupted operation, business results, customer conversion, review ratings, or revenue outcomes."],
  ["Changes, disputes, and contact", "Material updates will appear on this page with a revised effective date. If a dispute arises, contact Chakusa first. Applicable law, mandatory consumer protections, and jurisdiction rules remain in effect and are not waived by these Terms."],
];

const toc: Array<[string, string]> = clauses.map(([clauseTitle], index) => [`term-${index + 1}`, `${index + 1}. ${clauseTitle}`]);
---
<LegalLayout {title} {description} current="terms" {hero}>
  <LegalDisclaimer slot="hero-disclaimer">
    This page reflects the product's current terms as implemented. It has not been reviewed by a licensed attorney and shouldn't be relied on to establish legal enforceability.
  </LegalDisclaimer>

  <div class="terms__body"><div class="terms__shell terms__grid">
    <aside class="terms__toc-col">
      <LegalToc items={toc} ctaHref="mailto:support@chakusarecovery.com" ctaLabel="Contact support" />
      <button type="button" class="terms__print" data-print>Print agreement</button>
    </aside>

    <div class="terms__content">
      <section class="terms__pillars" aria-labelledby="terms-pillars-heading">
        <p class="terms__kicker">Agreement essentials</p>
        <h2 id="terms-pillars-heading">Clear responsibilities on both sides of the platform.</h2>
        <div class="terms__pillars-grid">
          {pillars.map(([pillarTitle, pillarBody], index) => (
            <article class="terms__pillar">
              <span>0{index + 1}</span>
              <h3>{pillarTitle}</h3>
              <p>{pillarBody}</p>
            </article>
          ))}
        </div>
      </section>

      <article class="terms__document">
        {clauses.map(([clauseTitle, clauseBody], index) => (
          <section id={`term-${index + 1}`}>
            <header>
              <span>Clause {index + 1}.0</span>
              <h2>{clauseTitle}</h2>
            </header>
            <p>{clauseBody}</p>
            {index === 6 && (
              <p>See the <a href="/ai-disclosure">AI Disclosure</a> for additional information about AI controls and limitations.</p>
            )}
            {index === 11 && (
              <LegalContactPanel label="Questions about these Terms?" email="support@chakusarecovery.com" />
            )}
          </section>
        ))}
      </article>
    </div>
  </div></div>
</LegalLayout>

<script>
document.querySelectorAll<HTMLElement>("[data-print]").forEach((button) => button.addEventListener("click", () => window.print()));
</script>

<style>
.terms__shell{width:min(100% - 2rem,72rem);margin-inline:auto}
.terms__body{padding:3rem 0 5rem}
.terms__grid{display:grid;grid-template-columns:16rem minmax(0,1fr);gap:3rem;align-items:start}
.terms__toc-col{display:grid;gap:0.75rem}
.terms__print{display:block;width:100%;padding:0.75rem;border:1px solid var(--hairline);border-radius:0.6rem;background:#fff;color:var(--heading);font-size:0.8rem;font-weight:700;cursor:pointer;min-height:2.75rem}
.terms__print:hover{border-color:var(--secondary)}
.terms__print:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
.terms__content{min-width:0;display:grid;gap:2.5rem}
.terms__content>*{min-width:0}
.terms__kicker{margin:0 0 0.5rem;color:var(--muted-text,#687184);font:800 0.72rem/1.2 var(--font);letter-spacing:0.08em;text-transform:uppercase}
.terms__pillars h2{margin:0 0 1.25rem;font:700 1.35rem/1.3 var(--font-heading);letter-spacing:-0.02em;color:var(--heading)}
.terms__pillars-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
.terms__pillar{padding:1.1rem;border:1px solid var(--hairline);border-radius:var(--r-lg);background:#fff}
.terms__pillar span{display:block;color:var(--secondary);font:800 0.78rem/1.2 var(--font)}
.terms__pillar h3{margin:0.5rem 0 0.4rem;font:700 1rem/1.3 var(--font-heading);color:var(--heading)}
.terms__pillar p{margin:0;color:var(--body-text);font-size:0.85rem;line-height:1.55}
.terms__document{display:grid;gap:2.5rem}
.terms__document section{scroll-margin-top:6rem}
.terms__document header{margin-bottom:0.6rem}
.terms__document header span{display:block;color:var(--muted-text,#687184);font:700 0.72rem/1.2 var(--font);letter-spacing:0.04em;text-transform:uppercase}
.terms__document h2{margin:0.25rem 0 0;font:700 1.35rem/1.3 var(--font-heading);letter-spacing:-0.02em;color:var(--heading)}
.terms__document p{margin:0.85rem 0 0;color:var(--body-text);font-size:0.95rem;line-height:1.7}
.terms__document a{color:var(--secondary);font-weight:700}
@media (max-width: 64rem) {
  .terms__grid{grid-template-columns:1fr}
  .terms__pillars-grid{grid-template-columns:1fr}
}
</style>
